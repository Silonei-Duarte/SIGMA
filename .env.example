# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-unica
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS_ENABLED=False

# PostgreSQL
DB_DEFAULT_NAME=sigma
DB_DEFAULT_USER=sigma
DB_DEFAULT_PASSWORD=troque-por-uma-senha
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=6432
# Ambiente padrão: Django usa PgBouncer em pool por transação.
POSTGRES_USA_PGBOUNCER=1
# Conexão direta necessária para a advisory lock global dos workers.
POSTGRES_DIRECT_HOST=127.0.0.1
POSTGRES_DIRECT_PORT=5432

# Oracle ERP
ORACLE_ERP_NAME=host:porta/servico
ORACLE_ERP_USER=usuario
ORACLE_ERP_PASSWORD=troque-por-uma-senha

# Oracle Alchemy
ORACLE_ALCHEMY_NAME=host:porta/servico
ORACLE_ALCHEMY_USER=usuario
ORACLE_ALCHEMY_PASSWORD=troque-por-uma-senha

# Webservices Sapiens G5
SAPIENS_URL_BASE=https://servidor:porta
SAPIENS_USERNAME=usuario
SAPIENS_PASSWORD=troque-por-uma-senha
SAPIENS_SOAP_VERSION=1.2

# WMS XC API
WMS_XC_API_URL=https://servidor/api
WMS_XC_API_USER=usuario
WMS_XC_API_PASSWORD=troque-por-uma-senha

# Filas de integração (opcional; paralelismo por lote/grupo, padrão 10)
LOGS_APONTAMENTOS_MAX_WORKERS=10
LOGS_APONTAMENTO_COMPONENTES_MAX_WORKERS=10
LOGS_BAIXA_COMPONENTES_MAX_WORKERS=10

# Coleta de telemetria HTTP (opcional; valores padrão indicados)
# Obrigatório definir antes de ativar qualquer fonte: sem allowlist a coleta falha fechada.
TELEMETRIA_HOSTS_PERMITIDOS=
TELEMETRIA_PAUSA_SUCESSO_SEGUNDOS=10
TELEMETRIA_BACKOFF_ERRO_SEGUNDOS=10
TELEMETRIA_TIMEOUT_MAX_SEGUNDOS=30
TELEMETRIA_PAUSA_MAX_SEGUNDOS=3600
TELEMETRIA_RESPOSTA_MAX_BYTES=1048576

# Active Directory / LDAP
LDAP_SERVER_URI=ldaps://servidor:636
LDAP_BIND_DN=DOMINIO\\usuario-servico
LDAP_BIND_PASSWORD=troque-por-uma-senha
LDAP_USER_DOMAIN=dominio.local
LDAP_REQUIRE_GROUP=
LDAP_CA_CERT_FILE=
LDAP_USER_SEARCH_BASE=DC=dominio,DC=local
# Se vazio, o settings.py utiliza LDAP_USER_SEARCH_BASE.
LDAP_GROUP_SEARCH_BASE=

# Microsoft Graph (aplicacao Entra com permissao de aplicativo Mail.Send)
MICROSOFT_GRAPH_TENANT_ID=seu-tenant-id
MICROSOFT_GRAPH_CLIENT_ID=seu-client-id
MICROSOFT_GRAPH_CLIENT_SECRET=seu-client-secret
MICROSOFT_GRAPH_MAIL_SENDER=remetente@dominio.com
MICROSOFT_GRAPH_TIMEOUT=30
DEFAULT_FROM_EMAIL=SIGMA <remetente@dominio.com>
PORTAL_BASE_URL=http://127.0.0.1:8000

# Firebase Cloud Messaging (arquivo privado somente no servidor)
FIREBASE_CREDENTIALS_FILE=/etc/sigma/firebase-admin.json

# Assinatura do APK Android (usada somente na maquina que gera o APK)
SIGMA_KEYSTORE_PASSWORD=
SIGMA_APK_FILE=artifacts/SIGMA.apk

# Ferramentas locais (opcional; este e o padrao no Windows)
NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd
