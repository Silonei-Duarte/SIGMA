# Exemplo de .env para rodar o SIGMA no container Docker de imagem única
# (Dockerfile na raiz). Copie para um arquivo próprio (ex.: .env.docker) e
# preencha antes de `docker run --env-file`; nunca commite o arquivo
# preenchido. Para as demais variáveis (Oracle, Sapiens, WMS, LDAP, Microsoft
# Graph, Firebase, Telemetria) use como referência o `.env.example` da raiz —
# aqui só estão destacadas as diferenças do modo Docker.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-unica
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS_ENABLED=False

# PostgreSQL: dentro da imagem não existe PgBouncer, então a conexão direta é
# mais simples e é o padrão de exemplo aqui — diferente do `.env.example` da
# raiz, que assume o PgBouncer de produção. Usuário/senha/banco abaixo são
# criados pelo docker/entrypoint.sh na primeira subida do container.
DB_DEFAULT_NAME=sigma
DB_DEFAULT_USER=sigma
DB_DEFAULT_PASSWORD=troque-por-uma-senha
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
POSTGRES_USA_PGBOUNCER=0
POSTGRES_DIRECT_HOST=127.0.0.1
POSTGRES_DIRECT_PORT=5432

# Ferramentas locais: dentro do container o npm só é usado no build da
# imagem; não precisa ser definido para rodar o container.
NPM_BIN_PATH=/usr/bin/npm

# Demais variáveis (Oracle ERP/Alchemy, Sapiens, WMS, LDAP, Microsoft Graph,
# Firebase, Telemetria) seguem exatamente o `.env.example` da raiz.
