a␀␀CREATE OR REPLACE PROCEDURE SP_SLDCCU_PLANOCTB
(
	V_CODEMP IN NUMBER)
AS 
  V_COUNT NUMBER;
BEGIN

 /* CRIANDO/TRUNCANDO TABELAS TEMPORARIAS... */
  DBMS_OUTPUT.PUT_LINE('PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...)'||to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')));

  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E045PLA_TMP4';
  
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E045PLA_TMP4';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E045PLA_TMP4     
	                   (CODEMP NUMBER(4) NOT NULL,      
					    CTARED NUMBER(7) NOT NULL,      
						ROOT_CTARED NUMBER(7) NOT NULL,      
						CLACTA VARCHAR2(30) NOT NULL,      
						NIVCTA NUMBER(2) NOT NULL,      
						QTDPOS NUMBER(1) NOT NULL) ON COMMIT PRESERVE ROWS'    ;
    
	EXECUTE IMMEDIATE 'CREATE INDEX E045PLA_TMP4Indice1 ON E045PLA_TMP4 (CODEMP, ROOT_CTARED)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E044CCU_TMP4';
  IF V_COUNT   > 0 THEN 
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E044CCU_TMP4';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E044CCU_TMP4     
	                  (CODEMP NUMBER(4) NOT NULL,      
					   CODCCU VARCHAR(9) NOT NULL,      
					   ROOT_CODCCU VARCHAR(9) NOT NULL,      
					   CCUPAI VARCHAR(9) NULL,      
					   CLACCU VARCHAR2(30) NOT NULL,      
					   NIVCCU NUMBER(2) NOT NULL,      
					   POSCCU NUMBER(2) NOT NULL) ON COMMIT PRESERVE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX E044CCU_TMP4Indice1 ON E044CCU_TMP4 (CODEMP, ROOT_CODCCU)';
  END IF;

  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'PLACCU_TMP4';  
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE PLACCU_TMP4';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE PLACCU_TMP4     
	                  (CODEMP NUMBER(4) NOT NULL,      
					   CODFIL NUMBER(5) NOT NULL,      
					   MESANO DATE NOT NULL,      
					   CTARED NUMBER(7) NOT NULL,      
					   CLACTA VARCHAR2(30) NOT NULL,      
					   NIVCTA NUMBER(2) NULL,      
					   CODCCU VARCHAR(9) NULL,      
					   CLACCU VARCHAR2(30) NULL,      
					   NIVCCU NUMBER(2) NULL) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX PLACCU_TMP4Indice1 ON PLACCU_TMP4 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'DEB_TMP4';
  IF V_COUNT   > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE DEB_TMP4';
  ELSE EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE DEB_TMP4     
                         (CODEMP NUMBER(4) NOT NULL,      
						  CODFIL NUMBER(5) NOT NULL,      
						  MESANO DATE NOT NULL,      
						  CTARED NUMBER(7) NOT NULL,      
						  CLACTA VARCHAR2(30) NOT NULL,      
						  CODCCU VARCHAR2(9) NOT NULL,      
						  CLACCU VARCHAR2(30) NOT NULL,      
						  SOMA NUMBER(17,2)) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX DEB_TMP4Indice1 ON DEB_TMP4 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'CRE_TMP4';
  IF V_COUNT   > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE CRE_TMP4';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE CRE_TMP4     
	                   (CODEMP NUMBER(4) NOT NULL,      
					    CODFIL NUMBER(5) NOT NULL,      
						MESANO DATE NOT NULL,      
						CTARED NUMBER(7) NOT NULL,      
						CLACTA VARCHAR2(30) NOT NULL,      
						CODCCU VARCHAR2(9) NOT NULL,      
						CLACCU VARCHAR2(30) NOT NULL,      
						SOMA NUMBER(17,2)) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX CRE_TMP4Indice1 ON CRE_TMP4 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'MOV_TMP4';
  IF V_COUNT   > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE MOV_TMP4';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE MOV_TMP4     
	                  (CODEMP NUMBER(4) NOT NULL,      
					   CODFIL NUMBER(5) NOT NULL,      
					   MESANO DATE NOT NULL,      
					   CTARED NUMBER(7) NOT NULL,      
					   CLACTA VARCHAR2(30) NOT NULL,      
					   CODCCU VARCHAR2(9) NOT NULL,      
					   CLACCU VARCHAR2(30) NOT NULL,      
					   DEBMES NUMBER(17,2),      
					   CREMES NUMBER(17,2),      
					   MOVMES NUMBER(17,2)) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX MOV_TMP4Indice1 ON MOV_TMP4 (CODEMP, CODFIL, CTARED, CODCCU, MESANO)';
    EXECUTE IMMEDIATE 'CREATE INDEX MOV_TMP4Indice2 ON MOV_TMP4 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
  
  /*(GERANDO CONTAS...)*/
  DBMS_OUTPUT.PUT_LINE('PASSO 2 (GERANDO CONTAS...)'||to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  
  FOR C_PLA IN (SELECT CODEMP, CTARED FROM  E045PLA WHERE CODEMP = V_CODEMP ORDER BY CTARED)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E045PLA_TMP4 (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS)     
                       SELECT E045PLA2.CODEMP CODEMP, E045PLA2.CTARED CTARED, E045PLA3.CTARED ROOT_CTARED, E045PLA2.CLACTA CLACTA,         
                              E045PLA2.NIVCTA NIVCTA, E045PLA2.QTDPOS QTDPOS     
                       FROM E045PLA E045PLA2, 
                            (SELECT CODEMP, CTARED FROM E045PLA WHERE E045PLA.CODEMP = :1 AND E045PLA.CTARED = :2) E045PLA3     
                       WHERE E045PLA2.CODEMP = E045PLA3.CODEMP     
                       START WITH E045PLA2.CODEMP = E045PLA3.CODEMP AND E045PLA2.CTARED = E045PLA3.CTARED     
                       CONNECT BY PRIOR E045PLA2.CODEMP = E045PLA2.CODEMP 
                              AND PRIOR E045PLA2.NIVCTA-1 = E045PLA2.NIVCTA             
                              AND PRIOR SUBSTR(TO_CHAR(E045PLA2.CLACTA),1,LENGTH(E045PLA2.CLACTA)-E045PLA2.QTDPOS) = E045PLA2.CLACTA     
                       ORDER SIBLINGS BY E045PLA2.CLACTA'  USING IN C_PLA.CODEMP, IN C_PLA.CTARED;
  END LOOP;
  
  /* GERANDO CENTROS DE CUSTO... */
  DBMS_OUTPUT.PUT_LINE('PASSO 2 (GERANDO CENTROS DE CUSTO...)'||to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  
  FOR C_CCU IN ( SELECT CODEMP, CODCCU FROM E044CCU WHERE  CODEMP = V_CODEMP ORDER BY CODCCU)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E044CCU_TMP4 (CODEMP, CODCCU, ROOT_CODCCU, CCUPAI, CLACCU, NIVCCU, POSCCU)     
                       SELECT E044CCU2.CODEMP CODEMP, E044CCU2.CODCCU CODCCU, E044CCU3.CODCCU ROOT_CODCCU, E044CCU2.CCUPAI CCUPAI, E044CCU2.CLACCU CLACCU,         
                              E044CCU2.NIVCCU NIVCCU, E044CCU2.POSCCU POSCCU     
                       FROM E044CCU E044CCU2, 
                            (SELECT CODEMP, CODCCU FROM E044CCU WHERE E044CCU.CODEMP = :1 AND E044CCU.CODCCU = :2) E044CCU3     
                       WHERE E044CCU2.CODEMP = E044CCU3.CODEMP     
                       START WITH E044CCU2.CODEMP = E044CCU3.CODEMP AND E044CCU2.CODCCU = E044CCU3.CODCCU     
                       CONNECT BY PRIOR E044CCU2.CODEMP = E044CCU2.CODEMP 
                              AND PRIOR E044CCU2.NIVCCU-1 = E044CCU2.NIVCCU             
                              AND PRIOR CCUPAI = E044CCU2.CODCCU     
                       ORDER SIBLINGS BY E044CCU2.CLACCU' USING IN C_CCU.CODEMP,IN C_CCU.CODCCU;
  END LOOP;
  
  
EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;        
END SP_SLDCCU_PLANOCTB;␀¯ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
rPROCEDURE SP_SLDCCU_POP(V_CODEMP NUMBER, V_DATINI DATE, V_DATFIM DATE, V_DESZER VARCHAR2(1))
 IS
BEGIN
  NULL;
END	ORACLE;0
 D␀␀create or replace PROCEDURE SP_SLDCCU_POP(V_CODEMP IN INTEGER, V_DATINI IN DATE, V_DATFIM IN DATE, V_DESZER IN VARCHAR2)
AS
  V_LCTIINI   DATE;
  V_LCTIFIM   DATE;
  V_LCTFINI   DATE;
  V_LCTFFIM   DATE;
  V_PERINILCT BOOLEAN;
  V_PERFIMLCT BOOLEAN;
  
  V_QUERYSDL VARCHAR2(32767);
  V_QUERYDEB VARCHAR2(32767);
  V_QUERYCRE VARCHAR2(32767);
  
  V_QUERYDEBZER VARCHAR2(32767);
  V_QUERYCREZER VARCHAR2(32767);
  
  V_PERDESINIZER DATE;
  V_PERDESFIMZER DATE;
BEGIN
  V_PERINILCT                      := FALSE;
  V_PERFIMLCT                      := FALSE;
  
  V_PERDESINIZER := V_DATINI;
  V_PERDESFIMZER := LAST_DAY(V_DATINI);
  
  IF (TRUNC(V_DATINI, 'MONTH') <> V_DATINI) THEN
    V_LCTIINI                  := TRUNC(V_DATINI, 'MONTH');
    V_LCTIFIM                  := V_DATINI -1;
    V_PERINILCT                := TRUE;
   END IF;

  IF (LAST_DAY(V_DATFIM) <> V_DATFIM) THEN
    V_LCTFINI            := V_DATFIM + 1;
    V_LCTFFIM            := LAST_DAY(V_DATFIM);
    V_PERFIMLCT          := TRUE;
  END IF;

  V_QUERYDEB :='INSERT INTO DEB_TMP3
                SELECT E640LCT.CODEMP CODEMP,                          
                     TRUNC(E640LCT.DATLCT,''MONTH'') MESANO,                          
                     E045PLA_TMP3.CTARED,                          
                     E045PLA_TMP3.CLACTA,                          
                     NVL(E044CCU_TMP3.CODCCU,'' '') CODCCU,                          
                     NVL(E044CCU_TMP3.CLACCU,''0'') CLACCU,                             
                     SUM(CASE WHEN E640LCT.TEMRAT IN (1,3) THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA,
                     :TIPSDL TIPSDL
              FROM E640LCT                        
              INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                       TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
              INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                     AND E640LCT.CTADEB = E045PLA_TMP3.ROOT_CTARED                       
              LEFT OUTER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP                                                
                                     AND E640LCT.NUMLCT = E640RAT.NUMLCT                                                
                                     AND E640LCT.CTADEB = E640RAT.CTARED                                                
                                     AND E640LCT.DATLCT = E640RAT.DATLCT
              LEFT OUTER JOIN E044CCU_TMP3 ON E640RAT.CODEMP = E044CCU_TMP3.CODEMP                                                    
                                          AND E640RAT.CODCCU = E044CCU_TMP3.ROOT_CODCCU                                                                     
              WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTADEB <> 0) AND                          
                    (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                    (E640LCT.DATLCT >= :V_DATAINI) AND                          
                    (E640LCT.DATLCT <= :V_DATAFIM)                    
              GROUP BY  E640LCT.CODEMP, TRUNC(E640LCT.DATLCT,''MONTH''), E045PLA_TMP3.CTARED,                          
                        E045PLA_TMP3.CLACTA, NVL(E044CCU_TMP3.CODCCU,'' ''), NVL(E044CCU_TMP3.CLACCU,''0'')
              HAVING SUM(CASE WHEN E640LCT.TEMRAT IN (1,3) THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) <> 0';
    
  V_QUERYCRE := 'INSERT INTO CRE_TMP3
                SELECT E640LCT.CODEMP CODEMP,                          
                       TRUNC(E640LCT.DATLCT,''MONTH'') MESANO,                          
                       E045PLA_TMP3.CTARED,                          
                       E045PLA_TMP3.CLACTA,                          
                       NVL(E044CCU_TMP3.CODCCU,'' '') CODCCU,                          
                       NVL(E044CCU_TMP3.CLACCU,''0'') CLACCU,
                       SUM(CASE WHEN E640LCT.TEMRAT IN (2,3) THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA,
                       :TIPSDL TIPSDL
                FROM E640LCT                        
                INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                         TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
                INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                       AND E640LCT.CTACRE = E045PLA_TMP3.ROOT_CTARED                       
                LEFT OUTER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP                                                
                                       AND E640LCT.NUMLCT = E640RAT.NUMLCT                                                
                                       AND E640LCT.CTACRE = E640RAT.CTARED                                                
                                       AND E640LCT.DATLCT = E640RAT.DATLCT
                LEFT OUTER JOIN E044CCU_TMP3 ON E640RAT.CODEMP = E044CCU_TMP3.CODEMP                                                    
                                            AND E640RAT.CODCCU = E044CCU_TMP3.ROOT_CODCCU                                                                     
                WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTACRE <> 0) AND                          
                      (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                      (E640LCT.DATLCT >= :V_DATAINI) AND                          
                      (E640LCT.DATLCT <= :V_DATAFIM)                    
                GROUP BY  E640LCT.CODEMP, TRUNC(E640LCT.DATLCT,''MONTH''), E045PLA_TMP3.CTARED,                          
                          E045PLA_TMP3.CLACTA, NVL(E044CCU_TMP3.CODCCU,'' ''), NVL(E044CCU_TMP3.CLACCU,''0'')
                HAVING SUM(CASE WHEN E640LCT.TEMRAT IN (2,3) THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) <> 0';
                
  V_QUERYDEBZER := 'INSERT INTO DEB_TMP3
                    SELECT E640LCT.CODEMP CODEMP, 
                    TRUNC(:DATAFIM,''MONTH'') MESANO,
                    E045PLA_TMP3.CTARED, 
                    E045PLA_TMP3.CLACTA,
                    '' '' CODCCU, 
                    ''0'' CLACCU, 
                    SUM(E640LCT.VLRLCT) SOMA,
                    E046HPD.TIPHPD TIPSDL    
              FROM E046HPD
              INNER JOIN E640LCT ON E046HPD.CODHPD = E640LCT.CODHPD AND E046HPD.TIPHPD = ''Z''                              
              INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                       TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
              INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                     AND E640LCT.CTADEB = E045PLA_TMP3.ROOT_CTARED                       
              WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTADEB <> 0) AND                          
                    (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                    (E640LCT.DATLCT >= :DATAINI) AND 
                    (E640LCT.DATLCT <= :DATAFIM) AND 
                    (E640LCT.TEMRAT = 0)
              GROUP BY E640LCT.CODEMP, E045PLA_TMP3.CTARED, E045PLA_TMP3.CLACTA, E046HPD.TIPHPD
              UNION ALL
              SELECT E640LCT.CODEMP CODEMP, 
                     TRUNC(:DATAFIM,''MONTH'') MESANO,
                     E045PLA_TMP3.CTARED, 
                     E045PLA_TMP3.CLACTA,
                     E044CCU_TMP3.CODCCU CODCCU, 
                     E044CCU_TMP3.CLACCU CLACCU,
                     SUM(E640RAT.VLRRAT) SOMA,
                     E046HPD.TIPHPD TIPSDL  
              FROM E046HPD
              INNER JOIN E640LCT ON E046HPD.CODHPD = E640LCT.CODHPD AND E046HPD.TIPHPD = ''Z''                              
              INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                       TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
              INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                     AND E640LCT.CTADEB = E045PLA_TMP3.ROOT_CTARED                       
              INNER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP                                                
                                     AND E640LCT.NUMLCT = E640RAT.NUMLCT                                                
                                     AND E640LCT.CTADEB = E640RAT.CTARED                                                
                                     AND E640LCT.DATLCT = E640RAT.DATLCT
              INNER JOIN E044CCU_TMP3 ON E640RAT.CODEMP = E044CCU_TMP3.CODEMP                                                    
                                           AND E640RAT.CODCCU = E044CCU_TMP3.ROOT_CODCCU                                                                     
              WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTADEB <> 0) AND                          
                    (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                    (E640LCT.DATLCT >= :DATAINI) AND                          
                    (E640LCT.DATLCT <= :DATAFIM) AND
                    (E640LCT.TEMRAT IN (1,3)) 
              GROUP BY E640LCT.CODEMP, E045PLA_TMP3.CTARED, E045PLA_TMP3.CLACTA, E044CCU_TMP3.CODCCU, E044CCU_TMP3.CLACCU, E046HPD.TIPHPD';

  V_QUERYCREZER := 'INSERT INTO CRE_TMP3
             SELECT E640LCT.CODEMP CODEMP, 
                    TRUNC(:DATAFIM,''MONTH'') MESANO,
                    E045PLA_TMP3.CTARED, 
                    E045PLA_TMP3.CLACTA,
                    '' '' CODCCU, 
                    ''0'' CLACCU, 
                    SUM(E640LCT.VLRLCT) SOMA,
                    E046HPD.TIPHPD TIPSDL    
              FROM E046HPD
              INNER JOIN E640LCT ON E046HPD.CODHPD = E640LCT.CODHPD AND E046HPD.TIPHPD = ''Z''                              
              INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                       TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
              INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                     AND E640LCT.CTACRE = E045PLA_TMP3.ROOT_CTARED                       
              WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTACRE <> 0) AND                          
                    (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                    (E640LCT.DATLCT >= :DATAINI) AND 
                    (E640LCT.DATLCT <= :DATAFIM) AND 
                    (E640LCT.TEMRAT = 0)
              GROUP BY E640LCT.CODEMP, E045PLA_TMP3.CTARED, E045PLA_TMP3.CLACTA, E046HPD.TIPHPD
              UNION ALL
              SELECT E640LCT.CODEMP CODEMP, 
                     TRUNC(:DATAFIM,''MONTH'') MESANO,
                     E045PLA_TMP3.CTARED, 
                     E045PLA_TMP3.CLACTA,
                     E044CCU_TMP3.CODCCU CODCCU, 
                     E044CCU_TMP3.CLACCU CLACCU,
                     SUM(E640RAT.VLRRAT) SOMA,
                     E046HPD.TIPHPD TIPSDL  
              FROM E046HPD
              INNER JOIN E640LCT ON E046HPD.CODHPD = E640LCT.CODHPD AND E046HPD.TIPHPD = ''Z''                              
              INNER JOIN TEMPSLDFIL ON TEMPSLDFIL.CODEMP = E640LCT.CODEMP AND                                             
                                       TEMPSLDFIL.CODFIL = E640LCT.CODFIL                                
              INNER JOIN E045PLA_TMP3 ON E640LCT.CODEMP = E045PLA_TMP3.CODEMP                                           
                                     AND E640LCT.CTACRE = E045PLA_TMP3.ROOT_CTARED                       
              INNER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP                                                
                                     AND E640LCT.NUMLCT = E640RAT.NUMLCT                                                
                                     AND E640LCT.CTACRE = E640RAT.CTARED                                                
                                     AND E640LCT.DATLCT = E640RAT.DATLCT
              INNER JOIN E044CCU_TMP3 ON E640RAT.CODEMP = E044CCU_TMP3.CODEMP                                                    
                                           AND E640RAT.CODCCU = E044CCU_TMP3.ROOT_CODCCU                                                                     
              WHERE (E640LCT.SITLCT = 2) AND (E640LCT.CTACRE <> 0) AND                          
                    (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND                          
                    (E640LCT.DATLCT >= :DATAINI) AND                          
                    (E640LCT.DATLCT <= :DATAFIM) AND
                    (E640LCT.TEMRAT IN (2,3)) 
              GROUP BY E640LCT.CODEMP, E045PLA_TMP3.CTARED, E045PLA_TMP3.CLACTA, E044CCU_TMP3.CODCCU, E044CCU_TMP3.CLACCU, E046HPD.TIPHPD';                                   
			  
			  
  V_QUERYSDL := 'INSERT INTO TEMPSLDCCU
                SELECT NVL(DEB.CLACCU,CRE.CLACCU) CLACCU, 
                       NVL(DEB.CLACTA,CRE.CLACTA) CLACTA,
                       NVL(DEB.CODCCU,CRE.CODCCU) CODCCU,
                       NVL(DEB.CTARED,CRE.CTARED) CTARED,
                       NVL(DEB.MESANO,CRE.MESANO) MESANO,
                       NVL(DEB.CODEMP,CRE.CODEMP) CODEMP, 
                       NVL(DEB.TIPSDL,CRE.TIPSDL) TIPSDL,        
                      -SUM(NVL(DEB.SOMA, 0)) DEBMES, 
                      -SUM(NVL(CRE.SOMA, 0)) CREMES
                FROM DEB_TMP3 DEB        
                FULL OUTER JOIN CRE_TMP3 CRE ON DEB.CODEMP = CRE.CODEMP          
                                            AND DEB.MESANO = CRE.MESANO          
                                            AND DEB.CTARED = CRE.CTARED          
                                            AND DEB.CODCCU = CRE.CODCCU
                GROUP BY NVL(DEB.CLACCU,CRE.CLACCU), 
                       NVL(DEB.CLACTA,CRE.CLACTA),
                       NVL(DEB.CODCCU,CRE.CODCCU),
                       NVL(DEB.CTARED,CRE.CTARED),
                       NVL(DEB.MESANO,CRE.MESANO),
                       NVL(DEB.CODEMP,CRE.CODEMP), 
                       NVL(DEB.TIPSDL,CRE.TIPSDL)
                HAVING (SUM(NVL(DEB.SOMA,0)) <> 0) OR (SUM(NVL(CRE.SOMA,0)) <>  0)';   			  
  
  IF V_DESZER = 'T' THEN
    SELECT TRUNC(MIN(DATLCT), 'MM') INTO V_PERDESINIZER
      FROM E640LCT
     INNER JOIN E046HPD
        ON E046HPD.CODHPD   = E640LCT.CODHPD
       AND E046HPD.TIPHPD  = 'Z'
     WHERE CODEMP        = V_CODEMP
       AND SITLCT          =2
       AND TIPLCT          = 1
       AND DATLCT         >= V_LCTFINI
       AND DATLCT         <= V_LCTFFIM;      
    IF (V_PERDESINIZER IS NOT NULL) THEN    
	    IF V_PERDESFIMZER > V_DATFIM THEN
	      V_PERDESFIMZER := V_DATFIM;
	    END IF;      
  
	    WHILE V_PERDESINIZER <= V_DATFIM LOOP
	      SYS.DBMS_OUTPUT.PUT_LINE('LANÇAMENTO DE ZERAMENTO À DESCONSIDERAR:'||V_DATINI ||' À '||V_PERDESFIMZER);
	      EXECUTE IMMEDIATE V_QUERYDEBZER USING V_PERDESFIMZER, V_DATINI, V_PERDESFIMZER, V_PERDESFIMZER, V_DATINI, V_PERDESFIMZER;
	      EXECUTE IMMEDIATE V_QUERYCREZER USING V_PERDESFIMZER, V_DATINI, V_PERDESFIMZER, V_PERDESFIMZER, V_DATINI, V_PERDESFIMZER;
	      
	      V_PERDESINIZER := ADD_MONTHS(TRUNC(V_PERDESINIZER,'MONTH'), 1);
	      V_PERDESFIMZER := Last_Day(V_PERDESINIZER);
	      
	      IF V_PERDESFIMZER > V_DATFIM THEN
	        V_PERDESFIMZER := V_DATFIM;
	      END IF;      
	    END LOOP;    
	    
	    EXECUTE IMMEDIATE V_QUERYSDL;
	    EXECUTE IMMEDIATE 'DELETE FROM CRE_TMP3';
	    EXECUTE IMMEDIATE 'DELETE FROM DEB_TMP3';
	 END IF;
  END IF;
  
  IF V_PERINILCT THEN
    SYS.DBMS_OUTPUT.PUT_LINE('LANÇAMENTO ANTERIOR À DESCONSIDERAR:'||V_LCTIINI ||' À '||V_LCTIFIM);
    EXECUTE IMMEDIATE V_QUERYDEB USING 'I', V_LCTIINI, V_LCTIFIM;
    EXECUTE IMMEDIATE V_QUERYCRE USING 'I', V_LCTIINI, V_LCTIFIM;    
    EXECUTE IMMEDIATE V_QUERYSDL;
    EXECUTE IMMEDIATE 'DELETE FROM CRE_TMP3';
    EXECUTE IMMEDIATE 'DELETE FROM DEB_TMP3';  
  END IF;

  IF V_PERFIMLCT THEN
    SYS.DBMS_OUTPUT.PUT_LINE('LANÇAMENTO FINAL À DESCONSIDERAR:'||V_LCTFINI ||' À '||V_LCTFFIM);
    EXECUTE IMMEDIATE V_QUERYDEB USING 'F', V_LCTFINI, V_LCTFFIM;
    EXECUTE IMMEDIATE V_QUERYCRE USING 'F', V_LCTFINI, V_LCTFFIM;
    EXECUTE IMMEDIATE V_QUERYSDL;
    EXECUTE IMMEDIATE 'DELETE FROM CRE_TMP3';
    EXECUTE IMMEDIATE 'DELETE FROM DEB_TMP3';  
  END IF;

EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;   
END SP_SLDCCU_POP;␀°ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
?PROCEDURE SP_SLDCCU_PREP(V_CODEMP NUMBER)
 IS
BEGIN
  NULL;
END	ORACLE;0
U␀␀create or replace PROCEDURE SP_SLDCCU_PREP(V_CODEMP IN INTEGER)
AS
  V_COUNT NUMBER;
BEGIN
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMPSLDCCU'; 
  IF V_COUNT > 0 THEN 
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMPSLDCCU';
  ELSE
    EXECUTE IMMEDIATE
    'CREATE GLOBAL TEMPORARY TABLE TEMPSLDCCU
    (CLACCU VARCHAR2(30 BYTE) NOT NULL,                        
     CLACTA VARCHAR2(30 BYTE) NOT NULL,                         
     CODCCU VARCHAR2(9 BYTE) NOT NULL,                         
     CTARED NUMBER(7, 0) NOT NULL,                        
     MESANO DATE NOT NULL,                         
     CODEMP NUMBER(4,0) NOT NULL,                        
     TIPSDL CHAR(1) NOT NULL,                        
     DEBMES NUMBER(17, 2),                         
     CREMES NUMBER(17, 2)) ON COMMIT PRESERVE ROWS';
    EXECUTE IMMEDIATE 'CREATE UNIQUE INDEX TEMPSLDCCU_INDICE1 ON TEMPSLDCCU (CODCCU, CTARED, TIPSDL, MESANO)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMPSLDFIL';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMPSLDFIL';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE  TEMPSLDFIL                         
                       (CODEMP NUMBER(4,0) NOT NULL,                          
                        CODFIL NUMBER(4,0) NOT NULL) ON COMMIT PRESERVE ROWS';
    EXECUTE IMMEDIATE 'CREATE UNIQUE  INDEX TEMPSLDFIL_INDICE1 ON TEMPSLDFIL(CODEMP, CODFIL)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E045PLA_TMP3';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E045PLA_TMP3';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E045PLA_TMP3     
	                   (CODEMP NUMBER(4) NOT NULL,      
					    CTARED NUMBER(7) NOT NULL,      
						ROOT_CTARED NUMBER(7) NOT NULL,      
						CLACTA VARCHAR2(30) NOT NULL,      
						NIVCTA NUMBER(2) NOT NULL,      
						QTDPOS NUMBER(1) NOT NULL) ON COMMIT PRESERVE ROWS'    ;
    
	EXECUTE IMMEDIATE 'CREATE INDEX E045PLA_TMP3Indice1 ON E045PLA_TMP3 (CODEMP, ROOT_CTARED)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E044CCU_TMP3';
  IF V_COUNT   > 0 THEN 
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E044CCU_TMP3';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E044CCU_TMP3     
	                  (CODEMP NUMBER(4) NOT NULL,      
					   CODCCU VARCHAR(9) NOT NULL,      
					   ROOT_CODCCU VARCHAR(9) NOT NULL,      
					   CCUPAI VARCHAR(9) NULL,      
					   CLACCU VARCHAR2(30) NOT NULL,      
					   NIVCCU NUMBER(2) NOT NULL,      
					   POSCCU NUMBER(2) NOT NULL) ON COMMIT PRESERVE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX E044CCU_TMP3Indice1 ON E044CCU_TMP3 (CODEMP, ROOT_CODCCU)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'DEB_TMP3';
  IF V_COUNT   > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE DEB_TMP3';
  ELSE EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE DEB_TMP3     
                         (CODEMP NUMBER(4) NOT NULL,      
                          MESANO DATE NOT NULL,      
                          CTARED NUMBER(7) NOT NULL,      
                          CLACTA VARCHAR2(30) NOT NULL,      
                          CODCCU VARCHAR2(9) NOT NULL,      
                          CLACCU VARCHAR2(30) NOT NULL,      
                          SOMA NUMBER(17,2),
                          TIPSDL CHAR(1) NOT NULL) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX DEB_TMP3Indice1 ON DEB_TMP3 (CODEMP, MESANO, CTARED, CODCCU)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'CRE_TMP3';
  IF V_COUNT   > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE CRE_TMP3';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE CRE_TMP3     
	                    (CODEMP NUMBER(4) NOT NULL,      
                       MESANO DATE NOT NULL,      
                       CTARED NUMBER(7) NOT NULL,      
                       CLACTA VARCHAR2(30) NOT NULL,      
                       CODCCU VARCHAR2(9) NOT NULL,      
                       CLACCU VARCHAR2(30) NOT NULL,      
                       SOMA NUMBER(17,2),
                       TIPSDL CHAR(1) NOT NULL) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX CRE_TMP3Indice1 ON CRE_TMP3 (CODEMP, MESANO, CTARED, CODCCU)';
  END IF;

  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'PLACCU_TMP3';  
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE PLACCU_TMP3';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE PLACCU_TMP3     
	                    (CODEMP NUMBER(4) NOT NULL,      
                       MESANO DATE NOT NULL,      
                       CTARED NUMBER(7) NOT NULL,      
                       CLACTA VARCHAR2(30) NOT NULL,      
                       NIVCTA NUMBER(2) NULL,      
                       CODCCU VARCHAR(9) NULL,      
                       CLACCU VARCHAR2(30) NULL,      
                       NIVCCU NUMBER(2) NULL) ON COMMIT DELETE ROWS';
    EXECUTE IMMEDIATE 'CREATE INDEX PLACCU_TMP3Indice1 ON PLACCU_TMP3 (CODEMP, MESANO, CTARED, CODCCU)';
  END IF;

  FOR C_PLA IN (SELECT CODEMP, CTARED FROM  E045PLA WHERE CODEMP = V_CODEMP ORDER BY CTARED)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E045PLA_TMP3 (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS)     
                       SELECT E045PLA2.CODEMP CODEMP, E045PLA2.CTARED CTARED, E045PLA3.CTARED ROOT_CTARED, E045PLA2.CLACTA CLACTA,         
                              E045PLA2.NIVCTA NIVCTA, E045PLA2.QTDPOS QTDPOS     
                       FROM E045PLA E045PLA2, 
                            (SELECT CODEMP, CTARED FROM E045PLA WHERE E045PLA.CODEMP = :1 AND E045PLA.CTARED = :2) E045PLA3     
                       WHERE E045PLA2.CODEMP = E045PLA3.CODEMP     
                       START WITH E045PLA2.CODEMP = E045PLA3.CODEMP AND E045PLA2.CTARED = E045PLA3.CTARED     
                       CONNECT BY PRIOR E045PLA2.CODEMP = E045PLA2.CODEMP 
                              AND PRIOR E045PLA2.NIVCTA-1 = E045PLA2.NIVCTA             
                              AND PRIOR SUBSTR(TO_CHAR(E045PLA2.CLACTA),1,LENGTH(E045PLA2.CLACTA)-E045PLA2.QTDPOS) = E045PLA2.CLACTA     
                       ORDER SIBLINGS BY E045PLA2.CLACTA'  USING IN C_PLA.CODEMP, IN C_PLA.CTARED;
  END LOOP;
  
  FOR C_CCU IN ( SELECT CODEMP, CODCCU FROM E044CCU WHERE  CODEMP = V_CODEMP ORDER BY CODCCU)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E044CCU_TMP3 (CODEMP, CODCCU, ROOT_CODCCU, CCUPAI, CLACCU, NIVCCU, POSCCU)     
                       SELECT E044CCU2.CODEMP CODEMP, E044CCU2.CODCCU CODCCU, E044CCU3.CODCCU ROOT_CODCCU, E044CCU2.CCUPAI CCUPAI, E044CCU2.CLACCU CLACCU,         
                              E044CCU2.NIVCCU NIVCCU, E044CCU2.POSCCU POSCCU     
                       FROM E044CCU E044CCU2, 
                            (SELECT CODEMP, CODCCU FROM E044CCU WHERE E044CCU.CODEMP = :1 AND E044CCU.CODCCU = :2) E044CCU3     
                       WHERE E044CCU2.CODEMP = E044CCU3.CODEMP     
                       START WITH E044CCU2.CODEMP = E044CCU3.CODEMP AND E044CCU2.CODCCU = E044CCU3.CODCCU     
                       CONNECT BY PRIOR E044CCU2.CODEMP = E044CCU2.CODEMP 
                              AND PRIOR E044CCU2.NIVCCU-1 = E044CCU2.NIVCCU             
                              AND PRIOR CCUPAI = E044CCU2.CODCCU     
                       ORDER SIBLINGS BY E044CCU2.CLACCU' USING IN C_CCU.CODEMP,IN C_CCU.CODCCU;
  END LOOP;

EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;    
END SP_SLDCCU_PREP;␀±ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
tPROCEDURE SP_SLDCCU_PROC(V_CODEMP NUMBER, V_CODFIL NUMBER, V_MESINIPAR DATE, V_MESFIMPAR DATE)
 IS
BEGIN
  NULL;
END	ORACLE;0
«6␀␀CREATE OR REPLACE PROCEDURE SP_SLDCCU_PROC
(  
  V_CODEMP    IN NUMBER,
  V_CODFIL    IN NUMBER, 
  V_MESINIPAR IN DATE,
  V_MESFIMPAR IN DATE)
AS
  V_MESINI DATE;
  V_MESFIM DATE;
BEGIN
      
  DBMS_OUTPUT.PUT_LINE('Inicio PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );
  
  SP_SALDOCCU_LIMPAR(V_CODEMP => V_CODEMP, V_CODFIL => V_CODFIL, V_MESANO => V_MESINIPAR);
  
  IF V_MESINIPAR IS NOT NULL THEN     
		V_MESINI:= TRUNC(V_MESINIPAR,'MONTH');   
	ELSE     
		EXECUTE IMMEDIATE 'SELECT TRUNC(MIN(MESANO),''MONTH'') FROM E650PMA WHERE CODEMP = :1 AND CODFIL IN('||V_CODFIL||')' INTO V_MESINI USING IN V_CODEMP;   
	END IF;      

	IF V_MESFIMPAR IS NOT NULL THEN     
		V_MESFIM:= LAST_DAY(V_MESFIMPAR);   
	ELSE     
		EXECUTE IMMEDIATE 'SELECT LAST_DAY(MAX(MESANO)) FROM E650PMA WHERE CODEMP = :1 AND CODFIL IN('||V_CODFIL||')' INTO V_MESFIM USING IN V_CODEMP;        
  END IF;      

  DBMS_OUTPUT.PUT_LINE('Inicio Insert PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );
    /* GERANDO CONTAS/CENTROS/MESANO */   
    
  EXECUTE IMMEDIATE 'INSERT INTO PLACCU_TMP4   
  
            SELECT E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED,           
                       PLACCU.CLACTA, PLACCU.NIVCTA, PLACCU.CODCCU, PLACCU.CLACCU, PLACCU.NIVCCU   
               FROM E650PMA, 
                
                (SELECT E045PLA.CODEMP, -1 CODFIL, E045PLA.CTARED, E045PLA.CLACTA, E045PLA.NIVCTA, '' '' CODCCU, ''0'' CLACCU, 0 NIVCCU 
                 FROM E045PLA WHERE E045PLA.CODEMP = :1 
                 
                 UNION ALL                  
                 
                 SELECT DISTINCT E640RAT.CODEMP, E640RAT.FILRAT, E045PLA_TMP4.CTARED, E045PLA_TMP4.CLACTA, E045PLA_TMP4.NIVCTA, E044CCU_TMP4.CODCCU, E044CCU_TMP4.CLACCU, E044CCU_TMP4.NIVCCU 
                 FROM (SELECT 
                       NVL(E640RAT.CODEMP,E650SLC.CODEMP) CODEMP, 
                       NVL(E640RAT.FILRAT,E650SLC.CODFIL) FILRAT, 
                       NVL(E640RAT.CTARED,E650SLC.CTARED) CTARED,                                
                     NVL(E640RAT.CODCCU,E650SLC.CODCCU) CODCCU                         
                     FROM 
                       
                     (SELECT CODEMP, FILRAT, CTARED, CODCCU 
                      FROM E640RAT                              
                      WHERE E640RAT.CODEMP = :2                              
                        AND E640RAT.FILRAT = :3 
                      AND E640RAT.DATLCT >= :4                              
                      AND E640RAT.DATLCT <= :5                              
                      GROUP BY CODEMP, FILRAT, CTARED, CODCCU) E640RAT 
                      
                      FULL OUTER JOIN (SELECT CODEMP, CODFIL, CTARED, CODCCU FROM E650SLC                                         
                               WHERE E650SLC.CODEMP = :6                                         
                               AND E650SLC.CODFIL = :7
                               AND E650SLC.MESANO = ADD_MONTHS(:8,-1)) E650SLC ON E640RAT.CODEMP = E650SLC.CODEMP 
                                                            AND E640RAT.FILRAT = E650SLC.CODFIL 
                                                      AND E640RAT.CTARED = E650SLC.CTARED 
                                                      AND E640RAT.CODCCU = E650SLC.CODCCU) E640RAT                  
                                                
                INNER JOIN E045PLA_TMP4 ON E640RAT.CODEMP = E045PLA_TMP4.CODEMP                    
                          AND E640RAT.CTARED = E045PLA_TMP4.ROOT_CTARED                  
                INNER JOIN E044CCU_TMP4 ON E640RAT.CODEMP = E044CCU_TMP4.CODEMP                   
                          AND E640RAT.CODCCU = E044CCU_TMP4.ROOT_CODCCU) PLACCU   
                          
                          
               WHERE E650PMA.CODEMP = PLACCU.CODEMP 
                AND (E650PMA.CODFIL = PLACCU.CODFIL OR PLACCU.CODFIL = -1)   
                 AND E650PMA.CODEMP = :9   
                 AND E650PMA.CODFIL = :10   
                 AND E650PMA.MESANO >= :11   
                 AND E650PMA.MESANO <= :12   
               ORDER BY E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, PLACCU.CODCCU '    
             
               USING IN V_CODEMP, IN V_CODEMP, IN V_CODFIL, IN V_MESINI, V_MESFIM, IN V_CODEMP, IN V_CODFIL, IN V_MESINI, IN V_CODEMP, IN V_CODFIL, IN V_MESINI, IN V_MESFIM;     
			   
  DBMS_OUTPUT.PUT_LINE('GERANDO CONTAS/CENTROS/MESANO PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );
    
     /* GERANDO DEBITOS... */   
  EXECUTE IMMEDIATE 'INSERT INTO DEB_TMP4   
               SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT,''MONTH'') MESANO, E045PLA_TMP4.CTARED, 
                  E045PLA_TMP4.CLACTA, NVL(E044CCU_TMP4.CODCCU,'' '') CODCCU, NVL(E044CCU_TMP4.CLACCU,''0'') CLACCU,    
                SUM(DECODE(E640LCT.TEMRAT,1,E640RAT.VLRRAT,3,E640RAT.VLRRAT,E640LCT.VLRLCT)) SOMA   
               FROM E640LCT    
               INNER JOIN E045PLA_TMP4 ON E640LCT.CODEMP = E045PLA_TMP4.CODEMP 
                                     AND E640LCT.CTADEB = E045PLA_TMP4.ROOT_CTARED   
               LEFT OUTER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP     
                                      AND E640LCT.NUMLCT = E640RAT.NUMLCT     
                          AND E640LCT.CTADEB = E640RAT.CTARED     
                          AND E640RAT.DATLCT >= :1     
                          AND E640RAT.DATLCT <= :2   
               LEFT OUTER JOIN E044CCU_TMP4 ON E640RAT.CODEMP = E044CCU_TMP4.CODEMP     
                                          AND E640RAT.CODCCU = E044CCU_TMP4.ROOT_CODCCU   
               WHERE E640LCT.CODEMP = :3   
                 AND E640LCT.CODFIL = :4   
               AND E640LCT.SITLCT = 2    
               AND E640LCT.CTADEB <> 0   
               AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)   
               AND E640LCT.DATLCT >= :5   
               AND E640LCT.DATLCT <= :6   
               GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''),    
                    E045PLA_TMP4.CTARED, E045PLA_TMP4.CLACTA,  NVL(E044CCU_TMP4.CODCCU,'' ''), NVL(E044CCU_TMP4.CLACCU,''0'')   
               ORDER BY 1, 2, 3, 4, 6'   
               
               USING IN V_MESINI, IN V_MESFIM, IN V_CODEMP, IN V_CODFIL, IN V_MESINI, IN V_MESFIM;      
   
  DBMS_OUTPUT.PUT_LINE('GERANDO DEBITOS PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );               
   
    /* GERANDO CREDITOS... */   
  EXECUTE IMMEDIATE 'INSERT INTO CRE_TMP4   
                       SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT,''MONTH'') MESANO,    
                  E045PLA_TMP4.CTARED, E045PLA_TMP4.CLACTA, NVL(E044CCU_TMP4.CODCCU,'' '') CODCCU, NVL(E044CCU_TMP4.CLACCU,''0'') CLACCU,    
                SUM(DECODE(E640LCT.TEMRAT,2,E640RAT.VLRRAT,3,E640RAT.VLRRAT,E640LCT.VLRLCT)) SOMA   
               FROM E640LCT
               INNER JOIN E045PLA_TMP4 ON E640LCT.CODEMP = E045PLA_TMP4.CODEMP     
                                     AND E640LCT.CTACRE = E045PLA_TMP4.ROOT_CTARED   
               LEFT OUTER JOIN E640RAT ON E640LCT.CODEMP = E640RAT.CODEMP     
                                      AND E640LCT.NUMLCT = E640RAT.NUMLCT     
                          AND E640LCT.CTACRE = E640RAT.CTARED     
                          AND E640RAT.DATLCT >= :1     
                          AND E640RAT.DATLCT <= :2   
               LEFT OUTER JOIN E044CCU_TMP4 ON E640RAT.CODEMP = E044CCU_TMP4.CODEMP     
                                        AND E640RAT.CODCCU = E044CCU_TMP4.ROOT_CODCCU   
               WHERE E640LCT.CODEMP = :3   
                 AND E640LCT.CODFIL = :4     
               AND E640LCT.SITLCT = 2    
               AND E640LCT.CTACRE <> 0   
               AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)   
               AND E640LCT.DATLCT >= :5   
               AND E640LCT.DATLCT <= :6   
              GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''),    
                   E045PLA_TMP4.CTARED, E045PLA_TMP4.CLACTA,  NVL(E044CCU_TMP4.CODCCU,'' ''), NVL(E044CCU_TMP4.CLACCU,''0'')   
              ORDER BY 1, 2, 3, 4, 6'   
              
              USING IN V_MESINI, IN V_MESFIM, IN V_CODEMP, IN V_CODFIL, IN V_MESINI, IN V_MESFIM;    
    
  DBMS_OUTPUT.PUT_LINE('GERANDO CREDITOS PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );                   
    
    /* CAPTURANDO ULTIMO SALDO VALIDO... */   
  EXECUTE IMMEDIATE 'INSERT INTO MOV_TMP4   
                       SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, SALMES   
               FROM E650SLC   WHERE CODEMP = :1   AND CODFIL = :2   
               AND MESANO = ADD_MONTHS(:3,-1)'   
               USING IN V_CODEMP, IN V_CODFIL, IN V_MESINI;    
    
  DBMS_OUTPUT.PUT_LINE('CAPTURANDO ULTIMO SALDO VALIDO PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );                   

  /* CONSOLIDANDO MOVIMENTOS... */   
  EXECUTE IMMEDIATE 'INSERT INTO MOV_TMP4
               SELECT PLACCU_TMP4.CODEMP, PLACCU_TMP4.CODFIL, PLACCU_TMP4.MESANO,           
                       PLACCU_TMP4.CTARED, PLACCU_TMP4.CLACTA, PLACCU_TMP4.CODCCU, PLACCU_TMP4.CLACCU,          
               NVL(MOVTO.DEBMES,0) DEBMES, NVL(MOVTO.CREMES,0) CREMES, NVL(MOVTO.MOVMES,0) MOVMES   
               FROM PLACCU_TMP4   
               LEFT OUTER JOIN  (SELECT NVL(DEB.CODEMP,CRE.CODEMP) CODEMP, 
                                        NVL(DEB.CODFIL,CRE.CODFIL) CODFIL, 
                          NVL(DEB.MESANO,CRE.MESANO) MESANO,         
                                        NVL(DEB.CTARED,CRE.CTARED) CTARED, 
                          NVL(DEB.CLACTA,CRE.CLACTA) CLACTA,         
                          NVL(DEB.CODCCU,CRE.CODCCU) CODCCU, 
                          NVL(DEB.CLACCU,CRE.CLACCU) CLACCU,        
                          NVL(DEB.SOMA,0) DEBMES, 
                          NVL(CRE.SOMA,0) CREMES,         
                          NVL(DEB.SOMA,0) - NVL(CRE.SOMA,0) MOVMES        
                       FROM DEB_TMP4 DEB        
                       FULL OUTER JOIN CRE_TMP4 CRE ON DEB.CODEMP = CRE.CODEMP          
                                                  AND DEB.CODFIL = CRE.CODFIL          
                                    AND DEB.MESANO = CRE.MESANO          
                                    AND DEB.CTARED = CRE.CTARED          
                                    AND DEB.CODCCU = CRE.CODCCU) MOVTO  ON PLACCU_TMP4.CODEMP = MOVTO.CODEMP    
                                                                       AND PLACCU_TMP4.CODFIL = MOVTO.CODFIL    
                                                       AND PLACCU_TMP4.MESANO = MOVTO.MESANO    
                                                       AND PLACCU_TMP4.CTARED = MOVTO.CTARED    
                                                       AND PLACCU_TMP4.CODCCU = MOVTO.CODCCU   
              ORDER BY PLACCU_TMP4.CODEMP, PLACCU_TMP4.CODFIL, PLACCU_TMP4.MESANO,             
                       PLACCU_TMP4.CLACTA, PLACCU_TMP4.CTARED, PLACCU_TMP4.CLACCU, PLACCU_TMP4.CODCCU';    
    
  DBMS_OUTPUT.PUT_LINE('CONSOLIDANDO MOVIMENTOS PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );                   

     /* GERANDO SALDOS... */   
  EXECUTE IMMEDIATE 'INSERT INTO E650SLC   
                       SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU,    
                              SALMES-MOVMES SALANT, DEBMES, CREMES, MOVMES, SALMES   
                       FROM 
                         (SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, MOVMES, (SELECT SUM(MOVMES)              
                                                                                                                   FROM MOV_TMP4 D2              
                                                                                                                   WHERE D2.CODEMP = D1.CODEMP               
                                                                                                                     AND D2.CODFIL = D1.CODFIL              
                                                                                                                     AND D2.CTARED = D1.CTARED               
                                                                                                                     AND D2.CODCCU = D1.CODCCU               
                                                                                                                     AND D2.MESANO <= D1.MESANO ) SALMES         
                          FROM MOV_TMP4 D1         
                          WHERE CODEMP = :1 AND CODFIL = :2 AND MESANO >= :3 ) SALDOS
						WHERE ((DEBMES <> 0) OR (CREMES <> 0) OR (MOVMES <> 0) OR (SALMES <> 0)) '   
                        
                        USING IN V_CODEMP,IN V_CODFIL, IN V_MESINI;    
    
  DBMS_OUTPUT.PUT_LINE('GERANDO SALDOS PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );                       

    /* SALVA ALTERACOES REALIZADAS */   
  COMMIT;   
	
  DBMS_OUTPUT.PUT_LINE('SALVA ALTERACOES REALIZADAS PROCESSAR650SLC - '|| to_number(to_char(sys_extract_utc(systimestamp), 'SSSSSFF3')) );                           
      
EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;         
END SP_SLDCCU_PROC;␀²ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* Registro (log) de alterações no cadastro do produto/derivação */
PROCEDURE SP_T055HPF(E_CODEMP NUMBER, E_CODPRO VARCHAR(14), E_CODDER VARCHAR(7), E_TIPHPF VARCHAR(1), E_CODITE VARCHAR(60), E_DESITE VARCHAR(255))
 IS

	QTDREG NUMBER;
	W_IdeHPf   E055HPF.IDEHPF%TYPE;
BEGIN
	IF ((E_TIPHPF = 'D' AND E_DESITE IS NOT NULL) OR (E_TIPHPF = 'C' AND E_CODITE IS NOT NULL)) THEN
		SELECT COUNT(1) INTO QTDREG
    	FROM E055HPF
    	WHERE E055HPF.CODEMP = E_CODEMP AND
    	E055HPF.CODPRO = E_CODPRO AND
    	E055HPF.CODDER = E_CODDER AND
    	E055HPF.TIPHPF = E_TIPHPF AND
    	E055HPF.PERFIM = CURDATE();
    
    	IF (QTDREG > 0) THEN   
			SELECT E055HPF.IDEHPF INTO W_IdeHpf
      		FROM E055HPF
     		WHERE E055HPF.CODEMP = E_CODEMP AND
     		E055HPF.CODPRO = E_CODPRO AND
     		E055HPF.CODDER = E_CODDER AND
     		E055HPF.TIPHPF = E_TIPHPF AND
        	E055HPF.PERFIM = CURDATE();
    	     
      		UPDATE E055HPF SET DESITE = E_DESITE, CODITE = E_CODITE WHERE IDEHPF = W_IdeHpf;
   		ELSE
			GETNEXTVALUE('E055HPF', 1, 'SELECT COALESCE(MAX(IDEHPF), 0) FROM E055HPF', W_IdeHPf OUT);
			INSERT INTO E055HPF (IDEHPF, CODEMP, CODPRO, CODDER, PERFIM, TIPHPF, CODITE, DESITE)
			VALUES (W_IdeHPf, E_CODEMP, E_CODPRO, E_CODDER, CURDATE(), E_TIPHPF, E_CODITE, E_DESITE);
		END IF;
   END IF;   
END␀³ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‰␀␀/* Registro (log) de alterações no cadastro do serviço */
PROCEDURE SP_T055HSF(E_CODEMP NUMBER, E_CODSER VARCHAR(14), E_TIPHSF VARCHAR(1), E_CODITE VARCHAR(60), E_DESITE VARCHAR(255))
 IS

	QTDREG NUMBER;
	W_IdeHsf   E055HSF.IDEHSF%TYPE;	
BEGIN
	IF ((E_TIPHSF = 'D' AND E_DESITE IS NOT NULL) OR (E_TIPHSF = 'C' AND E_CODITE IS NOT NULL)) THEN
		SELECT COUNT(1) INTO QTDREG
		FROM E055HSF
    	WHERE E055HSF.CODEMP=E_CODEMP AND
    	E055HSF.CODSER=E_CODSER AND
    	E055HSF.TIPHSF=E_TIPHSF AND
    	E055HSF.PERFIM=CURDATE();	

		IF (QTDREG > 0) THEN
		 	SELECT E055HSF.IDEHSF INTO W_IdeHsf
    	  	FROM E055HSF
     		WHERE E055HSF.CODEMP=E_CODEMP AND
    		E055HSF.CODSER=E_CODSER AND
    		E055HSF.TIPHSF=E_TIPHSF AND
    		E055HSF.PERFIM=CURDATE();	   
   
      		UPDATE E055HSF SET DESITE = E_DESITE, CODITE = E_CODITE WHERE IDEHSF = W_IdeHsf;	      	
    	ELSE    
	   		GETNEXTVALUE('E055HSF', 1, 'SELECT COALESCE(MAX(IDEHSF), 0) FROM E055HSF', W_IdeHsf OUT);
   		
    		INSERT INTO E055HSF (IDEHSF, CODEMP, CODSER, PERFIM, TIPHSF, CODITE, DESITE)
			VALUES (W_IdeHsf, E_CODEMP, E_CODSER, CURDATE(), E_TIPHSF, E_CODITE, E_DESITE);
		END IF;	
	END IF;
END␀´ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
#␀␀/* Registro (log) de alterações no cadastro da transportadora */
PROCEDURE SP_T073VTR(OLD_CODTRA NUMBER,OLD_NOMTRA VARCHAR2(100),OLD_TIPTRA VARCHAR2(1),OLD_INSEST VARCHAR2(25),OLD_INSMUN VARCHAR2(16),OLD_CGCCPF NUMBER(14),OLD_ENDTRA VARCHAR2(100),OLD_CPLEND VARCHAR2(20),OLD_CEPTRA NUMBER(8),OLD_BAITRA VARCHAR2(75),OLD_CIDTRA VARCHAR2(60),OLD_SIGUFS VARCHAR2(2),OLD_CODVIA VARCHAR2(3),OLD_TRACLI NUMBER,OLD_TRAFOR NUMBER,OLD_SITTRA VARCHAR2(1),OLD_USUATU NUMBER(10),OLD_CODGRE NUMBER(9),OLD_CODPAI VARCHAR2(4), OLD_DOCIDE VARCHAR2(14))
 IS

wk_seqatu	  E073VTR.SEQATU%TYPE;
	wk_datatu	  E073VTR.DATATU%TYPE;
	wk_horatu	  E073VTR.HORATU%TYPE;
BEGIN
	/* Buscar a data e hora da atualização */
	wk_datatu := CURDATE();
	wk_horatu := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());

	/* Buscar próxima sequência */
	BEGIN
		SELECT MAX(SEQATU) + 1 INTO wk_seqatu
			FROM E073VTR
		WHERE
			CODTRA = old_CODTRA AND
			DATATU = wk_datatu AND
			HORATU = wk_horatu;
	END;

	IF (wk_seqatu IS NULL) THEN
		wk_seqatu := 1;
	END IF;

	/* Gerar registro log */
	INSERT INTO E073VTR (
		CODTRA, DATATU, HORATU, SEQATU, NOMTRA, TIPTRA, INSEST, INSMUN, CGCCPF,
		ENDTRA, CPLEND, CEPTRA, BAITRA, CIDTRA, SIGUFS, CODVIA, TRACLI, TRAFOR, SITTRA,
		USUATU, CODGRE, DATFIS, CODPAI, DOCIDE)
	VALUES (
		old_CODTRA, wk_datatu,  wk_horatu,  wk_seqatu,  old_NOMTRA, old_TIPTRA, old_INSEST, old_INSMUN, old_CGCCPF,
		old_ENDTRA, old_CPLEND, old_CEPTRA, old_BAITRA, old_CIDTRA, old_SIGUFS, old_CODVIA, old_TRACLI, old_TRAFOR, old_SITTRA,
		old_USUATU, old_CODGRE, wk_datatu, old_CODPAI, old_DOCIDE);
END␀µê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
U␀␀/* Registro (log) de alterações no cadastro do cliente */
PROCEDURE SP_T085VCL(OLD_CODCLI NUMBER,OLD_DATATU DATE,OLD_HORATU NUMBER,OLD_NOMCLI VARCHAR2(255),OLD_TIPCLI VARCHAR2(255),OLD_TIPMER VARCHAR2(255),OLD_TIPEMC NUMBER,OLD_CLICON VARCHAR2(255),OLD_CODRAM VARCHAR2(255),OLD_INSEST VARCHAR2(255),OLD_INSMUN VARCHAR2(255),OLD_CGCCPF NUMBER,OLD_CODGRE NUMBER(9),OLD_ZONFRA NUMBER,OLD_CODSUF VARCHAR2(255),OLD_ENDCLI VARCHAR2(255),OLD_CPLEND VARCHAR2(255),OLD_CEPCLI NUMBER,OLD_BAICLI VARCHAR2(255),OLD_CIDCLI VARCHAR2(255),OLD_SIGUFS VARCHAR2(255),OLD_CODPAI VARCHAR2(255),OLD_ENDENT VARCHAR2(255),OLD_CPLENT VARCHAR2(255),OLD_CEPENT NUMBER,OLD_CIDENT VARCHAR2(255),OLD_ESTENT VARCHAR2(255),OLD_INSENT VARCHAR2(255),OLD_ENDCOB VARCHAR2(255),OLD_CPLCOB VARCHAR2(255),OLD_CEPCOB NUMBER,OLD_CIDCOB VARCHAR2(255),OLD_ESTCOB VARCHAR2(255),OLD_CGCCOB NUMBER,OLD_CODFOR NUMBER,OLD_CLIREP NUMBER,OLD_CLITRA NUMBER,OLD_DATVCT DATE,OLD_USUATU NUMBER,OLD_SITCLI VARCHAR2(255),OLD_BLOCRE VARCHAR2(255),OLD_TRIICM VARCHAR2(255),OLD_TRIIPI VARCHAR2(255),OLD_BAIENT VARCHAR2(255),OLD_BAICOB VARCHAR2(255),OLD_TRIPIS VARCHAR2(255),OLD_TRICOF VARCHAR2(255),OLD_RETCOF VARCHAR2(255),OLD_RETCSL VARCHAR2(255),OLD_RETPIS VARCHAR2(255),OLD_RETOUR VARCHAR2(255),OLD_DATSUF DATE,OLD_RETPRO VARCHAR2(255),OLD_RETIRF VARCHAR2(255),OLD_LIMRET VARCHAR2(255),OLD_CALFUN VARCHAR2(255),OLD_INDCOO VARCHAR2(255),OLD_NATRET NUMBER,OLD_NATPIS NUMBER,OLD_NATCOF NUMBER,OLD_DATSPC DATE,OLD_CIDSPC VARCHAR2(255),OLD_INFSPC NUMBER,OLD_USUSPC NUMBER, OLD_DOCIDE VARCHAR2(14), OLD_DOCIDECOB VARCHAR2(14))
 IS

wk_seqatu	  E085VCL.SEQATU%TYPE;
	wk_datger	  E085VCL.DATGER%TYPE;
BEGIN
	/* Buscar próxima sequência */
	BEGIN
		SELECT MAX(SEQATU) + 1 INTO wk_seqatu
			FROM E085VCL
		WHERE
			CODCLI = old_CODCLI AND 
			DATATU = old_DATATU AND
			HORATU = old_HORATU;
	END;

	IF (wk_seqatu IS NULL) THEN
		wk_seqatu := 1;
	END IF;

	wk_datger := CURDATE();

	/* Gerar registro */
	INSERT INTO E085VCL (
		CODCLI, DATATU, HORATU, SEQATU, NOMCLI, TIPCLI, TIPMER, TIPEMC, CLICON,
		CODRAM, INSEST, INSMUN, CGCCPF, CODGRE, ZONFRA, CODSUF, ENDCLI, CPLEND, CEPCLI,
		BAICLI, CIDCLI, SIGUFS, CODPAI, ENDENT, CPLENT, CEPENT, CIDENT, ESTENT, INSENT,
		ENDCOB, CPLCOB, CEPCOB, CIDCOB, ESTCOB, CGCCOB, CODFOR, CLIREP, CLITRA, DATVCT,
		USUATU, SITCLI, BLOCRE, TRIICM, TRIIPI, BAIENT, BAICOB, DATGER, TRIPIS, TRICOF,
		RETCOF, RETCSL, RETPIS, RETOUR, DATSUF, RETPRO, RETIRF, LIMRET, CALFUN, DATFIS,
             INDCOO, NATRET, NATPIS, NATCOF, DATSPC, CIDSPC, INFSPC, USUSPC, DOCIDE, DOCIDECOB)
	VALUES (
		old_CODCLI, old_DATATU, old_HORATU, wk_seqatu,  old_NOMCLI, old_TIPCLI, old_TIPMER, old_TIPEMC, old_CLICON,
		old_CODRAM, old_INSEST, old_INSMUN, old_CGCCPF, old_CODGRE, old_ZONFRA, old_CODSUF, old_ENDCLI, old_CPLEND, old_CEPCLI,
		old_BAICLI, old_CIDCLI, old_SIGUFS, old_CODPAI, old_ENDENT, old_CPLENT, old_CEPENT, old_CIDENT, old_ESTENT, old_INSENT,
		old_ENDCOB, old_CPLCOB, old_CEPCOB, old_CIDCOB, old_ESTCOB, old_CGCCOB, old_CODFOR, old_CLIREP, old_CLITRA, old_DATVCT,
		old_USUATU, old_SITCLI, old_BLOCRE, old_TRIICM, old_TRIIPI, old_BAIENT, old_BAICOB, wk_datger,  old_TRIPIS, old_TRICOF,
		old_RETCOF, old_RETCSL, old_RETPIS, old_RETOUR, old_DATSUF, old_RETPRO, old_RETIRF, old_LIMRET, old_CALFUN, old_DATATU,
              old_INDCOO, old_NATRET, old_NATPIS, old_NATCOF, old_DATSPC, old_CIDSPC, old_INFSPC, old_USUSPC, old_DOCIDE, old_DOCIDECOB);
END␀¶ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* Registro (log) de alterações no cadastro do representante */
PROCEDURE SP_T090VRE(OLD_CODREP NUMBER,OLD_NOMREP VARCHAR2(100),OLD_TIPREP VARCHAR2(1),OLD_INSEST VARCHAR2(25),OLD_INSMUN VARCHAR2(16),OLD_CGCCPF NUMBER(14),OLD_ENDREP VARCHAR2(100),OLD_CPLEND VARCHAR2(20),OLD_CEPREP NUMBER(8),OLD_BAIREP VARCHAR2(75),OLD_CIDREP VARCHAR2(60),OLD_SIGUFS VARCHAR2(2),OLD_SITREP VARCHAR2(1),OLD_QTDDEP NUMBER(2),OLD_DATNAS DATE,OLD_NUMRGE VARCHAR2(12),OLD_ORGRGE VARCHAR2(6),OLD_DATRGE DATE,OLD_REPCLI NUMBER,OLD_REPFOR NUMBER,OLD_USUATU NUMBER(10),OLD_CALIRF VARCHAR2(1),OLD_CALISS VARCHAR2(1),OLD_CALINS VARCHAR2(1),OLD_GERTIT VARCHAR2(1), OLD_DOCIDE VARCHAR2(14))
 IS

wk_seqatu	  E090VRE.SEQATU%TYPE;
	wk_datatu	  E090VRE.DATATU%TYPE;
	wk_horatu	  E090VRE.HORATU%TYPE;
BEGIN
	/* Buscar a data e hora da atualização */
	wk_datatu := CURDATE();
	wk_horatu := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());

	/* Buscar próxima sequência */
	BEGIN
		SELECT MAX(SEQATU) + 1 INTO wk_seqatu
			FROM E090VRE
		WHERE
			CODREP = old_CODREP AND
			DATATU = wk_datatu AND
			HORATU = wk_horatu;
	END;

	IF (wk_seqatu IS NULL) THEN
		wk_seqatu := 1;
	END IF;  

	/* Gerar registro */
	INSERT INTO E090VRE (
		CODREP, DATATU, HORATU, SEQATU, NOMREP, TIPREP, INSEST, INSMUN, CGCCPF,
		ENDREP, CPLEND, CEPREP, BAIREP, CIDREP, SIGUFS, SITREP, QTDDEP, DATNAS, NUMRGE,
		ORGRGE, DATRGE, REPCLI, REPFOR, USUATU, CALIRF, CALISS, CALINS, GERTIT, DATFIS, DOCIDEREP)
	VALUES (
		old_CODREP, wk_datatu,  wk_horatu,  wk_seqatu,  old_NOMREP, old_TIPREP, old_INSEST, old_INSMUN, old_CGCCPF,
		old_ENDREP, old_CPLEND, old_CEPREP, old_BAIREP, old_CIDREP, old_SIGUFS, old_SITREP, old_QTDDEP, old_DATNAS, old_NUMRGE,
		old_ORGRGE, old_DATRGE, old_REPCLI, old_REPFOR, old_USUATU, old_CALIRF, old_CALISS, old_CALINS, old_GERTIT, wk_datatu, old_DOCIDE);
END␀·ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
þ
␀␀/* Registro (log) de alterações no cadastro do fornecedor */
PROCEDURE SP_T095VFO(OLD_CODFOR NUMBER,OLD_DATATU DATE,OLD_HORATU NUMBER(5),OLD_NOMFOR VARCHAR2(100),OLD_TIPFOR VARCHAR2(1),OLD_TIPMER VARCHAR2(1),OLD_CODRAM VARCHAR2(5),OLD_INSEST VARCHAR2(25),OLD_INSMUN VARCHAR2(16),OLD_CGCCPF NUMBER(14),OLD_CODGRE NUMBER(9),OLD_CODSUF VARCHAR2(10),OLD_ENDFOR VARCHAR2(100),OLD_CPLEND VARCHAR2(20),OLD_BAIFOR VARCHAR2(75),OLD_CEPFOR NUMBER(8),OLD_CIDFOR VARCHAR2(60),OLD_SIGUFS VARCHAR2(2),OLD_CODCLI NUMBER,OLD_USUATU NUMBER(10),OLD_SITFOR VARCHAR2(1),OLD_CODPAI VARCHAR2(4),OLD_FORREP NUMBER,OLD_FORTRA NUMBER,OLD_CODTRI VARCHAR2(5),OLD_GERDIR VARCHAR2(1),OLD_QTDDEP NUMBER(4),OLD_RECPIS VARCHAR2(1),OLD_PERPID NUMBER(7,4),OLD_TRIISS VARCHAR2(1),OLD_RECCOF VARCHAR2(1),OLD_PERCOD NUMBER(7,4),OLD_RETCOF VARCHAR2(1),OLD_RETCSL VARCHAR2(1),OLD_RETPIS VARCHAR2(1),OLD_RETOUR VARCHAR2(1),OLD_RECIPI VARCHAR2(1),OLD_RECICM VARCHAR2(1),OLD_TRIICM VARCHAR2(1),OLD_TRIIPI VARCHAR2(1),OLD_RETPRO VARCHAR2(1),OLD_RETIRF VARCHAR2(1),OLD_INDFOR VARCHAR2(1),OLD_LIMRET VARCHAR2(1),OLD_NUMRGE VARCHAR2(12),OLD_INDCOO VARCHAR2(1), OLD_NUMNIS VARCHAR2(11),OLD_ORGEMI VARCHAR2(20),OLD_DATEXD DATE,OLD_DATNAS DATE,OLD_NUMCBO NUMBER,OLD_CATFOR NUMBER, OLD_DOCIDE VARCHAR2(14))
 IS

wk_seqatu	  E095VFO.SEQATU%TYPE;
	wk_datger	  E095VFO.DATGER%TYPE;
BEGIN
	/* Buscar próxima sequência */
	BEGIN
		SELECT MAX(SEQATU) + 1 INTO wk_seqatu
			FROM E095VFO
		WHERE
			CODFOR = old_CODFOR AND
			DATATU = old_DATATU AND
			HORATU = old_HORATU;
	END;

	IF (wk_seqatu IS NULL) THEN
		wk_seqatu := 1;
	END IF;

	wk_datger := CURDATE();

	/* Gerar registro log */
	INSERT INTO E095VFO (
		CODFOR, DATATU, HORATU, SEQATU, NOMFOR, TIPFOR, TIPMER, CODRAM, INSEST,
		INSMUN, CGCCPF, CODGRE, CODSUF, ENDFOR, CPLEND, BAIFOR, CEPFOR, CIDFOR, SIGUFS,
		CODCLI, USUATU, SITFOR, CODPAI, FORREP, FORTRA, DATGER, CODTRI, GERDIR, QTDDEP,
		RECPIS, PERPID, TRIISS, RECCOF, PERCOD, RETCOF, RETCSL, RETPIS, RETOUR, RECIPI,
		RECICM, TRIICM, TRIIPI, RETPRO, RETIRF, INDFOR, LIMRET, NUMRGE, DATFIS, INDCOO,
		NUMNIS, ORGEMI, DATEXD, DATNAS, NUMCBO, CATFOR, DOCIDE)
	VALUES (
		old_CODFOR, old_DATATU, old_HORATU, wk_seqatu,  old_NOMFOR, old_TIPFOR, old_TIPMER, old_CODRAM, old_INSEST,
		old_INSMUN, old_CGCCPF, old_CODGRE, old_CODSUF, old_ENDFOR, old_CPLEND, old_BAIFOR, old_CEPFOR, old_CIDFOR, old_SIGUFS,
		old_CODCLI, old_USUATU, old_SITFOR, old_CODPAI, old_FORREP, old_FORTRA, wk_datger,  old_CODTRI, old_GERDIR, old_QTDDEP,
		old_RECPIS, old_PERPID, old_TRIISS, old_RECCOF, old_PERCOD, old_RETCOF, old_RETCSL, old_RETPIS, old_RETOUR, old_RECIPI,
		old_RECICM, old_TRIICM, old_TRIIPI, old_RETPRO, old_RETIRF, old_INDFOR, old_LIMRET, old_NUMRGE, old_DATATU, old_INDCOO, 
		old_NUMNIS, old_ORGEMI, old_DATEXD, old_DATNAS, old_NUMCBO, old_CATFOR, old_DOCIDE);
END␀¸ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_TCRSALDOS(V_CODEMP NUMBER,V_DATINI DATE,V_DATFIM DATE,V_DATBAS DATE,V_TIPVCT NUMBER,V_USUGER NUMBER,V_DATGER DATE,V_HORGER NUMBER,V_CODFIL VARCHAR2(255),V_CODTPT VARCHAR2(255),V_CODPOR VARCHAR2(255),V_CODCRT VARCHAR2(255),V_PROTER VARCHAR2(255))
 IS
BEGIN
NULL;
END␀¹ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUSALDOS
‹␀␀PROCEDURE SP_TRANSFSALDOSCTB(PCODEMP NUMBER(04,0),PCODFIL NUMBER(05,0),PMESANO DATE)
 IS

WMESANO DATE;
WMAXMES DATE;
WDATAUX DATE;
PCTASUP NUMBER(07,0);

/*CURSOR para buscar todas as competências onde não existe a estrutura de saldos*/
CURSOR CUR_E650PMA_S IS
       SELECT MESANO
       FROM E650PMA E650PMA
       WHERE CODEMP=PCODEMP AND
       CODFIL = PCODFIL AND
       INDEST = 'N' AND
       MESANO <= PMESANO FOR UPDATE;

/*CURSOR para buscar a maior data existente com estrutura de saldos já transferida*/
CURSOR CUR_E650PMA_M IS
       SELECT IFNULL(MAX(MESANO),WDATAUX)
       FROM E650PMA E650PMA
       WHERE CODEMP = PCODEMP AND
       CODFIL = PCODFIL AND
       INDEST <> 'N' AND
       MESANO <= PMESANO;
BEGIN

/*caso o CURSOR acima não encontre nenhum registro eretorne a mesma data passada como parâmetro, atribui o dia 1º do mês*/
WDATAUX := DATETIME(01,MONTH(PMESANO),YEAR(PMESANO),0,0,0);

/*armazenar a maior data existente com transferência*/
FOREACH CUR_E650PMA_M INTO WMAXMES
LOOP
	WMAXMES := WMAXMES;
END LOOP;

/*atualizar os saldos da competência encontrada anteriormente*/
IF (WMAXMES <> WDATAUX) THEN
   SP_ATUSALDOS(PCODEMP,PCODFIL,WMAXMES,WMAXMES,'S','S',PCTASUP);
END IF;

FOREACH CUR_E650PMA_S INTO WMESANO
LOOP
      IF (WMESANO >= WMAXMES) THEN
              /*insere na tabela de saldos das contas contábeis*/
              INSERT INTO E650SAL
                    (CODEMP, CODFIL, MESANO, CTARED, CLACTA, ANASIN, QTDPOS,
                     DEBCAL, CRECAL, DEBMES, CREMES, SALMES, VLRORC)
                     SELECT PCODEMP, PCODFIL,WMESANO, B.CTARED, B.CLACTA,
                     B.ANASIN, B.QTDPOS, 0, 0, 0, 0, B.SALMES, 0
                     FROM E650SAL B
                     WHERE B.CODEMP = PCODEMP AND
                     B.CODFIL = PCODFIL AND
                     B.MESANO = WMAXMES AND
                     NOT EXISTS(SELECT 1 FROM E650SAL C WHERE C.CODEMP = B.CODEMP AND
                                                              C.CODFIL = B.CODFIL AND
                                                              C.MESANO = WMESANO);

               /*insere na tabela de saldos da composição auxiliar*/
               INSERT INTO E652SAL
                    (CODEMP, CODFIL, MESANO, CTAAUX, CTARED,
                     DEBCAL, CRECAL, DEBMES, CREMES, SALMES)
                     SELECT PCODEMP, PCODFIL,WMESANO, B.CTAAUX,
                     B.CTARED, 0, 0, 0, 0, B.SALMES
                     FROM E652SAL B
                     WHERE B.CODEMP = PCODEMP AND
                     B.CODFIL = PCODFIL AND B.MESANO = WMAXMES AND
                     NOT EXISTS(SELECT 1 FROM E652SAL C WHERE C.CODEMP = B.CODEMP AND
                                                              C.CODFIL = B.CODFIL AND
                                                              C.MESANO = WMESANO);

               /*atualiza o registro na tabela E650PMA alterando o campo INDEST para sim, indicando que a transferência foi efetuada*/
               UPDATE E650PMA
                     SET INDEST = 'S'
                     WHERE CODEMP = PCODEMP AND
                     CODFIL = PCODFIL AND
                     MESANO = WMESANO;
      END IF;
END LOOP;
END␀␀Ùoxh␀␀␀␀␀␀␀␀␀ÿ5␀5␀F␀␀␀␀ÿ␀␀ÿ␀ph³␀	␀␀␀␀␀␀␀␀Â5”qÂ5r<␀␀ƒÿ␀␀ÿ␀qhµ␀	␀␀␀␀␀␀␀␀d6¶yd6y<␀␀ƒÿ␀␀V@␀th5	␀␀␀␀␀␀␀␀?“␀?W␀␀␀ÿ␀␀ÿ␀vh	␀␀␀␀␀␀␀␀½␀␀Ï␀½␀␀B␀␀␀ÿ␀␀ÿ␀uhÎ␀	␀␀␀␀␀␀␀␀aGêCI‚@␀”ÿ␀␀ÿ␀yh‘␀	␀␀␀␀␀␀␀␀é/␀ˆ7␀ß/␀ <␀␀ƒÿ␀␀ÿ␀rhÈ␀	␀␀␀␀␀␀␀␀=Æ}=]<␀␀ƒÿ␀␀ÿ␀shN	␀␀␀␀␀␀␀␀C9@␀o9\␀␀␀ÿ␀␀ÿ␀whÎ␀	␀␀␀␀␀␀␀␀¶JÓ2␀é2␀‚@␀”ÿ␀␀ÿ␀␀j␀␀ SELECT 'A' E501TCP_VISAO, 
       E501TCP.CODEMP AS E501TCP_CODEMP, 
       E501TCP.CODFIL AS E501TCP_CODFIL,
       E501TCP.CODTPT AS E501TCP_CODTPT, 
       E501TCP.NUMTIT AS E501TCP_NUMTIT,
       E501TCP.DATENT AS E501TCP_DATENT, 
       E501TCP.VLRORI AS E501TCP_VLRORI,
       E501TCP.CODFOR AS E501TCP_CODFOR, 
       E501TCP.CODTNS AS E501TCP_CODTNS,
       E501TCP.VCTPRO AS E501TCP_VCTPRO
  FROM E501TCP
 WHERE NOT EXISTS (SELECT 1
                     FROM E001TNS, 
                          E070EMP, 
                          E501MCP 
                    WHERE E501MCP.CODEMP = E501TCP.CODEMP
                      AND E501MCP.CODFIL = E501TCP.CODFIL
                      AND E501MCP.CODFOR = E501TCP.CODFOR
                      AND E501MCP.CODTPT = E501TCP.CODTPT
                      AND E501MCP.NUMTIT = E501TCP.NUMTIT
                      AND E001TNS.CODEMP = E501MCP.CODEMP
                      AND E001TNS.CODTNS = E501MCP.CODTNS
                      AND E001TNS.LISMOD = 'CPB'
                      AND E070EMP.CODEMP = E501MCP.CODEMP
                      AND E501MCP.DATMOV <= E070EMP.DATPAL
                 GROUP BY E501MCP.VLRMOV
               HAVING SUM(E501MCP.VLRMOV) = E501TCP.VLRORI)
UNION
SELECT 'B' E501TCP_VISAO, 
       E501TCP.CODEMP AS E501TCP_CODEMP, 
       E501TCP.CODFIL AS E501TCP_CODFIL,
       E501TCP.CODTPT AS E501TCP_CODTPT, 
       E501TCP.NUMTIT AS E501TCP_NUMTIT,
       E501TCP.DATENT AS E501TCP_DATENT, 
       E501TCP.VLRORI AS E501TCP_VLRORI,
       E501TCP.CODFOR AS E501TCP_CODFOR, 
       E501TCP.CODTNS AS E501TCP_CODTNS,
       E501TCP.VCTPRO AS E501TCP_VCTPRO
  FROM E501TCP␀␀ÿÓoŒ³␀␀␀␀␀␀␀␀␀Â5”q”qr<␀␀␀ƒÿ␀␀R@␀Ä±␀␀␀␀␀␀␀␀␀␀ ²␀␀²␀␀²␀␀Ý␀␀␀ÿ␀␀ÿ␀¶µ␀␀␀␀␀␀␀␀␀d6¶y¶yy<␀␀␀ƒÿ␀␀V@␀Ì±␀␀␀␀␀␀␀␀␀␀€ä␀␀²␀␀²␀␀Ý␀␀␀ÿ␀␀ÿ␀º 5␀␀␀␀␀␀␀␀8Öý␀␀±ý␀␀W␀␀␀␀ÿ␀␀e@␀`¶␀␀È␀␀␀␀␀␀␀␀␀Ðº␀␀µ␀␀g¹␀␀]<␀␀␀ƒÿ␀␀4e␀3␀Û␀␀␀␀␀␀␀␀V	␀Û␀ä␀K␀␀ƒÿ␀␀ÿ␀ý÷␀␀␀␀␀␀␀␀␀␀‡ù␀␀„ö␀␀Šø␀␀F␀␀␀␀ÿ␀␀ÿ␀q÷␀␀␀␀␀␀␀␀␀␀ú␀␀Šø␀␀±ø␀␀&<␀␀␀ƒÿ␀␀ÿ␀KÈ␀␀␀␀␀␀␀␀␀›:ýý]<␀␀␀ƒÿ␀␀K@␀²±␀␀␀␀␀␀␀␀␀␀4³␀␀²␀␀²␀␀Ý␀␀␀ÿ␀␀ÿ␀ËO␀␀␀␀␀␀␀␀iReOhRò␀␀␀ÿ␀␀ÿ␀§V␀␀␀␀␀␀␀␀
