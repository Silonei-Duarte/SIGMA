DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E070EFI.INDEXP%TYPE; 

CURSOR CUR_E070EFI IS
       SELECT INDEXP
       FROM E070EFI
       WHERE CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL;
BEGIN
EXISTE := 'N';
FOREACH CUR_E070EFI INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E070EFI (CODEMP,CODFIL,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODFIL,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E070EFI SET INDEXP = 0 WHERE CODEMP = :OLD.CODEMP AND CODFIL = :OLD.CODFIL;
END IF;
