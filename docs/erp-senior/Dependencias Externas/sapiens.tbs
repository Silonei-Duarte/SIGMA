TRIGGER T080SERU AFTER UPDATE ON E080SER FOR EACH ROW

DECLARE
	
ITEMFISCAL   E070EPF.UTIFIS%TYPE;
DATAFISCAL   E070EPF.DATHFI%TYPE;
DATA DATE;
CODIGOITEM VARCHAR(60);	
	
CURSOR CUR_E070EPF IS
	SELECT UTIFIS, DATHFI 
	  FROM E070EPF
	 WHERE CODEMP=:OLD.CODEMP AND
	 	   DATHFI IS NOT NULL; 
BEGIN
  DATA := DATETIME(31,12,1900,0,0,0);
  
  IF NOT(((:NEW.DATGER = :NEW.DATALT) OR (:NEW.DATALT = DATA)) AND ((:NEW.HORGER = :NEW.HORALT) OR (:NEW.HORALT <= (:NEW.HORGER+100)))) THEN	
    CODIGOITEM := LTRIM(RTRIM(CONCAT('SER',:NEW.CODSER))); 
	FOREACH CUR_E070EPF INTO ITEMFISCAL, DATAFISCAL LOOP
      IF (DATA <> DATAFISCAL) THEN
        IF (ITEMFISCAL = 'S') THEN
          IF ((:OLD.ITEFIS IS NULL) OR (IFNULL(:OLD.ITEFIS, ' ') = ' ') OR (:OLD.ITEFIS <> :NEW.ITEFIS)) THEN
            IF (IFNULL(:OLD.ITEFIS, ' ') = ' ') THEN
              IF ((CODIGOITEM <> :NEW.ITEFIS) AND (IFNULL(CODIGOITEM, ' ') <> ' ')) THEN					
                SP_T055HSF(:OLD.CODEMP, :OLD.CODSER, 'C', CODIGOITEM, '');
              END IF;						
            ELSE					
              SP_T055HSF(:OLD.CODEMP, :OLD.CODSER, 'C', :OLD.ITEFIS, '');		
            END IF;				
          END IF;
          					
          IF ((:OLD.DESFIS IS NULL) OR (IFNULL(:OLD.DESFIS, ' ') = ' ') OR (:OLD.DESFIS <> :NEW.DESFIS)) THEN
            IF (IFNULL(:OLD.DESFIS, ' ') = ' ') THEN
              IF ((:OLD.DESSER <> :NEW.DESFIS) AND (IFNULL(:OLD.DESSER, ' ') <> ' ')) THEN						
                SP_T055HSF(:OLD.CODEMP, :OLD.CODSER, 'D', '', :OLD.DESSER);
              END IF;
            ELSE
              SP_T055HSF(:OLD.CODEMP, :OLD.CODSER, 'D', '', :OLD.DESFIS);						
            END IF;	
          END IF;
	    ELSE	
          IF (:OLD.DESSER <> :NEW.DESSER) THEN		
            SP_T055HSF(:OLD.CODEMP, :OLD.CODSER, 'D', '', :OLD.DESSER);
          END IF;								
        END IF;
      END IF;
    END LOOP;
  END IF;
END␀|þ␀␀		SENIOR;0*␀␀TRIGGER T080SERD AFTER DELETE ON E080SER FOR EACH ROW
BEGIN
  DELETE FROM E055FHS WHERE E055FHS.IdeHsf = (SELECT HSF.IDEHSF FROM E055HSF HSF WHERE HSF.CODEMP = :OLD.CODEMP AND HSF.CODSER = :OLD.CODSER);
  DELETE FROM E055HSF WHERE E055HSF.CODEMP = :OLD.CODEMP AND E055HSF.CODSER = :OLD.CODSER;	
END␀␀␀c␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ê`d‘␀␀È␀	␀␀␀␀␀␀␀␀”␀␀à’␀␀t“␀␀]<␀␀ƒÿ␀␀¬@␀Œ³␀	␀␀␀␀␀␀␀␀Â5”qÂ5r<␀␀ƒÿ␀␀R@␀¶µ␀	␀␀␀␀␀␀␀␀d6¶yd6y<␀␀ƒÿ␀␀V@␀Aø␀␀¨␀␀␀␀␀␀␀␀Iú␀␀„ö␀␀Šø␀␀F␀␀␀␀ÿ␀␀þ@␀8!␀o␀␀␀␀␀␀␀␀Á"␀¶!␀""␀ž<␀␀␀ƒÿ␀␀A␀'BÎ␀␀␀␀␀␀␀␀␀™G©DÑF‚@␀␀”ÿ␀␀Š@␀h‚␀␀µ␀␀␀␀␀␀␀␀␀„␀␀ƒ␀␀±ƒ␀␀&=␀␀␀ƒÿ␀␀©@␀!␀o␀␀␀␀␀␀␀␀â"␀#␀#␀ž<␀␀␀ƒÿ␀␀A␀™AÎ␀␀␀␀␀␀␀␀␀HL¨L‚@␀␀”ÿ␀␀†@␀6‚␀␀µ␀␀␀␀␀␀␀␀␀G„␀␀t…␀␀y…␀␀&=␀␀␀ƒÿ␀␀¨@␀␀␀␀0;1;2␀␀ö␀␀␀␀␀␀␀␀␀␀␀␀Ë`Œ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀R@␀¯ 	␀␀␀␀␀␀␀␀Í>²õ␀␀²õ␀␀A␀␀␀ÿ␀␀É`␀–Â␀	␀␀␀␀␀␀␀␀³w»»O␀ƒÿ␀␀ß\␀ABÎ␀	␀␀␀␀␀␀␀␀YIâ¤␀␀â¤␀␀‚@␀”ÿ␀␀ÿ␀GË␀␀»␀␀␀␀␀␀␀␀␀óÎ␀␀ÞÞ*<␀␀ƒÿ␀␀ã@␀·␀␀␀␀␀␀␀␀?ý1”2ß␀␀ÿ␀␀ÿ␀=␀␀␀␀␀␀␀␀␀\:Ä1ˆ3õ␀␀ÿ␀␀ÿ␀-␀␀␀␀␀␀␀␀}ú␀␀çö␀␀ù␀␀<␀␀␀␀ÿ␀␀ÿ␀‹æ␀␀Æ␀␀␀␀␀␀␀␀␀iÎ␀␀ËÄK<␀␀␀ƒÿ␀␀ÿ␀Œæ␀␀Æ␀␀␀␀␀␀␀␀␀jÎ␀␀ÌÅK<␀␀␀ƒÿ␀␀ÿ␀DË␀␀»␀␀␀␀␀␀␀␀␀ìÎ␀␀âã*<␀␀␀ƒÿ␀␀ã@␀␀␀Ì`␀␀␀0;1;2;3␀␀f␀␀␀␀␀␀␀␀␀␀␀␀Í`Œ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀R@␀¯ 	␀␀␀␀␀␀␀␀Í>²õ␀␀²õ␀␀A␀␀␀ÿ␀␀d@␀Ú N	␀␀␀␀␀␀␀␀ö8`␀@␀\␀␀␀ÿ␀␀j@␀8!␀o␀␀␀␀␀␀␀␀Á"␀³!␀¶!␀ž<␀␀␀ƒÿ␀␀ÿ␀'BÎ␀␀␀␀␀␀␀␀␀™G©DÙL‚@␀”ÿ␀␀ÿ␀h‚␀␀µ␀␀␀␀␀␀␀␀␀„␀␀ƒ␀␀ƒ␀␀&=␀␀ƒÿ␀␀ÿ␀␀␀Î`␀␀␀0;1;2␀␀g␀␀␀␀␀␀␀Ï`Œ³␀	␀␀␀␀␀␀␀␀÷3”q”qr<␀␀ƒÿ␀␀R@␀‘õ␀␀	␀␀␀␀␀␀␀␀:
