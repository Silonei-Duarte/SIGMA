END␀‹þ␀␀		SENIOR;0™␀␀TRIGGER T085HCLD AFTER DELETE ON E085HCL FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085EHC.INDEXP%TYPE; 

CURSOR CUR_E085EHC IS
       SELECT INDEXP
       FROM E085EHC
       WHERE CODCLI=:OLD.CODCLI AND CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085EHC INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085EHC (CODCLI,CODEMP,CODFIL,INDEXP) VALUES (:OLD.CODCLI,:OLD.CODEMP,:OLD.CODFIL,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085EHC SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI AND CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL;
END IF;
