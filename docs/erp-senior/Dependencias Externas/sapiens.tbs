u␀␀CREATE OR REPLACE PROCEDURE SP_LIMPA650SLC
(V_CODEMP IN NUMBER, V_CODFIL IN VARCHAR2, V_MESANO IN DATE)
AS
  V_STMT VARCHAR2(4000);
BEGIN
	IF V_CODEMP IS NOT NULL THEN
	  V_STMT:= 'DELETE FROM E650SLC WHERE CODEMP = :1';
	  IF V_CODFIL IS NOT NULL THEN
	    V_STMT:= V_STMT||' AND CODFIL IN ('||V_CODFIL||')';
	    IF V_MESANO IS NOT NULL THEN
	      V_STMT:= V_STMT||' AND MESANO >= :2';
	      EXECUTE IMMEDIATE V_STMT
        USING IN V_CODEMP, IN V_MESANO;
      ELSE
        EXECUTE IMMEDIATE V_STMT
        USING IN V_CODEMP;
      END IF;
    ELSE
	    IF V_MESANO IS NOT NULL THEN
	      V_STMT:= V_STMT||' AND MESANO >= :2';
	      EXECUTE IMMEDIATE V_STMT
        USING IN V_CODEMP, IN V_MESANO;
      ELSE
        EXECUTE IMMEDIATE V_STMT
        USING IN V_CODEMP;
      END IF;
    END IF;
  ELSE
    IF V_MESANO IS NULL AND V_CODFIL IS NULL THEN
      EXECUTE IMMEDIATE 'TRUNCATE TABLE E650SLC';
    ELSE
      RAISE_APPLICATION_ERROR(-20000,'SP_LIMPA650SLC: Empresa deve ser informada!');
    END IF;
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ROLLBACK;
    RAISE;
END SP_LIMPA650SLC;

	MSSQL;0
v␀␀CREATE PROCEDURE SP_LIMPA650SLC
@V_CODEMP SMALLINT, @V_CODFIL NVARCHAR(4000), @V_MESANO DATETIME
AS
  DECLARE @V_STMT NVARCHAR(4000)
	
	IF @V_CODEMP IS NOT NULL
	BEGIN
	  SET @V_STMT=N'DELETE FROM E650SLC WHERE CODEMP = @V_CODEMP'
	  IF @V_CODFIL IS NOT NULL
	    SET @V_STMT=@V_STMT+N' AND CODFIL IN ('+@V_CODFIL+')'
    IF @V_MESANO IS NOT NULL
    BEGIN
      SET @V_STMT=@V_STMT+N' AND MESANO >= @V_MESANO'
      EXEC sp_executesql @stmt=@V_STMT, @params=N'@V_CODEMP smallint, @V_MESANO datetime', @V_CODEMP=@V_CODEMP, @V_MESANO=@V_MESANO
    END
    ELSE
	    EXEC sp_executesql @stmt=@V_STMT, @params=N'@V_CODEMP smallint', @V_CODEMP=@V_CODEMP
  END
  ELSE
  BEGIN
    IF @V_MESANO IS NULL AND @V_CODFIL IS NULL
      EXEC sp_executesql @stmt=N'TRUNCATE TABLE E650SLC'
    ELSE
      RAISERROR(N'SP_LIMPA650SLC: Empresa deve ser informada!',11,1)
  END

	POSTGRESQL;0
D␀␀CREATE OR REPLACE PROCEDURE SP_LIMPA650SLC
(V_CODEMP IN NUMERIC, V_CODFIL IN VARCHAR, V_MESANO IN timestamp without time zone)
LANGUAGE 'plpgsql'
AS $BODY$
	DECLARE
	  V_STMT VARCHAR;
	BEGIN
		IF (V_CODEMP IS NOT NULL) THEN
			V_STMT:= CONCAT('DELETE FROM E650SLC WHERE CODEMP = ', V_CODEMP);
			IF (V_CODFIL IS NOT NULL) THEN
				V_STMT:= V_STMT||' AND CODFIL IN ('||V_CODFIL||')';
				IF (V_MESANO IS NOT NULL) THEN
					V_STMT:= V_STMT||' AND MESANO >= ''' || V_MESANO||'''';
					EXECUTE V_STMT;
				ELSE
					EXECUTE  V_STMT
					USING V_CODEMP;
				END IF;
			ELSE
				IF (V_MESANO IS NOT NULL) THEN
					V_STMT:= V_STMT||' AND MESANO >= ''' || V_MESANO||'''';
					EXECUTE  V_STMT
					USING V_CODEMP, V_MESANO;
				ELSE
					EXECUTE  V_STMT
					USING V_CODEMP;
				END IF;
			END IF;
		ELSE
			IF ((V_MESANO IS NULL) AND (V_CODFIL IS NULL)) THEN
				EXECUTE 'TRUNCATE TABLE E650SLC';
			ELSE
				RAISE 'SP_LIMPA650SLC: Empresa deve ser informada!';
			END IF;
		END IF;
		EXCEPTION
			WHEN OTHERS THEN
				ROLLBACK;
				RAISE;
	END;
$BODY$

␀¨ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0GetNextValue
,␀␀/* MGOE - Inserir notificação apontamento OEE, baseado em centro de recurso */
PROCEDURE SP_MGOE_NOTIF_CRE(A_CODIGO_EMPRESA NUMBER(4),A_CODIGO_CENTRO_RECURSO VARCHAR2(8),A_PARADA_CENTRO_REC_ID NUMBER(9),A_PARADA_RECURSO_ID NUMBER(9),A_APONTAMENTO_PRODUCAO_ID NUMBER(9),A_TIPO_OPERACAO VARCHAR2(1))
 IS

  X_INDOEE   E725CRE.INDOEE%TYPE;
  X_NOTIFICACAOID   MGOE_NOTIFICACAO.ID%TYPE;
BEGIN
  /*// Verifica se o centro de recurso sofre cálculo do OEE*/
  BEGIN
    SELECT INDOEE INTO X_INDOEE
      FROM E725CRE
     WHERE CODEMP = A_CODIGO_EMPRESA AND
           CODCRE = A_CODIGO_CENTRO_RECURSO;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      X_INDOEE := 'N';
  END;


  /*// Se o centro de recurso sofre cálculo do OEE, insere a notificação*/
  IF (X_INDOEE = 'S') THEN
    GETNEXTVALUE('MGOE_NOTIFICACAO', 1, NULL, X_NOTIFICACAOID OUT);

    INSERT INTO MGOE_NOTIFICACAO
    (ID, CODIGO_EMPRESA, PARADA_CENTRO_REC_ID, PARADA_RECURSO_ID, APONTAMENTO_PRODUCAO_ID, 
     SITUACAO_PROCESSAMENTO, TIPO_OPERACAO, DATA_GERACAO, USUARIO_GERACAO, DATA_ALTERACAO,
     USUARIO_ALTERACAO)
    VALUES
    (X_NOTIFICACAOID, A_CODIGO_EMPRESA, A_PARADA_CENTRO_REC_ID, A_PARADA_RECURSO_ID, A_APONTAMENTO_PRODUCAO_ID, 0, A_TIPO_OPERACAO, CURRENT_TIMESTAMP, 'SP_MGOE_NOTIF_CRE', CURRENT_TIMESTAMP,
     'SP_MGOE_NOTIF_CRE'); 
  END IF;
END␀©ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0GetNextValue
¥␀␀/* MGOE - Inserir notificação apontamento OEE, baseado em equipamento */
PROCEDURE SP_MGOE_NOTIF_EQP(A_CODIGO_EMPRESA NUMBER(4),A_CODIGO_EQUIPAMENTO VARCHAR2(20),A_PARADA_CENTRO_REC_ID NUMBER(9),A_PARADA_RECURSO_ID NUMBER(9),A_APONTAMENTO_PRODUCAO_ID NUMBER(9),A_TIPO_OPERACAO VARCHAR2(1))
 IS

X_INDOEE   E725CRE.INDOEE%TYPE;
  X_NOTIFICACAOID   MGOE_NOTIFICACAO.ID%TYPE;
BEGIN
  /*// Verifica se o centro de recurso do equipamento sofre cálculo do OEE*/
  BEGIN
    SELECT E725CRE.INDOEE INTO X_INDOEE
      FROM E103EQP, E725CRE
     WHERE E725CRE.CODEMP = E103EQP.CODEMP
       AND E725CRE.CODCRE = E103EQP.CODCRE
       AND E103EQP.CODEMP = A_CODIGO_EMPRESA
       AND E103EQP.CODEQP = A_CODIGO_EQUIPAMENTO;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      X_INDOEE := 'N';
  END;

  /*// Se o centro de recurso sofre cálculo do OEE, insere a notificação*/
  IF (X_INDOEE = 'S') THEN
    GETNEXTVALUE('MGOE_NOTIFICACAO', 1, NULL, X_NOTIFICACAOID OUT);

    INSERT INTO MGOE_NOTIFICACAO
    (ID, CODIGO_EMPRESA, PARADA_CENTRO_REC_ID, PARADA_RECURSO_ID, APONTAMENTO_PRODUCAO_ID, 
     SITUACAO_PROCESSAMENTO, TIPO_OPERACAO, DATA_GERACAO, USUARIO_GERACAO, DATA_ALTERACAO,
     USUARIO_ALTERACAO)
    VALUES
    (X_NOTIFICACAOID, A_CODIGO_EMPRESA, A_PARADA_CENTRO_REC_ID, A_PARADA_RECURSO_ID, A_APONTAMENTO_PRODUCAO_ID,
     0, A_TIPO_OPERACAO, CURRENT_TIMESTAMP, 'SP_MGOE_NOTIF_EQP', CURRENT_TIMESTAMP,
     'SP_MGOE_NOTIF_EQP'); 
  END IF;
END␀ªê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
A␀␀PROCEDURE SP_REGEXCLUSAO (
  PCODEMP IN NUMBER(4),
  PCODFIL IN NUMBER(5),
  PDATREG IN DATE) IS
  
  TEMREGISTRO NUMBER(1);
BEGIN
 
  BEGIN
    SELECT 1 INTO TEMREGISTRO FROM E210CEV WHERE E210CEV.CODEMP = PCODEMP AND E210CEV.CODFIL = PCODFIL AND DATPRC = PDATREG;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      TEMREGISTRO := 0; 
  END;

  IF (TEMREGISTRO = 0) THEN
    BEGIN 
      INSERT INTO E210CEV(codemp, codfil, datprc) VALUES (PCODEMP, PCODFIL, PDATREG); 
    EXCEPTION 
      WHEN OTHERS THEN
        TEMREGISTRO := 1; 
    END;
  END IF;

END␀«ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
cPROCEDURE SP_SALDOCCU_LIMPAR(V_CODEMP NUMBER, V_CODFIL NUMBER, V_MESANO DATE)
 IS
