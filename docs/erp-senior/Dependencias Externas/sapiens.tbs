		 (upper(rtrim(ltrim(:NEW.BAICOB))) <> upper(rtrim(ltrim(:OLD.BAICOB)))) OR (:NEW.TRIPIS <> :OLD.TRIPIS) OR (:NEW.TRICOF <> :OLD.TRICOF) OR
		 (:NEW.RETCOF <> :OLD.RETCOF) OR (:NEW.RETCSL <> :OLD.RETCSL) OR (:NEW.RETPIS <> :OLD.RETPIS) OR(:NEW.RETOUR <> :OLD.RETOUR) OR 
		 (:NEW.DATSUF <> :OLD.DATSUF) OR (:NEW.RETPRO <> :OLD.RETPRO) OR (:NEW.RETIRF <> :OLD.RETIRF) OR (:NEW.LIMRET <> :OLD.LIMRET) OR 
