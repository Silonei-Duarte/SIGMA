DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085EFP.INDEXP%TYPE; 

CURSOR CUR_E085EFP IS
       SELECT INDEXP
       FROM E085EFP
       WHERE CODCLI=:OLD.CODCLI AND CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND CODFPG=:OLD.CODFPG;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085EFP INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085EFP (CODCLI,CODEMP,CODFIL,CODFPG,INDEXP) VALUES (:OLD.CODCLI,:OLD.CODEMP,:OLD.CODFIL,:OLD.CODFPG,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085EFP SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI AND CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND CODFPG=:OLD.CODFPG;
END IF;
