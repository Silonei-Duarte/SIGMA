L␀␀CREATE OR REPLACE PROCEDURE sp_clear_ws_log(PQTDDAY INTEGER, PPRMID INTEGER, CLEAR_NOT_RECORDABLE INTEGER) IS
VQTDDAY INTEGER;
VDATREF DATE;
VDATSTR VARCHAR(255);
CBLOCK_LEN INTEGER := 1000;
XBLOCK_LEN INTEGER;
XNULLDATEINI DATE;    
CPORTFLAGLOGNORECORD INTEGER := -1;
CPORTFLAGLOGALWAYSRECORD INTEGER := -2;
CSERVICEPORTNOEXISTS INTEGER := -3;

CURSOR C1 IS SELECT r960prt.tipser TIPSER, NVL(flglog,0) FLGLOG FROM r960prt r960prt WHERE tipser IS NOT NULL
             UNION ALL
             SELECT DISTINCT r960req.tipser TIPSER, CSERVICEPORTNOEXISTS FLGLOG FROM r960req r960req WHERE NOT EXISTS(SELECT 1 FROM r960prt r960prt WHERE r960prt.tipser = r960req.tipser);
BEGIN
    VDATSTR := TO_CHAR(SYSDATE,'dd/mm/yyyy');
    UPDATE r900gpr SET prmval = VDATSTR WHERE prmid = PPRMID;
    IF SQL%NOTFOUND THEN
        INSERT INTO r900gpr(prmid,prmval) VALUES (PPRMID, VDATSTR);
    END IF;

    COMMIT;

    FOR SEVREC IN C1
    LOOP
        XNULLDATEINI := NULL;    
        IF (SEVREC.FLGLOG = CSERVICEPORTNOEXISTS) THEN
            IF (PQTDDAY <> CPORTFLAGLOGALWAYSRECORD) THEN
                VQTDDAY := (PQTDDAY * -1);
                XNULLDATEINI := SYSDATE + (VQTDDAY -1);
            ElSE
                VQTDDAY := NULL;
            END IF;    
        ELSE
            IF (SEVREC.FLGLOG = CPORTFLAGLOGALWAYSRECORD) THEN
                VQTDDAY := NULL;
            ELSE
                IF (SEVREC.FLGLOG = CPORTFLAGLOGNORECORD) THEN
                    IF (CLEAR_NOT_RECORDABLE = 1) THEN
                        VQTDDAY := 1;
                    ELSE
                        VQTDDAY := NULL;
                    END IF;
                ELSE
                    IF (SEVREC.FLGLOG = 0) THEN
                        IF (PQTDDAY = CPORTFLAGLOGALWAYSRECORD) THEN
                            VQTDDAY := NULL;
                        ELSE
                            IF (PQTDDAY = CPORTFLAGLOGNORECORD) THEN
                                IF (CLEAR_NOT_RECORDABLE = 1) THEN
                                    VQTDDAY := 1;
                                ELSE
                                    VQTDDAY := NULL;
                                END IF;
                            ELSE
                                VQTDDAY := (PQTDDAY * -1);
                            END IF;
                        END IF;
                    ELSE
                        VQTDDAY := (SEVREC.FLGLOG * -1);
                    END IF;
                END IF;
            END IF;
        END IF;

        IF (VQTDDAY IS NOT NULL) THEN
            VDATREF := SYSDATE + VQTDDAY;

            LOOP
                DELETE FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser = SEVREC.TIPSER AND r.datfin <= VDATREF) and rownum <= CBLOCK_LEN;
                XBLOCK_LEN := sql%rowcount;
                COMMIT;
                IF XBLOCK_LEN < CBLOCK_LEN THEN 
                    EXIT;
                END IF;
            END LOOP;

            LOOP
                DELETE FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser = SEVREC.TIPSER AND COALESCE(r.datini, XNULLDATEINI) <= VDATREF - 1) and rownum <= CBLOCK_LEN;
                XBLOCK_LEN := sql%rowcount;
                COMMIT;
                IF XBLOCK_LEN < CBLOCK_LEN THEN 
                    EXIT;
                END IF;
            END LOOP;

            LOOP
                DELETE FROM r960req WHERE tipser=SEVREC.TIPSER AND datfin <= VDATREF and rownum <= CBLOCK_LEN;
                XBLOCK_LEN := sql%rowcount;
                COMMIT;
                IF XBLOCK_LEN < CBLOCK_LEN THEN 
                    EXIT;
                END IF;
            END LOOP;
              
            LOOP
                DELETE FROM r960req WHERE tipser=SEVREC.TIPSER AND COALESCE(datini, XNULLDATEINI) <=VDATREF - 1 and rownum <= CBLOCK_LEN;
                XBLOCK_LEN := sql%rowcount;
                COMMIT;
                IF XBLOCK_LEN < CBLOCK_LEN THEN 
                    EXIT;
                END IF;
            END LOOP;
        END IF;        
    END LOOP;
END;	MSSQL;0
N␀␀CREATE PROCEDURE sp_clear_ws_log(@PQTDDAY INTEGER, @PPRMID INTEGER, @CLEAR_NOT_RECORDABLE INTEGER) AS
BEGIN
    SET NOCOUNT ON
    DECLARE @VTIPSER VARCHAR(255)
    DECLARE @VFLGLOG SMALLINT
    DECLARE @VQTDDAY INTEGER
    DECLARE @DATREF DATETIME
    DECLARE @VDATSTR VARCHAR(255)
    DECLARE @CBLOCK_LEN INTEGER = 1000
    DECLARE @XBLOCK_LEN INTEGER
    DECLARE @XNULLDATEINI DATETIME    
    DECLARE @CPORTFLAGLOGNORECORD INTEGER = -1
    DECLARE @CPORTFLAGLOGALWAYSRECORD INTEGER = -2
    DECLARE @CSERVICEPORTNOEXISTS INTEGER = -3
    
    DECLARE c1 CURSOR FOR SELECT r960prt.tipser TIPSER, ISNULL(flglog,0) FLGLOG FROM r960prt r960prt WHERE tipser IS NOT NULL
                          UNION ALL
                          SELECT DISTINCT r960req.tipser TIPSER, @CSERVICEPORTNOEXISTS FLGLOG FROM r960req r960req WHERE NOT EXISTS(SELECT 1 FROM r960prt r960prt WHERE r960prt.tipser = r960req.tipser)
    
    SET @VDATSTR = CONVERT(VARCHAR,GETDATE(),103)
    
    UPDATE r900gpr SET prmval = @VDATSTR WHERE prmid=@PPRMID
    IF @@ROWCOUNT = 0
        INSERT INTO r900gpr(prmid,prmval) VALUES (@PPRMID, @VDATSTR)
    
    OPEN C1
    
    FETCH NEXT FROM C1 INTO @VTIPSER, @VFLGLOG
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
        SET @XNULLDATEINI = NULL
        
        IF @VFLGLOG = @CSERVICEPORTNOEXISTS
        BEGIN
            IF @PQTDDAY <> @CPORTFLAGLOGALWAYSRECORD
            BEGIN
                SET @VQTDDAY = @PQTDDAY * -1
                SET @XNULLDATEINI = DATEADD(DAY,@VQTDDAY -1,GETDATE())             
            END
            ELSE
                SET @VQTDDAY = NULL
        END
        ELSE
        IF @VFLGLOG = @CPORTFLAGLOGALWAYSRECORD
            SET @VQTDDAY = NULL
        ELSE
        IF @VFLGLOG = @CPORTFLAGLOGNORECORD
        BEGIN
            IF @CLEAR_NOT_RECORDABLE = 1
                SET @VQTDDAY = 1
            ELSE
                SET @VQTDDAY = NULL
        END
        ELSE
        IF @VFLGLOG = 0
        BEGIN
            IF @PQTDDAY = @CPORTFLAGLOGALWAYSRECORD
                SET @VQTDDAY = NULL
            ELSE
            IF @PQTDDAY = @CPORTFLAGLOGNORECORD
                IF @CLEAR_NOT_RECORDABLE = 1
                    SET @VQTDDAY = 1
                ELSE
                    SET @VQTDDAY = NULL
            ELSE
                SET @VQTDDAY = @PQTDDAY * -1
        END
        ELSE
            SET @VQTDDAY = @VFLGLOG * -1
        
        IF @VQTDDAY IS NOT NULL
        BEGIN
            SET @DATREF = DATEADD(DAY,@VQTDDAY,GETDATE())
            
            SET @XBLOCK_LEN = @CBLOCK_LEN
            WHILE @XBLOCK_LEN = @CBLOCK_LEN
            BEGIN
                DELETE TOP (1000) FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser=@VTIPSER AND r.datfin<=@DATREF)
                SET @XBLOCK_LEN = @@ROWCOUNT
            END

            SET @XBLOCK_LEN = @CBLOCK_LEN
            WHILE @XBLOCK_LEN = @CBLOCK_LEN
            BEGIN
                DELETE TOP (1000) FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser=@VTIPSER AND COALESCE(r.datini, @XNULLDATEINI) <=@DATREF - 1)
                SET @XBLOCK_LEN = @@ROWCOUNT
            END

            SET @XBLOCK_LEN = @CBLOCK_LEN
            WHILE @XBLOCK_LEN = @CBLOCK_LEN
            BEGIN
                DELETE TOP (1000) FROM r960req WHERE tipser=@VTIPSER AND datfin<=@DATREF
                SET @XBLOCK_LEN = @@ROWCOUNT
            END

            SET @XBLOCK_LEN = @CBLOCK_LEN
            WHILE @XBLOCK_LEN = @CBLOCK_LEN
            BEGIN
                DELETE TOP (1000) FROM r960req WHERE tipser=@VTIPSER AND COALESCE(datini, @XNULLDATEINI) <=@DATREF - 1
                SET @XBLOCK_LEN = @@ROWCOUNT
            END
        END
        FETCH NEXT FROM C1 INTO @VTIPSER, @VFLGLOG
    END
    CLOSE C1
    DEALLOCATE C1
END	POSTGRESQL;0
!␀␀CREATE OR REPLACE PROCEDURE sp_clear_ws_log(PQTDDAY INTEGER, PPRMID INTEGER, CLEAR_NOT_RECORDABLE INTEGER) 
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
    VTIPSER VARCHAR(255);
    VFLGLOG SMALLINT;
    VQTDDAY INTEGER;
    VDATREF TIMESTAMP;
    VDATSTR VARCHAR(255);
    CBLOCK_LEN INTEGER := 1000;
    XBLOCK_LEN INTEGER;
    XNULLDATEINI DATE;    
    CPORTFLAGLOGNORECORD INTEGER := -1;
    CPORTFLAGLOGALWAYSRECORD INTEGER := -2;
    CSERVICEPORTNOEXISTS INTEGER := -3;
    
    C1 CURSOR FOR SELECT r960prt.tipser TIPSER, COALESCE(flglog,0) FLGLOG FROM r960prt r960prt WHERE tipser IS NOT NULL
                  UNION ALL
                  SELECT DISTINCT r960req.tipser TIPSER, CSERVICEPORTNOEXISTS FLGLOG FROM r960req r960req WHERE NOT EXISTS(SELECT 1 FROM r960prt r960prt WHERE r960prt.tipser = r960req.tipser);
BEGIN
    VDATSTR := TO_CHAR(NOW(),'dd/mm/yyyy');
    UPDATE r900gpr SET prmval = VDATSTR WHERE prmid = PPRMID;
    IF NOT FOUND THEN
        INSERT INTO r900gpr(prmid, prmval) VALUES (PPRMID, VDATSTR);
    END IF;
    
    OPEN C1;
    FETCH C1 INTO VTIPSER, VFLGLOG;
    WHILE FOUND
    LOOP
        XNULLDATEINI := NULL;
        IF (VFLGLOG = CSERVICEPORTNOEXISTS) THEN
            IF (PQTDDAY <> CPORTFLAGLOGALWAYSRECORD) THEN
                VQTDDAY := (PQTDDAY * -1);
                XNULLDATEINI := CURRENT_DATE + (VQTDDAY -1);
            ElSE
                VQTDDAY := NULL;
            END IF;
        ELSE
            IF (VFLGLOG = CPORTFLAGLOGALWAYSRECORD) THEN
                VQTDDAY := NULL;
            ELSE
                IF (VFLGLOG = CPORTFLAGLOGNORECORD) THEN
                    IF (CLEAR_NOT_RECORDABLE = 1) THEN
                        VQTDDAY := 1;
                    ELSE
                        VQTDDAY := NULL;
                    END IF;
                ELSE
                    IF (VFLGLOG = 0) THEN
                        IF (PQTDDAY = CPORTFLAGLOGALWAYSRECORD) THEN
                            VQTDDAY := NULL;
                        ELSE
                            IF (PQTDDAY = CPORTFLAGLOGNORECORD) THEN
                                IF (CLEAR_NOT_RECORDABLE = 1) THEN
                                    VQTDDAY := 1;
                                ELSE
                                    VQTDDAY := NULL;
                                END IF;
                            ELSE
                                VQTDDAY := (PQTDDAY * -1);
                            END IF;
                        END IF;
                    ELSE
                        VQTDDAY := (VFLGLOG * -1);
                    END IF;
                END IF;
            END IF;
        END IF;
        IF (VQTDDAY IS NOT NULL) THEN
            VDATREF := NOW() + (CAST(VQTDDAY AS VARCHAR) || ' day')::INTERVAL;
       
            XBLOCK_LEN := CBLOCK_LEN;
            WHILE XBLOCK_LEN = CBLOCK_LEN loop
                DELETE FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser = VTIPSER AND r.datfin <= VDATREF LIMIT CBLOCK_LEN);
                GET DIAGNOSTICS XBLOCK_LEN := ROW_COUNT;                
            END LOOP;
       
            XBLOCK_LEN := CBLOCK_LEN;
            WHILE XBLOCK_LEN = CBLOCK_LEN loop            
                DELETE FROM r960par WHERE idreq in (SELECT r.idreq idreq FROM r960req r WHERE r.tipser = VTIPSER AND COALESCE(r.datini, XNULLDATEINI) <= (VDATREF - INTERVAL '1 day') LIMIT CBLOCK_LEN);
                GET DIAGNOSTICS XBLOCK_LEN := ROW_COUNT;
            END LOOP;
       
            XBLOCK_LEN := CBLOCK_LEN;
            WHILE XBLOCK_LEN = CBLOCK_LEN loop                        
                DELETE FROM r960req WHERE idreq in (SELECT r.idreq FROM r960req r WHERE r.tipser = VTIPSER AND r.datfin <= VDATREF LIMIT CBLOCK_LEN);
                GET DIAGNOSTICS XBLOCK_LEN := ROW_COUNT;
            END LOOP;
       
            XBLOCK_LEN := CBLOCK_LEN;
            WHILE XBLOCK_LEN = CBLOCK_LEN loop
                DELETE FROM r960req WHERE idreq in (SELECT r.idreq FROM r960req r WHERE r.tipser = VTIPSER AND COALESCE(r.datini, XNULLDATEINI) <= (VDATREF - INTERVAL '1 day') LIMIT CBLOCK_LEN);
                GET DIAGNOSTICS XBLOCK_LEN := ROW_COUNT;
            END LOOP;
        END IF;
        FETCH C1 INTO VTIPSER, VFLGLOG;
    END LOOP;
    CLOSE C1;
END
$BODY$;␀£ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
-PROCEDURE SP_CTB_LIMPAR
 IS
BEGIN
  NULL;
