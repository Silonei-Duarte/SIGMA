kPROCEDURE ClearRecentAccess (P_MODID IN NUMBER, P_CODUSU IN NUMBER, P_ITKIND IN NUMBER) IS
BEGIN
	NULL;
END	ORACLE;0
‹␀␀CREATE OR REPLACE PROCEDURE ClearRecentAccess(P_MODID IN NUMBER,P_CODUSU IN NUMBER,P_ITKIND IN NUMBER) AS
BEGIN
	DELETE FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND AND ITEMID NOT IN 
	(
		SELECT ITEMID FROM 
		(
			SELECT ITEMID FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND ORDER BY DATACC DESC
		) WHERE ROWNUM <= 30
	);
END;	MSSQL;0
l␀␀CREATE PROCEDURE ClearRecentAccess(@P_MODID NUMERIC, @P_CODUSU NUMERIC, @P_ITKIND NUMERIC) AS
BEGIN
    SET NOCOUNT ON
	DELETE FROM R975RAC WHERE MODID = @P_MODID AND CODUSU = @P_CODUSU AND ITKIND = @P_ITKIND AND ITEMID NOT IN 
	(
		SELECT TOP 30 ITEMID FROM R975RAC WHERE MODID = @P_MODID AND CODUSU = @P_CODUSU AND ITKIND = @P_ITKIND ORDER BY DATACC DESC
	);
END	POSTGRESQL;0
„␀␀CREATE OR REPLACE PROCEDURE ClearRecentAccess(P_MODID NUMERIC, P_CODUSU NUMERIC, P_ITKIND NUMERIC)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  DELETE FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND AND ITEMID NOT IN 
  (
    SELECT ITEMID FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND ORDER BY DATACC DESC LIMIT 30
  );
END
$BODY$;␀å€␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
