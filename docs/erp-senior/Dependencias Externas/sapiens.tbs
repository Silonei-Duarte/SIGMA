DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E026ERA.INDEXP%TYPE; 

CURSOR CUR_E026ERA IS
       SELECT INDEXP
       FROM E026ERA
       WHERE CODRAM=:OLD.CODRAM;
BEGIN
EXISTE := 'N';
FOREACH CUR_E026ERA INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E026ERA (CODRAM,INDEXP) VALUES (:OLD.CODRAM,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E026ERA SET INDEXP = 0 WHERE CODRAM=:OLD.CODRAM;
END IF;
