       SUM(E670SAL.SALANO) AS EW67SUC_SALANO, SUM(E670SAL.SALANC) AS EW67SUC_SALANC,
       SUM(E670SAL.ENTMIO) AS EW67SUC_ENTMIO, SUM(E670SAL.ENTMCO) AS EW67SUC_ENTMCO,
       SUM(E670SAL.BAIMIO) AS EW67SUC_BAIMIO, SUM(E670SAL.BAIMCO) AS EW67SUC_BAIMCO,
       SUM(E670SAL.REAMIO) AS EW67SUC_REAMIO, SUM(E670SAL.REAMCO) AS EW67SUC_REAMCO,
       SUM(E670SAL.BDPMIO) AS EW67SUC_BDPMIO, SUM(E670SAL.BDPMCO) AS EW67SUC_BDPMCO,
