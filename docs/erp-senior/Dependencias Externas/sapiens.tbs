DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E057ENV.INDEXP%TYPE; 

CURSOR CUR_E057ENV IS
       SELECT INDEXP
       FROM E057ENV
       WHERE CODMOT=:OLD.CODMOT;
BEGIN
EXISTE := 'N';
FOREACH CUR_E057ENV INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E057ENV (CODMOT,INDEXP) VALUES (:OLD.CODMOT,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E057ENV SET INDEXP = 0 WHERE CODMOT = :OLD.CODMOT;
