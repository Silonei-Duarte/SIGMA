q␀␀CREATE OR REPLACE PROCEDURE SP_SALDOCCU_LIMPAR
(
    V_CODEMP IN NUMBER,
    V_CODFIL IN NUMBER,
    V_MESANO IN DATE)
AS
  V_STMT VARCHAR2(200);
BEGIN
	
  DBMS_OUTPUT.PUT_LINE('Inicio LIMPA650SLC - '|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  
  IF V_CODEMP     IS NOT NULL THEN
    V_STMT        := 'DELETE FROM E650SLC WHERE CODEMP = :1';
    IF V_CODFIL   IS NOT NULL THEN
      V_STMT      := V_STMT||' AND CODFIL = :2 ';
      IF V_MESANO IS NOT NULL THEN
        V_STMT    := V_STMT||' AND MESANO >= :3';
        EXECUTE IMMEDIATE V_STMT USING IN V_CODEMP,IN V_CODFIL, IN V_MESANO;
      ELSE
        EXECUTE IMMEDIATE V_STMT USING IN V_CODEMP;
      END IF;
    ELSE
      IF V_MESANO IS NOT NULL THEN
        V_STMT    := V_STMT||' AND MESANO >= :2';
        EXECUTE IMMEDIATE V_STMT USING IN V_CODEMP, IN V_MESANO;
      ELSE
        EXECUTE IMMEDIATE V_STMT USING IN V_CODEMP;
      END IF;
    END IF;
  ELSE
    IF V_MESANO IS NULL AND V_CODFIL IS NULL THEN
      EXECUTE IMMEDIATE 'TRUNCATE TABLE E650SLC';
    ELSE
      RAISE_APPLICATION_ERROR(-20000, 'SP_LIMPA650SLC: Empresa deve ser informada!');
    END IF;
  END IF;
  
  DBMS_OUTPUT.PUT_LINE('FIM LIMPA650SLC -'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')) );
  
EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;
END SP_SALDOCCU_LIMPAR;␀¬ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
^PROCEDURE SP_SALDOCTB_EXEC(V_CODEMP NUMBER, V_CODFIL NUMBER, V_MES DATE)
 IS
BEGIN
  NULL;
END	ORACLE;0
·$␀␀CREATE OR REPLACE PROCEDURE SP_SALDOCTB_EXEC (  
  V_CODEMP    IN NUMBER,
  V_CODFIL    IN NUMBER, 
  V_MES IN DATE)
AS
  V_MESINI DATE;
  V_MESFIM DATE;
BEGIN
  
  V_MESINI:= TRUNC(V_MES,'MONTH');   
  V_MESFIM:= LAST_DAY(V_MESINI); 

  DBMS_OUTPUT.PUT_LINE('PARAMETROS PASSADOS NA SP_SALDOCTB_EXEC: EMPRESA = ' || TO_CHAR(V_CODEMP) || ' - FILIAL = ' ||
                       TO_CHAR(V_CODFIL) || ' - MES = ' || TO_CHAR(V_MES, 'DD/MM/YYYY') || ' - MESINI = ' || 
					   TO_CHAR(V_MESINI, 'DD/MM/YYYY') || ' - MESFIM = ' || TO_CHAR(V_MESFIM, 'DD/MM/YYYY'));
  DBMS_OUTPUT.PUT_LINE('PASSO 4 (PREPARANDO DEBITOS...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));

  EXECUTE IMMEDIATE 
    'INSERT INTO TEMP_DEB
          SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT,''MONTH'') MESANO, 
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) SOMA, TEMP_E045PLA.QTDPOS, 
				 TEMP_E045PLA.ANASIN
            FROM E640LCT
      INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                 E640LCT.CTADEB = TEMP_E045PLA.ROOT_CTARED
           WHERE E640LCT.CODEMP = :1 AND
                 E640LCT.CODFIL = :2 AND
                 E640LCT.SITLCT = 2 AND
                 E640LCT.CTADEB <> 0 AND
                 (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND
                 E640LCT.DATLCT >= :3 AND
                 E640LCT.DATLCT <= :4
        GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''), TEMP_E045PLA.CTARED, 
		         TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN' 
    USING IN V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA TEMP_DEB');
  
  DBMS_OUTPUT.PUT_LINE('PASSO 5 (PREPARANDO CRÉDITOS...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  EXECUTE IMMEDIATE 
    'INSERT INTO TEMP_CRE 
          SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT, ''MONTH'') MESANO, 
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) SOMA, TEMP_E045PLA.QTDPOS, 
				 TEMP_E045PLA.ANASIN
            FROM E640LCT
      INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                 E640LCT.CTACRE = TEMP_E045PLA.ROOT_CTARED
           WHERE E640LCT.CODEMP = :1 AND
                 E640LCT.CODFIL = :2 AND
                 E640LCT.SITLCT = 2 AND
                 E640LCT.CTACRE <> 0 AND
                 (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)AND
                 E640LCT.DATLCT >= :3 AND
                 E640LCT.DATLCT <= :4
        GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''), TEMP_E045PLA.CTARED, 
		         TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN'
    USING IN V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA TEMP_CRE');
  
  DBMS_OUTPUT.PUT_LINE('PASSO 6 (PREPARANDO MOVIMENTOS...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  EXECUTE IMMEDIATE 
    'INSERT INTO TEMP_MOV 
          SELECT TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, TEMP_TABLE.CTARED, TEMP_TABLE.CLACTA,
                 SUM(TEMP_TABLE.DEBMES) DEBMES, SUM(TEMP_TABLE.CREMES) CREMES, SUM(TEMP_TABLE.SALMES) SALMES, 
			     TEMP_TABLE.QTDPOS, TEMP_TABLE.ANASIN, SUM(TEMP_TABLE.SALANT) SALANT
            FROM (
			      SELECT CODEMP, CODFIL, :1 MESANO, 
                         CTARED, CLACTA, 0 DEBMES, 0 CREMES, 0 SALMES, QTDPOS, 
                         ANASIN, SALMES SALANT
                    FROM E650SAL
                   WHERE CODEMP = :2 AND
                         CODFIL = :3 AND
                         MESANO = ADD_MONTHS(:4, -1)
                   UNION            
                  SELECT NVL(DEB.CODEMP,CRE.CODEMP) CODEMP, 
                         NVL(DEB.CODFIL,CRE.CODFIL) CODFIL, 
                         NVL(DEB.MESANO,CRE.MESANO) MESANO, 
                         NVL(DEB.CTARED,CRE.CTARED) CTARED, 
                         NVL(DEB.CLACTA,CRE.CLACTA) CLACTA, 
                         NVL(DEB.SOMA,0) DEBMES, 
                         NVL(CRE.SOMA,0) CREMES, 
                         NVL(DEB.SOMA,0) - NVL(CRE.SOMA,0) SALMES, 
                         NVL(DEB.QTDPOS, CRE.QTDPOS) QTDPOS, 
                         NVL(DEB.ANASIN, CRE.ANASIN) ANASIN, 
                         0 SALANT
                    FROM TEMP_DEB DEB
         FULL OUTER JOIN TEMP_CRE CRE ON DEB.CODEMP = CRE.CODEMP AND
                                            DEB.CODFIL  = CRE.CODFIL AND
                                            DEB.MESANO  = CRE.MESANO AND
                                            DEB.CTARED  = CRE.CTARED
                                            
                   UNION
                  SELECT CODEMP, :5 CODFIL, :6 MESANO, CTARED, CLACTA, 0 DEBMES, 
                         0 CREMES, 0 SALMES, QTDPOS, ANASIN, 0 SALANT 
                    FROM E045PLA 
		           WHERE CODEMP = :7) TEMP_TABLE
        GROUP BY TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, TEMP_TABLE.CTARED, TEMP_TABLE.CLACTA, 
	             TEMP_TABLE.QTDPOS, TEMP_TABLE.ANASIN' 
    USING IN V_MESINI, V_CODEMP, V_CODFIL, V_MESINI, V_CODFIL, V_MESINI, V_CODEMP;   
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA TEMP_MOV');	
  
  DBMS_OUTPUT.PUT_LINE('PASSO 7 (EXCLUINDO MOVIMENTAÇÕES ANTERIOES...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  
  EXECUTE IMMEDIATE 
    'INSERT INTO TEMP_RTO
          SELECT E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                 E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                 E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC
            FROM E650SAL
       LEFT JOIN E650RTO ON E650RTO.CODEMP = E650SAL.CODEMP AND 
                            E650RTO.CODFIL = E650SAL.CODFIL AND 
                            E650RTO.CTARED = E650SAL.CTARED AND 
                            E650RTO.MESANO = E650SAL.MESANO
           WHERE E650SAL.MESANO BETWEEN :1 AND :2 AND
                 E650SAL.CODFIL = :3 AND
                 E650SAL.CODEMP = :4 AND 
                 (E650SAL.VLRORC <> 0 OR E650RTO.VLRRAT <>0 OR E650RTO.SALMES <> 0)
        GROUP BY E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                 E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                 E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC'
    USING IN V_MESINI, V_MESFIM, V_CODFIL, V_CODEMP;   
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA TEMP_RTO');
  
  EXECUTE IMMEDIATE 'DELETE FROM E650RTO WHERE CODEMP = :1 AND CODFIL = :2 AND MESANO = :3' USING IN V_CODEMP, V_CODFIL, V_MESINI;  
  DBMS_OUTPUT.PUT_LINE('DELETADO NA TABELA E650RTO');
  EXECUTE IMMEDIATE 'DELETE FROM E650SAL WHERE CODEMP = :1 AND CODFIL = :2 AND MESANO = :3' USING IN V_CODEMP, V_CODFIL, V_MESINI;
  DBMS_OUTPUT.PUT_LINE('DELETADO NA TABELA E650SAL');
  
  DBMS_OUTPUT.PUT_LINE('PASSO 8 (INCLUINDO NOVAS MOVIMENTAÇÕES...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));  
  
  EXECUTE IMMEDIATE 
    'INSERT INTO E650SAL 
          SELECT TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                 TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, 0, 0, TEMP_MOV.DEBMES, 
                 TEMP_MOV.CREMES, TEMP_MOV.DEBMES - TEMP_MOV.CREMES + TEMP_MOV.SALANT SALMES, 
                 Coalesce(TEMP_RTO.VLRORC, 0) VLRORC
            FROM TEMP_MOV 
	   LEFT JOIN TEMP_RTO ON TEMP_RTO.CODEMP = TEMP_MOV.CODEMP AND 
                             TEMP_RTO.CODFIL = TEMP_MOV.CODFIL AND 
                             TEMP_RTO.CTARED = TEMP_MOV.CTARED AND 
                             TEMP_RTO.MESANO = TEMP_MOV.MESANO 
           WHERE TEMP_MOV.CODEMP = :1 AND
                 TEMP_MOV.CODFIL = :2 AND
                 TEMP_MOV.MESANO = :3 AND
	             (TEMP_MOV.DEBMES <> 0 OR TEMP_MOV.CREMES <> 0 OR TEMP_MOV.SALANT <> 0 OR TEMP_RTO.VLRORC <> 0)
        GROUP BY TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                 TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, 0, 0, TEMP_MOV.DEBMES, 
                 TEMP_MOV.CREMES, TEMP_MOV.SALANT, TEMP_RTO.VLRORC'
   USING IN V_CODEMP, V_CODFIL, V_MESINI;   
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA E650SAL');   
   
  EXECUTE IMMEDIATE 
    'INSERT INTO E650RTO 
          SELECT TEMP_RTO.CODEMP, TEMP_RTO.CODFIL, TEMP_RTO.MESANO, TEMP_RTO.CTARED, 
                 TEMP_RTO.CODCCU, TEMP_RTO.CTAFIN, TEMP_RTO.SALMES, TEMP_RTO.VLRRAT, 
                 TEMP_RTO.PERRAT, TEMP_RTO.DATGER, TEMP_RTO.SEQOBS 
            FROM TEMP_RTO
           WHERE TEMP_RTO.CODEMP = :1 AND 
                 TEMP_RTO.CODFIL = :2 AND 
                 TEMP_RTO.MESANO BETWEEN :3 AND :4 AND 
                 TEMP_RTO.CODCCU IS NOT NULL'
    USING IN V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;     
  DBMS_OUTPUT.PUT_LINE('INCLUÍNDO NA TABELA E650RTO');	
  
  COMMIT;
  DBMS_OUTPUT.PUT_LINE('PASSO 9 (FINALIZANDO...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));

EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;    
END SP_SALDOCTB_EXEC;	MSSQL;0
Z'␀␀CREATE PROCEDURE SP_SALDOCTB_EXEC (  
  @V_CODEMP FLOAT,
  @V_CODFIL FLOAT, 
  @V_MES DATETIME
)
AS
BEGIN
  DECLARE @V_MESINI DATETIME;
  DECLARE @V_MESFIM DATETIME;

  SET @V_MESINI = DATEADD(MONTH, DATEDIFF(MONTH, 0, @V_MES), 0);   
  SET @V_MESFIM = EOMONTH(@V_MESINI); 
  
  PRINT 'PARAMETROS PASSADOS NA SP_SALDOCTB_EXEC: EMPRESA = ' + CONVERT(VARCHAR, @V_CODEMP) + ' - FILIAL = ' + 
        CONVERT(VARCHAR, @V_CODFIL) + ' - MES = ' + CONVERT(VARCHAR, @V_MES, 103) + ' - MESINI = ' + 
		CONVERT(VARCHAR, @V_MES, 103) + ' - MESFIM = ' + CONVERT(VARCHAR, @V_MESFIM, 103);
  PRINT 'PASSO 4 (PREPARANDO DEBITOS...)' + CONVERT(VARCHAR,GETDATE(),109);

  BEGIN TRANSACTION;

  EXEC sp_executesql 
    N'INSERT INTO TEMP_DEB
           SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATEADD(MONTH, DATEDIFF(MONTH, 0, E640LCT.DATLCT), 0) MESANO, 
                  TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) SOMA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN
             FROM E640LCT
       INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                  E640LCT.CTADEB = TEMP_E045PLA.ROOT_CTARED
            WHERE E640LCT.CODEMP = @V_CODEMP AND
                  E640LCT.CODFIL = @V_CODFIL AND
                  E640LCT.SITLCT = 2 AND
                  E640LCT.CTADEB <> 0 AND
                  (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND
                  E640LCT.DATLCT >= @V_MESINI AND
                  E640LCT.DATLCT <= @V_MESFIM
         GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATEADD(MONTH, DATEDIFF(MONTH, 0, E640LCT.DATLCT), 0),
                  TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE, @V_MESFIM DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI, @V_MESFIM;
  PRINT 'INCLUÍNDO NA TABELA TEMP_DEB';
  
  PRINT 'PASSO 5 (PREPARANDO CRÉDITOS...)' + CONVERT(VARCHAR,GETDATE(),109);

  EXEC sp_executesql 
    N'INSERT INTO TEMP_CRE 
           SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATEADD(MONTH, DATEDIFF(MONTH, 0, E640LCT.DATLCT), 0) MESANO, 
                  TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) SOMA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN
             FROM E640LCT
       INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                  E640LCT.CTACRE = TEMP_E045PLA.ROOT_CTARED
            WHERE E640LCT.CODEMP = @V_CODEMP AND
                  E640LCT.CODFIL = @V_CODFIL AND
                  E640LCT.SITLCT = 2 AND
                  E640LCT.CTACRE <> 0 AND
                  (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND
                  E640LCT.DATLCT >= @V_MESINI AND
                  E640LCT.DATLCT <= @V_MESFIM
         GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATEADD(MONTH, DATEDIFF(MONTH, 0, E640LCT.DATLCT), 0),
                  TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE, @V_MESFIM DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI, @V_MESFIM;
  PRINT 'INCLUÍNDO NA TABELA TEMP_CRE';
  
  PRINT 'PASSO 6 (PREPARANDO MOVIMENTOS...)' + CONVERT(VARCHAR,GETDATE(),109);

  EXEC sp_executesql 
    N'INSERT INTO TEMP_MOV 
           SELECT TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, E045PLA.CTARED, E045PLA.CLACTA,
                  SUM(TEMP_TABLE.DEBMES) DEBMES, SUM(TEMP_TABLE.CREMES) CREMES, SUM(TEMP_TABLE.SALMES) SALMES, 
				  E045PLA.QTDPOS, E045PLA.ANASIN, SUM(TEMP_TABLE.SALANT) SALANT
             FROM ( 
                   SELECT CODEMP, CODFIL, @V_MESINI MESANO, CTARED, CLACTA, 0 DEBMES, 
				          0 CREMES, 0 SALMES, QTDPOS, ANASIN, SALMES SALANT
                     FROM E650SAL
                    WHERE CODEMP = @V_CODEMP AND
                          CODFIL = @V_CODFIL AND
                          MESANO = DATEADD(MONTH, -1, @V_MESINI) AND
						  ANASIN = ''A''
                    UNION
                   SELECT ISNULL(DEB.CODEMP, CRE.CODEMP) CODEMP, 
                          ISNULL(DEB.CODFIL, CRE.CODFIL) CODFIL, 
                          ISNULL(DEB.MESANO, CRE.MESANO) MESANO, 
                          ISNULL(DEB.CTARED, CRE.CTARED) CTARED, 
                          ISNULL(DEB.CLACTA, CRE.CLACTA) CLACTA, 
                          ISNULL(DEB.SOMA, 0) DEBMES, 
                          ISNULL(CRE.SOMA, 0) CREMES, 
                          ISNULL(DEB.SOMA, 0) - ISNULL(CRE.SOMA, 0) SALMES, 
                          ISNULL(DEB.QTDPOS, CRE.QTDPOS) QTDPOS, 
                          ISNULL(DEB.ANASIN, CRE.ANASIN) ANASIN, 
                          0 SALANT
                     FROM TEMP_DEB DEB
          FULL OUTER JOIN TEMP_CRE CRE ON DEB.CODEMP = CRE.CODEMP AND
                                          DEB.CODFIL = CRE.CODFIL AND
                                          DEB.MESANO = CRE.MESANO AND
                                          DEB.CTARED = CRE.CTARED
                    UNION
                   SELECT CODEMP, @V_CODFIL CODFIL, @V_MESINI MESANO, CTARED, CLACTA, 0 DEBMES, 
                          0 CREMES, 0 SALMES, QTDPOS, ANASIN, 0 SALANT 
                     FROM E045PLA 
                    WHERE CODEMP = @V_CODEMP
                  ) AS TEMP_TABLE
	   INNER JOIN TEMP_E045PLA ON TEMP_E045PLA.CODEMP = TEMP_TABLE.CODEMP AND
                                  TEMP_E045PLA.CTARED = TEMP_TABLE.CTARED
       INNER JOIN E045PLA ON E045PLA.CODEMP = TEMP_E045PLA.CODEMP AND
	                         E045PLA.CTARED = TEMP_E045PLA.ROOT_CTARED
         GROUP BY TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, E045PLA.CTARED, E045PLA.CLACTA, 
		          E045PLA.QTDPOS, E045PLA.ANASIN',
    N'@V_MESINI DATE, @V_CODEMP INT, @V_CODFIL INT',
    @V_MESINI, @V_CODEMP, @V_CODFIL;
  PRINT 'INCLUÍNDO NA TABELA TEMP_MOV';
  
  PRINT 'PASSO 7 (EXCLUINDO MOVIMENTAÇÕES ANTERIOES...)' + CONVERT(VARCHAR,GETDATE(),109);
  
  EXEC sp_executesql 
    N'INSERT INTO TEMP_RTO
           SELECT E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                  E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                  E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC
             FROM E650SAL
        LEFT JOIN E650RTO ON E650RTO.CODEMP = E650SAL.CODEMP AND 
                             E650RTO.CODFIL = E650SAL.CODFIL AND 
                             E650RTO.CTARED = E650SAL.CTARED AND 
                             E650RTO.MESANO = E650SAL.MESANO
          WHERE E650SAL.MESANO BETWEEN @V_MESINI AND @V_MESFIM AND
                E650SAL.CODFIL = @V_CODFIL AND
                E650SAL.CODEMP = @V_CODEMP AND 
                (E650SAL.VLRORC <> 0 OR E650RTO.VLRRAT <> 0 OR E650RTO.SALMES <> 0)
       GROUP BY E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC',
    N'@V_MESINI DATE, @V_MESFIM DATE, @V_CODFIL INT, @V_CODEMP INT',
    @V_MESINI, @V_MESFIM, @V_CODFIL, @V_CODEMP;
  PRINT 'INCLUÍNDO NA TABELA TEMP_RTO';
  
  EXEC sp_executesql 
    N'DELETE FROM E650RTO WHERE CODEMP = @V_CODEMP AND CODFIL = @V_CODFIL AND MESANO = @V_MESINI',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI;  
  PRINT 'DELETADO NA TABELA E650RTO';
  
  EXEC sp_executesql 
    N'DELETE FROM E650SAL WHERE CODEMP = @V_CODEMP AND CODFIL = @V_CODFIL AND MESANO = @V_MESINI',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI;
  PRINT 'DELETADO NA TABELA E650SAL';

  PRINT 'PASSO 8 (INCLUINDO NOVAS MOVIMENTAÇÕES...)' + CONVERT(VARCHAR,GETDATE(),109);  

  EXEC sp_executesql 
    N'INSERT INTO E650SAL 
           SELECT TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                  TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, 0, 0, TEMP_MOV.DEBMES, 
                  TEMP_MOV.CREMES, TEMP_MOV.DEBMES - TEMP_MOV.CREMES + TEMP_MOV.SALANT SALMES, 
                  ISNULL(TEMP_RTO.VLRORC, 0) VLRORC
             FROM TEMP_MOV
        LEFT JOIN TEMP_RTO ON TEMP_RTO.CODEMP = TEMP_MOV.CODEMP AND 
                              TEMP_RTO.CODFIL = TEMP_MOV.CODFIL AND 
                              TEMP_RTO.CTARED = TEMP_MOV.CTARED AND 
                              TEMP_RTO.MESANO = TEMP_MOV.MESANO 
            WHERE TEMP_MOV.CODEMP = @V_CODEMP AND
                  TEMP_MOV.CODFIL = @V_CODFIL AND
                  TEMP_MOV.MESANO = @V_MESINI AND
                  (TEMP_MOV.DEBMES <> 0 OR TEMP_MOV.CREMES <> 0 OR TEMP_MOV.SALANT <> 0 OR TEMP_RTO.VLRORC <> 0)
         GROUP BY TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                  TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, TEMP_MOV.DEBMES, 
                  TEMP_MOV.CREMES, TEMP_MOV.SALANT, TEMP_RTO.VLRORC',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI; 
  PRINT 'INCLUÍNDO NA TABELA E650SAL';	
   
  EXEC sp_executesql 
    N'INSERT INTO E650RTO 
           SELECT TEMP_RTO.CODEMP, TEMP_RTO.CODFIL, TEMP_RTO.MESANO, TEMP_RTO.CTARED, 
                  TEMP_RTO.CODCCU, TEMP_RTO.CTAFIN, TEMP_RTO.SALMES, TEMP_RTO.VLRRAT, 
                  TEMP_RTO.PERRAT, TEMP_RTO.DATGER, TEMP_RTO.SEQOBS 
             FROM TEMP_RTO
            WHERE TEMP_RTO.CODEMP = @V_CODEMP AND 
                  TEMP_RTO.CODFIL = @V_CODFIL AND 
                  TEMP_RTO.MESANO BETWEEN @V_MESINI AND @V_MESFIM AND 
                  TEMP_RTO.CODCCU IS NOT NULL',
    N'@V_CODEMP INT, @V_CODFIL INT, @V_MESINI DATE, @V_MESFIM DATE',
    @V_CODEMP, @V_CODFIL, @V_MESINI, @V_MESFIM;   
  PRINT 'INCLUÍNDO NA TABELA E650RTO';	
  
  COMMIT TRANSACTION;

  PRINT 'PASSO 9 (FINALIZANDO...)' + CONVERT(VARCHAR,GETDATE(),109);
END	POSTGRESQL;0
P#␀␀CREATE OR REPLACE PROCEDURE SP_SALDOCTB_EXEC (
  V_CODEMP IN NUMERIC,
  V_CODFIL IN NUMERIC, 
  V_MES IN timestamp without time zone)
LANGUAGE 'plpgsql'
AS $BODY$ 
DECLARE
  V_MESINI timestamp without time zone;
  V_MESFIM timestamp without time zone;
begin
  V_MESINI := DATE_TRUNC('month', V_MES);
  V_MESFIM := (V_MESINI + INTERVAL '1 month' - INTERVAL '1 day')::DATE;

  RAISE NOTICE 'PARAMETROS PASSADOS NA SP_SALDOCTB_EXEC: EMPRESA = % - FILIAL = % - MES = % - MESINI = % - MESFIM = %',
               V_CODEMP, V_CODFIL, TO_CHAR(V_MES, 'DD/MM/YYYY'), TO_CHAR(V_MESINI, 'DD/MM/YYYY'), TO_CHAR(V_MESFIM, 'DD/MM/YYYY');

  RAISE NOTICE 'PASSO 4 (PREPARANDO DEBITOS...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

  EXECUTE 
    'INSERT INTO TEMP_DEB
          SELECT E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''month'', E640LCT.DATLCT) AS MESANO, 
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) AS SOMA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN
            FROM E640LCT
      INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                 E640LCT.CTADEB = TEMP_E045PLA.ROOT_CTARED
           WHERE E640LCT.CODEMP = $1 AND
                 E640LCT.CODFIL = $2 AND
                 E640LCT.SITLCT = 2 AND
                 E640LCT.CTADEB <> 0 AND
                 (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND
                 E640LCT.DATLCT >= $3 AND
                 E640LCT.DATLCT <= $4
        GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''month'', E640LCT.DATLCT),
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN'
  USING V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;
  RAISE NOTICE 'INCLUÍNDO NA TABELA TEMP_DEB';

  RAISE NOTICE 'PASSO 5 (PREPARANDO CRÉDITOS...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

  EXECUTE 
    'INSERT INTO TEMP_CRE
          SELECT E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''month'', E640LCT.DATLCT) AS MESANO, 
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, SUM(E640LCT.VLRLCT) AS SOMA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN
            FROM E640LCT
      INNER JOIN TEMP_E045PLA ON E640LCT.CODEMP = TEMP_E045PLA.CODEMP AND
                                 E640LCT.CTACRE = TEMP_E045PLA.ROOT_CTARED
           WHERE E640LCT.CODEMP = $1 AND
                 E640LCT.CODFIL = $2 AND
                 E640LCT.SITLCT = 2 AND
                 E640LCT.CTACRE <> 0 AND
                 (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3) AND
                 E640LCT.DATLCT >= $3 AND
                 E640LCT.DATLCT <= $4
        GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''month'', E640LCT.DATLCT),
                 TEMP_E045PLA.CTARED, TEMP_E045PLA.CLACTA, TEMP_E045PLA.QTDPOS, TEMP_E045PLA.ANASIN'
  USING V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;
  RAISE NOTICE 'INCLUÍNDO NA TABELA TEMP_CRE';

  RAISE NOTICE 'PASSO 6 (PREPARANDO MOVIMENTOS...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

  EXECUTE 
    'INSERT INTO TEMP_MOV
          SELECT TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, TEMP_TABLE.CTARED, TEMP_TABLE.CLACTA, 
		         SUM(TEMP_TABLE.DEBMES) AS DEBMES, SUM(TEMP_TABLE.CREMES) AS CREMES, SUM(TEMP_TABLE.SALMES) AS SALMES, 
				 TEMP_TABLE.QTDPOS, TEMP_TABLE.ANASIN, SUM(TEMP_TABLE.SALANT) AS SALANT
           FROM (
                 SELECT CODEMP, CODFIL, $1 AS MESANO, CTARED, CLACTA, 0 AS DEBMES, 
                        0 AS CREMES, 0 AS SALMES, QTDPOS, ANASIN, SALMES AS SALANT
                   FROM E650SAL
                  WHERE CODEMP = $2 AND
                        CODFIL = $3 AND
                        MESANO = $4 - INTERVAL ''1 month''
                  UNION 
                 SELECT COALESCE(DEB.CODEMP, CRE.CODEMP) AS CODEMP, COALESCE(DEB.CODFIL, CRE.CODFIL) AS CODFIL, 
                        COALESCE(DEB.MESANO, CRE.MESANO) AS MESANO, COALESCE(DEB.CTARED, CRE.CTARED) AS CTARED, 
                        COALESCE(DEB.CLACTA, CRE.CLACTA) AS CLACTA, COALESCE(DEB.SOMA, 0) AS DEBMES, 
                        COALESCE(CRE.SOMA, 0) AS CREMES, COALESCE(DEB.SOMA, 0) - COALESCE(CRE.SOMA, 0) AS SALMES, 
                        COALESCE(DEB.QTDPOS, CRE.QTDPOS) AS QTDPOS, COALESCE(DEB.ANASIN, CRE.ANASIN) AS ANASIN, 
                        0 AS SALANT
                   FROM TEMP_DEB DEB
        FULL OUTER JOIN TEMP_CRE CRE ON DEB.CODEMP = CRE.CODEMP AND
                                        DEB.CODFIL = CRE.CODFIL AND
                                        DEB.MESANO = CRE.MESANO AND
                                        DEB.CTARED = CRE.CTARED
                  UNION
                 SELECT CODEMP, $5 AS CODFIL, $6 AS MESANO, CTARED, CLACTA, 0 AS DEBMES, 
                        0 AS CREMES, 0 AS SALMES, QTDPOS, ANASIN, 0 AS SALANT 
                   FROM E045PLA 
                  WHERE CODEMP = $7 
                ) AS TEMP_TABLE
        GROUP BY TEMP_TABLE.CODEMP, TEMP_TABLE.CODFIL, TEMP_TABLE.MESANO, TEMP_TABLE.CTARED, TEMP_TABLE.CLACTA, 
	             TEMP_TABLE.QTDPOS, TEMP_TABLE.ANASIN'
  USING V_MESINI, V_CODEMP, V_CODFIL, V_MESINI, V_CODFIL, V_MESINI, V_CODEMP;
  RAISE NOTICE 'INCLUÍNDO NA TABELA TEMP_MOV';

  RAISE NOTICE 'PASSO 7 (EXCLUINDO MOVIMENTAÇÕES ANTERIOES...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

  EXECUTE 
    'INSERT INTO TEMP_RTO
          SELECT E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                 E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                 E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC
            FROM E650SAL
 LEFT OUTER JOIN E650RTO ON E650RTO.CODEMP = E650SAL.CODEMP AND 
                            E650RTO.CODFIL = E650SAL.CODFIL AND 
                            E650RTO.CTARED = E650SAL.CTARED AND 
                            E650RTO.MESANO = E650SAL.MESANO
           WHERE E650SAL.MESANO BETWEEN $1 AND $2 AND
                 E650SAL.CODFIL = $3 AND
                 E650SAL.CODEMP = $4 AND 
                 (E650SAL.VLRORC <> 0 OR E650RTO.VLRRAT <> 0 OR E650RTO.SALMES <> 0)
        GROUP BY E650SAL.CODEMP, E650SAL.CODFIL, E650SAL.MESANO, E650SAL.CTARED, 
                 E650RTO.CODCCU, E650RTO.CTAFIN, E650RTO.SALMES, E650RTO.VLRRAT, 
                 E650RTO.PERRAT, E650RTO.DATGER, E650RTO.SEQOBS, E650SAL.VLRORC'
  USING V_MESINI, V_MESFIM, V_CODFIL, V_CODEMP;
  RAISE NOTICE 'INCLUÍNDO NA TABELA TEMP_RTO';

  EXECUTE 'DELETE FROM E650RTO WHERE CODEMP = $1 AND CODFIL = $2 AND MESANO = $3' 
    USING V_CODEMP, V_CODFIL, V_MESINI;
  RAISE NOTICE 'DELETADO NA TABELA E650RTO';

  EXECUTE 'DELETE FROM E650SAL WHERE CODEMP = $1 AND CODFIL = $2 AND MESANO = $3' 
    USING V_CODEMP, V_CODFIL, V_MESINI;
  RAISE NOTICE 'DELETADO NA TABELA E650SAL';

  RAISE NOTICE 'PASSO 8 (INCLUINDO NOVAS MOVIMENTAÇÕES...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

  EXECUTE 
    'INSERT INTO E650SAL 
          SELECT TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                 TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, 0, 0, TEMP_MOV.DEBMES, 
                 TEMP_MOV.CREMES, TEMP_MOV.DEBMES - TEMP_MOV.CREMES + TEMP_MOV.SALANT AS SALMES, 
                 COALESCE(TEMP_RTO.VLRORC, 0) AS VLRORC
            FROM TEMP_MOV 
       LEFT JOIN TEMP_RTO ON TEMP_RTO.CODEMP = TEMP_MOV.CODEMP AND 
                             TEMP_RTO.CODFIL = TEMP_MOV.CODFIL AND 
                             TEMP_RTO.CTARED = TEMP_MOV.CTARED AND 
                             TEMP_RTO.MESANO = TEMP_MOV.MESANO 
           WHERE TEMP_MOV.CODEMP = $1 AND
                 TEMP_MOV.CODFIL = $2 AND
                 TEMP_MOV.MESANO = $3 AND
                 (TEMP_MOV.DEBMES <> 0 OR TEMP_MOV.CREMES <> 0 OR TEMP_MOV.SALANT <> 0 OR TEMP_RTO.VLRORC <> 0)
        GROUP BY TEMP_MOV.CODEMP, TEMP_MOV.CODFIL, TEMP_MOV.MESANO, TEMP_MOV.CTARED, 
                 TEMP_MOV.CLACTA, TEMP_MOV.ANASIN, TEMP_MOV.QTDPOS, TEMP_MOV.DEBMES, 
                 TEMP_MOV.CREMES, TEMP_MOV.SALANT, TEMP_RTO.VLRORC' 
  USING V_CODEMP, V_CODFIL, V_MESINI;
  RAISE NOTICE 'INCLUÍNDO NA TABELA E650SAL';

  EXECUTE 
    'INSERT INTO E650RTO 
          SELECT TEMP_RTO.CODEMP, TEMP_RTO.CODFIL, TEMP_RTO.MESANO, TEMP_RTO.CTARED, 
                 TEMP_RTO.CODCCU, TEMP_RTO.CTAFIN, TEMP_RTO.SALMES, TEMP_RTO.VLRRAT, 
                 TEMP_RTO.PERRAT, TEMP_RTO.DATGER, TEMP_RTO.SEQOBS 
            FROM TEMP_RTO
           WHERE TEMP_RTO.CODEMP = $1 AND 
                 TEMP_RTO.CODFIL = $2 AND 
                 TEMP_RTO.MESANO BETWEEN $3 AND $4 AND 
                 TEMP_RTO.CODCCU IS NOT NULL' 
  USING V_CODEMP, V_CODFIL, V_MESINI, V_MESFIM;
  RAISE NOTICE 'INCLUÍNDO NA TABELA E650RTO';

  RAISE NOTICE 'PASSO 9 (FINALIZANDO...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  
  EXCEPTION
  WHEN OTHERS THEN
    RAISE;
END;
$BODY$;
␀­ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
APROCEDURE SP_SALDOCTB_PREP(V_CODEMP NUMBER)
 IS
BEGIN
  NULL;
END	ORACLE;0
Ä␀␀CREATE OR REPLACE PROCEDURE SP_SALDOCTB_PREP
(
	V_CODEMP IN NUMBER)
AS 
  V_COUNT NUMBER;
BEGIN
	
  DBMS_OUTPUT.PUT_LINE('PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMP_E045PLA';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMP_E045PLA';
  ELSE  
    EXECUTE IMMEDIATE 
      'CREATE GLOBAL TEMPORARY TABLE TEMP_E045PLA 
       (CODEMP NUMBER(4,0)  NOT NULL, 
        CTARED NUMBER(7,0)  NOT NULL, 
        ROOT_CTARED NUMBER(7,0)  NOT NULL, 
        CLACTA VARCHAR2(30 BYTE)  NOT NULL, 
        NIVCTA NUMBER(2,0)  NOT NULL, 
        QTDPOS NUMBER(1,0)  NOT NULL, 
        ANASIN VARCHAR2(1 BYTE) NOT NULL) ON COMMIT PRESERVE ROWS';
    
    EXECUTE IMMEDIATE 'CREATE INDEX TEMP_E045PLAINDICE1 ON TEMP_E045PLA (CODEMP, ROOT_CTARED)';	
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMP_CRE';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMP_CRE';
  ELSE  
    EXECUTE IMMEDIATE 
      'CREATE GLOBAL TEMPORARY TABLE TEMP_CRE 
       (CODEMP NUMBER(4,0) NOT NULL, 
        CODFIL NUMBER(5,0) NOT NULL, 
        MESANO DATE NOT NULL, 
        CTARED NUMBER(7,0) NOT NULL, 
        CLACTA VARCHAR2(30 BYTE) NOT NULL, 
        SOMA NUMBER(17,2), 
        QTDPOS NUMBER(1,0) NOT NULL, 
        ANASIN VARCHAR2(1 BYTE) NOT NULL) ON COMMIT DELETE ROWS';
    
    EXECUTE IMMEDIATE  'CREATE INDEX TEMP_CREINDICE1 ON TEMP_CRE (CODEMP, CODFIL, MESANO, CTARED)';
  END IF;
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMP_RTO';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMP_RTO';
  ELSE  
    EXECUTE IMMEDIATE 
      'CREATE GLOBAL TEMPORARY TABLE TEMP_RTO
      (CODEMP NUMBER(4,0) NOT NULL, 
       CODFIL NUMBER(5,0) NOT NULL, 
       MESANO DATE NOT NULL, 
       CTARED NUMBER(7,0) NOT NULL, 
       CODCCU VARCHAR2(9), 
       CTAFIN NUMBER(7,0),  
       SALMES NUMBER(17,2), 
       VLRRAT NUMBER(17,2), 
       PERRAT NUMBER(7,4), 
       DATGER DATE, 
       SEQOBS NUMBER(8,0),
       VLRORC NUMBER(17,2) ) ON COMMIT DELETE ROWS'; 
       
    EXECUTE IMMEDIATE 'CREATE INDEX TEMP_RTOINDICE1 ON TEMP_RTO (CODEMP, CODFIL, MESANO, CTARED, CODCCU, CTAFIN)';
  END IF;

  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMP_DEB';
  IF V_COUNT       > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMP_DEB';
  ELSE  
    EXECUTE IMMEDIATE 
      'CREATE GLOBAL TEMPORARY TABLE TEMP_DEB 
       (CODEMP NUMBER(4,0) NOT NULL, 
        CODFIL NUMBER(5,0) NOT NULL, 
        MESANO DATE NOT NULL, 
        CTARED NUMBER(7,0) NOT NULL, 
        CLACTA VARCHAR2(30 BYTE) NOT NULL, 
        SOMA NUMBER(17,2), 
        QTDPOS NUMBER(1,0) NOT NULL, 
        ANASIN VARCHAR2(1 BYTE) NOT NULL) ON COMMIT DELETE ROWS';

    EXECUTE IMMEDIATE 'CREATE INDEX TEMP_DEBINDICE1 ON TEMP_DEB (CODEMP, CODFIL, MESANO, CTARED)';	
  END IF;

  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'TEMP_MOV';
  IF V_COUNT       > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE TEMP_MOV';
  ELSE   
    EXECUTE IMMEDIATE  
      'CREATE GLOBAL TEMPORARY TABLE TEMP_MOV 
       (CODEMP NUMBER(4,0) NOT NULL, 
        CODFIL NUMBER(5,0) NOT NULL, 
        MESANO DATE NOT NULL, 
        CTARED NUMBER(7,0) NOT NULL, 
        CLACTA VARCHAR2(30 BYTE) NOT NULL, 
        DEBMES NUMBER(17,2), 
        CREMES NUMBER(17,2), 
        MOVMES NUMBER(17,2), 
        QTDPOS NUMBER(1,0) NOT NULL, 
        ANASIN VARCHAR2(1 BYTE) NOT NULL,
        SALANT NUMBER(17,2)) ON COMMIT DELETE ROWS';
   
    EXECUTE IMMEDIATE 'CREATE INDEX TEMP_MOVINDICE1 ON TEMP_MOV (CODEMP, CODFIL, MESANO, CTARED)'; 
  END IF;
  
  DBMS_OUTPUT.PUT_LINE('PASSO 2 (PREPARANDO PLANO CONTABIL...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));

  FOR C_PLA IN (SELECT CODEMP, CTARED FROM E045PLA WHERE CODEMP = V_CODEMP ORDER BY CTARED )
  LOOP
    EXECUTE IMMEDIATE
      'INSERT INTO TEMP_E045PLA ( CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS, ANASIN )
       SELECT E045PLA2.CODEMP CODEMP, E045PLA2.CTARED CTARED, E045PLA3.CTARED
              ROOT_CTARED, E045PLA2.CLACTA CLACTA, E045PLA2.NIVCTA NIVCTA,
              E045PLA2.QTDPOS, E045PLA2.ANASIN
         FROM E045PLA E045PLA2, 
            (SELECT CODEMP, CTARED
               FROM E045PLA
              WHERE E045PLA.CODEMP = :1 AND
                    E045PLA.CTARED = :2) E045PLA3
        WHERE E045PLA2.CODEMP = E045PLA3.CODEMP
		START WITH E045PLA2.CODEMP = E045PLA3.CODEMP AND
				   E045PLA2.CTARED = E045PLA3.CTARED
	 CONNECT BY PRIOR E045PLA2.CODEMP = E045PLA2.CODEMP AND
	            PRIOR E045PLA2.NIVCTA -1 = E045PLA2.NIVCTA AND
	            PRIOR SUBSTR(TO_CHAR(E045PLA2.CLACTA),1,LENGTH(E045PLA2.CLACTA)- E045PLA2.QTDPOS) = E045PLA2.CLACTA
       ORDER SIBLINGS BY E045PLA2.CLACTA' 
       USING IN C_PLA.CODEMP, C_PLA.CTARED;    
  END LOOP;  
  
  DBMS_OUTPUT.PUT_LINE('PASSO 3 (CONCLUSÃO PLANO DE CONTAS...)'|| to_number(TO_CHAR(sys_extract_utc(systimestamp), 'SSSSSFF3')));

EXCEPTION
WHEN OTHERS THEN
  ROLLBACK;
  RAISE;  
END SP_SALDOCTB_PREP;	MSSQL;0
ó␀␀CREATE PROCEDURE SP_SALDOCTB_PREP (
  @V_CODEMP FLOAT
)
AS
BEGIN
  DECLARE @V_COUNT BIGINT;
  DECLARE @V_CTARED INT;

  PRINT 'PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...)' + CONVERT(VARCHAR, GETDATE(), 109);

  -- TEMP_E045PLA
  SELECT @V_COUNT = COUNT(1) FROM sys.tables WHERE name = 'TEMP_E045PLA';
  IF @V_COUNT > 0
  BEGIN
    TRUNCATE TABLE TEMP_E045PLA;
  END
  ELSE
  BEGIN
    EXEC sp_executesql N'
    CREATE TABLE TEMP_E045PLA 
    (
      CODEMP SMALLINT NOT NULL, 
      CTARED INT NOT NULL, 
      ROOT_CTARED INT NOT NULL, 
      CLACTA VARCHAR(30) NOT NULL, 
      NIVCTA SMALLINT NOT NULL, 
      QTDPOS SMALLINT NOT NULL, 
      ANASIN VARCHAR(1) NOT NULL
    );

    CREATE INDEX TEMP_E045PLAINDICE1 ON TEMP_E045PLA (CODEMP, ROOT_CTARED);';
  END

  -- TEMP_CRE
  SELECT @V_COUNT = COUNT(1) FROM sys.tables WHERE name = 'TEMP_CRE';
  IF @V_COUNT > 0
  BEGIN
    TRUNCATE TABLE TEMP_CRE;
  END
  ELSE
  BEGIN
    EXEC sp_executesql N'
    CREATE TABLE TEMP_CRE 
    (
      CODEMP SMALLINT NOT NULL, 
      CODFIL SMALLINT NOT NULL, 
      MESANO DATETIME NOT NULL, 
      CTARED INT NOT NULL, 
      CLACTA VARCHAR(30) NOT NULL, 
      SOMA NUMERIC(17, 2), 
      QTDPOS SMALLINT NOT NULL, 
      ANASIN VARCHAR(1) NOT NULL
    );

    CREATE INDEX TEMP_CREINDICE1 ON TEMP_CRE (CODEMP, CODFIL, MESANO, CTARED);';
  END

  -- TEMP_RTO
  SELECT @V_COUNT = COUNT(1) FROM sys.tables WHERE name = 'TEMP_RTO';
  IF @V_COUNT > 0
  BEGIN
    TRUNCATE TABLE TEMP_RTO;
  END
  ELSE
  BEGIN
    EXEC sp_executesql N'
    CREATE TABLE TEMP_RTO
    (
      CODEMP SMALLINT NOT NULL, 
      CODFIL SMALLINT NOT NULL, 
      MESANO DATETIME NOT NULL, 
      CTARED INT NOT NULL, 
      CODCCU VARCHAR(9), 
      CTAFIN INT,  
      SALMES NUMERIC(17, 2), 
      VLRRAT NUMERIC(17, 2), 
      PERRAT NUMERIC(7, 4), 
      DATGER DATE, 
      SEQOBS INT,
      VLRORC NUMERIC(17, 2)
    );

    CREATE INDEX TEMP_RTOINDICE1 ON TEMP_RTO (CODEMP, CODFIL, MESANO, CTARED, CODCCU, CTAFIN);';
  END

  -- TEMP_DEB
  SELECT @V_COUNT = COUNT(1) FROM sys.tables WHERE name = 'TEMP_DEB';
  IF @V_COUNT > 0
  BEGIN
    TRUNCATE TABLE TEMP_DEB;
  END
  ELSE
  BEGIN
    EXEC sp_executesql N'
    CREATE TABLE TEMP_DEB 
    (
      CODEMP SMALLINT NOT NULL, 
      CODFIL INT NOT NULL, 
      MESANO DATETIME NOT NULL, 
      CTARED INT NOT NULL, 
      CLACTA VARCHAR(30) NOT NULL, 
      SOMA NUMERIC(17, 2), 
      QTDPOS INT NOT NULL, 
      ANASIN VARCHAR(1) NOT NULL
    );

    CREATE INDEX TEMP_DEBINDICE1 ON TEMP_DEB (CODEMP, CODFIL, MESANO, CTARED);';
  END

  -- TEMP_MOV
  SELECT @V_COUNT = COUNT(1) FROM sys.tables WHERE name = 'TEMP_MOV';
  IF @V_COUNT > 0
  BEGIN
    TRUNCATE TABLE TEMP_MOV;
  END
  ELSE
  BEGIN
    EXEC sp_executesql N'
    CREATE TABLE TEMP_MOV 
    (
      CODEMP SMALLINT NOT NULL, 
      CODFIL SMALLINT NOT NULL, 
      MESANO DATETIME NOT NULL, 
      CTARED INT NOT NULL, 
      CLACTA VARCHAR(30) NOT NULL, 
      DEBMES NUMERIC(17, 2), 
      CREMES NUMERIC(17, 2), 
      MOVMES NUMERIC(17, 2), 
      QTDPOS SMALLINT NOT NULL, 
      ANASIN VARCHAR(1) NOT NULL,
      SALANT NUMERIC(17, 2)
    );

    CREATE INDEX TEMP_MOVINDICE1 ON TEMP_MOV (CODEMP, CODFIL, MESANO, CTARED);';
  END

  PRINT 'PASSO 2 (PREPARANDO PLANO CONTABIL...)' + CONVERT(VARCHAR, GETDATE(), 109);

  DECLARE C_PLA_CURSOR CURSOR FOR
    SELECT CODEMP, CTARED 
    FROM E045PLA 
    WHERE CODEMP = @V_CODEMP 
    ORDER BY CTARED;

  OPEN C_PLA_CURSOR;

  FETCH NEXT FROM C_PLA_CURSOR INTO @V_CODEMP, @V_CTARED;
  WHILE @@FETCH_STATUS = 0
  BEGIN
    WITH CTE AS (
      SELECT E045PLA2.CODEMP, E045PLA2.CTARED, E045PLA2.CLACTA, E045PLA2.NIVCTA, E045PLA2.QTDPOS, 
             E045PLA2.ANASIN, E045PLA2.CLACTA AS ROOT_CLACTA, E045PLA2.CTARED AS ROOT_CTARED, 0 AS LEVEL
        FROM E045PLA E045PLA2
       WHERE E045PLA2.CODEMP = @V_CODEMP AND 
	         E045PLA2.CTARED = @V_CTARED
       UNION ALL
      SELECT E045PLA2.CODEMP, E045PLA2.CTARED, E045PLA2.CLACTA, E045PLA2.NIVCTA, E045PLA2.QTDPOS, 
             E045PLA2.ANASIN, CTE.ROOT_CLACTA, CTE.ROOT_CTARED, CTE.LEVEL + 1
        FROM E045PLA E045PLA2
  INNER JOIN CTE ON E045PLA2.CODEMP = CTE.CODEMP AND 
                    E045PLA2.NIVCTA = CTE.NIVCTA + 1 AND 
					E045PLA2.CLACTA LIKE CTE.CLACTA + '%'
    )
    INSERT INTO TEMP_E045PLA (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS, ANASIN)
         SELECT CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS, ANASIN
           FROM CTE;

    FETCH NEXT FROM C_PLA_CURSOR INTO @V_CODEMP, @V_CTARED;
  END

  CLOSE C_PLA_CURSOR;
  DEALLOCATE C_PLA_CURSOR;

  PRINT 'PASSO 3 (CONCLUSÃO PLANO DE CONTAS...)' + CONVERT(VARCHAR, GETDATE(), 109);
END
	POSTGRESQL;0
²␀␀CREATE OR REPLACE PROCEDURE SP_SALDOCTB_PREP(
    V_CODEMP IN NUMERIC)
LANGUAGE 'plpgsql'
AS $BODY$
  DECLARE
    V_COUNT INTEGER;
    C_PLA RECORD;
  BEGIN
    RAISE NOTICE 'PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

    SELECT COUNT(*) INTO V_COUNT 
	  FROM pg_tables 
	 WHERE UPPER(tablename) = 'TEMP_E045PLA';
	 
    IF V_COUNT > 0 THEN
        EXECUTE 'TRUNCATE TABLE TEMP_E045PLA';
    ELSE
        EXECUTE '
            CREATE TABLE TEMP_E045PLA (
                CODEMP INTEGER NOT NULL,
                CTARED INTEGER NOT NULL,
                ROOT_CTARED INTEGER NOT NULL,
                CLACTA VARCHAR(30) NOT NULL,
                NIVCTA INTEGER NOT NULL,
                QTDPOS INTEGER NOT NULL,
                ANASIN CHAR(1) NOT NULL
            )';
        
        EXECUTE 'CREATE INDEX TEMP_E045PLAINDICE1 ON TEMP_E045PLA (CODEMP, ROOT_CTARED)';
    END IF;

    SELECT COUNT(*) INTO V_COUNT 
	  FROM pg_tables 
     WHERE UPPER(tablename) = 'TEMP_CRE';
	 
    IF V_COUNT > 0 THEN
        EXECUTE 'TRUNCATE TABLE TEMP_CRE';
    ELSE
        EXECUTE '
            CREATE TABLE TEMP_CRE (
                CODEMP INTEGER NOT NULL,
                CODFIL INTEGER NOT NULL,
                MESANO DATE NOT NULL,
                CTARED INTEGER NOT NULL,
                CLACTA VARCHAR(30) NOT NULL,
                SOMA NUMERIC(17, 2),
                QTDPOS INTEGER NOT NULL,
                ANASIN CHAR(1) NOT NULL
            )';
        
        EXECUTE 'CREATE INDEX TEMP_CREINDICE1 ON TEMP_CRE (CODEMP, CODFIL, MESANO, CTARED)';
    END IF;

    SELECT COUNT(*) INTO V_COUNT 
	  FROM pg_tables 
	 WHERE UPPER(tablename) = 'TEMP_RTO';
	 
    IF V_COUNT > 0 THEN
        EXECUTE 'TRUNCATE TABLE TEMP_RTO';
    ELSE
        EXECUTE '
            CREATE TABLE TEMP_RTO (
                CODEMP INTEGER NOT NULL,
                CODFIL INTEGER NOT NULL,
                MESANO DATE NOT NULL,
                CTARED INTEGER NOT NULL,
                CODCCU VARCHAR(9),
                CTAFIN INTEGER,
                SALMES NUMERIC(17, 2),
                VLRRAT NUMERIC(17, 2),
                PERRAT NUMERIC(7, 4),
                DATGER DATE,
                SEQOBS INTEGER,
                VLRORC NUMERIC(17, 2)
            )';
        
        EXECUTE 'CREATE INDEX TEMP_RTOINDICE1 ON TEMP_RTO (CODEMP, CODFIL, MESANO, CTARED, CODCCU, CTAFIN)';
    END IF;

    SELECT COUNT(*) INTO V_COUNT 
	  FROM pg_tables 
     WHERE UPPER(tablename) = 'TEMP_DEB';
	 
    IF V_COUNT > 0 THEN
        EXECUTE 'TRUNCATE TABLE TEMP_DEB';
    ELSE
        EXECUTE '
            CREATE TABLE TEMP_DEB (
                CODEMP INTEGER NOT NULL,
                CODFIL INTEGER NOT NULL,
                MESANO DATE NOT NULL,
                CTARED INTEGER NOT NULL,
                CLACTA VARCHAR(30) NOT NULL,
                SOMA NUMERIC(17, 2),
                QTDPOS INTEGER NOT NULL,
                ANASIN CHAR(1) NOT NULL
            )';
        
        EXECUTE 'CREATE INDEX TEMP_DEBINDICE1 ON TEMP_DEB (CODEMP, CODFIL, MESANO, CTARED)';
    END IF;

    SELECT COUNT(*) INTO V_COUNT 
	  FROM pg_tables 
	 WHERE UPPER(tablename) = 'TEMP_MOV';
	 
    IF V_COUNT > 0 THEN
        EXECUTE 'TRUNCATE TABLE TEMP_MOV';
    ELSE
        EXECUTE '
            CREATE TABLE TEMP_MOV (
                CODEMP INTEGER NOT NULL,
                CODFIL INTEGER NOT NULL,
                MESANO DATE NOT NULL,
                CTARED INTEGER NOT NULL,
                CLACTA VARCHAR(30) NOT NULL,
                DEBMES NUMERIC(17, 2),
                CREMES NUMERIC(17, 2),
                MOVMES NUMERIC(17, 2),
                QTDPOS INTEGER NOT NULL,
                ANASIN CHAR(1) NOT NULL,
                SALANT NUMERIC(17, 2)
            )';
        
        EXECUTE 'CREATE INDEX TEMP_MOVINDICE1 ON TEMP_MOV (CODEMP, CODFIL, MESANO, CTARED)';
    END IF;

    RAISE NOTICE 'PASSO 2 (PREPARANDO PLANO CONTABIL...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');

    FOR C_PLA IN 
        SELECT CODEMP, CTARED FROM E045PLA WHERE CODEMP = V_CODEMP ORDER BY CTARED
    LOOP
        EXECUTE 'WITH RECURSIVE e045pla_cte AS (
         SELECT e2.codemp, e2.ctared, e3.ctared AS root_ctared, e2.clacta,
                e2.nivcta, e2.qtdpos, e2.anasin
         FROM e045pla e2
         JOIN (SELECT codemp, ctared
               FROM e045pla
               WHERE codemp = $1 AND ctared = $2) e3
           ON e2.codemp = e3.codemp
         WHERE e2.codemp = e3.codemp AND e2.ctared = e3.ctared
         UNION ALL
         SELECT e2.codemp, e2.ctared, e_cte.root_ctared, e2.clacta,
                e2.nivcta, e2.qtdpos, e2.anasin
         FROM e045pla e2
         JOIN e045pla_cte e_cte
           ON e2.codemp = e_cte.codemp
           AND e2.nivcta = e_cte.nivcta - 1
           AND SUBSTRING(e_cte.clacta FROM 1 FOR LENGTH(e_cte.clacta) - e_cte.qtdpos) = e2.clacta
      )
      INSERT INTO temp_e045pla (codemp, ctared, root_ctared, clacta, nivcta, qtdpos, anasin)
      SELECT codemp, ctared, root_ctared, clacta, nivcta, qtdpos, anasin
      FROM e045pla_cte
      ORDER BY clacta;' 
    USING c_pla.codemp, c_pla.ctared;
    END LOOP;

    RAISE NOTICE 'PASSO 3 (CONCLUSÃO PLANO DE CONTAS...) %', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  
    EXCEPTION
      WHEN OTHERS THEN
        RAISE;
  END;
$BODY$
;
