TRIGGER T640LCTAIE AFTER INSERT ON E640LCT FOR EACH ROW DECLARE
	WMESANO DATE;
	WNEWDEB NUMBER(7);
	WNEWCRE NUMBER(7);
BEGIN
	/* Monta a data do mês/ano em questão */
	WMESANO := DATETIME(01, MONTH(:NEW.DATLCT), YEAR(:NEW.DATLCT), 0, 0, 0);

	/*Caso o lançamento seja contabilizado (sitlct = 2), transfere os saldos*/
	IF (:NEW.SITLCT = 2) THEN
		SP_TRANSFSALDOSCTB(:NEW.CODEMP, :NEW.CODFIL, :NEW.DATLCT);
	END IF;

	/* Inicializa variáveis */
	WNEWDEB := IFNULL(:NEW.CTADEB, 0);
	WNEWCRE := IFNULL(:NEW.CTACRE, 0); 

	/* Somente lançamentos do tipo 2 (Contabilizado) atualizam saldo */
	IF (WNEWDEB <> 0) AND (:NEW.SITLCT = 2) THEN
		SP_ATUCONTAS(:NEW.CODEMP, :NEW.CODFIL, WMESANO, :NEW.CTADEB, :NEW.VLRLCT, 'D');
	END IF;

	IF (WNEWCRE <> 0) AND (:NEW.SITLCT = 2) THEN
		SP_ATUCONTAS(:NEW.CODEMP, :NEW.CODFIL, WMESANO, :NEW.CTACRE, :NEW.VLRLCT, 'C');
	END IF;

	IF (:NEW.NUMLOT > 0) THEN
		SP_ATULOTE(:NEW.CODEMP, :NEW.CODFIL, :NEW.NUMLOT, 0, WNEWDEB, 0, WNEWCRE, 0, :NEW.VLRLCT);
	END IF;
END␀ªþ␀␀	SENIOR;0=TRIGGER T640LCTAU AFTER UPDATE ON E640LCT
BEGIN
	NULL;
END	ORACLE;0Ç␀␀CREATE OR REPLACE TRIGGER T640LCTAU AFTER UPDATE ON E640LCT
DECLARE
  WMESANO_OLD DATE;
  WMESANO_NEW DATE;
  WVLRAUX NUMBER(17,2);
  WDIFLCT NUMBER(17,2);
  WOLDDEB NUMBER(10);
  WNEWDEB NUMBER(10);
  WOLDCRE NUMBER(10);
  WNEWCRE NUMBER(10);
BEGIN
WMESANO_OLD := TO_DATE('31/12/1900','DD/MM/YYYY HH24:MI:SS');
WMESANO_NEW := TO_DATE('31/12/1900','DD/MM/YYYY HH24:MI:SS');

FOR C_LCTOS IN
  ( SELECT OLD_CODEMP, OLD_TIPLCT, OLD_ORILCT, OLD_CODFIL, TRUNC(OLD_DATLCT, 'MM') OLD_DATLCT, OLD_CTADEB, OLD_CTACRE, OLD_NUMLOT, OLD_SITLCT, NEW_CODEMP, 
           NEW_TIPLCT, NEW_ORILCT, NEW_CODFIL, TRUNC(NEW_DATLCT, 'MM') NEW_DATLCT, NEW_CTADEB, NEW_CTACRE, NEW_NUMLOT, NEW_SITLCT, SUM(OLD_VLRLCT) OLD_VLRLCT, SUM(NEW_VLRLCT) NEW_VLRLCT
      FROM E640LCT_TMP
     GROUP BY OLD_CODEMP, OLD_TIPLCT, OLD_ORILCT, OLD_CODFIL, TRUNC(OLD_DATLCT, 'MM'), OLD_CTADEB, OLD_CTACRE, OLD_NUMLOT, OLD_SITLCT, NEW_CODEMP, 
              NEW_TIPLCT, NEW_ORILCT, NEW_CODFIL, TRUNC(NEW_DATLCT, 'MM'), NEW_CTADEB, NEW_CTACRE, NEW_NUMLOT, NEW_SITLCT
  )
  LOOP       
    IF (C_LCTOS.NEW_SITLCT=2) AND (C_LCTOS.OLD_SITLCT<>2) AND (C_LCTOS.NEW_DATLCT <> WMESANO_NEW) THEN
      SP_TRANSFSALDOSCTB(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_DATLCT);
    END IF;

    WMESANO_OLD := C_LCTOS.OLD_DATLCT;  
    WMESANO_NEW := C_LCTOS.NEW_DATLCT;
    WOLDDEB := NVL(C_LCTOS.OLD_CTADEB,0);
    WNEWDEB := NVL(C_LCTOS.NEW_CTADEB,0);
    WOLDCRE := NVL(C_LCTOS.OLD_CTACRE,0);
    WNEWCRE := NVL(C_LCTOS.NEW_CTACRE,0);

    IF (C_LCTOS.OLD_SITLCT  =1) AND (C_LCTOS.NEW_SITLCT=1) THEN
      IF (C_LCTOS.NEW_NUMLOT>0) THEN
        SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,WOLDDEB,WNEWDEB,WOLDCRE,WNEWCRE,C_LCTOS.OLD_VLRLCT,C_LCTOS.NEW_VLRLCT);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=1) AND (C_LCTOS.NEW_SITLCT=2) THEN
      WDIFLCT        := C_LCTOS.NEW_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=1) AND (C_LCTOS.NEW_SITLCT=3) THEN
      IF (C_LCTOS.NEW_NUMLOT >0) THEN
        SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,WOLDDEB,0,WOLDCRE,0,C_LCTOS.OLD_VLRLCT,0);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=2) AND (C_LCTOS.NEW_SITLCT=1) THEN
      WDIFLCT        := -C_LCTOS.OLD_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT =2) AND (C_LCTOS.NEW_SITLCT=2) THEN
      IF (WOLDDEB     <>0) AND (WOLDDEB<>WNEWDEB) THEN
        WVLRAUX := (C_LCTOS.OLD_VLRLCT*-1);
        SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDDEB,WVLRAUX,'D');
      END IF;
      IF (WOLDCRE     <>0) AND (WOLDCRE<>WNEWCRE) THEN
        WVLRAUX := (C_LCTOS.OLD_VLRLCT*-1);
        SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDCRE,WVLRAUX,'C');
      END IF;
      IF (C_LCTOS.OLD_CODFIL<>C_LCTOS.NEW_CODFIL) THEN
        WVLRAUX      := (C_LCTOS.OLD_VLRLCT*-1);
        IF (WOLDDEB  <>0) AND (WOLDDEB=WNEWDEB) THEN
          SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDDEB,WVLRAUX,'D');
        END IF;
        IF (WOLDCRE<>0) AND (WOLDCRE=WNEWCRE) THEN
          SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDCRE,WVLRAUX,'C');
        END IF;
      END IF;
      IF (WNEWDEB  <>0) THEN
        WDIFLCT    := C_LCTOS.NEW_VLRLCT;
        IF ((WOLDDEB=WNEWDEB) AND (C_LCTOS.OLD_CODFIL=C_LCTOS.NEW_CODFIL)) THEN
          WDIFLCT  := C_LCTOS.NEW_VLRLCT-C_LCTOS.OLD_VLRLCT;
        END IF;
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE  <>0) THEN
        WDIFLCT    := C_LCTOS.NEW_VLRLCT;
        IF ((WOLDCRE=WNEWCRE) AND (C_LCTOS.OLD_CODFIL=C_LCTOS.NEW_CODFIL)) THEN
          WDIFLCT  := C_LCTOS.NEW_VLRLCT-C_LCTOS.OLD_VLRLCT;
        END IF;
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=2) AND (C_LCTOS.NEW_SITLCT=3) THEN
      WDIFLCT        := -C_LCTOS.OLD_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWCRE,WDIFLCT,'C');
      END IF;
      IF (C_LCTOS.NEW_NUMLOT>0) THEN
        SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,WOLDDEB,0,WOLDCRE,0,C_LCTOS.OLD_VLRLCT,0);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=3) AND (C_LCTOS.NEW_SITLCT=1) THEN
      IF (C_LCTOS.NEW_NUMLOT >0) THEN
        SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,0,WNEWDEB,0,WNEWCRE,0,C_LCTOS.NEW_VLRLCT);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=2) AND (C_LCTOS.NEW_SITLCT=4) THEN
      WDIFLCT        := -C_LCTOS.OLD_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=4) AND (C_LCTOS.NEW_SITLCT=2) THEN
      WDIFLCT        := C_LCTOS.NEW_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWCRE,WDIFLCT,'C');
      END IF;
    END IF;    
  END LOOP;    
  
  DELETE FROM E640LCT_TMP;
END;	MSSQL;0c6␀␀CREATE TRIGGER T640LCTAU ON E640LCT FOR UPDATE AS 
BEGIN

DECLARE @OLD_CODEMP SMALLINT
DECLARE @OLD_TIPLCT SMALLINT
DECLARE @OLD_ORILCT VARCHAR(3)
DECLARE @OLD_CODFIL INTEGER
DECLARE @OLD_DATLCT DATETIME
DECLARE @OLD_CTADEB INTEGER
DECLARE @OLD_CTACRE INTEGER
DECLARE @OLD_VLRLCT NUMERIC(17, 2)
DECLARE @OLD_NUMLOT INTEGER
DECLARE @OLD_SITLCT SMALLINT
DECLARE @NEW_CODEMP SMALLINT
DECLARE @NEW_TIPLCT SMALLINT
DECLARE @NEW_ORILCT VARCHAR(3)
DECLARE @NEW_CODFIL SMALLINT
DECLARE @NEW_DATLCT DATETIME
DECLARE @NEW_CTADEB INTEGER
DECLARE @NEW_CTACRE INTEGER
DECLARE @NEW_VLRLCT NUMERIC(17, 2)
DECLARE @NEW_NUMLOT INTEGER
DECLARE @NEW_SITLCT SMALLINT
DECLARE CUR_E640LCT_UPD CURSOR FOR SELECT 
      OLD.CODEMP O_CODEMP, OLD.TIPLCT O_TIPLCT, OLD.ORILCT O_ORILCT, OLD.CODFIL O_CODFIL,
	  CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,OLD.DATLCT))+'/'+CONVERT(VARCHAR,01)+'/'+CONVERT(VARCHAR,DATEPART(YY,OLD.DATLCT))+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)) O_DATLCT,
	  OLD.CTADEB O_CTADEB, OLD.CTACRE O_CTACRE, OLD.NUMLOT O_NUMLOT, OLD.SITLCT O_SITLCT,
      NEW.CODEMP N_CODEMP, NEW.TIPLCT N_TIPLCT, NEW.ORILCT N_ORILCT, NEW.CODFIL N_CODFIL,
	  CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,NEW.DATLCT))+'/'+CONVERT(VARCHAR,01)+'/'+CONVERT(VARCHAR,DATEPART(YY,NEW.DATLCT))+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)) N_DATLCT,
	  NEW.CTADEB N_CTADEB, NEW.CTACRE N_CTACRE, NEW.NUMLOT N_NUMLOT, NEW.SITLCT N_SITLCT,
      SUM(OLD.VLRLCT) O_VLRLCT, SUM(NEW.VLRLCT) N_VLRLCT
      FROM DELETED OLD
INNER JOIN INSERTED NEW
    ON NEW.CODEMP = OLD.CODEMP AND
	   NEW.NUMLCT = OLD.NUMLCT
GROUP BY
      OLD.CODEMP, OLD.TIPLCT, OLD.ORILCT, OLD.CODFIL, 
	  CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,OLD.DATLCT))+'/'+CONVERT(VARCHAR,01)+'/'+CONVERT(VARCHAR,DATEPART(YY,OLD.DATLCT))+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)),
	  OLD.CTADEB, OLD.CTACRE, OLD.NUMLOT, OLD.SITLCT,
      NEW.CODEMP, NEW.TIPLCT, NEW.ORILCT, NEW.CODFIL,
	  CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,NEW.DATLCT))+'/'+CONVERT(VARCHAR,01)+'/'+CONVERT(VARCHAR,DATEPART(YY,NEW.DATLCT))+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)),
      NEW.CTADEB, NEW.CTACRE, NEW.NUMLOT, NEW.SITLCT;

DECLARE @WMESANO DATETIME
DECLARE @WVLRAUX FLOAT
DECLARE @WDIFLCT FLOAT
DECLARE @WOLDDEB BIGINT
DECLARE @WNEWDEB BIGINT
DECLARE @WOLDCRE BIGINT
DECLARE @WNEWCRE BIGINT
  DECLARE @CHKERROR INTEGER
SAVE TRANSACTION TR_E640LCTAU
  SELECT @CHKERROR = 0
  OPEN CUR_E640LCT_UPD
  SELECT @CHKERROR = @@ERROR
  IF @CHKERROR <> 0
  BEGIN
    CLOSE CUR_E640LCT_UPD
    DEALLOCATE CUR_E640LCT_UPD
    GOTO FIM
  END
  SELECT @CHKERROR = @@ERROR
  IF @CHKERROR <> 0
  BEGIN
    CLOSE CUR_E640LCT_UPD
    DEALLOCATE CUR_E640LCT_UPD
    GOTO FIM
  END
  FETCH NEXT FROM CUR_E640LCT_UPD INTO 
@OLD_CODEMP, @OLD_TIPLCT, @OLD_ORILCT, @OLD_CODFIL, @OLD_DATLCT, @OLD_CTADEB, @OLD_CTACRE,
@OLD_NUMLOT, @OLD_SITLCT,  
@NEW_CODEMP, @NEW_TIPLCT, @NEW_ORILCT, @NEW_CODFIL, @NEW_DATLCT, @NEW_CTADEB, @NEW_CTACRE,
@NEW_NUMLOT, @NEW_SITLCT,  
@OLD_VLRLCT, @NEW_VLRLCT
  WHILE (@@FETCH_STATUS = 0)
  BEGIN
    IF ((@OLD_ORILCT<>@NEW_ORILCT) 
      OR (@OLD_CODFIL<>@NEW_CODFIL) 
      OR (@OLD_DATLCT=@NEW_DATLCT) 
      OR (@OLD_CTADEB<>@NEW_CTADEB) 
      OR (@OLD_CTACRE<>@NEW_CTACRE) 
      OR (@OLD_VLRLCT=@NEW_VLRLCT) 
      OR (@OLD_NUMLOT<>@NEW_NUMLOT) 
      OR (@OLD_SITLCT<>@NEW_SITLCT) 
      OR (@OLD_TIPLCT<>@NEW_TIPLCT))
    BEGIN	  
      IF (@OLD_TIPLCT<>@NEW_TIPLCT)
      BEGIN
        BEGIN
          RAISERROR('TRIGGER: O TIPO DE LANÇAMENTO NÃO PODE SER ALTERADO',11,1) WITH SETERROR
          CLOSE CUR_E640LCT_UPD
          DEALLOCATE CUR_E640LCT_UPD
          SELECT @CHKERROR = -30
          GOTO FIM
        END
      END
      SELECT @WMESANO = @OLD_DATLCT
      SELECT @WOLDDEB = ISNULL(@OLD_CTADEB,0)
      SELECT @WNEWDEB = ISNULL(@NEW_CTADEB,0)
      SELECT @WOLDCRE = ISNULL(@OLD_CTACRE,0)
      SELECT @WNEWCRE = ISNULL(@NEW_CTACRE,0)
      IF (@OLD_TIPLCT=2)
      BEGIN
        BEGIN
          RAISERROR('TRIGGER: ALTERAÇÃO NÃO PERMITIDA PARA LANÇAMENTO GERENCIAL (TIPO = 2)',11,1) WITH SETERROR
          CLOSE CUR_E640LCT_UPD
          DEALLOCATE CUR_E640LCT_UPD
          SELECT @CHKERROR = -30
          GOTO FIM
        END
      END
      IF (@OLD_SITLCT=3) 
      AND (@NEW_SITLCT=2)
      BEGIN
        BEGIN
          RAISERROR('TRIGGER: ALTERAÇÃO DE SITUAÇÃO DE EXCLUÍDO PARA CONTABILIZADO NÃO É PERMITIDO',11,1) WITH SETERROR
          CLOSE CUR_E640LCT_UPD
          DEALLOCATE CUR_E640LCT_UPD
          SELECT @CHKERROR = -30
          GOTO FIM
        END
      END
      IF (@OLD_NUMLOT<>@NEW_NUMLOT)
      BEGIN
        BEGIN
          RAISERROR('TRIGGER: ALTERAÇÃO DE NÚMERO DO LOTE NÃO É PERMITIDO',11,1) WITH SETERROR
          CLOSE CUR_E640LCT_UPD
          DEALLOCATE CUR_E640LCT_UPD
          SELECT @CHKERROR = -30
          GOTO FIM
        END
      END
      IF (@NEW_SITLCT=2) 
      AND (@OLD_SITLCT<>2)
      BEGIN
        EXECUTE  @CHKERROR = SP_TRANSFSALDOSCTB @NEW_CODEMP,@NEW_CODFIL,@NEW_DATLCT 
        IF @CHKERROR <> 0
        BEGIN
          CLOSE CUR_E640LCT_UPD
          DEALLOCATE CUR_E640LCT_UPD
          GOTO FIM
        END
      END
      IF (@OLD_SITLCT=1) 
      AND (@NEW_SITLCT=1)
      BEGIN
        IF (@NEW_NUMLOT>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATULOTE @NEW_CODEMP,@NEW_CODFIL,@NEW_NUMLOT,@WOLDDEB,@WNEWDEB,@WOLDCRE,@WNEWCRE,@OLD_VLRLCT,@NEW_VLRLCT 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=1) 
      AND (@NEW_SITLCT=2)
      BEGIN
        SELECT @WDIFLCT = @NEW_VLRLCT
        IF (@WNEWDEB<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=1) 
      AND (@NEW_SITLCT=3)
      BEGIN
        IF (@NEW_NUMLOT>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATULOTE @NEW_CODEMP,@NEW_CODFIL,@NEW_NUMLOT,@WOLDDEB,0,@WOLDCRE,0,@OLD_VLRLCT,0 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=2) 
      AND (@NEW_SITLCT=1)
      BEGIN
        SELECT @WDIFLCT = -@OLD_VLRLCT
        IF (@WNEWDEB<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=2) 
      AND (@NEW_SITLCT=2)
      BEGIN
        IF (@WOLDDEB<>0) 
      AND (@WOLDDEB<>@WNEWDEB)
        BEGIN
          SELECT @WVLRAUX = (@OLD_VLRLCT*-1)
          EXECUTE  @CHKERROR = SP_ATUCONTAS @OLD_CODEMP,@OLD_CODFIL,@WMESANO,@WOLDDEB,@WVLRAUX,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WOLDCRE<>0) 
      AND (@WOLDCRE<>@WNEWCRE)
        BEGIN
          SELECT @WVLRAUX = (@OLD_VLRLCT*-1)
          EXECUTE  @CHKERROR = SP_ATUCONTAS @OLD_CODEMP,@OLD_CODFIL,@WMESANO,@WOLDCRE,@WVLRAUX,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@OLD_CODFIL<>@NEW_CODFIL)
        BEGIN
          SELECT @WVLRAUX = (@OLD_VLRLCT*-1)
          IF (@WOLDDEB<>0) 
      AND (@WOLDDEB=@WNEWDEB)
          BEGIN
            EXECUTE  @CHKERROR = SP_ATUCONTAS @OLD_CODEMP,@OLD_CODFIL,@WMESANO,@WOLDDEB,@WVLRAUX,'D' 
            IF @CHKERROR <> 0
            BEGIN
              CLOSE CUR_E640LCT_UPD
              DEALLOCATE CUR_E640LCT_UPD
              GOTO FIM
            END
          END
          IF (@WOLDCRE<>0) 
      AND (@WOLDCRE=@WNEWCRE)
          BEGIN
            EXECUTE  @CHKERROR = SP_ATUCONTAS @OLD_CODEMP,@OLD_CODFIL,@WMESANO,@WOLDCRE,@WVLRAUX,'C' 
            IF @CHKERROR <> 0
            BEGIN
              CLOSE CUR_E640LCT_UPD
              DEALLOCATE CUR_E640LCT_UPD
              GOTO FIM
            END
          END
        END
        IF (@WNEWDEB<>0)
        BEGIN
          SELECT @WDIFLCT = @NEW_VLRLCT
          IF ((@WOLDDEB=@WNEWDEB) 
      AND (@OLD_CODFIL=@NEW_CODFIL))
          BEGIN
            SELECT @WDIFLCT = @NEW_VLRLCT-@OLD_VLRLCT
          END
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          SELECT @WDIFLCT = @NEW_VLRLCT
          IF ((@WOLDCRE=@WNEWCRE) 
      AND (@OLD_CODFIL=@NEW_CODFIL))
          BEGIN
            SELECT @WDIFLCT = @NEW_VLRLCT-@OLD_VLRLCT
          END
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=2) 
      AND (@NEW_SITLCT=3)
      BEGIN
        SELECT @WDIFLCT = -@OLD_VLRLCT
        IF (@WNEWDEB<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@NEW_NUMLOT>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATULOTE @NEW_CODEMP,@NEW_CODFIL,@NEW_NUMLOT,@WOLDDEB,0,@WOLDCRE,0,@OLD_VLRLCT,0 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=3) 
      AND (@NEW_SITLCT=1)
      BEGIN
        IF (@NEW_NUMLOT>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATULOTE @NEW_CODEMP,@NEW_CODFIL,@NEW_NUMLOT,0,@WNEWDEB,0,@WNEWCRE,0,@NEW_VLRLCT 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=2) 
      AND (@NEW_SITLCT=4)
      BEGIN
        SELECT @WDIFLCT = -@OLD_VLRLCT
        IF (@WNEWDEB<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
      ELSE IF (@OLD_SITLCT=4) 
      AND (@NEW_SITLCT=2)
      BEGIN
        SELECT @WDIFLCT = @NEW_VLRLCT
        IF (@WNEWDEB<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWDEB,@WDIFLCT,'D' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
        IF (@WNEWCRE<>0)
        BEGIN
          EXECUTE  @CHKERROR = SP_ATUCONTAS @NEW_CODEMP,@NEW_CODFIL,@WMESANO,@WNEWCRE,@WDIFLCT,'C' 
          IF @CHKERROR <> 0
          BEGIN
            CLOSE CUR_E640LCT_UPD
            DEALLOCATE CUR_E640LCT_UPD
            GOTO FIM
          END
        END
      END
    END
    FETCH NEXT FROM CUR_E640LCT_UPD INTO 
@OLD_CODEMP, @OLD_TIPLCT, @OLD_ORILCT, @OLD_CODFIL, @OLD_DATLCT, @OLD_CTADEB, @OLD_CTACRE,
@OLD_NUMLOT, @OLD_SITLCT,  
@NEW_CODEMP, @NEW_TIPLCT, @NEW_ORILCT, @NEW_CODFIL, @NEW_DATLCT, @NEW_CTADEB, @NEW_CTACRE,
@NEW_NUMLOT, @NEW_SITLCT,  
@OLD_VLRLCT, @NEW_VLRLCT
  END
  CLOSE CUR_E640LCT_UPD
  DEALLOCATE CUR_E640LCT_UPD
  FIM:
  IF @CHKERROR <> 0
    ROLLBACK TRANSACTION TR_E640LCTAU
END	POSTGRESQL;0e␀␀DO $$BEGIN
CREATE OR REPLACE FUNCTION t640lctau$tf()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE
  WMESANO_OLD DATE;
  WMESANO_NEW DATE;
  WVLRAUX NUMERIC(17,2);
  WDIFLCT NUMERIC(17,2);
  WOLDDEB INTEGER;
  WNEWDEB INTEGER;
  WOLDCRE INTEGER;
  WNEWCRE INTEGER;
  C_LCTOS RECORD;  
BEGIN
IF to_regclass('E640LCT_TMP') IS NULL THEN
	RETURN NEW;
END IF;

WMESANO_OLD := TO_DATE('31/12/1900','DD/MM/YYYY HH24:MI:SS');
WMESANO_NEW := TO_DATE('31/12/1900','DD/MM/YYYY HH24:MI:SS');

FOR C_LCTOS IN
  ( SELECT OLD_CODEMP, OLD_TIPLCT, OLD_ORILCT, OLD_CODFIL, DATE_TRUNC('MONTH', OLD_DATLCT) OLD_DATLCT, OLD_CTADEB, OLD_CTACRE, OLD_NUMLOT, OLD_SITLCT, NEW_CODEMP, 
           NEW_TIPLCT, NEW_ORILCT, NEW_CODFIL, DATE_TRUNC('MONTH', NEW_DATLCT) NEW_DATLCT, NEW_CTADEB, NEW_CTACRE, NEW_NUMLOT, NEW_SITLCT, SUM(OLD_VLRLCT) OLD_VLRLCT, SUM(NEW_VLRLCT) NEW_VLRLCT
      FROM E640LCT_TMP
     GROUP BY OLD_CODEMP, OLD_TIPLCT, OLD_ORILCT, OLD_CODFIL, DATE_TRUNC('MONTH', OLD_DATLCT), OLD_CTADEB, OLD_CTACRE, OLD_NUMLOT, OLD_SITLCT, NEW_CODEMP, 
              NEW_TIPLCT, NEW_ORILCT, NEW_CODFIL, DATE_TRUNC('MONTH', NEW_DATLCT), NEW_CTADEB, NEW_CTACRE, NEW_NUMLOT, NEW_SITLCT
  )
  LOOP       
    IF (C_LCTOS.NEW_SITLCT=2) AND (C_LCTOS.OLD_SITLCT<>2) AND (C_LCTOS.NEW_DATLCT <> WMESANO_NEW) THEN
      CALL SP_TRANSFSALDOSCTB(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_DATLCT);
    END IF;

    WMESANO_OLD := C_LCTOS.OLD_DATLCT;  
    WMESANO_NEW := C_LCTOS.NEW_DATLCT;
    WOLDDEB := COALESCE(C_LCTOS.OLD_CTADEB,0);
    WNEWDEB := COALESCE(C_LCTOS.NEW_CTADEB,0);
    WOLDCRE := COALESCE(C_LCTOS.OLD_CTACRE,0);
    WNEWCRE := COALESCE(C_LCTOS.NEW_CTACRE,0);

    IF (C_LCTOS.OLD_SITLCT  =1) AND (C_LCTOS.NEW_SITLCT=1) THEN
      IF (C_LCTOS.NEW_NUMLOT>0) THEN
        CALL SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,WOLDDEB,WNEWDEB,WOLDCRE,WNEWCRE,C_LCTOS.OLD_VLRLCT,C_LCTOS.NEW_VLRLCT);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=1) AND (C_LCTOS.NEW_SITLCT=2) THEN
      WDIFLCT        := C_LCTOS.NEW_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=1) AND (C_LCTOS.NEW_SITLCT=3) THEN
      IF (C_LCTOS.NEW_NUMLOT >0) THEN
        CALL SP_ATULOTE(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,C_LCTOS.NEW_NUMLOT,WOLDDEB,0,WOLDCRE,0,C_LCTOS.OLD_VLRLCT,0);
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=2) AND (C_LCTOS.NEW_SITLCT=1) THEN
      WDIFLCT        := -C_LCTOS.OLD_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE<>0) THEN
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT =2) AND (C_LCTOS.NEW_SITLCT=2) THEN
      IF (WOLDDEB     <>0) AND (WOLDDEB<>WNEWDEB) THEN
        WVLRAUX := (C_LCTOS.OLD_VLRLCT*-1);
        CALL SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDDEB,WVLRAUX,'D');
      END IF;
      IF (WOLDCRE     <>0) AND (WOLDCRE<>WNEWCRE) THEN
        WVLRAUX := (C_LCTOS.OLD_VLRLCT*-1);
        CALL SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDCRE,WVLRAUX,'C');
      END IF;
      IF (C_LCTOS.OLD_CODFIL<>C_LCTOS.NEW_CODFIL) THEN
        WVLRAUX      := (C_LCTOS.OLD_VLRLCT*-1);
        IF (WOLDDEB  <>0) AND (WOLDDEB=WNEWDEB) THEN
          CALL SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDDEB,WVLRAUX,'D');
        END IF;
        IF (WOLDCRE<>0) AND (WOLDCRE=WNEWCRE) THEN
          CALL SP_ATUCONTAS(C_LCTOS.OLD_CODEMP,C_LCTOS.OLD_CODFIL,WMESANO_OLD,WOLDCRE,WVLRAUX,'C');
        END IF;
      END IF;
      IF (WNEWDEB  <>0) THEN
        WDIFLCT    := C_LCTOS.NEW_VLRLCT;
        IF ((WOLDDEB=WNEWDEB) AND (C_LCTOS.OLD_CODFIL=C_LCTOS.NEW_CODFIL)) THEN
          WDIFLCT  := C_LCTOS.NEW_VLRLCT-C_LCTOS.OLD_VLRLCT;
        END IF;
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWDEB,WDIFLCT,'D');
      END IF;
      IF (WNEWCRE  <>0) THEN
        WDIFLCT    := C_LCTOS.NEW_VLRLCT;
        IF ((WOLDCRE=WNEWCRE) AND (C_LCTOS.OLD_CODFIL=C_LCTOS.NEW_CODFIL)) THEN
          WDIFLCT  := C_LCTOS.NEW_VLRLCT-C_LCTOS.OLD_VLRLCT;
        END IF;
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_NEW,WNEWCRE,WDIFLCT,'C');
      END IF;
    ELSIF (C_LCTOS.OLD_SITLCT=2) AND (C_LCTOS.NEW_SITLCT=3) THEN
      WDIFLCT        := -C_LCTOS.OLD_VLRLCT;
      IF (WNEWDEB    <>0) THEN
        CALL SP_ATUCONTAS(C_LCTOS.NEW_CODEMP,C_LCTOS.NEW_CODFIL,WMESANO_OLD,WNEWDEB,WDIFLCT,'D');
