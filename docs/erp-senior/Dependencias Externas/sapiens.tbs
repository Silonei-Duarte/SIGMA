DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E039EPO.INDEXP%TYPE; 

CURSOR CUR_E039EPO IS
       SELECT INDEXP
       FROM E039EPO
       WHERE CODEMP=:OLD.CODEMP AND CODPOR=:OLD.CODPOR;
BEGIN
EXISTE := 'N';
FOREACH CUR_E039EPO INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E039EPO (CODEMP,CODPOR,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODPOR,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E039EPO SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODPOR=:OLD.CODPOR;
END IF;
