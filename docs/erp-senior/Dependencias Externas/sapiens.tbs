BEGIN
/* Insere o registro (log) de alterações no cadastro do representante */
IF	((:OLD.CODREP <> 0) AND
	 ((:OLD.CODREP <> :NEW.CODREP) OR
	  (upper(rtrim(ltrim(:OLD.NOMREP))) <> upper(rtrim(ltrim(:NEW.NOMREP)))) OR
	  (:OLD.TIPREP <> :NEW.TIPREP) OR
	  (upper(rtrim(ltrim(:OLD.INSEST))) <> upper(rtrim(ltrim(:NEW.INSEST)))) OR
	  (upper(rtrim(ltrim(:OLD.INSMUN))) <> upper(rtrim(ltrim(:NEW.INSMUN)))) OR
	  (:OLD.CGCCPF <> :NEW.CGCCPF) OR
	  (upper(rtrim(ltrim(:OLD.ENDREP))) <> upper(rtrim(ltrim(:NEW.ENDREP)))) OR
	  (upper(rtrim(ltrim(:OLD.CPLEND))) <> upper(rtrim(ltrim(:NEW.CPLEND)))) OR
	  (:OLD.CEPREP <> :NEW.CEPREP) OR
	  (upper(rtrim(ltrim(:OLD.BAIREP))) <> upper(rtrim(ltrim(:NEW.BAIREP)))) OR
	  (upper(rtrim(ltrim(:OLD.CIDREP))) <> upper(rtrim(ltrim(:NEW.CIDREP)))) OR
	  (:OLD.SIGUFS <> :NEW.SIGUFS) OR
	  (:OLD.SITREP <> :NEW.SITREP) OR
	  (:OLD.QTDDEP <> :NEW.QTDDEP) OR
	  (:OLD.DATNAS <> :NEW.DATNAS) OR
	  (upper(rtrim(ltrim(:OLD.NUMRGE))) <> upper(rtrim(ltrim(:NEW.NUMRGE)))) OR
	  (upper(rtrim(ltrim(:OLD.ORGRGE))) <> upper(rtrim(ltrim(:NEW.ORGRGE)))) OR
	  (:OLD.DATRGE <> :NEW.DATRGE) OR
	  (:OLD.REPCLI <> :NEW.REPCLI) OR
	  (:OLD.REPFOR <> :NEW.REPFOR) OR
	  (:OLD.CALIRF <> :NEW.CALIRF) OR
	  (:OLD.CALISS <> :NEW.CALISS) OR
	  (:OLD.CALINS <> :NEW.CALINS) OR
	  (:OLD.GERTIT <> :NEW.GERTIT) OR 
	  (:OLD.DOCIDEREP <> :NEW.DOCIDEREP))) THEN
	SP_T090VRE(	:OLD.CODREP,	:OLD.NOMREP,	:OLD.TIPREP,	:OLD.INSEST,	:OLD.INSMUN,	:OLD.CGCCPF,	:OLD.ENDREP,	:OLD.CPLEND,	:OLD.CEPREP,
			:OLD.BAIREP,	:OLD.CIDREP,	:OLD.SIGUFS,	:OLD.SITREP,	:OLD.QTDDEP,	:OLD.DATNAS,	:OLD.NUMRGE,	:OLD.ORGRGE,	:OLD.DATRGE,	:OLD.REPCLI,
			:OLD.REPFOR,	0,	:OLD.CALIRF,	:OLD.CALISS,	:OLD.CALINS,	:OLD.GERTIT, :OLD.DOCIDEREP);
END IF;
END␀þ␀␀		SENIOR;0␀␀

TRIGGER T090REPD AFTER DELETE ON E090REP FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E090ERE.INDEXP%TYPE; 

CURSOR CUR_E090ERE IS
       SELECT INDEXP
       FROM E090ERE
       WHERE CODREP=:OLD.CODREP;
BEGIN
EXISTE := 'N';
FOREACH CUR_E090ERE INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E090ERE (CODREP,INDEXP) VALUES (:OLD.CODREP,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E090ERE SET INDEXP = 0 WHERE CODREP = :OLD.CODREP;
END IF;
