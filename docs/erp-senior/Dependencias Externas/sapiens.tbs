.½␀␀␀␀␀␀␀␀␀©&š-6&<␀␀␀ƒÿ␀␀H^␀ÿ-½␀␀␀␀␀␀␀␀␀¾&›-7&<␀␀␀ƒÿ␀␀H^␀ý-½␀␀␀␀␀␀␀␀␀¿&œ-8&<␀␀␀ƒÿ␀␀H^␀␀␀␀0;1þ␀␀		SENIOR;0¾␀␀TRIGGER T083ESOD AFTER DELETE ON E083ESO FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WSITREG   E098REG.SITREG%TYPE;
WINDEXP   E083EES.INDEXP%TYPE; 

CURSOR CUR_E098REG IS
       SELECT SITREG FROM E098REG
       WHERE CODEMP=:OLD.CODEMP AND MODSIS='GER' AND IDEREG='000INTMV01';

CURSOR CUR_E083EES IS
       SELECT INDEXP
       FROM E083EES
       WHERE CODEMP=:OLD.CODEMP AND CODESO=:OLD.CODESO;
BEGIN
WSITREG := 'I';
FOREACH CUR_E098REG INTO WSITREG
   LOOP
   EXISTE := 'N';
   END LOOP;

IF ((WSITREG = 'A') AND (:OLD.TIPINT <> 0)) OR (WSITREG='I') THEN
   EXISTE := 'N';
   FOREACH CUR_E083EES INTO WINDEXP
             LOOP
             EXISTE := 'S';
             END LOOP;
   IF (EXISTE = 'N') THEN
       INSERT INTO E083EES (CODEMP,CODESO,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODESO,0);
   END IF;
   IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
      UPDATE E083EES SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODESO=:OLD.CODESO;
   END IF;
