␀g<␀␀	ƒÿ␀␀ÿ␀␀␀òm␀␀␀0;1;2;3ñm		SENIOR;0h␀␀TRIGGER E670SALAI AFTER INSERT ON E670SAL FOR EACH ROW

DECLARE
MENSAGEM VARCHAR (250); 
ANO INTEGER;
MES INTEGER;
DIA INTEGER;
BEGIN
    IF (DAYOFMONTH(:NEW.MESANO+1) <> 01) THEN 
        ANO := Year(:NEW.MESANO);
        MES := MONTH(:NEW.MESANO);
        DIA := DAYOFMONTH(:NEW.MESANO);

       MENSAGEM := CONCAT(CONCAT(CONCAT(CONVERT(NUMBER_TO_CHAR, DIA), '/'), CONCAT(CONVERT(NUMBER_TO_CHAR, MES), '/')), CONVERT(NUMBER_TO_CHAR, ANO));	  
       MENSAGEM := CONCAT('Trigger E670SALAI: O campo "MESANO" tem que estar no último dia do mês! MESANO: ', MENSAGEM);
  
        RAISERROR 103 MENSAGEM;
    END IF;
