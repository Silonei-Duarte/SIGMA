DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E403EFP.INDEXP%TYPE; 

CURSOR CUR_E403EFP IS
       SELECT INDEXP
       FROM E403EFP
       WHERE CODEMP=:OLD.CODEMP AND CODFOR=:OLD.CODFOR AND CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER AND SIGUFS=:OLD.SIGUFS AND CODTNS=:OLD.CODTNS;
BEGIN
EXISTE := 'N';
FOREACH CUR_E403EFP INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E403EFP (CODEMP,CODFOR,CODPRO,CODDER,SIGUFS,CODTNS,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODFOR,:OLD.CODPRO,:OLD.CODDER,:OLD.SIGUFS,:OLD.CODTNS,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E403EFP SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODFOR=:OLD.CODFOR AND CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER AND SIGUFS=:OLD.SIGUFS AND CODTNS=:OLD.CODTNS;
END IF;
