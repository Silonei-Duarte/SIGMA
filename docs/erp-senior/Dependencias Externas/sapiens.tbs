		'V' AS CODFAM, 'V' AS DESFAM, 'V' AS CODPRO, 'V' AS DESPRO, 'V' AS CODTNS, 'V' AS DESTNS, 0 AS QTDREC, 0 AS QTDDEV, 0 AS DATEMI, 0 AS ORCCTR, 
		'V' AS CODSAF, 'V'  AS TRGFOR, 'V' AS DESPAR, 'V' AS CODTRG, 'V' AS DESTRG FROM E115CES WHERE (0=1)␀␀ÿp˜³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀ÿ␀°␀␀È␀	␀␀␀␀␀␀␀␀	»␀␀4È␀␀”¹␀␀]<␀␀ƒÿ␀␀ÿ␀©5	␀␀␀␀␀␀␀␀î7…Ä␀␀˜Ä␀␀W␀␀␀ÿ␀␀ÿ␀°␀␀È␀	␀␀␀␀␀␀␀␀º␀␀Ÿ¾␀␀‹¹␀␀]<␀␀ƒÿ␀␀ÿ␀›³␀	␀␀␀␀␀␀␀␀Ö<Ptúur<␀␀ƒÿ␀␀ÿ␀´oµ␀	␀␀␀␀␀␀␀␀¯ó␀␀Wî␀␀˜ñ␀␀4<␀␀ƒ£␀␀ÿ␀²oµ␀	␀␀␀␀␀␀␀␀®ó␀␀Eî␀␀—ñ␀␀4<␀␀ƒ£␀␀ÿ␀š	␀␀␀␀␀␀␀␀Î<ÅsÍsI␀␀␀ÿ␀␀ÿ␀Ùþ␀␀␀␀␀␀␀␀␀␀Â›␀␀i␀k␀F␀␀␀␀ÿ␀␀ÿ␀␀+␀␀ SELECT
  E930PRE.CODEMP,
  E930PRE.NUMPRE,
  EW909MVO.CODORI,
  EW909MVO.NUMORP,
  EW909MVO.CODETG,
  EW909MVO.EOQINI,
  EW909MVO.EOQFIM,
  E930PRE.CODEQP,
  UPPER(CASE E103EQP.CODFRT WHEN NULL THEN 'E' WHEN ' ' THEN 'E' WHEN '' THEN 'E' ELSE 'F' END) AS TIPEQP /* Tipo de equipamento/ferramenta (E: equipamento; F: ferramenta)*/
FROM E930PRE, EW909MVO, E103EQP
WHERE
  E103EQP.CODEMP = E930PRE.CODEMP AND
  E103EQP.EQPPRI = E930PRE.CODEQP AND /* O equipamento principal do equipamento usado no movimento deve ser igual ao equipamento da parada*/
  EW909MVO.CODEMP = E103EQP.CODEMP AND
  (
    EW909MVO.CODEQP = E103EQP.CODEQP OR /* Verifica se foi usado como equipamento no movimento de OP*/
    EXISTS ( /* Verifica se foi usado como ferramenta no movimento de OP*/
      SELECT 1 FROM E900EOF
      WHERE
        E900EOF.CODEMP = EW909MVO.CODEMP AND
        E900EOF.CODORI = EW909MVO.CODORI AND
        E900EOF.NUMORP = EW909MVO.NUMORP AND
        E900EOF.CODETG = EW909MVO.CODETG AND
        E900EOF.SEQEOQ = EW909MVO.EOQPRI AND /* Usa a ligação com o apontamento prioritário (de fim, senão o de início)*/
        E900EOF.CODEQP = E103EQP.CODEQP
    )
  ) AND
  (
    /* Verifica a intersecção entre o período do movimento de OP e da parada*/
    ((EW909MVO.DATINI < E930PRE.DATREF) OR ((EW909MVO.DATINI = E930PRE.DATREF) AND (EW909MVO.HORINI <= E930PRE.HORREF))) AND
    (
      (EW909MVO.SITMVO = 'I') OR 
      ((EW909MVO.DATFIM > E930PRE.DATREI) OR ((EW909MVO.DATFIM = E930PRE.DATREI) AND (EW909MVO.HORFIM >= E930PRE.HORREI)))
    )
  ) AND
  EW909MVO.TIPEXE = 'I'
EW909MVO
