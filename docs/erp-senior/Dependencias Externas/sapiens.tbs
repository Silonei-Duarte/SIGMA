DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E001ETN.INDEXP%TYPE; 

CURSOR CUR_E001ETN IS
       SELECT INDEXP
       FROM E001ETN
       WHERE CODEMP=:OLD.CODEMP AND CODTNS=:OLD.CODTNS;
BEGIN
EXISTE := 'N';
FOREACH CUR_E001ETN INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E001ETN (CODEMP,CODTNS,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODTNS,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E001ETN SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODTNS=:OLD.CODTNS;
END IF;
