DECLARE
MENSAGEM VARCHAR (250); 
ANO INTEGER;
MES INTEGER;
DIA INTEGER;
BEGIN
    
    IF (DAYOFMONTH(:NEW.MESANO) <> 01) THEN
        ANO := Year(:NEW.MESANO);
        MES := MONTH(:NEW.MESANO);
        DIA := DAYOFMONTH(:NEW.MESANO);

        MENSAGEM := CONCAT(CONCAT(CONCAT(CONVERT(NUMBER_TO_CHAR, DIA), '/'), CONCAT(CONVERT(NUMBER_TO_CHAR, MES), '/')), CONVERT(NUMBER_TO_CHAR, ANO));	  
        MENSAGEM := CONCAT('Trigger E650SALAI: O campo "MESANO" tem que estar no primeiro dia do mês! MESANO: ', MENSAGEM);
  
        RAISERROR 103 MENSAGEM;
    END IF;

    IF ((:NEW.CTARED IS NULL) OR (:NEW.CTARED = 0)) THEN
        RAISERROR 103 'Trigger E650SALAI: Campo CTARED não pode ser nulo!';
    END IF;
	
    IF ((:NEW.CLACTA IS NULL) OR (:NEW.CLACTA = '')) THEN
        RAISERROR 103 'Trigger E650SALAI: Campo CLACTA não pode ser nulo!';
    END IF;
	
    IF ((:NEW.ANASIN IS NULL) OR (:NEW.ANASIN = '')) THEN
        RAISERROR 103 'Trigger E650SALAI: Campo ANASIN não pode ser nulo!';
    END IF;
		
    IF ((:NEW.QTDPOS IS NULL) OR (:NEW.QTDPOS = 0)) THEN
        RAISERROR 103 'Trigger E650SALAI: Campo QTDPOS não pode ser nulo!';
    END IF;
