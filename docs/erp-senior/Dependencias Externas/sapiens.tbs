END␀›þ␀␀		SENIOR;0¡␀␀TRIGGER T140IPVD AFTER DELETE ON E140IPV FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E140EIP.INDEXP%TYPE; 
WPEDPAL   E120PED.PEDPAL%TYPE;
WCODREP   E140NFV.CODREP%TYPE;

CURSOR CUR_E140NFV IS
       SELECT CODREP
       FROM E140NFV
       WHERE CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND CODSNF=:OLD.CODSNF AND NUMNFV=:OLD.NUMNFV;
CURSOR CUR_E120PED IS
       SELECT PEDPAL
       FROM E120PED
       WHERE CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND NUMPED=:OLD.NUMPED;
CURSOR CUR_E140EIP IS
       SELECT INDEXP
       FROM E140EIP
       WHERE CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND CODSNF=:OLD.CODSNF AND NUMNFV=:OLD.NUMNFV AND SEQIPV=:OLD.SEQIPV;

BEGIN
WPEDPAL := 0;
WCODREP := 0;
FOREACH CUR_E140NFV INTO WCODREP
        LOOP
        EXISTE := 'S';
        END LOOP;

FOREACH CUR_E120PED INTO WPEDPAL
       LOOP
       EXISTE := 'S';
       END LOOP;

EXISTE := 'N';
FOREACH CUR_E140EIP INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;

IF (EXISTE = 'N') THEN
    INSERT INTO E140EIP (CODEMP,CODFIL,CODSNF,NUMNFV,SEQIPV,PEDPAL,NUMPED,SEQIPD,CODREP,INDEXP)  
    VALUES (:OLD.CODEMP,:OLD.CODFIL,:OLD.CODSNF,:OLD.NUMNFV,:OLD.SEQIPV,WPEDPAL,:OLD.NUMPED,:OLD.SEQIPD,WCODREP,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E140EIP SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODFIL=:OLD.CODFIL AND CODSNF=:OLD.CODSNF AND NUMNFV=:OLD.NUMNFV AND SEQIPV=:OLD.SEQIPV;
END IF;
