TRIGGER T085CLID AFTER DELETE ON E085CLI FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085ECL.INDEXP%TYPE; 

CURSOR CUR_E085ECL IS
       SELECT INDEXP
       FROM E085ECL
       WHERE CODCLI=:OLD.CODCLI;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085ECL INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085ECL (CODCLI,INDEXP) VALUES (:OLD.CODCLI,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085ECL SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI;
END IF;
END␀␀␀%␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀`aKÈ␀	␀␀␀␀␀␀␀␀›:ýý]<␀␀ƒÿ␀␀K@␀Q³␀	␀␀␀␀␀␀␀␀6<–0T2r<␀␀ƒÿ␀␀}_␀Ýµ␀␀␀␀␀␀␀␀␀␀w¼␀␀·␀␀¹␀␀I␀␀␀ÿ␀␀ÿ␀-§␀␀‘␀␀␀␀␀␀␀␀␀u§␀␀t§␀␀t§␀␀ <␀␀ƒÿ␀␀ÿ␀+‘␀␀␀␀␀␀␀␀␀”vè,è, <␀␀ƒÿ␀␀ÿ␀I÷␀␀¨	␀␀␀␀␀␀␀␀øù␀␀Šø␀␀Šø␀␀F␀␀␀ÿ␀␀ÿ␀8!␀o␀␀␀␀␀␀␀␀Á"␀¶!␀""␀ž<␀␀␀ƒÿ␀␀A␀'BÎ␀␀␀␀␀␀␀␀␀™G©DÑF‚@␀␀”ÿ␀␀Š@␀h‚␀␀µ␀␀␀␀␀␀␀␀␀„␀␀ƒ␀␀±ƒ␀␀&=␀␀␀ƒÿ␀␀©@␀!␀o␀␀␀␀␀␀␀␀â"␀#␀#␀ž<␀␀␀ƒÿ␀␀A␀©AÎ␀␀␀␀␀␀␀␀␀HL¨L‚@␀␀”ÿ␀␀†@␀=‚␀␀µ␀␀␀␀␀␀␀␀␀G„␀␀t…␀␀y…␀␀&=␀␀␀ƒÿ␀␀¨@␀tí␀␀␀␀␀␀␀␀␀␀œí␀␀í␀␀í␀␀õ␀␀ÿ␀␀ÿ␀␀␀aa␀␀0;1␀␀.␀␀␀␀␀␀␀␀␀␀␀␀␀␀baKÈ␀	␀␀␀␀␀␀␀␀›:ýý]<␀lDš␀ƒÿ␀␀K@␀®ï␀␀µ␀	␀␀␀␀␀␀␀␀ó␀␀ãí␀␀Žñ␀␀4<␀␀ƒ£␀␀è@␀ar	␀␀␀␀␀␀␀␀ÐrAr‘rÝTDš␀␀ÿ␀␀ÿ␀Y*␀␀␀␀␀␀␀␀Q")"6"òLDš␀␀␀ÿ␀␀o@␀…Â␀␀␀␀␀␀␀␀␀Ô¬¤OBDš␀ƒÿ␀␀ÿ␀”¢␀␀Â␀␀␀␀␀␀␀␀␀¿w»»O␀ƒÿ␀␀ÿ␀ÆW␀␀␀␀␀␀␀␀
