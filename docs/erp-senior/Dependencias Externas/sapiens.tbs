␀Ïn␀␀␀0;1;2²þ␀␀		SENIOR;0é␀␀TRIGGER T900COPU AFTER UPDATE ON E900COP FOR EACH ROW

DECLARE
WTOTAL INTEGER;
WNUMCAD   E900EOQ.NUMCAD%TYPE;
WMOVOPD   E083ORI.MOVOPD%TYPE;
CURSOR CUR_E083ORI IS
SELECT MOVOPD FROM E083ORI WHERE CODEMP=:OLD.CODEMP AND CODORI=:OLD.CODORI;
CURSOR CUR_E900EOQ IS
SELECT
E900EOQ.NUMCAD, COUNT(*)
FROM
E900OOP, E900EOQ
WHERE
E900EOQ.CODEMP = :OLD.CODEMP AND
E900EOQ.CODORI = :OLD.CODORI AND
E900EOQ.NUMORP = :OLD.NUMORP AND
E900EOQ.CODEMP = E900OOP.CODEMP AND
E900EOQ.CODORI = E900OOP.CODORI AND
E900EOQ.NUMORP = E900OOP.NUMORP AND
E900EOQ.CODETG = E900OOP.CODETG AND
E900EOQ.SEQROT = E900OOP.SEQROT AND
E900OOP.TIPCRE = 'I' AND
E900OOP.MOVORP = 'S' 
GROUP BY E900EOQ.NUMCAD
HAVING (((COUNT(*) / 2) * 2) <> COUNT(*));
BEGIN
IF ((:OLD.SITORP <> 'F') AND (:NEW.SITORP = 'F')) THEN
FOREACH CUR_E083ORI INTO WMOVOPD
LOOP
IF (WMOVOPD = 'S') THEN
FOREACH CUR_E900EOQ INTO WNUMCAD, WTOTAL
LOOP
RAISERROR 103 'Existe operador c/ movto aberto (não pode ser finalizado OP)!';
END LOOP;
END IF;
END LOOP;
