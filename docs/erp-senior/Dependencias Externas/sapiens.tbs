TRIGGER T075DERU AFTER UPDATE ON E075DER FOR EACH ROW

DECLARE
	
DESCRICAONOTA   E075PRO.DESNFV%TYPE;
DATAFISCAL   E070EPF.DATHFI%TYPE;
ITEMFISCAL   E070EPF.UTIFIS%TYPE;
DATA DATE;
CODIGOITEM VARCHAR(60);	
	
CURSOR CUR_E075PRO IS
	SELECT DESNFV
	FROM E075PRO
	WHERE CODEMP=:OLD.CODEMP AND
		  CODPRO=:OLD.CODPRO; 
		  	
	
CURSOR CUR_E070EPF IS
	SELECT DATHFI, UTIFIS 
	  FROM E070EPF
	 WHERE CODEMP=:OLD.CODEMP AND 
	 	   UTIFIS = 'S' AND
	 	   DATHFI IS NOT NULL;	 
BEGIN
  DATA := DATETIME(31,12,1900,0,0,0);
  
  IF NOT(((:NEW.DATGER = :NEW.DATALT) OR (:NEW.DATALT = DATA)) AND ((:NEW.HORGER = :NEW.HORALT) OR (:NEW.HORALT <= (:NEW.HORGER+100)))) THEN	
    IF (IFNULL(:NEW.CODDER, ' ') = ' ') THEN
	  CODIGOITEM := LTRIM(RTRIM(CONCAT('PRO',:NEW.CODPRO))); 
	ELSE
	  CODIGOITEM := LTRIM(RTRIM(CONCAT('PRO',CONCAT(:NEW.CODPRO, CONCAT('-',:NEW.CODDER))))); 
	END IF;

	FOREACH CUR_E070EPF INTO DATAFISCAL, ITEMFISCAL LOOP
      IF (DATA <> DATAFISCAL) THEN
        IF (ITEMFISCAL = 'S') THEN 
          IF ((:OLD.ITEFIS IS NULL) OR (IFNULL(:OLD.ITEFIS, ' ') = ' ') OR (:OLD.ITEFIS <> :NEW.ITEFIS)) THEN
            IF (IFNULL(:OLD.ITEFIS, ' ') = ' ') THEN
              IF ((CODIGOITEM <> :NEW.ITEFIS) AND (IFNULL(CODIGOITEM, ' ') <> ' ')) THEN
		        SP_T055HPF(:OLD.CODEMP, :OLD.CODPRO, :OLD.CODDER, 'C', CODIGOITEM, '');
	          END IF;						
            ELSE
              SP_T055HPF(:OLD.CODEMP, :OLD.CODPRO, :OLD.CODDER, 'C', :OLD.ITEFIS, '');
            END IF;	
		  END IF;
          
		  IF ((:OLD.DESFIS IS NULL) OR (IFNULL(:OLD.DESFIS, ' ') = ' ') OR (:OLD.DESFIS <> :NEW.DESFIS)) THEN
            IF (IFNULL(:OLD.DESFIS, ' ') = ' ') THEN
              FOREACH CUR_E075PRO INTO DESCRICAONOTA LOOP					
                IF ((:NEW.DESFIS <> DESCRICAONOTA) AND (IFNULL(DESCRICAONOTA, ' ') <> ' ')) THEN
                  SP_T055HPF(:OLD.CODEMP, :OLD.CODPRO, :OLD.CODDER, 'D', '', DESCRICAONOTA);
                END IF;						
              END LOOP;					
            ELSE
              SP_T055HPF(:OLD.CODEMP, :OLD.CODPRO, :OLD.CODDER, 'D', '', :OLD.DESFIS);
            END IF;
          END IF;
        END IF;	
      END IF;
    END LOOP;
  END IF;	
END␀wþ␀␀		SENIOR;0½␀␀TRIGGER T075DERD AFTER DELETE ON E075DER FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E075EDE.INDEXP%TYPE; 

CURSOR CUR_E075EDE IS
       SELECT INDEXP
       FROM E075EDE
       WHERE CODEMP=:OLD.CODEMP AND CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER;
BEGIN
  EXISTE := 'N';
  FOREACH CUR_E075EDE INTO WINDEXP LOOP
    EXISTE := 'S';
  END LOOP;
	
  IF (EXISTE = 'N') THEN
    INSERT INTO E075EDE (CODEMP,CODPRO,CODDER,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODPRO,:OLD.CODDER,0);
  END IF;
  
  IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
    UPDATE E075EDE SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER;
  END IF;

  DELETE FROM E055FHP WHERE E055FHP.IdeHpf = (SELECT HPF.IDEHPF FROM E055HPF HPF WHERE HPF.CODEMP = :OLD.CODEMP AND HPF.CODPRO = :OLD.CODPRO AND HPF.CODDER = :OLD.CODDER);
  DELETE FROM E055HPF WHERE E055HPF.CODEMP = :OLD.CODEMP AND E055HPF.CODPRO = :OLD.CODPRO AND E055HPF.CODDER = :OLD.CODDER;	
