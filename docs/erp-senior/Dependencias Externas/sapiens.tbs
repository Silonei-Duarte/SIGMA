FTER DELETE ON E085ENT FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085EEN.INDEXP%TYPE; 

CURSOR CUR_E085EEN IS
       SELECT INDEXP
       FROM E085EEN
       WHERE CODCLI=:OLD.CODCLI AND SEQENT=:OLD.SEQENT;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085EEN INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085EEN (CODCLI,SEQENT,INDEXP) VALUES (:OLD.CODCLI,:OLD.SEQENT,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085EEN SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI AND SEQENT=:OLD.SEQENT;
END IF;
