ƒ␀␀
ƒ␀␀&=␀␀ƒÿ␀␀ÿ␀ÓQ	␀␀␀␀␀␀␀␀¤␀␀!0Û$F␀␀␀ÿ␀␀ÿ␀ÎQ	␀␀␀␀␀␀␀␀ëœ␀␀ÔÔF␀␀␀ÿ␀␀ÿN␀␀o␀␀␀0;1ºþ␀␀		SENIOR;0¸␀␀/* Triggers para alimentar dados para as tabelas de notificações do painel OEE
 * 
 * Após inserir: alimenta a tabela (E930MPO) de ligação entre tabela de Parada de Equipamento e a tabela de 
 * notificações de operações do painel OEE. Essa trigger é definida apenas para oracle para obter o valor do 
 * ID único. No SqlServer o valor do identificador único é gerado através do campo do tipo Identity
 * 
 * Após atualizar: efetua a notificação direta para o painel OEE através de stored procedure
 * 
 * Após excluir: efetua a notificação direta para o painel OEE através de stored procedure e posteriormente 
 * exclui o registro na tabela E930PRO, pois não é feito mais nenhum tratamento com esta tabela.
 */ 
TRIGGER T930PREAI AFTER INSERT ON E930PRE FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930PRO IS
		   SELECT IDEUNI
		   FROM E930PRO
		   WHERE CODEMP = :NEW.CODEMP AND NUMPRE = :NEW.NUMPRE;
BEGIN
	INSERT INTO E930PRO (CODEMP, NUMPRE) VALUES (:NEW.CODEMP, :NEW.NUMPRE);
	EXISTE := 'N';

	FOREACH CUR_E930PRO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN
		SP_MGOE_NOTIF_EQP(:NEW.CODEMP, :NEW.CODEQP, NULL, WIDEUNI, NULL, 'I');
	END IF;	
END	ORACLE;0I␀␀CREATE OR REPLACE TRIGGER T930PREAI AFTER INSERT ON E930PRE FOR EACH ROW 
DECLARE WIDEUNI INT;
BEGIN
	ATGETNEXTVALUE ('E930PRO_IDEUNI', 1, NULL, WIDEUNI);	
	INSERT INTO E930PRO (IDEUNI, CODEMP, NUMPRE) VALUES (WIDEUNI, :NEW.CODEMP, :NEW.NUMPRE);
	SP_MGOE_NOTIF_EQP(:NEW.CODEMP, :NEW.CODEQP, NULL, WIDEUNI, NULL, 'I');	
END;␀»þ␀␀		SENIOR;0ª␀␀


TRIGGER T930PREAU AFTER UPDATE ON E930PRE FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930PRO IS
		   SELECT IDEUNI
		   FROM E930PRO
		   WHERE CODEMP = :NEW.CODEMP AND NUMPRE = :NEW.NUMPRE;

BEGIN
	EXISTE := 'N';

	FOREACH CUR_E930PRO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN
		SP_MGOE_NOTIF_EQP(:NEW.CODEMP, :NEW.CODEQP, NULL, WIDEUNI, NULL, 'A');
	END IF;  
END␀¹þ␀␀		SENIOR;0á␀␀

TRIGGER T930PREAD AFTER DELETE ON E930PRE FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930PRO IS
		   SELECT IDEUNI
		   FROM E930PRO
		   WHERE CODEMP = :OLD.CODEMP AND NUMPRE = :OLD.NUMPRE;
BEGIN
	EXISTE := 'N';

	FOREACH CUR_E930PRO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN  		    	
		SP_MGOE_NOTIF_EQP(:OLD.CODEMP, :OLD.CODEQP, NULL, WIDEUNI, NULL, 'E');  		
		DELETE E930PRO WHERE IDEUNI = WIDEUNI;   	 
	END IF;
END␀␀␀9È␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀oQ’␀␀È␀	␀␀␀␀␀␀␀␀”␀␀à’␀␀t“␀␀]<␀␀ƒÿ	11¬@␀Œ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀R@␀‰¶␀␀È␀	␀␀␀␀␀␀␀␀
