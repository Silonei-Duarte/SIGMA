åCREATE OR REPLACE PROCEDURE ATGETNEXTVALUE (pKey IN VARCHAR2, pIncrement IN NUMBER, pSelect IN VARCHAR2, pRet OUT NUMBER) AS
  PRAGMA AUTONOMOUS_TRANSACTION;
BEGIN
  GETNEXTVALUE(pKey, pIncrement, pSelect, pRet);
  COMMIT;
END;

