DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E062EDI.INDEXP%TYPE; 

CURSOR CUR_E062EDI IS
       SELECT INDEXP
       FROM E062EDI
       WHERE CODROE=:OLD.CODROE AND SEQDIA=:OLD.SEQDIA;
BEGIN
EXISTE := 'N';
FOREACH CUR_E062EDI INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E062EDI (CODROE,SEQDIA,INDEXP) VALUES (:OLD.CODROE,:OLD.SEQDIA,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E062EDI SET INDEXP = 0 WHERE CODROE=:OLD.CODROE AND SEQDIA=:OLD.SEQDIA;
END IF;
