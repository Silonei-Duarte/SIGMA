DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E081ETP.INDEXP%TYPE; 

CURSOR CUR_E081ETP IS
       SELECT INDEXP
       FROM E081ETP
       WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR AND DATINI=:OLD.DATINI;
BEGIN
EXISTE := 'N';
FOREACH CUR_E081ETP INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E081ETP (CODEMP,CODTPR,DATINI,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODTPR,:OLD.DATINI,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E081ETP SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR AND DATINI=:OLD.DATINI;
END IF;
