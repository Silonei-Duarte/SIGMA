DECLARE
MENSAGEM VARCHAR (250); 
ANO INTEGER;
MES INTEGER;
DIA INTEGER;
BEGIN
    IF (DAYOFMONTH(:NEW.DATCAL+1) <> 01) THEN
        ANO := Year(:NEW.DATCAL);
        MES := MONTH(:NEW.DATCAL);
        DIA := DAYOFMONTH(:NEW.DATCAL);

        MENSAGEM := CONCAT(CONCAT(CONCAT(CONVERT(NUMBER_TO_CHAR, DIA), '/'), CONCAT(CONVERT(NUMBER_TO_CHAR, MES), '/')), CONVERT(NUMBER_TO_CHAR, ANO));	  
        MENSAGEM := CONCAT('Trigger E670MOVAI: O campo "DATCAL" tem que estar no último dia do mês! DATCAL: ', MENSAGEM);
  
        RAISERROR 103 MENSAGEM;
    END IF;
