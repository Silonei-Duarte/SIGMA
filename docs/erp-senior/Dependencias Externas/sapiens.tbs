DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E062ERO.INDEXP%TYPE; 

CURSOR CUR_E062ERO IS
       SELECT INDEXP
       FROM E062ERO
       WHERE CODROE=:OLD.CODROE;
BEGIN
EXISTE := 'N';
FOREACH CUR_E062ERO INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E062ERO (CODROE,INDEXP) VALUES (:OLD.CODROE,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E062ERO SET INDEXP = 0 WHERE CODROE=:OLD.CODROE;
END IF;
