DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085EJU.INDEXP%TYPE; 

CURSOR CUR_E085EJU IS
       SELECT INDEXP
       FROM E085EJU
       WHERE CODCLI=:OLD.CODCLI;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085EJU INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085EJU (CODCLI,INDEXP) VALUES (:OLD.CODCLI,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085EJU SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI;
END IF;
