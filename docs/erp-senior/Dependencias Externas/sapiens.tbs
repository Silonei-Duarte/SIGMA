DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E081ETA.INDEXP%TYPE; 

CURSOR CUR_E081ETA IS
       SELECT INDEXP
       FROM E081ETA
       WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR;
BEGIN
EXISTE := 'N';
FOREACH CUR_E081ETA INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E081ETA (CODEMP,CODTPR,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODTPR,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E081ETA SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR;
END IF;
