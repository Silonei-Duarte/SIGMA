DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E081EIT.INDEXP%TYPE; 

CURSOR CUR_E081EIT IS
       SELECT INDEXP
       FROM E081EIT
       WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR AND DATINI=:OLD.DATINI AND CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER AND QTDMAX=:OLD.QTDMAX;
BEGIN
EXISTE := 'N';
FOREACH CUR_E081EIT INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E081EIT (CODEMP,CODTPR,DATINI,CODPRO,CODDER,QTDMAX,INDEXP) 
    VALUES (:OLD.CODEMP,:OLD.CODTPR,:OLD.DATINI,:OLD.CODPRO,:OLD.CODDER,:OLD.QTDMAX,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E081EIT SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODTPR=:OLD.CODTPR AND DATINI=:OLD.DATINI AND
   CODPRO=:OLD.CODPRO AND CODDER=:OLD.CODDER AND QTDMAX=:OLD.QTDMAX;
END IF;
