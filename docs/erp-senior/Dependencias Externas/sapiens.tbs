		 (:NEW.ESTCOB <> :OLD.ESTCOB) OR (:NEW.CGCCOB <> :OLD.CGCCOB) OR (:NEW.CODFOR <> :OLD.CODFOR) OR (:NEW.CLIREP <> :OLD.CLIREP) OR 
