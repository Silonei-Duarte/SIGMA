DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085EFI.INDEXP%TYPE; 

CURSOR CUR_E085EFI IS
       SELECT INDEXP
       FROM E085EFI
       WHERE CODCLI=:OLD.CODCLI;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085EFI INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085EFI (CODCLI,INDEXP) VALUES (:OLD.CODCLI,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085EFI SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI;
END IF;
