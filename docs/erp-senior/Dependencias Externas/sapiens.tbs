      BEGIN        
        ROLLBACK TRAN
        CLOSE CUR_R900LCN
        GOTO BEGINADDLOG
      END
      GOTO FNCUR_R900LCN1
    END
    COMMIT TRAN
    FETCH NEXT FROM CUR_R900LCN INTO @VEVTPOS, @VMAXPOS
  END
  FNCUR_R900LCN1: /* FINALLY OPEN CURSOR */
  CLOSE CUR_R900LCN
