       E120PED.CODFIL AS E120PED_CODFIL, E120PED.NUMPED AS E120PED_NUMPED, E120PED.QTDABE AS E120PED_ABEPED,
       E120PED.VLRLIQ AS E120PED_VLRLIQ, E120PED.DATEMI AS E120PED_DATEMI, E120PED.DATPRV AS E120PED_DATPRV,
