DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E066EFP.INDEXP%TYPE; 

CURSOR CUR_E066EFP IS
       SELECT INDEXP
       FROM E066EFP
       WHERE CODEMP=:OLD.CODEMP AND CODFPG=:OLD.CODFPG;
BEGIN
EXISTE := 'N';
FOREACH CUR_E066EFP INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E066EFP (CODEMP,CODFPG,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODFPG,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E066EFP SET INDEXP = 0 WHERE CODEMP = :OLD.CODEMP AND CODFPG = :OLD.CODFPG;
END IF;
