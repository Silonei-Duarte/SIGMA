DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085ECT.INDEXP%TYPE; 

CURSOR CUR_E085ECT IS
       SELECT INDEXP
       FROM E085ECT
       WHERE CODCLI=:OLD.CODCLI AND SEQCTO=:OLD.SEQCTO;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085ECT INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085ECT (CODCLI,SEQCTO,INDEXP) VALUES (:OLD.CODCLI,:OLD.SEQCTO,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085ECT SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI AND SEQCTO=:OLD.SEQCTO;
END IF;
