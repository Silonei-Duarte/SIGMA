       SUM(E670SAL.SALATC) AS EW67SCU_SALATC FROM E670SAL
WHERE (E670SAL.CTARED > 0) AND (E670SAL.CODCCU <> ' ')
GROUP BY E670SAL.CODEMP, E670SAL.CODFIL, E670SAL.CTARED, E670SAL.CODCCU, E670SAL.MESANO␀ÿp˜³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀ÿ␀©5	␀␀␀␀␀␀␀␀Å␀␀…Ä␀␀˜Ä␀␀W␀␀␀ÿ␀␀ÿ␀°␀␀È␀	␀␀␀␀␀␀␀␀º␀␀µ␀␀‹¹␀␀]<␀␀ƒÿ␀␀ÿ␀›³␀	␀␀␀␀␀␀␀␀Ó<Ptúur<␀␀ƒÿ␀␀ÿ␀2ê␀␀³␀␀␀␀␀␀␀␀␀çô␀␀óî␀␀ò␀␀r<␀␀ƒÿ␀␀ÿ␀°␀␀³␀␀␀␀␀␀␀␀␀¤º␀␀’␀␀J¹␀␀r<␀␀␀ƒÿ␀␀ÿ␀¬	␀␀␀␀␀␀␀␀S;@×␀␀@×␀␀A␀␀␀ÿ␀␀ÿ␀•[	␀␀␀␀␀␀␀␀w5O#O`␀␀␀ÿ␀␀ÿ␀°␀␀È␀␀␀␀␀␀␀␀␀í»␀␀¢Â␀␀«Â␀␀]<␀␀ƒÿ␀␀ÿ␀´oµ␀	␀␀␀␀␀␀␀␀žò␀␀Wî␀␀˜ñ␀␀4<␀␀ƒ£␀␀ÿ␀²oµ␀	␀␀␀␀␀␀␀␀žò␀␀Eî␀␀—ñ␀␀4<␀␀ƒ£␀␀ÿ␀µoµ␀	␀␀␀␀␀␀␀␀±ó␀␀Ûî␀␀™ñ␀␀4<␀␀ƒ£␀␀ÿ␀|ê␀␀␀␀␀␀␀␀␀␀'ú␀␀·ö␀␀Íø␀␀F␀␀␀␀ÿ␀␀ÿ␀¨V	␀␀␀␀␀␀␀␀ç7¢Â␀␀¾Â␀␀^␀␀␀ÿ␀␀ÿ␀¥Ø␀␀Š␀␀␀␀␀␀␀␀␀â␀␀@Ú␀␀MÞ␀␀b<␀␀ƒÿ␀␀ÿ␀¦Ø␀␀Š␀␀␀␀␀␀␀␀␀â␀␀AÚ␀␀OÞ␀␀b<␀␀ƒÿ␀␀ÿ␀§Ø␀␀Š␀␀␀␀␀␀␀␀␀â␀␀CÚ␀␀QÞ␀␀b<␀␀ƒÿ␀␀ÿ␀¹Ø␀␀Š␀␀␀␀␀␀␀␀␀oß␀␀ñØ␀␀gÞ␀␀b<␀␀ƒÿ␀␀ÿ␀¸Ø␀␀Š␀␀␀␀␀␀␀␀␀~Þ␀␀±Ù␀␀ÀÝ␀␀b<␀␀ƒÿ␀␀ÿ␀³Ø␀␀Š␀␀␀␀␀␀␀␀␀â␀␀@Ú␀␀LÞ␀␀b<␀␀ƒÿ␀␀ÿ␀´Ø␀␀Š␀␀␀␀␀␀␀␀␀â␀␀AÚ␀␀NÞ␀␀b<␀␀ƒÿ␀␀ÿ␀µØ␀␀Š␀␀␀␀␀␀␀␀␀â␀␀CÚ␀␀PÞ␀␀b<␀␀ƒÿ␀␀ÿ␀¶Ø␀␀Š␀␀␀␀␀␀␀␀␀oß␀␀ñØ␀␀fÞ␀␀b<␀␀ƒÿ␀␀ÿ␀¯Ø␀␀Š␀␀␀␀␀␀␀␀␀~Þ␀␀±Ù␀␀¿Ý␀␀b<␀␀ƒÿ␀␀ÿ␀¤O␀␀␀␀␀␀␀␀ä2¦¨␀␀§¨␀␀␀␀ÿ␀␀ÿ␀°␀␀O␀␀␀␀␀␀␀␀þ␀␀­·␀␀Í¹␀␀␀␀ÿ␀␀ÿ␀1@Î␀␀␀␀␀␀␀␀␀éDÍDØD‚@␀”ÿ␀␀ÿ␀¦␀␀µ␀␀␀␀␀␀␀␀␀/ƒ␀␀*ƒ␀␀9ƒ␀␀&=␀␀ƒÿ␀␀ÿ␀.@Î␀	␀␀␀␀␀␀␀␀OGQDsD‚@␀”ÿ␀␀ÿ␀¥␀␀µ␀␀␀␀␀␀␀␀␀äƒ␀␀
ƒ␀␀ƒ␀␀&=␀␀ƒÿ␀␀ÿ␀øþ␀␀n␀␀␀␀␀␀␀␀¤␀ž␀¢␀J␀ƒÿ␀␀ÿ␀Œ␀␀␀␀␀␀␀␀␀
␀ß(ß(ð␀␀ÿ␀␀ÿ␀äÆ␀␀␀␀␀␀␀␀␀ãÞ␀␀QQK<␀␀ƒÿ␀␀ÿ␀ãÆ␀␀␀␀␀␀␀␀␀äÞ␀␀RRK<␀␀ƒÿ␀␀ÿ␀áþ␀␀v␀␀␀␀␀␀␀␀Ë␀‘␀‘␀^<␀␀ƒÿ␀␀ÿ␀ãþ␀␀v␀␀␀␀␀␀␀␀õ␀¦␀§␀^<␀␀ƒÿ␀␀ÿ␀Ûþ␀␀␀␀␀␀␀␀␀␀S	␀Î␀Ñ␀F␀␀␀␀ÿ␀␀ÿ␀Úþ␀␀␀␀␀␀␀␀␀␀␀Î
␀u␀v␀F␀␀␀␀ÿ␀␀ÿ␀’_␀␀␀␀␀␀␀␀“:3Oa␀␀␀␀ÿ␀␀ÿ␀š␀␀␀␀␀␀␀␀Ê<¿sÇsI␀␀␀␀ÿ␀␀ÿ␀³o␀␀␀␀␀␀␀␀␀HŸ␀␀ž#␀Ÿ#␀F␀␀␀␀ÿ␀␀ÿ␀”␀␀␀␀␀␀␀␀B<–NN<␀␀␀␀ÿ␀␀ÿ␀·Ø␀␀Š␀␀␀␀␀␀␀␀␀Wâ␀␀uÚ␀␀ŸÞ␀␀b<␀␀ƒÿ␀␀ÿ␀°␀␀È␀␀␀␀␀␀␀␀␀©“␀␀>·␀␀C¹␀␀]<␀␀ƒÿ␀␀ÿ␀d␀␀␀␀␀␀␀␀Ý;xUe␀␀␀␀ÿ␀␀ÿ␀3ê␀␀³␀␀␀␀␀␀␀␀␀fò␀␀ãí␀␀ñ␀␀r<␀␀␀ƒÿ␀␀ÿ␀µN␀␀␀␀␀␀␀␀ö8`␀@␀\␀␀␀␀ÿ␀␀ÿ␀␀/␀␀ /* (1) Origem movimenta por operador, execução interna*/
SELECT
  E900EOQI.CODEMP,
  E900EOQI.CODORI,
  E900EOQI.NUMORP,
  E900EOQI.CODETG,
  E900EOQI.SEQROT,
  E900EOQI.NUMGOP,
  E900EOQI.CODPRO,
  E900EOQI.CODDER,
  E900EOQI.NUMCAD,  
  E900EOQI.SEQEOQ AS EOQINI,
  E900EOQF.SEQEOQ AS EOQFIM,
  IFNULL(E900EOQF.SEQEOQ, E900EOQI.SEQEOQ) AS EOQPRI, /* Prioriza a sequência do fim de movimento, mas se o movimento ainda não foi finalizado, usa a sequência do início do movimento*/
  CASE WHEN E900EOQF.SEQEOQ IS NULL THEN UPPER('I') ELSE UPPER('F') END AS SITMVO, /* Situação do movimento (I = iniciado; F = finalizado)*/
  E900OOP.CODOPR,
  E900EOQI.QTDRE1 AS QT1INI,
  E900EOQI.QTDRE2 AS QT2INI,
  E900EOQI.QTDRE3 AS QT3INI,
  E900EOQI.QTDRFG AS QTRINI,
  E900EOQI.QTDIQL AS QTIINI,
  IFNULL(E900EOQF.QTDRE1, E900EOQI.QTDRE1) AS QTDRE1,
  IFNULL(E900EOQF.QTDRE2, E900EOQI.QTDRE2) AS QTDRE2,
  IFNULL(E900EOQF.QTDRE3, E900EOQI.QTDRE3) AS QTDRE3,
  IFNULL(E900EOQF.QTDRFG, E900EOQI.QTDRFG) AS QTDRFG,
  IFNULL(E900EOQF.QTDIQL, E900EOQI.QTDIQL) AS QTDIQL,
  E900EOQF.CODLOT,
  E900EOQF.NUMSEP,
  E900EOQI.DATINI,
  E900EOQI.HORINI,
  E900EOQF.DATREA AS DATFIM,
  E900EOQF.HORREA AS HORFIM,
  E900EOQI.TURTRB,
  E900EOQF.CNVTMP,
  E900EOQF.BASCAL,
  E900EOQF.BASCA2,  
  E900EOQF.TMPBRU,
  E900EOQF.QTDHRR AS TMPLIQ,
  UPPER('D') AS TIPMVO, /* Tipo da movimentação (E: estágio; O: operação; D: operador)*/
  UPPER('I') AS TIPEXE, /* Tipo de execução (I: interna; E: externa)*/
  IFNULL(E900EOQF.CODCRE, E900EOQI.CODCRE) AS CODCRE,
  IFNULL(E900EOQF.CODEQP, E900EOQI.CODEQP) AS CODEQP,
  IFNULL(E900EOQF.EOQFRT, E900EOQI.EOQFRT) AS EOQFRT,
  E900EOQF.CODDEP,
  E900EOQF.QTDTR1,
  E900EOQF.NUMEPI,
  E900EOQF.CODCCU,
  NULL AS SEQSET, /* Retorna nulo, pois movimentos internos não geram remessa/retorno de terceirização*/
  E900EOQF.CODTNS
FROM
  (E900EOQ E900EOQI 
   /* Ligação com o apontamento de fim*/
   LEFT OUTER JOIN E900EOQ E900EOQF
   ON
     E900EOQI.CODEMP = E900EOQF.CODEMP AND
     E900EOQI.CODORI = E900EOQF.CODORI AND
     E900EOQI.NUMORP = E900EOQF.NUMORP AND
     E900EOQI.CODETG = E900EOQF.CODETG AND
     E900EOQI.SEQROT = E900EOQF.SEQROT AND
     E900EOQI.NUMGOP = E900EOQF.NUMGOP AND
     E900EOQI.CODPRO = E900EOQF.CODPRO AND
     E900EOQI.CODDER = E900EOQF.CODDER AND
     E900EOQI.NUMCAD = E900EOQF.NUMCAD AND     
     (E900EOQF.DATREA IS NOT NULL AND E900EOQF.DATREA > STRTODATE('1900/12/31')) AND /* Só aceita apontamentos de fim*/
     E900EOQI.SEQEOQ < E900EOQF.SEQEOQ /* Sequência de apontamento de início deve ser menor que a de fim*/
  ),
  E900OOP, E083ORI 
WHERE
  (E900EOQI.DATREA IS NULL OR E900EOQI.DATREA = STRTODATE('1900/12/31')) AND /* Só aceita apontamentos de início*/
  (
    E900EOQF.SEQEOQ IS NULL OR
    E900EOQF.SEQEOQ = ( /* Busca a sequência do apontamento de fim (o menor compatível que vier após a sequência de início)*/
      SELECT MIN(B.SEQEOQ) FROM E900EOQ B
      WHERE
        E900EOQF.CODEMP = B.CODEMP AND
        E900EOQF.CODORI = B.CODORI AND
        E900EOQF.NUMORP = B.NUMORP AND
        E900EOQF.CODETG = B.CODETG AND
        E900EOQF.SEQROT = B.SEQROT AND
        E900EOQF.NUMGOP = B.NUMGOP AND
        E900EOQF.CODPRO = B.CODPRO AND
        E900EOQF.CODDER = B.CODDER AND
        E900EOQF.NUMCAD = B.NUMCAD AND        
        (B.DATREA IS NOT NULL AND B.DATREA > STRTODATE('1900/12/31')) AND /* Só aceita apontamentos de fim */
        B.SEQEOQ > E900EOQI.SEQEOQ /* Sequência do apontamento deve ser maior que a de início*/
    )
  ) AND
  E900OOP.CODEMP = E900EOQI.CODEMP AND
  E900OOP.CODORI = E900EOQI.CODORI AND
  E900OOP.NUMORP = E900EOQI.NUMORP AND
  E900OOP.CODETG = E900EOQI.CODETG AND
  E900OOP.SEQROT = E900EOQI.SEQROT AND  
  E900OOP.TIPCRE = 'I' AND /* Execução interna*/
  E083ORI.CODEMP = E900EOQI.CODEMP AND
  E083ORI.CODORI = E900EOQI.CODORI AND
  E083ORI.MOVOPD = 'S' /* Origem que movimentam por operador*/

UNION ALL

/* (2) Origem movimenta por operação, execução interna*/
SELECT
  E900EOQ.CODEMP,
  E900EOQ.CODORI,
  E900EOQ.NUMORP,
  E900EOQ.CODETG,
  E900EOQ.SEQROT,
  E900EOQ.NUMGOP,
  E900EOQ.CODPRO,
  E900EOQ.CODDER,
  0 AS NUMCAD, /* Retorna "0", pois não movimenta por operador*/
  E900EOQ.SEQEOQ AS EOQINI,
  E900EOQ.SEQEOQ AS EOQFIM,
  E900EOQ.SEQEOQ AS EOQPRI,
  UPPER('F') AS SITMVO, /* Situação do movimento (I = iniciado; F = finalizado) - apontamentos por estágio/operação são registrados somente no seu fim*/
  E900OOP.CODOPR,  
  E900EOQ.QTDRE1 AS QT1INI,
  E900EOQ.QTDRE2 AS QT2INI,
  E900EOQ.QTDRE3 AS QT3INI,
  E900EOQ.QTDRFG AS QTRINI,
  E900EOQ.QTDIQL AS QTIINI,  
  E900EOQ.QTDRE1,
  E900EOQ.QTDRE2,
  E900EOQ.QTDRE3,
  E900EOQ.QTDRFG,
  E900EOQ.QTDIQL,
  E900EOQ.CODLOT,
  E900EOQ.NUMSEP,  
  E900EOQ.DATINI,
  E900EOQ.HORINI,
  E900EOQ.DATREA AS DATFIM,
  E900EOQ.HORREA AS HORFIM,
  E900EOQ.TURTRB,
  E900EOQ.CNVTMP,
  E900EOQ.BASCAL,
  E900EOQ.BASCA2,
  E900EOQ.QTDHRR AS TMPLIQ,
  E900EOQ.TMPBRU,
  UPPER('O') AS TIPMVO, /* Tipo da movimentação (E: estágio; O: operação; D: operador)*/
  UPPER('I') AS TIPEXE, /* Tipo de execução (I: interna; E: externa)  */
  E900EOQ.CODCRE,
  E900EOQ.CODEQP,
  UPPER('N') AS EOQFRT, /* Movimentação por operação não utiliza ferramentas*/
  E900EOQ.CODDEP,
  E900EOQ.QTDTR1,
  E900EOQ.NUMEPI,
  E900EOQ.CODCCU,
  NULL AS SEQSET, /* Retorna nulo, pois movimentos internos não geram remessa/retorno de terceirização*/
  E900EOQ.CODTNS
FROM
  E900EOQ, E900OOP, E083ORI
WHERE
  E900OOP.CODEMP = E900EOQ.CODEMP AND
  E900OOP.CODORI = E900EOQ.CODORI AND
  E900OOP.NUMORP = E900EOQ.NUMORP AND
  E900OOP.CODETG = E900EOQ.CODETG AND
  E900OOP.SEQROT = E900EOQ.SEQROT AND
  E900OOP.TIPCRE = 'I' AND /* Execução interna*/
  E083ORI.CODEMP = E900EOQ.CODEMP AND
  E083ORI.CODORI = E900EOQ.CODORI AND
  E083ORI.GEROPR = 'S' AND /* Movimenta por operação*/
  E083ORI.MOVOPD = 'N' /* Não movimenta por operador (esses entram em outro SELECT)*/

UNION ALL

/* (3) Origem movimenta por estágio, execução interna*/
SELECT
  E900EOQ.CODEMP,
  E900EOQ.CODORI,
  E900EOQ.NUMORP,
  E900EOQ.CODETG,
  0 AS SEQROT, /* Retorna "0", pois não movimenta por operação*/
  E900EOQ.NUMGOP,
  E900EOQ.CODPRO,
  E900EOQ.CODDER,
  0 AS NUMCAD, /* Retorna "0", pois não movimenta por operador*/
  E900EOQ.SEQEOQ AS EOQINI,
  E900EOQ.SEQEOQ AS EOQFIM,
  E900EOQ.SEQEOQ AS EOQPRI,
  UPPER('F') AS SITMVO, /* Situação do movimento (I = iniciado; F = finalizado) - apontamentos por estágio/operação são registrados no seu fim*/
  ' ' AS CODOPR, /* Retorna " ", pois não movimenta por operação  */
  E900EOQ.QTDRE1 AS QT1INI,
  E900EOQ.QTDRE2 AS QT2INI,
  E900EOQ.QTDRE3 AS QT3INI,
  E900EOQ.QTDRFG AS QTRINI,
  E900EOQ.QTDIQL AS QTIINI,  
  E900EOQ.QTDRE1,
  E900EOQ.QTDRE2,
  E900EOQ.QTDRE3,
  E900EOQ.QTDRFG,
  E900EOQ.QTDIQL,
  E900EOQ.CODLOT,
  E900EOQ.NUMSEP,  
  E900EOQ.DATINI,
  E900EOQ.HORINI,
  E900EOQ.DATREA AS DATFIM,
  E900EOQ.HORREA AS HORFIM,
  E900EOQ.TURTRB,
  E900EOQ.CNVTMP,
  E900EOQ.BASCAL,
  E900EOQ.BASCA2,
  E900EOQ.QTDHRR AS TMPLIQ,
  E900EOQ.TMPBRU,
  UPPER('E') AS TIPMVO, /* Tipo da movimentação (E: estágio; O: operação; D: operador)*/
  UPPER('I') AS TIPEXE, /* Tipo de execução (I: interna; E: externa)*/
  E900EOQ.CODCRE,
  E900EOQ.CODEQP,
  UPPER('N') AS EOQFRT, /* Movimentação por estágio não utiliza ferramentas*/
  E900EOQ.CODDEP,
  E900EOQ.QTDTR1,
  E900EOQ.NUMEPI,
  E900EOQ.CODCCU,
  NULL AS SEQSET, /* Retorna nulo, pois movimentos internos não geram remessa/retorno de terceirização*/
  E900EOQ.CODTNS
FROM
  E900EOQ, E093ETG, E083ORI
WHERE
  E093ETG.CODEMP = E900EOQ.CODEMP AND
  E093ETG.CODETG = E900EOQ.CODETG AND 
  E093ETG.TIPETG = 'I' AND /* Execução interna*/
  E083ORI.CODEMP = E900EOQ.CODEMP AND
  E083ORI.CODORI = E900EOQ.CODORI AND
  E083ORI.GEROPR = 'N' /* Movimenta por estágio*/

UNION ALL

/* (4) Origem movimenta por operação/operador, execução externa*/
SELECT  
  E900EOQ.CODEMP,
  E900EOQ.CODORI,
  E900EOQ.NUMORP,
  E900EOQ.CODETG,
  E900EOQ.SEQROT,
  E900EOQ.NUMGOP,
  E900EOQ.CODPRO,
  E900EOQ.CODDER,
  E900EOQ.NUMCAD, /* Pode retornar "0", pois só tem valor em movimentos por operador*/
  E900EOQ.SEQEOQ AS EOQINI,
  E900EOQ.SEQEOQ AS EOQFIM,
  E900EOQ.SEQEOQ AS EOQPRI,
  UPPER('F') AS SITMVO, /* Situação do movimento (I = iniciado; F = finalizado) - apontamentos externos só são registrados no seu fim*/
  E900OOP.CODOPR,  
  E900EOQ.QTDRE1 AS QT1INI,
  E900EOQ.QTDRE2 AS QT2INI,
  E900EOQ.QTDRE3 AS QT3INI,
  E900EOQ.QTDRFG AS QTRINI,
  E900EOQ.QTDIQL AS QTIINI,  
  E900EOQ.QTDRE1,
  E900EOQ.QTDRE2,
  E900EOQ.QTDRE3,
  E900EOQ.QTDRFG,
  E900EOQ.QTDIQL,
  E900EOQ.CODLOT,
  E900EOQ.NUMSEP,  
  E900EOQ.DATREA AS DATINI, /* Movimentos externos não possuem data/hora de início, então usa-se igual ao de fim*/
  E900EOQ.HORREA AS HORINI, /* Movimentos externos não possuem data/hora de início, então usa-se igual ao de fim*/
  E900EOQ.DATREA AS DATFIM,
  E900EOQ.HORREA AS HORFIM,
  E900EOQ.TURTRB,
  E900EOQ.CNVTMP,
  E900EOQ.BASCAL,
  E900EOQ.BASCA2,
  0 AS TMPLIQ, /* Para execuções externas, esse valor sempre é "0"*/
  0 AS TMPBRU, /* Para execuções externas, esse valor sempre é "0"*/
  UPPER(CASE WHEN E083ORI.MOVOPD = 'S' THEN 'D' ELSE 'O' END) AS TIPMVO, /* Tipo da movimentação (E: estágio; O: operação; D: operador)*/
  UPPER('E') AS TIPEXE, /* Tipo de execução (I: interna; E: externa)*/
  E900EOQ.CODCRE,
  E900EOQ.CODEQP,
  UPPER('N') AS EOQFRT, /* Movimentos externos não utilizam ferramentas*/
  E900EOQ.CODDEP,
  E900EOQ.QTDTR1,
  E900EOQ.NUMEPI,
  E900EOQ.CODCCU,
  E900EOQ.SEQSET,
  E900EOQ.CODTNS
FROM
  E900EOQ, E900OOP, E083ORI
WHERE
  E900OOP.CODEMP = E900EOQ.CODEMP AND
  E900OOP.CODORI = E900EOQ.CODORI AND
  E900OOP.NUMORP = E900EOQ.NUMORP AND
  E900OOP.CODETG = E900EOQ.CODETG AND
  E900OOP.SEQROT = E900EOQ.SEQROT AND
  E900OOP.TIPCRE = 'E' AND /* Execução externa*/
  E083ORI.CODEMP = E900EOQ.CODEMP AND
  E083ORI.CODORI = E900EOQ.CODORI AND
  E083ORI.GEROPR = 'S' /* Origens que movimentam por operação (por operação ou por operador)*/

UNION ALL

/* (5) Origem movimenta por estágio, execução externa*/
SELECT 
  E900EOQ.CODEMP,
  E900EOQ.CODORI,
  E900EOQ.NUMORP,
  E900EOQ.CODETG,
  0 AS SEQROT, /* Retorna "0", pois não movimenta por operação*/
  E900EOQ.NUMGOP,
  E900EOQ.CODPRO,
  E900EOQ.CODDER,
  0 AS NUMCAD, /* Retorna "0", pois não movimenta por operador*/
  E900EOQ.SEQEOQ AS EOQINI,
  E900EOQ.SEQEOQ AS EOQFIM,
  E900EOQ.SEQEOQ AS EOQPRI,
  UPPER('F') AS SITMVO, /* Situação do movimento (I = iniciado; F = finalizado) - apontamentos externos só são registrados no seu fim*/
  ' ' AS CODOPR, /* Retorna " ", pois não movimenta por operação */
  E900EOQ.QTDRE1 AS QT1INI,
  E900EOQ.QTDRE2 AS QT2INI,
  E900EOQ.QTDRE3 AS QT3INI,
  E900EOQ.QTDRFG AS QTRINI,
  E900EOQ.QTDIQL AS QTIINI,  
  E900EOQ.QTDRE1,
  E900EOQ.QTDRE2,
  E900EOQ.QTDRE3,
  E900EOQ.QTDRFG,
  E900EOQ.QTDIQL,
  E900EOQ.CODLOT,
  E900EOQ.NUMSEP,  
  E900EOQ.DATREA AS DATINI, /* Movimentos externos não possuem data/hora de início, então usa-se igual ao de fim*/
  E900EOQ.HORREA AS HORINI, /* Movimentos externos não possuem data/hora de início, então usa-se igual ao de fim*/
  E900EOQ.DATREA AS DATFIM,
  E900EOQ.HORREA AS HORFIM,
  E900EOQ.TURTRB, 
  E900EOQ.CNVTMP,
  E900EOQ.BASCAL,
  E900EOQ.BASCA2,
  0 AS TMPLIQ, /* Para execuções externas, esse valor sempre é "0"*/
  0 AS TMPBRU, /* Para execuções externas, esse valor sempre é "0"*/
  UPPER('E') AS TIPMVO, /* Tipo da movimentação (E: estágio; O: operação; D: operador)*/
  UPPER('E') AS TIPEXE, /* Tipo de execução (I: interna; E: externa)*/
  E900EOQ.CODCRE,  
  E900EOQ.CODEQP,
  UPPER('N') AS EOQFRT, /* Movimentos externos não utilizam ferramentas*/
  E900EOQ.CODDEP,
  E900EOQ.QTDTR1,
  E900EOQ.NUMEPI,
  E900EOQ.CODCCU,
  E900EOQ.SEQSET,
  E900EOQ.CODTNS
FROM
  E900EOQ, E093ETG, E083ORI
WHERE
  E093ETG.CODEMP = E900EOQ.CODEMP AND
  E093ETG.CODETG = E900EOQ.CODETG AND 
  E093ETG.TIPETG = 'E' AND /* Execução externa*/
  E083ORI.CODEMP = E900EOQ.CODEMP AND
  E083ORI.CODORI = E900EOQ.CODORI AND
  E083ORI.GEROPR = 'N'␀␀ÿpžÈ␀	␀␀␀␀␀␀␀␀å<˜}Æ}]<␀␀ƒÿ␀␀ÿ␀1@Î␀␀␀␀␀␀␀␀␀J`CaC‚@␀”ÿ␀␀ÿ␀.@Î␀	␀␀␀␀␀␀␀␀H9C;C‚@␀”ÿ␀␀ÿ␀±†␀␀␀␀␀␀␀␀␀␀␀‘␀␀ï(ï(F␀␀␀ÿ␀␀ÿN␀2␀␀ SELECT A.CODFOR, A.DATCAD DATINI, B.DATATU AS DATFIM, B.INDCOO
  FROM E095FOR A, E095VFO B
 WHERE B.CODFOR = A.CODFOR
   AND  TRIM(NUMBERTOSTR(YEAROF(B.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(B.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(B.SEQATU + 1000), 1, 3)
   = (SELECT MIN(TRIM(NUMBERTOSTR(YEAROF(C.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(C.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(C.SEQATU + 1000), 1, 3)) 
                                                                              FROM E095VFO C
                                                                             WHERE C.CODFOR = B.CODFOR
                                                                               AND C.DATATU >= A.DATCAD)
UNION ALL
SELECT DISTINCT A.CODFOR, A.DATATU+1 DATINI, B.DATATU AS DATFIM, B.INDCOO INDCOO
  FROM E095VFO A, E095VFO B, E095FOR C
 WHERE  C.CODFOR = A.CODFOR
   AND C.DATCAD <= A.DATATU
   AND B.CODFOR = A.CODFOR     
   AND  TRIM(NUMBERTOSTR(YEAROF(B.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(B.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(B.SEQATU + 1000), 1, 3)
   = (SELECT MIN(TRIM(NUMBERTOSTR(YEAROF(C.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(C.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(C.SEQATU + 1000), 1, 3)) 
                                                                             FROM E095VFO C
                                                                             WHERE C.CODFOR = B.CODFOR
                                                                              AND C.DATATU > A.DATATU)
UNION ALL
SELECT A.CODFOR, B.DATATU+1 DATINI, LASTDAY(TODAY) AS DATFIM, A.INDCOO
  FROM E095FOR A, E095VFO B
 WHERE B.CODFOR = A.CODFOR    
   AND TRIM(NUMBERTOSTR(YEAROF(B.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(B.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(B.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(B.SEQATU + 1000), 1, 3) 
   = (SELECT MAX(TRIM(NUMBERTOSTR(YEAROF(C.DATATU))) || SUBSTR(NUMBERTOSTR(MONTHOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(DAYOF(C.DATATU) + 100), 1, 2) || SUBSTR(NUMBERTOSTR(C.HORATU + 10000), 1, 4) || SUBSTR(NUMBERTOSTR(C.SEQATU + 1000), 1, 3)) 
                                                                              FROM E095VFO C
                                                                             WHERE C.CODFOR = B.CODFOR
                                                                               AND C.DATATU >= A.DATCAD)
UNION ALL
SELECT A.CODFOR, A.DATCAD DATINI, LASTDAY(TODAY) AS DATFIM, A.INDCOO
  FROM E095FOR A
 WHERE NOT EXISTS (SELECT 1 
                     FROM E095VFO B
                    WHERE B.CODFOR = A.CODFOR
                      AND B.DATATU >= A.DATCAD)␀␀ÿêoôm³␀	␀␀␀␀␀␀␀␀÷3”q”qr<␀␀ƒÿ␀␀ÿ␀õmµ␀	␀␀␀␀␀␀␀␀4¶y¶yy<␀␀ƒÿ␀␀V@␀öm½␀␀␀␀␀␀␀␀␀X&–-3&<␀␀␀ƒÿ␀␀ÿ␀÷mÎ␀	␀␀␀␀␀␀␀␀¯␀␀¸!ñ!*©␀␀␀”ÿ␀␀ÿ␀÷o~␀␀␀␀␀␀␀␀*ì␀␀Së␀␀¢ë␀␀l<␀␀␀ƒÿ␀␀ÿ␀öo|␀␀␀␀␀␀␀␀)ì␀␀Rë␀␀¡ë␀␀g<␀␀␀ƒÿ␀␀ÿ␀óo~␀␀␀␀␀␀␀␀˜␀ns5␀l<␀␀␀ƒÿ␀␀ÿ␀òo|␀␀␀␀␀␀␀␀—␀ms4␀g<␀␀␀ƒÿ␀␀ÿ␀ìo~␀␀␀␀␀␀␀␀‘␀›␀l<␀␀␀ƒÿ␀␀ÿ␀ëo|␀␀␀␀␀␀␀␀␀–␀g<␀␀␀ƒÿ␀␀ÿ␀õo~␀␀␀␀␀␀␀␀š␀æä␀␀P␀l<␀␀␀ƒÿ␀␀ÿ␀ôo|␀␀␀␀␀␀␀␀™␀åä␀␀O␀g<␀␀␀ƒÿ␀␀ÿ␀îo~␀␀␀␀␀␀␀␀␀Í␀l<␀␀␀ƒÿ␀␀ÿ␀ío|␀␀␀␀␀␀␀␀Ž␀Ì␀g<␀␀␀ƒÿ␀␀ÿ␀ïo|␀␀␀␀␀␀␀␀“␀>)!␀g<␀␀␀ƒÿ␀␀ÿ␀ño~␀␀␀␀␀␀␀␀•␀lN/␀l<␀␀␀ƒÿ␀␀ÿ␀ðo|␀␀␀␀␀␀␀␀”␀hN.␀g<␀␀␀ƒÿ␀␀ÿ␀ùo~␀␀␀␀␀␀␀␀4ì␀␀Uë␀␀©ë␀␀l<␀␀␀ƒÿ␀␀ÿ␀øo|␀␀␀␀␀␀␀␀3ì␀␀Të␀␀¨ë␀␀g<␀␀␀ƒÿ␀␀ÿ␀␀7␀␀ SELECT E670SAL.CODEMP, E670SAL.CODFIL, E670SAL.CTARED, E670SAL.MESANO,
       SUM(E670SAL.SALANO) AS EW67SCT_SALANO, SUM(E670SAL.SALANC) AS EW67SCT_SALANC,
       SUM(E670SAL.ENTMIO) AS EW67SCT_ENTMIO, SUM(E670SAL.ENTMCO) AS EW67SCT_ENTMCO,
       SUM(E670SAL.BAIMIO) AS EW67SCT_BAIMIO, SUM(E670SAL.BAIMCO) AS EW67SCT_BAIMCO,
       SUM(E670SAL.REAMIO) AS EW67SCT_REAMIO, SUM(E670SAL.REAMCO) AS EW67SCT_REAMCO,
       SUM(E670SAL.BDPMIO) AS EW67SCT_BDPMIO, SUM(E670SAL.BDPMCO) AS EW67SCT_BDPMCO,
       SUM(E670SAL.CORMCO) AS EW67SCT_CORMCO, SUM(E670SAL.DPRMIO) AS EW67SCT_DPRMIO,
       SUM(E670SAL.DPRMCO) AS EW67SCT_DPRMCO, SUM(E670SAL.SALATO) AS EW67SCT_SALATO,
       SUM(E670SAL.SALATC) AS EW67SCT_SALATC FROM E670SAL
WHERE (E670SAL.CTARED > 0)
GROUP BY E670SAL.CODEMP, E670SAL.CODFIL, E670SAL.CTARED, E670SAL.MESANO␀ÿpØã␀␀o	␀␀␀␀␀␀␀␀6?
