ƒ␀␀
ƒ␀␀&=␀␀␀␀ÿÿ␀␀ÿ␀-␀´␀ÿÿÿÿÿÿÿÿà␀␀¦Ù␀␀®Ý␀␀(<␀␀␀␀ÿÿ␀␀ÿ␀␀È␀ÿÿÿÿÿÿÿÿëí␀␀ëí␀␀ëí␀␀]<␀␀␀␀ÿÿ␀␀ÿ␀␀␀o␀␀0;1;2;3;4;5;6;7·þ␀␀		SENIOR;0Ö␀␀/* Triggers para alimentar dados para as tabelas de notificações do painel OEE
 * 
 * Após inserir: alimenta a tabela (E930MPO) de ligação entre tabela de Parada de Recurso e a tabela de 
 * notificações de operações do painel OEE. Essa trigger é definida apenas para oracle para obter o valor do 
 * ID único. No SqlServer o valor do identificador único é gerado através do campo do tipo Identity
 * 
 * Após atualizar: efetua a notificação direta para o painel OEE através de stored procedure
 * 
 * Após excluir: efetua a notificação direta para o painel OEE através de stored procedure e posteriormente 
 * exclui o registro na tabela E930MPO, pois não é feito mais nenhum tratamento com esta tabela.
 */ 
TRIGGER T930MPRAI AFTER INSERT ON E930MPR FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930MPO IS
		   SELECT IDEUNI
		   FROM E930MPO
		   WHERE CODEMP = :NEW.CODEMP AND CODFIL = :NEW.CODFIL AND CODETG = :NEW.CODETG AND CODCRE = :NEW.CODCRE 
		     AND IDEBEM = :NEW.IDEBEM AND DATMPR = :NEW.DATMPR AND CODMTV = :NEW.CODMTV AND SEQMPR = :NEW.SEQMPR;

BEGIN
	INSERT INTO E930MPO (CODEMP, CODFIL, CODETG, CODCRE, IDEBEM, DATMPR, CODMTV, SEQMPR) 
	VALUES (:NEW.CODEMP, :NEW.CODFIL, :NEW.CODETG, :NEW.CODCRE, :NEW.IDEBEM, :NEW.DATMPR, :NEW.CODMTV, :NEW.SEQMPR);
	
	EXISTE := 'N';

	FOREACH CUR_E930MPO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN
		SP_MGOE_NOTIF_CRE(:NEW.CODEMP, :NEW.CODCRE, NULL, NULL, WIDEUNI, 'I');
	END IF; 	
END	ORACLE;0Ô␀␀CREATE OR REPLACE TRIGGER T930MPRAI AFTER INSERT ON E930MPR FOR EACH ROW 
DECLARE WIDEUNI INT;
BEGIN
	ATGETNEXTVALUE ('E930MPO_IDEUNI', 1, NULL, WIDEUNI);	
	INSERT INTO E930MPO (IDEUNI, CODEMP, CODFIL, CODETG, CODCRE, IDEBEM, DATMPR, CODMTV, SEQMPR) 
	     VALUES (WIDEUNI, :NEW.CODEMP, :NEW.CODFIL, :NEW.CODETG, :NEW.CODCRE, :NEW.IDEBEM, :NEW.DATMPR, :NEW.CODMTV, :NEW.SEQMPR);
	SP_MGOE_NOTIF_CRE(:NEW.CODEMP, :NEW.CODCRE, NULL, NULL, WIDEUNI, 'I');	     
END;␀¸þ␀␀		SENIOR;0I␀␀


TRIGGER T930MPRQAU AFTER UPDATE ON E930MPR FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930MPO IS
		   SELECT IDEUNI
		   FROM E930MPO
		   WHERE CODEMP = :NEW.CODEMP AND CODFIL = :NEW.CODFIL AND CODETG = :NEW.CODETG AND CODCRE = :NEW.CODCRE 
		     AND IDEBEM = :NEW.IDEBEM AND DATMPR = :NEW.DATMPR AND CODMTV = :NEW.CODMTV AND SEQMPR = :NEW.SEQMPR;

BEGIN
	EXISTE := 'N';

	FOREACH CUR_E930MPO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN
		SP_MGOE_NOTIF_CRE(:NEW.CODEMP, :NEW.CODCRE, NULL, NULL, WIDEUNI, 'A');
	END IF;  
END␀¶þ␀␀		SENIOR;0␀␀

TRIGGER T930MPRAD AFTER DELETE ON E930MPR FOR EACH ROW
DECLARE
	WIDEUNI INTEGER;
	EXISTE VARCHAR (01);
	CURSOR CUR_E930MPO IS
		   SELECT IDEUNI
		   FROM E930MPO
		   WHERE CODEMP = :OLD.CODEMP AND CODFIL = :OLD.CODFIL AND CODETG = :OLD.CODETG AND CODCRE = :OLD.CODCRE 
		     AND IDEBEM = :OLD.IDEBEM AND DATMPR = :OLD.DATMPR AND CODMTV = :OLD.CODMTV AND SEQMPR = :OLD.SEQMPR;
BEGIN
	EXISTE := 'N';

	FOREACH CUR_E930MPO INTO WIDEUNI
	LOOP
		EXISTE := 'S';
	END LOOP;

	IF EXISTE = 'S' THEN  		    	
		SP_MGOE_NOTIF_CRE(:OLD.CODEMP, :OLD.CODCRE, NULL, NULL, WIDEUNI, 'E');  		
		DELETE E930MPO WHERE IDEUNI = WIDEUNI;   	 
	END IF;
END␀␀␀<È␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀oŒ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀R@␀‰¶␀␀È␀	␀␀␀␀␀␀␀␀
