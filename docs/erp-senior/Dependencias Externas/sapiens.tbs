BEGIN
/* Insere o registro (log) de alterações no cadastro da transportadora */
IF	((:OLD.CODTRA <> 0) AND
	 ((:NEW.CODTRA <> :OLD.CODTRA) OR
	  (upper(rtrim(ltrim(:NEW.NOMTRA))) <> upper(rtrim(ltrim(:OLD.NOMTRA)))) OR
	  (:NEW.TIPTRA <> :OLD.TIPTRA) OR
	  (upper(rtrim(ltrim(:NEW.INSEST))) <> upper(rtrim(ltrim(:OLD.INSEST)))) OR
	  (upper(rtrim(ltrim(:NEW.INSMUN))) <> upper(rtrim(ltrim(:OLD.INSMUN)))) OR
	  (:NEW.CGCCPF <> :OLD.CGCCPF) OR
	  (upper(rtrim(ltrim(:NEW.ENDTRA))) <> upper(rtrim(ltrim(:OLD.ENDTRA)))) OR
	  (upper(rtrim(ltrim(:NEW.CPLEND))) <> upper(rtrim(ltrim(:OLD.CPLEND)))) OR
	  (:NEW.CEPTRA <> :OLD.CEPTRA) OR
	  (upper(rtrim(ltrim(:NEW.BAITRA))) <> upper(rtrim(ltrim(:OLD.BAITRA)))) OR
	  (upper(rtrim(ltrim(:NEW.CIDTRA))) <> upper(rtrim(ltrim(:OLD.CIDTRA)))) OR
	  (:NEW.SIGUFS <> :OLD.SIGUFS) OR
	  (:NEW.CODVIA <> :OLD.CODVIA) OR
	  (:NEW.TRACLI <> :OLD.TRACLI) OR
	  (:NEW.TRAFOR <> :OLD.TRAFOR) OR
	  (:NEW.SITTRA <> :OLD.SITTRA) OR
	  (:NEW.CODGRE <> :OLD.CODGRE) OR
	  (:NEW.CODPAI <> :OLD.CODPAI) OR 
	  (:NEW.DOCIDETRA <> :OLD.DOCIDETRA))) THEN
	SP_T073VTR(	:OLD.CODTRA,	:OLD.NOMTRA,	:OLD.TIPTRA,	:OLD.INSEST,	:OLD.INSMUN,	:OLD.CGCCPF,	:OLD.ENDTRA,	:OLD.CPLEND,	:OLD.CEPTRA,
			:OLD.BAITRA,	:OLD.CIDTRA,	:OLD.SIGUFS,	:OLD.CODVIA,	:OLD.TRACLI,	:OLD.TRAFOR,	:OLD.SITTRA,	0,	:OLD.CODGRE, :OLD.CODPAI, :OLD.DOCIDETRA);
END IF;
END␀uþ␀␀		SENIOR;0␀␀

TRIGGER T073TRAD AFTER DELETE ON E073TRA FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E073ETR.INDEXP%TYPE; 

CURSOR CUR_E073ETR IS
       SELECT INDEXP
       FROM E073ETR
       WHERE CODTRA=:OLD.CODTRA;
BEGIN
EXISTE := 'N';
FOREACH CUR_E073ETR INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E073ETR (CODTRA,INDEXP) VALUES (:OLD.CODTRA,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E073ETR SET INDEXP = 0 WHERE CODTRA=:OLD.CODTRA;
END IF;
END␀␀␀y␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀`Ã‡␀	␀␀␀␀␀␀␀␀¿»␀␀^^A␀␀ƒÿ␀␀ÿ␀ûX␀␀␀␀␀␀␀␀¿»␀␀^^4␀␀␀␀ÿ␀␀@␀ã È␀	␀␀␀␀␀␀␀␀×4C␀×4]<␀␀
