       E120PED.CIFFOB AS E120PED_CIFFOB, E120PED.OBSPED AS E120PED_OBSPED, E120PED.CODROE AS E120PED_CODROE,
       E120PED.SEQROE AS E120PED_SEQROE, E120PED.CODSRO AS E120PED_CODSRO, E120PED.TEMPAR AS E120PED_TEMPAR,
       E120PED.ACEPAR AS E120PED_ACEPAR, E120PED.CODPOR AS E120PED_CODPOR, E120PED.CODCRT AS E120PED_CODCRT,
       E085MCL.BLOFAT AS E085MCL_BLOFAT, E120PED.CODEMP AS E120PED_CODEMP, E120PED.FILFAT AS E120PED_FILFAT,
       E120IPD.RESMAN AS E120IPD_RESMAN, E085CLI.TIPMER AS E085CLI_TIPMER, E120PED.QTDANE AS E120PED_QTDANE,
       E120PED.SOMFRE AS E120PED_SOMFRE, E120PED.FATPED AS E120PED_FATPED,'S' AS EW140FGR_FATURAR,
       E120PED.PERDS5 AS E120PED_PERDS5, E120PED.INDPRE AS E120PED_INDPRE, E120PED.CODFCR AS E120PED_CODFCR,
       E120PED.DATFCR AS E120PED_DATFCR, E120PED.INDITM AS E120PED_INDITM, E120PED.CODITM AS E120PED_CODITM,
	   E120PED.CGCITM AS E120PED_CGCITM, E120PED.CADITM AS E120PED_CADITM, E120PED.CATCLI AS E120PED_CATCLI,
	   E120PED.TIPPED AS E120PED_TIPPED
FROM E120IPD, E075PRO, E120PED, E085MCL, E085CLI, E084PGR
WHERE E120PED.CODCLI = E085CLI.CODCLI AND E120PED.CODEMP = E120IPD.CODEMP AND E120PED.CODFIL = E120IPD.CODFIL AND
      E120PED.NUMPED = E120IPD.NUMPED AND E120IPD.CODEMP = E075PRO.CODEMP AND E120IPD.CODPRO = E075PRO.CODPRO AND
      E084PGR.CODEMP = E120IPD.CODEMP AND E084PGR.CODFXA = E120IPD.CODFXA AND E084PGR.CODPGR = E120IPD.CODPGR AND
      E085MCL.CODCLI = E120PED.CODCLI AND E085MCL.CODEMP = E120PED.CODEMP AND E085MCL.CODMAR = E120PED.CODMAR AND
      E120IPD.PEDPRV = 'N' AND E120IPD.SITIPD IN (1,2) AND
      E120PED.SITPED IN (1,2) AND E120PED.PEDBLO = 'N' AND E085MCL.BLOFAT <> 'S' AND
      NOT EXISTS (SELECT 1 FROM E120EMB,E210EMB
                  WHERE E120EMB.CODEMP=E120PED.CODEMP AND E120EMB.CODFIL=E120PED.CODFIL AND
                        E120EMB.NUMPED=E120PED.NUMPED AND E120EMB.IDXGRD=E120IPD.IDXGRD AND
                        E210EMB.CODEMP=E120EMB.CODEMP AND E210EMB.NUMEMB=E120EMB.NUMEMB AND
                        (E210EMB.CODDEP<>E120IPD.CODDEP OR (E120EMB.SITEMB <> 5 OR E210EMB.SITEMB <> 3))) AND
      EXISTS (SELECT 1 FROM E120EMB
              WHERE E120EMB.CODEMP=E120PED.CODEMP AND E120EMB.CODFIL=E120PED.CODFIL AND
                    E120EMB.NUMPED=E120PED.NUMPED AND E120EMB.IDXGRD=E120IPD.IDXGRD)
GROUP BY E120PED.CODFIL,E120PED.NUMPED,E120PED.QTDABE,E120PED.VLRLIQ,E120PED.DATEMI,E120PED.DATPRV,E120PED.CODCLI,
         E085CLI.NOMCLI,E120IPD.CODPRO,E120IPD.CODDEP,E120IPD.DATENT,E120IPD.RESEST,E120IPD.PREUNI,E120IPD.UNIMED,
         E075PRO.DESPRO,E075PRO.CPLPRO,E120PED.HOREMI,E120PED.TNSPRO,E120PED.CODREP,E120IPD.CODTPR,E075PRO.CODMDP,
         E120PED.INDSIG,E120PED.CODCPG,E120PED.CODMAR,E085CLI.SIGUFS,E120IPD.CODFXA,E120IPD.CODPGR,E120IPD.IDXGRD,
         E084PGR.TOTPRP,E120PED.VLRFUM,E120PED.QTDFRE,E120PED.FORFRE,E120PED.PERDS1,E120PED.PERDS2,E120PED.PERDS3,
         E120PED.PERDS4,E120PED.PEROF1,E120PED.PEROF2,E120PED.SEQENT,E120PED.SEQCOB,E120PED.CODFPG,E120PED.CODTRA,
         E120PED.CODRED,E120PED.CODVIA,E120PED.PLAVEI,E120PED.CIFFOB,E120PED.OBSPED,E120PED.CODROE,E120PED.SEQROE,
         E120PED.CODSRO,E120PED.TEMPAR,E120PED.ACEPAR,E120PED.CODPOR,E120PED.CODCRT,E085MCL.BLOFAT,E120PED.CODEMP,
         E120PED.FILFAT,E120IPD.RESMAN,E085CLI.TIPMER,E120PED.QTDANE,E120PED.SOMFRE,E120PED.FATPED,E120PED.PERDS5,
		 E120PED.INDPRE,E120PED.CODFCR,E120PED.DATFCR,E120PED.INDITM,E120PED.CODITM,E120PED.CGCITM,E120PED.CADITM,
		 E120PED.CATCLI,E120PED.TIPPED
UNION
SELECT SUM(E120IPD.QTDABE) AS EW140FGR_ABEIPD, SUM(E120IPD.VLRLIQ) AS EW140FGR_VLRITE,
       E120PED.CODFIL AS E120PED_CODFIL, E120PED.NUMPED AS E120PED_NUMPED, E120PED.QTDABE AS E120PED_ABEPED,
       E120PED.VLRLIQ AS E120PED_VLRLIQ, E120PED.DATEMI AS E120PED_DATEMI, E120PED.DATPRV AS E120PED_DATPRV,
       E120PED.CODCLI AS E120PED_CODCLI, E085CLI.NOMCLI AS E085CLI_NOMCLI, E120IPD.CODPRO AS E120IPD_CODPRO,
       E120IPD.CODDEP AS E120IPD_CODDEP, E120IPD.DATENT AS E120IPD_DATENT, E120IPD.RESEST AS E120IPD_RESEST,
       E120IPD.PREUNI AS E120IPD_PREUNI, E120IPD.UNIMED AS E120IPD_UNIMED, E075PRO.DESPRO AS E075PRO_DESPRO,
       E075PRO.CPLPRO AS E075PRO_CPLPRO, E120PED.HOREMI AS E120PED_HOREMI, E120PED.TNSPRO AS E120PED_TNSPRO,
       E120PED.CODREP AS E120PED_CODREP, E120IPD.CODTPR AS E120IPD_CODTPR, E075PRO.CODMDP AS E075PRO_CODMDP,
       E120PED.INDSIG AS E120PED_INDSIG, E120PED.CODCPG AS E120PED_CODCPG, E120PED.CODMAR AS E120PED_CODMAR,
       E085CLI.SIGUFS AS E085CLI_SIGUFS, E120IPD.CODFXA AS E120IPD_CODFXA, E120IPD.CODPGR AS E120IPD_CODPGR,
       E120IPD.IDXGRD AS E120IPD_IDXGRD, E084PGR.TOTPRP AS E084PGR_TOTPRP, E120PED.VLRFUM AS E120PED_VLRFUM,
       E120PED.QTDFRE AS E120PED_QTDFRE, E120PED.FORFRE AS E120PED_FORFRE, E120PED.PERDS1 AS E120PED_PERDS1,
       E120PED.PERDS2 AS E120PED_PERDS2, E120PED.PERDS3 AS E120PED_PERDS3, E120PED.PERDS4 AS E120PED_PERDS4,
       E120PED.PEROF1 AS E120PED_PEROF1, E120PED.PEROF2 AS E120PED_PEROF2, E120PED.SEQENT AS E120PED_SEQENT,
       E120PED.SEQCOB AS E120PED_SEQCOB, E120PED.CODFPG AS E120PED_CODFPG, E120PED.CODTRA AS E120PED_CODTRA,
       E120PED.CODRED AS E120PED_CODRED, E120PED.CODVIA AS E120PED_CODVIA, E120PED.PLAVEI AS E120PED_PLAVEI,
       E120PED.CIFFOB AS E120PED_CIFFOB, E120PED.OBSPED AS E120PED_OBSPED, E120PED.CODROE AS E120PED_CODROE,
       E120PED.SEQROE AS E120PED_SEQROE, E120PED.CODSRO AS E120PED_CODSRO, E120PED.TEMPAR AS E120PED_TEMPAR,
       E120PED.ACEPAR AS E120PED_ACEPAR, E120PED.CODPOR AS E120PED_CODPOR, E120PED.CODCRT AS E120PED_CODCRT,
       E085MCL.BLOFAT AS E085MCL_BLOFAT, E120PED.CODEMP AS E120PED_CODEMP, E120PED.FILFAT AS E120PED_FILFAT,
       E120IPD.RESMAN AS E120IPD_RESMAN, E085CLI.TIPMER AS E085CLI_TIPMER, E120PED.QTDANE AS E120PED_QTDANE,
       E120PED.SOMFRE AS E120PED_SOMFRE, E120PED.FATPED AS E120PED_FATPED,'N' AS EW140FGR_FATURAR,
       E120PED.PERDS5 AS E120PED_PERDS5, E120PED.INDPRE AS E120PED_INDPRE, E120PED.CODFCR AS E120PED_CODFCR,
       E120PED.DATFCR AS E120PED_DATFCR, E120PED.INDITM AS E120PED_INDITM, E120PED.CODITM AS E120PED_CODITM,
	   E120PED.CGCITM AS E120PED_CGCITM, E120PED.CADITM AS E120PED_CADITM, E120PED.CATCLI AS E120PED_CATCLI,
	   E120PED.TIPPED AS E120PED_TIPPED
FROM E120IPD, E075PRO, E120PED, E085MCL, E085CLI, E084PGR
WHERE E120PED.CODCLI = E085CLI.CODCLI AND E120PED.CODEMP = E120IPD.CODEMP AND E120PED.CODFIL = E120IPD.CODFIL AND
      E120PED.NUMPED = E120IPD.NUMPED AND E120IPD.CODEMP = E075PRO.CODEMP AND E120IPD.CODPRO = E075PRO.CODPRO AND
      E084PGR.CODEMP = E120IPD.CODEMP AND E084PGR.CODFXA = E120IPD.CODFXA AND E084PGR.CODPGR = E120IPD.CODPGR AND
      E085MCL.CODCLI = E120PED.CODCLI AND E085MCL.CODEMP = E120PED.CODEMP AND E085MCL.CODMAR = E120PED.CODMAR AND
      E120IPD.PEDPRV = 'N' AND E120IPD.SITIPD IN (1,2) AND
      E120PED.SITPED IN (1,2) AND E120PED.PEDBLO = 'N' AND E085MCL.BLOFAT <> 'S' AND
      (EXISTS (SELECT 1 FROM E120EMB,E210EMB
               WHERE E120EMB.CODEMP=E120PED.CODEMP AND E120EMB.CODFIL=E120PED.CODFIL AND
                     E120EMB.NUMPED=E120PED.NUMPED AND E120EMB.IDXGRD=E120IPD.IDXGRD AND
                     E210EMB.CODEMP=E120EMB.CODEMP AND E210EMB.NUMEMB=E120EMB.NUMEMB AND
                     (E210EMB.CODDEP<>E120IPD.CODDEP OR (E120EMB.SITEMB <> 5 OR E210EMB.SITEMB <> 3))) OR
       NOT EXISTS (SELECT 1 FROM E120EMB
                   WHERE E120EMB.CODEMP=E120PED.CODEMP AND E120EMB.CODFIL=E120PED.CODFIL AND
                         E120EMB.NUMPED=E120PED.NUMPED AND E120EMB.IDXGRD=E120IPD.IDXGRD))
GROUP BY E120PED.CODFIL,E120PED.NUMPED,E120PED.QTDABE,E120PED.VLRLIQ,E120PED.DATEMI,E120PED.DATPRV,E120PED.CODCLI,
         E085CLI.NOMCLI,E120IPD.CODPRO,E120IPD.CODDEP,E120IPD.DATENT,E120IPD.RESEST,E120IPD.PREUNI,E120IPD.UNIMED,
         E075PRO.DESPRO,E075PRO.CPLPRO,E120PED.HOREMI,E120PED.TNSPRO,E120PED.CODREP,E120IPD.CODTPR,E075PRO.CODMDP,
         E120PED.INDSIG,E120PED.CODCPG,E120PED.CODMAR,E085CLI.SIGUFS,E120IPD.CODFXA,E120IPD.CODPGR,E120IPD.IDXGRD,
         E084PGR.TOTPRP,E120PED.VLRFUM,E120PED.QTDFRE,E120PED.FORFRE,E120PED.PERDS1,E120PED.PERDS2,E120PED.PERDS3,
         E120PED.PERDS4,E120PED.PEROF1,E120PED.PEROF2,E120PED.SEQENT,E120PED.SEQCOB,E120PED.CODFPG,E120PED.CODTRA,
         E120PED.CODRED,E120PED.CODVIA,E120PED.PLAVEI,E120PED.CIFFOB,E120PED.OBSPED,E120PED.CODROE,E120PED.SEQROE,
         E120PED.CODSRO,E120PED.TEMPAR,E120PED.ACEPAR,E120PED.CODPOR,E120PED.CODCRT,E085MCL.BLOFAT,E120PED.CODEMP,
         E120PED.FILFAT,E120IPD.RESMAN,E085CLI.TIPMER,E120PED.QTDANE,E120PED.SOMFRE,E120PED.FATPED,E120PED.PERDS5,
		 E120PED.INDPRE,E120PED.CODFCR,E120PED.DATFCR,E120PED.INDITM,E120PED.CODITM,E120PED.CGCITM,E120PED.CADITM,
