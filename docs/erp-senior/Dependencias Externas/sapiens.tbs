ž␀␀CREATE PROCEDURE getnextvalueint64 @pKey VARCHAR(255), @pIncrement NUMERIC, @pSelect VARCHAR(1024), @pRet VARCHAR(19) OUTPUT AS
BEGIN
  SET NOCOUNT ON
  DECLARE @rowcount INTEGER
  DECLARE @xNselect NVARCHAR(1024)
  DECLARE @xSelectIndex INTEGER
  DECLARE @xRetBI BIGINT
  SET @xRetBI = NULL

  UPDATE r900nxv SET lstval = lstval + @pIncrement, @xRetBI = lstval + 1 WHERE codpky = @pKey
  SET @rowcount = @@ROWCOUNT
  IF @xRetBI IS NULL
  BEGIN
    IF @rowcount = 1
    DELETE r900nxv WHERE codpky = @pKey
    IF NOT @pSelect IS NULL
    BEGIN
      SET @xNselect = UPPER(@pSelect)
      SET @xSelectIndex = CHARINDEX('@PRET', @xNselect)
      IF @xSelectIndex = 0
      BEGIN
        SET @xSelectIndex = CHARINDEX('SELECT ', @xNselect)
        SET @xNselect = STUFF(@xNselect, @xSelectIndex, 7, 'SELECT @pRet = ')
      END
    ELSE
      SET @xNselect = @pSelect
      EXECUTE sp_executesql @xNselect, N'@pRet INTEGER OUTPUT', @xRetBI OUTPUT
      SET @xRetBI = COALESCE(@xRetBI, 0)
    END
  ELSE
    SET @xRetBI = 0
    INSERT INTO r900nxv (codpky, lstval) VALUES (@pKey, @xRetBI + @pIncrement)
    SET @xRetBI = @xRetBI + 1
  END
  SET @pRet = CONVERT(VARCHAR(19), @xRetBI)
END	POSTGRESQL;0
o␀␀CREATE OR REPLACE PROCEDURE GETNEXTVALUEINT64 (pKey IN VARCHAR, pIncrement IN NUMERIC, pSelect IN VARCHAR, pRet INOUT VARCHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  xAux BIGINT;
BEGIN
  xAux := NULL;
  UPDATE R900NXV SET LSTVAL = LSTVAL + pIncrement WHERE CODPKY = pKey RETURNING (LSTVAL - pIncrement) + 1 INTO xAux;
  IF xAux IS NULL THEN
    IF TRIM(COALESCE(pSelect, '')) <> '' THEN
      EXECUTE PSelect INTO xAux;
    ELSE
      xAux := 0;
    END IF;
    INSERT INTO R900NXV (CODPKY, LSTVAL) VALUES (pKey, xAux + pIncrement);
    xAux := xAux + 1;
  END IF;
  pRet := xAux::varchar;
END;
$BODY$;
␀÷¨␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
œ␀␀/* A janela de execução é grava na tabela R960WIN em intervalos de meia em meia hora.
   Ou seja, o valor 0 representa 00:00 às 00:29, o valor 1 representa das 0:30 às 0:59 e assim por diante, de domingo a sábado */
PROCEDURE MCCheckExecWindow(ATIPSER VARCHAR2(255),ACANEXEC OUT VARCHAR(1),AEXECDATETIME OUT DATE)
 IS

xBaseDate DATE;  
  xTimeNow DATE;
  xCanExec INTEGER;
  xHour INTEGER;
  xHourAux INTEGER;
  xNextHour INTEGER;
  xDayOfWeek INTEGER;
  xDif INTEGER;
  CURSOR xCURSORForw IS SELECT HORBLO FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO > xHour ORDER BY HORBLO;
  CURSOR xCURSORBack IS SELECT HORBLO FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO < xHour ORDER BY HORBLO;
BEGIN
  /* Soma quantas "meia hora" tem na data atual*/
  xBaseDate := CURDATE();
  xTimeNow := CURTIME();
  xDayOfWeek := DAYOFWEEK(xBaseDate);
  /* inicializa o DATETime de retorno com um valor default. BDE não aceita DATETime com valor NULL. */
  aExecDateTime := DATETIME(31,12,1900,0,0,0);
  IF (xDayOfWeek = 1) THEN
    xHour := 0;
  ELSE
    xHour := ((xDayOfWeek-1) * 48)-1;
    /* ajusta a data base para domingo, para calcular a data da proxima execucao*/
    xDif := (-1)*(xDayOfWeek-1);
    xBaseDate := DATETIMEADD(DD, xDif, xBaseDate);
  END IF;  
  xHour := xHour + HOUR(xTimeNow) * 2;    
  IF (MINUTE(xTimeNow) <= 29) THEN
    xHour := xHour + 1;
  ELSE
    xHour := xHour + 2;
  END IF; 
  aCanExec := 'T';    
  xCanExec := 1;
  BEGIN
    SELECT 0 INTO xCanExec FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO = xHour;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
  IF (xCanExec = 0) THEN
    aCanExec := 'F';

    /* está bloqueado neste horário, verifica se pode reagendar e procura o próximo horário disponível */
    
    SELECT 1 INTO xCanExec FROM R900GPR WHERE PRMID = 44 AND PRMVAL <> '0';
    IF (xCanExec = 1) THEN /* testa se pode reagendar para o proximo horário disponível */

      xHourAux := xHour;
      FOREACH xCURSORForw INTO xNextHour
      LOOP
        IF xNextHour = xHourAux + 1 THEN
          xHourAux := xHourAux + 1;
        ELSE 
          EXIT;
        END IF; 
      END LOOP;
      xNextHour := xHourAux + 1;
    
      /* se chegou a 336 foi pra frente até o final da semana e não achou nada, procura do 0 até a hora corrente*/
      IF (xNextHour = 336) THEN
        xHourAux := 0;
        FOREACH xCURSORBack INTO xNextHour
        LOOP
          IF (xNextHour = xHourAux) THEN
           xHourAux := xHourAux + 1;
          ELSE
            EXIT;
          END IF;  
        END LOOP;
        /* se chegou até o final e não encontrou, está tudo bloqueado, retorna 0 */
        IF (xHourAux = xHour) THEN
          aExecDateTime := DATETIME(31,12,1900,0,0,0);
        ELSE
          xDif := (336 + xHourAux)*30;
          aExecDateTime := DATETIMEADD(MI, xDif, xBaseDate);
        END IF; 
      ELSE
        xDif := xNextHour*30;
        aExecDateTime := DATETIMEADD(MI, xDif, xBaseDate);
      END IF;
    END IF;
  END IF;
END␀lç␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0ClearRecentAccess
è␀␀PROCEDURE RegisterAccess(P_MODID IN NUMBER(5), P_CODUSU IN NUMBER(10), P_ITEMID IN NUMBER(10), P_ITKIND IN NUMBER(1), P_DATACC IN DATE) 
IS

	L_COUNTER NUMBER(10);
	L_DATE_LIMIT DATE;
BEGIN
	/* TABELA DE ACESSOS RECENTES*/
	SELECT COUNT(1) INTO L_COUNTER FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	
	IF (L_COUNTER > 0) THEN
		UPDATE R975RAC SET DATACC = P_DATACC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	ELSE
		INSERT INTO R975RAC (MODID, CODUSU, ITEMID, ITKIND, DATACC) VALUES (P_MODID, P_CODUSU, P_ITEMID, P_ITKIND, P_DATACC);
	END IF;
	
	ClearRecentAccess(P_MODID, P_CODUSU, P_ITKIND);
	
	
	/* TABELA DE MAIS ACESSADOS*/
	BEGIN
		SELECT ACCCNT INTO L_COUNTER FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			L_COUNTER := 0;
	END;
	
	IF (L_COUNTER > 0) THEN
		L_COUNTER := L_COUNTER + 1;
		UPDATE R975MAC SET DATACC = P_DATACC, ACCCNT = L_COUNTER WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	ELSE
		INSERT INTO R975MAC (MODID, CODUSU, ITEMID, ITKIND, DATACC, ACCCNT) VALUES (P_MODID, P_CODUSU, P_ITEMID, P_ITKIND, P_DATACC, 1);
	END IF;
	
	L_DATE_LIMIT := DATETIMEADD(DD , -60, P_DATACC);
	
	DELETE FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND DATACC <= L_DATE_LIMIT;
	
	DELETE FROM R975SNS WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID NOT IN (SELECT ITEMID FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU);		 
END␀ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
,␀␀PROCEDURE SP_ADDLOG(PEVTIDT NUMBER,PEVTTIM NUMBER,PEVTUSR NUMBER,PEVTDA1 VARCHAR2(255),PEVTDA2 VARCHAR2(255),PEVTDA3 VARCHAR2(255),PEVTDA4 VARCHAR2(255),PEVTDA5 VARCHAR2(255),PEVTDA6 VARCHAR2(255),PEVTDA7 VARCHAR2(255),PEVTDA8 VARCHAR2(255),PEVTDA9 VARCHAR2(255),PEVTDA10 VARCHAR2(255),PEVTDA11 VARCHAR2(255),PEVTDA12 VARCHAR2(255),PEVTDA13 VARCHAR2(255),PEVTDA14 VARCHAR2(255),PEVTDA15 VARCHAR2(255),PEVTDA16 VARCHAR2(255),PEVTDA17 VARCHAR2(255),PEVTDA18 VARCHAR2(255),PEVTDA19 VARCHAR2(255),PEVTDA20 VARCHAR2(255),PEVTDA21 VARCHAR2(255),PEVTDA22 VARCHAR2(255),PEVTDA23 VARCHAR2(255),PEVTDA24 VARCHAR2(255),PEVTDA25 VARCHAR2(255),PEVTDA26 VARCHAR2(255),PEVTDA27 VARCHAR2(255),PEVTDA28 VARCHAR2(255),PEVTDA29 VARCHAR2(255),PEVTDA30 VARCHAR2(255),PEVTDA31 VARCHAR2(255),PEVTDA32 VARCHAR2(255)) IS
BEGIN
	NULL;
END	ORACLE;0
ôH␀␀CREATE OR REPLACE PROCEDURE SP_ADDLOG(PEVTIDT NUMBER,PEVTTIM NUMBER,PEVTUSR NUMBER,PEVTDA1 VARCHAR2,PEVTDA2 VARCHAR2,PEVTDA3 VARCHAR2,PEVTDA4 VARCHAR2,PEVTDA5 VARCHAR2,PEVTDA6 VARCHAR2,PEVTDA7 VARCHAR2,PEVTDA8 VARCHAR2,PEVTDA9 VARCHAR2,PEVTDA10 VARCHAR2,PEVTDA11 VARCHAR2,PEVTDA12 VARCHAR2,PEVTDA13 VARCHAR2,PEVTDA14 VARCHAR2,PEVTDA15 VARCHAR2,PEVTDA16 VARCHAR2,PEVTDA17 VARCHAR2,PEVTDA18 VARCHAR2,PEVTDA19 VARCHAR2,PEVTDA20 VARCHAR2,PEVTDA21 VARCHAR2,PEVTDA22 VARCHAR2,PEVTDA23 VARCHAR2,PEVTDA24 VARCHAR2,PEVTDA25 VARCHAR2,PEVTDA26 VARCHAR2,PEVTDA27 VARCHAR2,PEVTDA28 VARCHAR2,PEVTDA29 VARCHAR2,PEVTDA30 VARCHAR2,PEVTDA31 VARCHAR2,PEVTDA32 VARCHAR2) IS
  VEVTPOS NUMBER(10);
  VMAXPOS NUMBER(10);
  VEVTNBR NUMBER(10);
  VEVTPOSCNT NUMBER(10);
  VISCIRCULAR BOOLEAN;
  cursor CUR_R900LCN is 
    SELECT R900LCN.EVTPOS EVTPOS,R900LCN.MAXPOS MAXPOS FROM R900LCN R900LCN FOR UPDATE;
begin
  VISCIRCULAR := TRUE;
  open CUR_R900LCN;
  begin
    fetch CUR_R900LCN into VEVTPOS,VMAXPOS;
    while (CUR_R900LCN%FOUND)
    loop
      if (VMAXPOS=-1727) then
        VISCIRCULAR := FALSE;
      end if;
      VEVTNBR := VEVTPOS;
      SELECT 
      COUNT(*) COL_0
       INTO VEVTPOSCNT 
       FROM R900LOG R900LOG
       WHERE EVTPOS=VEVTPOS;
      if (VISCIRCULAR=TRUE) then
        if (VEVTPOSCNT<>1) then
          raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
        end if;
        UPDATE R900LOG SET EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA1, EVTDA2 = PEVTDA2 WHERE EVTPOS=VEVTPOS;
      else
        INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA1,PEVTDA2);
      end if;
      if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
        VEVTPOS := VEVTPOS+1;
      else
        VEVTPOS := 1;
      end if;
      if (NVL(LENGTH(PEVTDA3),0)<>0) then
        SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
        if (VISCIRCULAR=TRUE) then
          if (VEVTPOSCNT<>1) then
            raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
          end if;
          UPDATE R900LOG SET EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA3, EVTDA2 = PEVTDA4 WHERE EVTPOS=VEVTPOS;
        else
          INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA3,PEVTDA4);
        end if;
        if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
          VEVTPOS := VEVTPOS+1;
        else
          VEVTPOS := 1;
        end if;
        if (NVL(LENGTH(PEVTDA5),0)<>0) then
          SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
          if (VISCIRCULAR=TRUE) then
            if (VEVTPOSCNT<>1) then
              raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
            end if;
            UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA5, EVTDA2 = PEVTDA6  WHERE EVTPOS=VEVTPOS;
          else
            INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA5,PEVTDA6);
          end if;
          if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
            VEVTPOS := VEVTPOS+1;
          else
            VEVTPOS := 1;
          end if;
          if (NVL(LENGTH(PEVTDA7),0)<>0) then
            SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
            if (VISCIRCULAR=TRUE) then
              if (VEVTPOSCNT<>1) then
                raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
              end if;
              UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA7, EVTDA2 = PEVTDA8  WHERE EVTPOS=VEVTPOS;
            else
              INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA7,PEVTDA8);
            end if;
            if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
              VEVTPOS := VEVTPOS+1;
            else
              VEVTPOS := 1;
            end if;
            if (NVL(LENGTH(PEVTDA9),0)<>0) then
              SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
              if (VISCIRCULAR=TRUE) then
                if (VEVTPOSCNT<>1) then
                  raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                end if;
                UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA9, EVTDA2 = PEVTDA10  WHERE EVTPOS=VEVTPOS;
              else
                INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA9,PEVTDA10);
              end if;
              if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
                VEVTPOS := VEVTPOS+1;
              else
                VEVTPOS := 1;
              end if;
              if (NVL(LENGTH(PEVTDA11),0)<>0) then
                SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
                if (VISCIRCULAR=TRUE) then
                  if (VEVTPOSCNT<>1) then
                    raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                  end if;
                  UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA11, EVTDA2 = PEVTDA12  WHERE EVTPOS=VEVTPOS;
                else
                  INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA11,PEVTDA12);
