TRIGGER T660ERTAUE AFTER UPDATE ON E660ERT FOR EACH ROW
BEGIN
  IF (:NEW.VLRIMP <> :OLD.VLRIMP) THEN
    SP_ATUVLRIMP_ERT(:NEW.CODEMP, :NEW.CODFIL, :NEW.CODFOR, :NEW.NUMNFI, :NEW.NUMNFF, :NEW.CODSNF, :NEW.CODTNS, :NEW.SEQINC, :NEW.CODIMP, :NEW.VLRIMP);
  END IF;  
END␀¬þ␀␀		SENIOR;0Ô

TRIGGER T660ERTADE AFTER DELETE ON E660ERT FOR EACH ROW
