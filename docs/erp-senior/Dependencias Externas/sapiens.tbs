DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E070EEM.INDEXP%TYPE; 

CURSOR CUR_E070EEM IS
       SELECT INDEXP
       FROM E070EEM
       WHERE CODEMP=:OLD.CODEMP;
BEGIN
EXISTE := 'N';
FOREACH CUR_E070EEM INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E070EEM (CODEMP,INDEXP) VALUES (:OLD.CODEMP,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E070EEM SET INDEXP = 0 WHERE CODEMP = :OLD.CODEMP;
END IF;
END␀␀␀i␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¯_Œ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀␀ƒÿ␀␀R@␀¶µ␀	␀␀␀␀␀␀␀␀d6¶y¶yy<␀␀ƒÿ␀␀V@␀õï␀␀µ␀	␀␀␀␀␀␀␀␀Mñ␀␀âí␀␀Õó␀␀4<␀␀
