DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E085ECO.INDEXP%TYPE; 

CURSOR CUR_E085ECO IS
       SELECT INDEXP
       FROM E085ECO
       WHERE CODCLI=:OLD.CODCLI AND SEQCOB=:OLD.SEQCOB;
BEGIN
EXISTE := 'N';
FOREACH CUR_E085ECO INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E085ECO (CODCLI,SEQCOB,INDEXP) VALUES (:OLD.CODCLI,:OLD.SEQCOB,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E085ECO SET INDEXP = 0 WHERE CODCLI=:OLD.CODCLI AND SEQCOB=:OLD.SEQCOB;
END IF;
