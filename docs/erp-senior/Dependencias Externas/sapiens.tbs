TRIGGER T210EAVI AFTER INSERT ON E210EAV FOR EACH ROW

DECLARE
ALTEROU NUMBER(01);
    SAPIENS NUMBER(01);

    DATA   E210CEV.DATPRC%TYPE; 
    PROCESSO   E210CTR.PRCSAP%TYPE; 

    CURSOR CUR_E210CEV IS
           SELECT DATPRC
           FROM E210CEV
           WHERE CODEMP=:NEW.CODEMP AND
                             CODFIL=:NEW.CODFIL AND
                             DATPRC=:NEW.DATEST;

    CURSOR CUR_E210CTR IS
           SELECT PRCSAP
           FROM E210CTR
           WHERE CODEMP=:NEW.CODEMP AND
                             CODFIL=:NEW.CODFIL AND
                              PRCSAP=0;
BEGIN
    ALTEROU := 0;
    SAPIENS := 1;

    FOREACH CUR_E210CEV INTO DATA 
    LOOP
        ALTEROU := 1;
    END LOOP;

    FOREACH CUR_E210CTR INTO PROCESSO
    LOOP
            SAPIENS := 0;
    END LOOP;

    IF ((ALTEROU=0) AND (SAPIENS=0)) THEN
        INSERT INTO E210CEV (CODEMP, CODFIL, DATPRC) VALUES (:NEW.CODEMP,:NEW.CODFIL,:NEW.DATEST);
    END IF;
END␀¢þ␀␀		SENIOR;0é␀␀TRIGGER T210EAVD AFTER DELETE ON E210EAV FOR EACH ROW

DECLARE
ALTEROU   NUMBER(01);
    SAPIENS     NUMBER(01);

    DATA                   E210CEV.DATPRC%TYPE; 
    PROCESSO      E210CTR.PRCSAP%TYPE; 

    CURSOR CUR_E210CEV IS
           SELECT DATPRC 
           FROM E210CEV
           WHERE CODEMP=:OLD.CODEMP AND
                             CODFIL=:OLD.CODFIL AND
                             DATPRC=:OLD.DATEST;

    CURSOR CUR_E210CTR IS
           SELECT PRCSAP
           FROM E210CTR
           WHERE CODEMP=:OLD.CODEMP AND
                             CODFIL=:OLD.CODFIL AND
                              PRCSAP=0;
BEGIN
    ALTEROU := 0;
    SAPIENS := 1;

    FOREACH CUR_E210CEV INTO DATA
    LOOP
        ALTEROU := 1;
    END LOOP;

    FOREACH CUR_E210CTR INTO PROCESSO
    LOOP
                SAPIENS := 0;
    END LOOP;

    IF  ((ALTEROU=0) AND (SAPIENS=0)) THEN
        INSERT INTO E210CEV (CODEMP, CODFIL, DATPRC) VALUES (:OLD.CODEMP,:OLD.CODFIL,:OLD.DATEST);
