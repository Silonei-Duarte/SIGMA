END;	MSSQL;0ãCREATE TRIGGER rtc_replicationdef_si ON RTC_REPLICATIONDEF FOR INSERT AS
BEGIN
  UPDATE R900GPR SET PRMVAL = 'TRUE' WHERE PRMID = 220; 
  IF @@ROWCOUNT = 0
    INSERT INTO R900GPR (PRMID, PRMVAL) VALUES (220, 'TRUE');
END;	POSTGRESQL;0­␀␀DO $$BEGIN
CREATE OR REPLACE FUNCTION rtc_replicationdef_si$tf()
RETURNS TRIGGER
LANGUAGE PLPGSQL
AS
$PL$
BEGIN
  UPDATE R900GPR SET PRMVAL = 'TRUE' WHERE PRMID = 220;
  IF NOT FOUND THEN
    INSERT INTO R900GPR (PRMID, PRMVAL) VALUES  (220, 'TRUE');
  END IF;
  RETURN NEW;
END
$PL$;

CREATE TRIGGER rtc_replicationdef_si BEFORE INSERT ON RTC_REPLICATIONDEF
	EXECUTE FUNCTION rtc_replicationdef_si$tf();
END $$;␀5ä␀␀	SENIOR;0S

