	 ((:NEW.CODFOR <> :OLD.CODFOR) OR (upper(rtrim(ltrim(:NEW.NOMFOR))) <> upper(rtrim(ltrim(:OLD.NOMFOR)))) OR 
	 (:NEW.TIPFOR <> :OLD.TIPFOR) OR  (:NEW.TIPMER <> :OLD.TIPMER) OR (:NEW.CODRAM <> :OLD.CODRAM) OR 
                 (upper(rtrim(ltrim(:NEW.INSEST))) <> upper(rtrim(ltrim(:OLD.INSEST)))) OR (upper(rtrim(ltrim(:NEW.INSMUN))) <> upper(rtrim(ltrim(:OLD.INSMUN)))) OR 
                 (:NEW.CGCCPF <> :OLD.CGCCPF) OR (:NEW.CODGRE <> :OLD.CODGRE) OR (upper(rtrim(ltrim(:NEW.CODSUF))) <> upper(rtrim(ltrim(:OLD.CODSUF)))) OR 
                 (upper(rtrim(ltrim(:NEW.ENDFOR))) <> upper(rtrim(ltrim(:OLD.ENDFOR)))) OR (upper(rtrim(ltrim(:NEW.CPLEND))) <> upper(rtrim(ltrim(:OLD.CPLEND)))) OR
                 (upper(rtrim(ltrim(:NEW.BAIFOR))) <> upper(rtrim(ltrim(:OLD.BAIFOR)))) OR (:NEW.CEPFOR <> :OLD.CEPFOR) OR 
                 (upper(rtrim(ltrim(:NEW.CIDFOR))) <> upper(rtrim(ltrim(:OLD.CIDFOR)))) OR (:NEW.SIGUFS <> :OLD.SIGUFS) OR (:NEW.CODCLI <> :OLD.CODCLI) OR 
                 (:NEW.USUATU <> :OLD.USUATU) OR (:NEW.SITFOR <> :OLD.SITFOR) OR (:NEW.CODPAI <> :OLD.CODPAI) OR 
	 (:NEW.FORREP <> :OLD.FORREP) OR (:NEW.FORTRA <> :OLD.FORTRA) OR (upper(rtrim(ltrim(:NEW.CODTRI))) <> upper(rtrim(ltrim(:OLD.CODTRI)))) OR 
	 (:NEW.GERDIR <> :OLD.GERDIR) OR (:NEW.QTDDEP <> :OLD.QTDDEP) OR (:NEW.RECPIS <> :OLD.RECPIS) OR (:NEW.PERPID <> :OLD.PERPID) OR
	 (:NEW.TRIISS <> :OLD.TRIISS) OR (:NEW.RECCOF <> :OLD.RECCOF) OR (:NEW.PERCOD <> :OLD.PERCOD) OR (:NEW.RETCOF <> :OLD.RETCOF) OR 
	 (:NEW.RETCSL <> :OLD.RETCSL) OR (:NEW.RETPIS <> :OLD.RETPIS) OR (:NEW.RETOUR <> :OLD.RETOUR) OR (:NEW.RECIPI <> :OLD.RECIPI) OR 
	 (:NEW.RECICM <> :OLD.RECICM) OR (:NEW.TRIICM <> :OLD.TRIICM) OR (:NEW.TRIIPI <> :OLD.TRIIPI) OR (:NEW.RETPRO <> :OLD.RETPRO) OR
	 (:NEW.RETIRF <> :OLD.RETIRF) OR (:NEW.INDFOR <> :OLD.INDFOR) OR (:NEW.LIMRET <> :OLD.LIMRET) OR (:NEW.NUMNIS <> :OLD.NUMNIS) OR 
	 (:NEW.ORGEMI <> :OLD.ORGEMI) OR (:NEW.DATEXD <> :OLD.DATEXD) OR (:NEW.DATNAS <> :OLD.DATNAS) OR (:NEW.NUMCBO <> :OLD.NUMCBO) OR 
	 (:NEW.CATFOR <> :OLD.CATFOR) OR (:NEW.DOCIDE <> :OLD.DOCIDE)) OR
	 (upper(rtrim(ltrim(:NEW.NUMRGE))) <> upper(rtrim(ltrim(:OLD.NUMRGE)))) OR (:NEW.INDCOO <> :OLD.INDCOO))  THEN
	SP_T095VFO(	:OLD.CODFOR,	:OLD.DATATU,	:OLD.HORATU,	:OLD.NOMFOR,	:OLD.TIPFOR,	:OLD.TIPMER,	:OLD.CODRAM,	:OLD.INSEST,	:OLD.INSMUN,
			:OLD.CGCCPF,	:OLD.CODGRE,	:OLD.CODSUF,	:OLD.ENDFOR,	:OLD.CPLEND,	:OLD.BAIFOR,	:OLD.CEPFOR,	:OLD.CIDFOR,	:OLD.SIGUFS,	:OLD.CODCLI,
			:OLD.USUATU,	:OLD.SITFOR,	:OLD.CODPAI,	:OLD.FORREP,	:OLD.FORTRA,	:OLD.CODTRI,	:OLD.GERDIR,	:OLD.QTDDEP,	:OLD.RECPIS,	:OLD.PERPID,
			:OLD.TRIISS,	:OLD.RECCOF,	:OLD.PERCOD,	:OLD.RETCOF,	:OLD.RETCSL,	:OLD.RETPIS,	:OLD.RETOUR,	:OLD.RECIPI,	:OLD.RECICM,	:OLD.TRIICM,
			:OLD.TRIIPI,	:OLD.RETPRO,	:OLD.RETIRF,	:OLD.INDFOR,	:OLD.LIMRET,	:OLD.NUMRGE,    :OLD.INDCOO,    :OLD.NUMNIS,    :OLD.ORGEMI,    :OLD.DATEXD, 
			:OLD.DATNAS,    :OLD.NUMCBO,    :OLD.CATFOR,    :OLD.DOCIDE);
END IF;
