TRIGGER E642LCTAI AFTER INSERT ON E642LCT FOR EACH ROW

DECLARE
WMESANO DATE;
BEGIN

/* Monta a data do mês/ano em questão */
WMESANO := DATETIME(01,MONTH(:NEW.DATLCT),YEAR(:NEW.DATLCT),0,0,0);

/* Somente lançamentos situação 2 (Contabilizado) atualizam saldo */
IF   (:NEW.SITAUX = 2) THEN
     SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,:NEW.VLRLCT,:NEW.DEBCRE);
END IF;
END␀Wj		SENIOR;0Á␀␀

TRIGGER E642LCTAU AFTER UPDATE ON E642LCT FOR EACH ROW

DECLARE
WMESANO DATE;
WVLRAUX NUMBER(17,2);
WDIFLCT NUMBER(17,2);
BEGIN

/* Monta a data do mês/ano em questão */
WMESANO := DATETIME(01,MONTH(:OLD.DATLCT),YEAR(:OLD.DATLCT),0,0,0);

/* Trata excessões que não podem ser executadas */
IF   (:OLD.SITAUX = 3) AND (:NEW.SITAUX = 2) THEN
     RAISERROR 103 'Trigger: Alteração de Situação de Excluído para Contabilizado não é Permitido';
END IF;
IF   (:OLD.SITAUX = 4) AND (:NEW.SITAUX <> 2) THEN
     RAISERROR 103 'Trigger: A situação Eliminada (4) somente poderá ser retornada para situação Contabilizado (2)';
END IF;

/* Alterações de situações : */
/* OLD |NEW | Ação no Saldo                */
/*----------------------------------------------------- */
/* 1   | 1  | Não faz nada                              */
/* 1   | 2  | Soma novo valor                      */
/* 1   | 3  | Não faz nada                              */
/* 2   | 1  | Diminui o novo valor                 */
/* 2   | 2  | Diferença velho e novo          */
/* 2   | 3  | Diminui valor                               */
/* 3   | 1  | Não faz nada                              */
/* 3   | 2  | Erro. não suportado                 */
/* 3   | 3  | Não faz nada                              */
/**** Condições para Eliminação de Históricos - somente para estes casos   ****/  
/* 2   | 4  | Diminui valor             = 2->3 | HP - Não faz nada                     */
/* 4   | 2  | Soma Novo Valor   = 1->2 | HP - Não faz nada                     */


IF   (:OLD.SITAUX = 1) AND (:NEW.SITAUX = 2) THEN
      WDIFLCT := :NEW.VLRLCT;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);

ELSIF (:OLD.SITAUX = 2) AND (:NEW.SITAUX = 1) THEN
      WDIFLCT := -:OLD.VLRLCT;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);

ELSIF (:OLD.SITAUX = 2) AND (:NEW.SITAUX = 2) THEN
      IF   (:OLD.CTAAUX <> :NEW.CTAAUX) THEN
           /* elimina qualquer informação da conta  anterior */
           WVLRAUX := (:OLD.VLRLCT * -1);
           SP_ATUCONTASAUX(:OLD.CODEMP,:OLD.CODFIL,WMESANO,:OLD.CTAAUX,:OLD.CTARED,WVLRAUX,:OLD.DEBCRE);
      END IF;

      WDIFLCT := :NEW.VLRLCT;
      IF  (:OLD.CTAAUX = :NEW.CTAAUX) THEN
           WDIFLCT := :NEW.VLRLCT - :OLD.VLRLCT;
      END IF;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);

ELSIF (:OLD.SITAUX = 2) AND (:NEW.SITAUX = 3) THEN
      WDIFLCT := -:OLD.VLRLCT;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);

ELSIF (:OLD.SITAUX = 2) AND (:NEW.SITAUX = 4) THEN
      WDIFLCT := -:OLD.VLRLCT;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);

ELSIF (:OLD.SITAUX = 4) AND (:NEW.SITAUX = 2) THEN
      WDIFLCT := :NEW.VLRLCT;
      SP_ATUCONTASAUX(:NEW.CODEMP,:NEW.CODFIL,WMESANO,:NEW.CTAAUX,:NEW.CTARED,WDIFLCT,:NEW.DEBCRE);
END IF;
END␀Uj		SENIOR;0²␀␀TRIGGER E642LCTAD AFTER DELETE ON E642LCT FOR EACH ROW

DECLARE
WMESANO DATE;
WVLRAUX NUMBER(17,2);
BEGIN
/* Monta a data do mês/ano em questão */
WMESANO := DATETIME(01,MONTH(:OLD.DATLCT),YEAR(:OLD.DATLCT),0,0,0);

/* Somente Lançamentos Contabilizados  */
IF   (:OLD.SITAUX = 2)   THEN
     WVLRAUX := (:OLD.VLRLCT * -1);
