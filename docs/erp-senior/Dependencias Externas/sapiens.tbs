␀”ÿ␀␀†@␀=‚␀␀µ␀␀␀␀␀␀␀␀␀P„␀␀©‚␀␀Z„␀␀&=␀␀␀ƒÿ␀␀¨@␀␀␀␀0;1;2ìj		SENIOR;0i␀␀TRIGGER E650PMAAI AFTER INSERT ON E650PMA FOR EACH ROW

DECLARE
MENSAGEM VARCHAR (250); 
ANO INTEGER;
MES INTEGER;
DIA INTEGER;
BEGIN
    IF (DAYOFMONTH(:NEW.MESANO) <> 01) THEN
        ANO := Year(:NEW.MESANO);
        MES := MONTH(:NEW.MESANO);
        DIA := DAYOFMONTH(:NEW.MESANO);

        MENSAGEM := CONCAT(CONCAT(CONCAT(CONVERT(NUMBER_TO_CHAR, DIA), '/'), CONCAT(CONVERT(NUMBER_TO_CHAR, MES), '/')), CONVERT(NUMBER_TO_CHAR, ANO));	  
        MENSAGEM := CONCAT('Trigger E650PMAAI: O campo "MESANO" tem que estar no primeiro dia do mês! MESANO: ', MENSAGEM);
  
        RAISERROR 103 MENSAGEM;
    END IF;
