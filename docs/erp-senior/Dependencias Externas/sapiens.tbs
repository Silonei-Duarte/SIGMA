TRIGGER T095FORD AFTER DELETE ON E095FOR FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WSITREG   E098REG.SITREG%TYPE;
WINDEXP   E095EFO.INDEXP%TYPE; 

CURSOR CUR_E098REG IS
       SELECT SITREG FROM E098REG
       WHERE MODSIS='GER' AND IDEREG='000INTMV01';
CURSOR CUR_E095EFO IS
       SELECT INDEXP
       FROM E095EFO
       WHERE CODFOR=:OLD.CODFOR;
BEGIN
WSITREG := 'I';
FOREACH CUR_E098REG INTO WSITREG
   LOOP
   EXISTE := 'N';
   END LOOP;

IF ((WSITREG = 'A') AND (:OLD.TIPINT <> 0)) OR (WSITREG='I') THEN
   EXISTE := 'N';
   FOREACH CUR_E095EFO INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
   IF (EXISTE = 'N') THEN
       INSERT INTO E095EFO (CODFOR,INDEXP,CGCCPF,DOCIDE) VALUES (:OLD.CODFOR,0,:OLD.CGCCPF,:OLD.DOCIDE);
   END IF;
   IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
      UPDATE E095EFO SET INDEXP = 0 WHERE CODFOR=:OLD.CODFOR;
   END IF;
END IF;
