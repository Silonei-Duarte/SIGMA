x␀␀create or replace PROCEDURE GETNEXTVALUE (pKey IN VARCHAR2, pIncrement IN NUMBER, pSelect IN VARCHAR2, pRet OUT NUMBER) AS
cMaxVal NUMBER(10) := 9999999999;
BEGIN
  UPDATE R900NXV SET LSTVAL = LSTVAL + pIncrement WHERE CODPKY = pKey RETURNING (LSTVAL - pIncrement) + 1 INTO pRet;
  IF pRet IS NULL THEN
    IF NOT trim(pSelect) IS NULL THEN
      EXECUTE IMMEDIATE PSelect INTO pRet;
    ELSE
      pRet := 0;
    END IF;
    INSERT INTO R900NXV (CODPKY, LSTVAL) VALUES (pKey, pRet + pIncrement);
    pRet := pRet + 1;
  END IF;
  /*artifício para gerar overflow*/
  IF pRet > cMaxVal THEN
    cMaxVal := cMaxVal + 1;
  END IF;
END;	MSSQL;0
;␀␀CREATE PROCEDURE getnextvalue @pKey VARCHAR(255), @pIncrement NUMERIC, @pSelect VARCHAR(1024), @pRet NUMERIC OUTPUT AS
BEGIN
  SET NOCOUNT ON
  DECLARE @rowcount INTEGER
  DECLARE @xNselect NVARCHAR(1024)
  DECLARE @xSelectIndex INTEGER
  SET @pRet = NULL

  UPDATE r900nxv SET lstval = lstval + @pIncrement, @pRet = lstval + 1 WHERE codpky = @pKey
  SET @rowcount = @@ROWCOUNT
  IF @pRet IS NULL
  BEGIN
    IF @rowcount = 1
    DELETE r900nxv WHERE codpky = @pKey
    IF @pSelect IS NOT NULL
    BEGIN
      SET @xNselect = UPPER(@pSelect)
      SET @xSelectIndex = CHARINDEX('@PRET', @xNselect)
      IF @xSelectIndex = 0
      BEGIN
        SET @xSelectIndex = CHARINDEX('SELECT ', @xNselect)
        SET @xNselect = STUFF(@pSelect, @xSelectIndex, 7, 'SELECT @pRet = ')
      END
    ELSE
      SET @xNselect = @pSelect
      EXECUTE sp_executesql @xNselect, N'@pRet INTEGER OUTPUT', @pRet OUTPUT
      SET @pRet = COALESCE(@pRet, 0)
    END
  ELSE
    SET @pRet = 0
    INSERT INTO r900nxv (codpky, lstval) VALUES (@pKey, @pRet + @pIncrement)
    SET @pRet = @pRet + 1
  END
END	POSTGRESQL;0
¼␀␀CREATE OR REPLACE PROCEDURE GETNEXTVALUE (pKey IN VARCHAR, pIncrement IN NUMERIC, pSelect IN VARCHAR, pRet INOUT NUMERIC)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  cMaxVal NUMERIC(10) := 9999999999;
BEGIN
  UPDATE R900NXV SET LSTVAL = LSTVAL + pIncrement WHERE CODPKY = pKey RETURNING (LSTVAL - pIncrement) + 1 INTO pRet;
  IF pRet IS NULL THEN
    IF TRIM(COALESCE(pSelect, '')) <> '' THEN
      EXECUTE PSelect INTO pRet;
    ELSE
      pRet := 0;
    END IF;
    INSERT INTO R900NXV (CODPKY, LSTVAL) VALUES (pKey, pRet + pIncrement);
    pRet := pRet + 1;
  END IF;
  /*artifício para gerar overflow*/
  IF pRet > cMaxVal THEN
    cMaxVal := cMaxVal + 1;
  END IF;
END;
$BODY$;
