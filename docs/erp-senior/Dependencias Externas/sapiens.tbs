DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E008ERA.INDEXP%TYPE; 

CURSOR CUR_E008ERA IS
       SELECT INDEXP
       FROM E008ERA
       WHERE CODRAI=:OLD.CODRAI;
BEGIN
EXISTE := 'N';
FOREACH CUR_E008ERA INTO WINDEXP
          LOOP
          EXISTE := 'S';
          END LOOP;
IF (EXISTE = 'N') THEN
    INSERT INTO E008ERA (CODRAI,INDEXP) VALUES (:OLD.CODRAI,0);
END IF;
IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
   UPDATE E008ERA SET INDEXP = 0 WHERE CODRAI = :OLD.CODRAI;
END IF;
