DECLARE
l_verseq     NUMBER(10);
  l_seqreg     NUMBER(15);
  l_veraud     CHAR(1);
BEGIN
  l_veraud := 'N';
  SP_AUDVER(l_veraud OUT,'R900CPL');

  IF (l_veraud = 'S') THEN
      SP_AUDGETVERSEQ(0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;
      BEGIN
          INSERT INTO R900ACP (SEQREG,VERSEQ,PERID,FUSO,HORVER,EMAIL,PRXUSR,PRXPSW)
                        VALUES (l_seqreg,l_verseq,:NEW.PERID,:NEW.FUSO,:NEW.HORVER,:NEW.EMAIL,:NEW.PRXUSR,:NEW.PRXPSW);

          SP_AUDGENREG(l_seqreg,l_verseq,'R900CPL','INSERÇÃO');
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'R900CPL_EI. Erro gerar registro para auditoria.';
      END;
  END IF;
END␀®â␀␀		SENIOR;0(	␀␀

TRIGGER R900CPL_EU AFTER UPDATE ON R900CPL FOR EACH ROW

DECLARE
l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_veraud           CHAR(1);
BEGIN
  l_veraud := 'N';
  SP_AUDVER(l_veraud OUT,'R900CPL');

  IF (l_veraud = 'S') THEN
      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.PERID <> :OLD.PERID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PERID ';
      END IF;

      IF (:NEW.FUSO <> :OLD.FUSO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FUSO ';
      END IF;

      IF (:NEW.HORVER <> :OLD.HORVER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORVER ';
      END IF;

      IF (:NEW.EMAIL <> :OLD.EMAIL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMAIL ';
      END IF;

      IF (:NEW.PRXUSR <> :OLD.PRXUSR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRXUSR ';
      END IF;

      IF (:NEW.PRXPSW <> :OLD.PRXPSW) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRXPSW ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;
          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN
              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg  FROM R900ACP WHERE PERID = :OLD.PERID;
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'R900CPL_EU. Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ(l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R900ACP (SEQREG, VERSEQ, PERID, FUSO, HORVER, EMAIL, PRXUSR, PRXPSW)
                           VALUES (l_seqreg,l_verseq,:NEW.PERID,:NEW.FUSO,:NEW.HORVER,:NEW.EMAIL,:NEW.PRXUSR,:NEW.PRXPSW);

              SP_AUDGENREG(l_seqreg,l_verseq,'R900CPL',l_camposAlterados);
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'R900CPL_EU. Erro gerar registro para auditoria. ';
          END;
          
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀¬â␀␀		SENIOR;0‚␀␀

TRIGGER R900CPL_ED AFTER DELETE ON R900CPL FOR EACH ROW

DECLARE
l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_veraud       CHAR(1);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_veraud := 'N';
  SP_AUDVER(l_veraud OUT,'R900CPL');

  IF (l_veraud = 'S') THEN

      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN
          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg  FROM R900ACP WHERE PERID = :OLD.PERID;
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'R900CPL_ED. Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ(l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R900ACP (SEQREG,VERSEQ,PERID,FUSO,HORVER,EMAIL,PRXUSR,PRXPSW)
                        VALUES (l_seqreg,l_verseq,:OLD.PERID,:OLD.FUSO,:OLD.HORVER,:OLD.EMAIL,:OLD.PRXUSR,:OLD.PRXPSW);

          SP_AUDGENREG(l_seqreg,l_verseq,'R900CPL','DELETE');
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'R900CPL_ED. Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀&#␀␀␀␀␀␀␀␀␀¯â␀␀%¶␀␀°␀	␀␀␀␀␀␀␀␀ì¼␀␀ë¼␀␀ë¼␀␀E<␀␀ƒÿ␀␀ÿ␀5@µ␀	␀␀␀␀␀␀␀␀~õ␀␀õ␀␀õ␀␀ÿ␀ƒÿ␀␀ÿ␀2@.␀␀␀␀␀␀␀␀ï¾␀␀Ö¾␀␀Ö¾␀␀ü␀␀ÿ␀␀ÿ␀6@.␀␀␀␀␀␀␀␀¿␀␀õ¾␀␀õ¾␀␀ü␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀v␀␀␀␀␀°â␀␀ ¶␀␀°␀	␀␀␀␀␀␀␀␀V½␀␀Ê·␀␀Q½␀␀E<␀␀ƒÿ␀␀ÿ␀5@µ␀	␀␀␀␀␀␀␀␀qõ␀␀õ␀␀õ␀␀ÿ␀ƒÿ␀␀ÿ␀2@.␀␀␀␀␀␀␀␀í¾␀␀Ö¾␀␀Ö¾␀␀ü␀␀ÿ␀␀ÿ␀6@.␀␀␀␀␀␀␀␀
