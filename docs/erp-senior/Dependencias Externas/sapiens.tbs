       TO_CHAR(b.CodEmp)        AS CODEMP,
       TO_CHAR(b.CodFil)        AS CODFIL,
       TO_CHAR(b.NumPed)        AS NUMPED,
       b.DatEmi                 AS DATEMI,
       TO_CHAR(b.CodCli)        AS CODCLI,
       b.NomCli                 AS NOMCLI,
       TO_CHAR(b.SeqIpd)        AS SEQIPD,      
       TRIM(b.CodPro) || TRIM(b.CodDer)                 AS CODPRO,
       b.DesPro                 AS DESPRO,
       b.PreUni                 AS PREUNI,       
       b.Saldo                  AS QTDPED,       
       b.Saldo - NVL(b.QtdFat, 0)                       AS QTDABE,
       b.QtdAbeIpd              AS QTDABEIPD,
       b.QtdCan                 AS QTDCAN,
       b.NumAne                 AS NUMANE,
       TO_CHAR(b.NumPfa)        AS NUMPFA,
       TO_CHAR(b.NumNfv)        AS NUMNFV,
       b.QtdPpf                 AS QTDPPF,
       b.QtdFat                 AS QTDFAT,
       b.DatEnt                 AS DATENT,
       b.DatDpe                 AS DATDPE,
       b.DatGer                 AS DATGER,       
       CASE WHEN b.DatDpe IS NULL           THEN NULL
            WHEN b.DatGer IS NOT NULL       THEN CASE WHEN b.DatGer > b.DatDpe THEN 'Atrasado' ELSE 'OK' END
            WHEN TRUNC(SYSDATE) > b.DatDpe  THEN 'Atrasado'
            ELSE NULL END                                                                           AS STSPE,
       b.DatDpf                 AS DATDPF,
       b.DatEmiFat              AS DATEMIFAT,      
       CASE WHEN b.DatDpf IS NULL           THEN NULL
            WHEN b.DatEmiFat IS NOT NULL    THEN CASE WHEN b.DatEmiFat > b.DatDpf THEN 'Atrasado' ELSE 'OK' END
            WHEN TRUNC(SYSDATE) > b.DatDpf  THEN 'Atrasado'
            ELSE NULL END                                                                           AS STSPF,
       b.DatDde                 AS DATDDE,
       b.DatCmc                 AS DATCMC,      
       CASE WHEN b.DatDde IS NULL           THEN NULL
            WHEN b.DatCmc IS NOT NULL       THEN CASE WHEN b.DatCmc > b.DatDde THEN 'Atrasado' ELSE 'OK' END
            WHEN TRUNC(SYSDATE) > b.DatDde  THEN 'Atrasado'
            ELSE NULL END                                                                           AS STSENT,       
       NULLIF(GREATEST( NVL(CASE WHEN b.DatDpe IS NULL     THEN NULL
                                 WHEN b.DatGer IS NOT NULL THEN (b.DatGer - b.DatDpe)
                                 ELSE (TRUNC(SYSDATE) - b.DatDpe) END, -999999),
                        NVL(CASE WHEN b.DatDpf IS NULL        THEN NULL
                                 WHEN b.DatEmiFat IS NOT NULL THEN (b.DatEmiFat - b.DatDpf)
                                 ELSE (TRUNC(SYSDATE) - b.DatDpf) END, -999999),
                        NVL(CASE WHEN b.DatDde IS NULL     THEN NULL
                                 WHEN b.DatCmc IS NOT NULL THEN (b.DatCmc - b.DatDde)
                                 ELSE (TRUNC(SYSDATE) - b.DatDde) END, -999999) ), -999999)         AS ATRASO
  FROM ( SELECT i.CodEmp                                       AS CodEmp,
                i.CodFil                                       AS CodFil,
                p.NumPed                                       AS NumPed,
                p.DatEmi                                       AS DatEmi,
                p.CodCli                                       AS CodCli,
                c.NomCli                                       AS NomCli,
                i.SeqIpd                                       AS SeqIpd,
                i.CodPro                                       AS CodPro,
                i.CodDer                                       AS CodDer,
                pr.DesPro                                      AS DesPro,
                i.PreUni                                       AS PreUni,
                i.QtdPed                                       AS QtdPedIpd,
                i.QtdAbe                                       AS QtdAbeIpd,
                i.QtdCan                                       AS QtdCan,                
                i.QtdPed - NVL( (SELECT SUM(ipv2.QtdFat)
                                   FROM E135PES pf2
                                   LEFT JOIN E140IPV ipv2 ON ipv2.CodEmp = pf2.CodEmp
                                                         AND ipv2.CodFil = pf2.FilNfv
                                                         AND ipv2.CodSnf = pf2.SnfNfv
                                                         AND ipv2.NumNfv = pf2.NumNfv
                                                         AND ipv2.SeqIpv = pf2.SeqIpv
                                  WHERE pf2.CodEmp = i.CodEmp
                                    AND pf2.CodFil = i.CodFil
                                    AND pf2.NumPed = i.NumPed
                                    AND pf2.SeqIpd = i.SeqIpd
                                    AND pf2.NumPfa < pf.NumPfa), 0)          AS Saldo,
                pf.NumAne                                      AS NumAne,
                pf.NumPfa                                      AS NumPfa,
                pf.NumNfv                                      AS NumNfv,
                pf.SeqIpv                                      AS SeqIpv,
                pf.QtdPpf                                      AS QtdPpf,
                ipv.QtdFat                                     AS QtdFat,
                pfa.DatGer                                     AS DatGer,
                nf.DatEmi                                      AS DatEmiFat,
                nf.DatCmc                                      AS DatCmc,
                p.USU_PrvEnt                                   AS DatEnt,                
                (CASE WHEN c.USU_IndAge = 'S' AND agc.MaxDatAge IS NOT NULL
                      THEN agc.MaxDatAge - (p.USU_DiaOpe + p.USU_DiaEnt)
                      ELSE p.USU_PrvEst END)                   AS DatDpe,                
                (CASE WHEN c.USU_IndAge = 'S' AND agc.MaxDatAge IS NOT NULL
                      THEN agc.MaxDatAge - p.USU_DiaOpe
                      ELSE p.USU_PrvFat END)                   AS DatDpf,               
                (CASE WHEN c.USU_IndAge = 'S' AND agc.MaxDatAge IS NOT NULL
                      THEN agc.MaxDatAge
                      ELSE p.USU_PrvEnt END)                   AS DatDde
           FROM E120IPD i
           INNER JOIN E120PED p ON p.CodEmp = i.CodEmp
                               AND p.CodFil = i.CodFil
                               AND p.NumPed = i.NumPed
           INNER JOIN E085CLI c ON c.CodCli = p.CodCli
           INNER JOIN E075PRO pr ON pr.CodEmp = i.CodEmp
                                AND pr.CodPro = i.CodPro           
           LEFT JOIN ( SELECT pes.CodEmp, pes.CodFil, pes.NumPed, MAX(pfx.DatAge) AS MaxDatAge
                         FROM E135PES pes
                         INNER JOIN E135PFA pfx ON pfx.CodEmp = pes.CodEmp
                                               AND pfx.CodFil = pes.CodFil
                                               AND pfx.NumAne = pes.NumAne
                                               AND pfx.NumPfa = pes.NumPfa
                        WHERE pfx.SitPfa IN (2, 3, 8)
                        GROUP BY pes.CodEmp, pes.CodFil, pes.NumPed ) agc
                  ON agc.CodEmp = i.CodEmp
                 AND agc.CodFil = i.CodFil
                 AND agc.NumPed = i.NumPed
           LEFT JOIN E135PES pf ON pf.CodEmp = i.CodEmp
                               AND pf.CodFil = i.CodFil
                               AND pf.NumPed = i.NumPed
                               AND pf.SeqIpd = i.SeqIpd
           LEFT JOIN E135PFA pfa ON pfa.CodEmp = pf.CodEmp
                                AND pfa.CodFil = pf.CodFil
                                AND pfa.NumAne = pf.NumAne
                                AND pfa.NumPfa = pf.NumPfa
           LEFT JOIN E140NFV nf ON nf.CodEmp = pf.CodEmp
                               AND nf.CodFil = pf.FilNfv
                               AND nf.CodSnf = pf.SnfNfv
                               AND nf.NumNfv = pf.NumNfv
           LEFT JOIN E140IPV ipv ON ipv.CodEmp = pf.CodEmp
                                AND ipv.CodFil = pf.FilNfv
                                AND ipv.CodSnf = pf.SnfNfv
                                AND ipv.NumNfv = pf.NumNfv
                                AND ipv.SeqIpv = pf.SeqIpv
          WHERE p.SitPed NOT IN (5)
            AND i.SitIpd NOT IN (5)
            AND p.TipPed <> 5            
            AND p.DatEmi >= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM')
            AND p.DatEmi <  TRUNC(SYSDATE) + 1 ) b
