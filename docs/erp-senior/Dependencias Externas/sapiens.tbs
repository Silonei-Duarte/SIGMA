DECLARE
EXISTE VARCHAR (01); 
WSITREG   E098REG.SITREG%TYPE;
WINDEXP   E015EME.INDEXP%TYPE; 
CURSOR CUR_E098REG IS
       SELECT SITREG FROM E098REG
       WHERE MODSIS='GER' AND IDEREG='000INTMV01';

CURSOR CUR_E015EME IS
       SELECT INDEXP
       FROM E015EME
       WHERE UNIMED=:OLD.UNIMED;
BEGIN
WSITREG := 'I';
FOREACH CUR_E098REG INTO WSITREG
   LOOP
   EXISTE := 'N';
   END LOOP;

IF ((WSITREG = 'A') AND (:OLD.TIPINT <> 0)) OR (WSITREG='I') THEN
   EXISTE := 'N';
   FOREACH CUR_E015EME INTO WINDEXP
             LOOP
             EXISTE := 'S';
             END LOOP;
   IF (EXISTE = 'N') THEN
       INSERT INTO E015EME (UNIMED,INDEXP) VALUES (:OLD.UNIMED,0);
   END IF;
   IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
      UPDATE E015EME SET INDEXP = 0 WHERE UNIMED=:OLD.UNIMED;
   END IF;
END IF;
