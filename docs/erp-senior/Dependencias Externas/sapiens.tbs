Ç!␀␀PROCEDURE SP_BKATUPROJET(PCODEMP NUMBER(04),PNUMPRJ NUMBER(08),PCODFPJ NUMBER(04),PCTAFIN NUMBER(07),PCODCCU VARCHAR2(9),PMESANO DATE,PROTPPJ NUMBER(02),PCRIRAT NUMBER(01),PSOMSUB NUMBER(01),PCODTNS VARCHAR2(5),PVLRRAT NUMBER(15,2))
 IS

/* Variávies gerais */
WINSERT NUMBER (01);
WSITREG CHAR;
/* Variáveis dos valores de saldos para UPDATE ou INSERT */
WVLRDMP NUMBER (15,2);
WVLRCMP NUMBER (15,2);
WVLRSMP NUMBER (15,2);
WVLRDMX NUMBER (15,2);
WVLRCMX NUMBER (15,2);
WVLRSMX NUMBER (15,2);
WACUDMP NUMBER (15,2);
WACUCMP NUMBER (15,2);
WACUSMP NUMBER (15,2);
WACUDMX NUMBER (15,2);
WACUCMX NUMBER (15,2);
WACUSMX NUMBER (15,2);
WSALDAP NUMBER (15,2);
WSALCAP NUMBER (15,2);
WSALSAP NUMBER (15,2);
WSALDAX NUMBER (15,2);
WSALCAX NUMBER (15,2);
WSALSAX NUMBER (15,2);
/* Variáveis para tratamento das contas financeiras */
WCTAFIN NUMBER (07);
WCLAFIN VARCHAR2 (20);
WCLASFI VARCHAR2 (20);
WPOSFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMFIN NUMBER (02);
WQTDFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WANASIN CHAR;
WTEMSCT CHAR;
/* Variáveis para tratamento dos centros de custos */
WCODCCU VARCHAR2(09);
WCLACCU VARCHAR2 (30);
WCLASCC VARCHAR2 (30);
WPOSCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMCCU NUMBER (02);
WQTDCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WTEMSCC CHAR;

/* CURSOR para trazer o dados da conta e centro de custos e saldos do projeto (E615POS) */
CURSOR CUR_E615POS IS
       SELECT CLAFIN,POSFIN,CLACCU,POSCCU
              FROM E615POS
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ AND CTAFIN=WCTAFIN AND CODCCU=WCODCCU AND
                    ROTPPJ=PROTPPJ AND MESANO=PMESANO;

/* CURSOR para trazer a classificação e outras informações da conta financeira em questão */
CURSOR CUR_E091PLF IS
       SELECT CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CTAFIN=PCTAFIN;

/* CURSOR para trazer a classificação e outras informações do centro de custo em questão */
CURSOR CUR_E044CCU IS
       SELECT CLACCU,POSCCU
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CODCCU=PCODCCU;

/* CURSOR para trazer a conta financeira superior */
CURSOR CUR_E091PLF_S IS
       SELECT CTAFIN,CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CLAFIN=WCLASFI;

/* CURSOR para trazer a centro de custo superior */
CURSOR CUR_E044CCU_S IS
       SELECT CODCCU,CLACCU,POSCCU
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CLACCU=WCLASCC;

/* CURSOR para verificar se deve atualizar as contas sintéticas */
CURSOR CUR_E098REG IS
       SELECT SITREG
              FROM E098REG
              WHERE CODEMP=PCODEMP AND MODSIS='GER' AND IDEREG='000NOLPJ02' AND CODTNS=' ';
BEGIN
/* Caso critério for nenhum não atualiza saldo */
IF (PCRIRAT = 5) THEN
   RETURN;
END IF;

/* Inicializa Variáveis */
/* Variávies gerais */
WSITREG := 'I';
/* Valores de saldos para UPDATE ou INSERT */
WVLRDMP := 0;
WVLRCMP := 0;
WVLRSMP := 0;
WVLRDMX := 0;
WVLRCMX := 0;
WVLRSMX := 0;
WACUDMP := 0;
WACUCMP := 0;
WACUSMP := 0;
WACUDMX := 0;
WACUCMX := 0;
WACUSMX := 0;
WSALDAP := 0;
WSALCAP := 0;
WSALSAP := 0;
WSALDAX := 0;
WSALCAX := 0;
WSALSAX := 0;
/* Variáveis para tratamento das contas financeiras */
WCTAFIN := 0;
WCLAFIN := ' ';
WCLASFI := ' ';
WPOSFIN := 0;
WANASIN := ' ';
WQTDFIN := 0;
WTEMSCT := 'S';
/* Variáveis para tratamento dos centros de custos */
WCODCCU := ' ';
WCLACCU := ' ';
WCLASCC := ' ';
WPOSCCU := 0;
WQTDCCU := 0;
WTEMSCC := 'S';

FOREACH CUR_E091PLF INTO WCLAFIN,WANASIN,WPOSFIN
LOOP
   FOREACH CUR_E044CCU INTO WCLACCU,WPOSCCU
   LOOP
      /* Regime competência */
      IF (PSOMSUB IN (1,3,4,6)) THEN
         /* Débito */
         IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
            WVLRDMP := PVLRRAT;
            WVLRSMP := (PVLRRAT * -1);
            WACUDMP := PVLRRAT;
            WACUSMP := (PVLRRAT * -1);
            WSALDAP := PVLRRAT;
            WSALSAP := (PVLRRAT * -1);
         /* Crédito */
         ELSE
            WVLRCMP := PVLRRAT;
            WVLRSMP := PVLRRAT;
            WACUCMP := PVLRRAT;
            WACUSMP := PVLRRAT;
            WSALCAP := PVLRRAT;
            WSALSAP := PVLRRAT;
         END IF;
      END IF;
      /* Regime caixa */
      IF (PSOMSUB IN (2,3,5,6)) THEN
         /* Débito */
         IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
            WVLRDMX := PVLRRAT;
            WVLRSMX := (PVLRRAT * -1);
            WACUDMX := PVLRRAT;
            WACUSMX := (PVLRRAT * -1);
            WSALDAX := PVLRRAT;
            WSALSAX := (PVLRRAT * -1);
         /* Crédito */
         ELSE
            WVLRCMX := PVLRRAT;
            WVLRSMX := PVLRRAT;
            WACUCMX := PVLRRAT;
            WACUSMX := PVLRRAT;
            WSALCAX := PVLRRAT;
            WSALSAX := PVLRRAT;
         END IF;
      END IF;
      /* Verificar se deve atualizar as contas sintéticas */
      FOREACH CUR_E098REG INTO WSITREG
      LOOP
         WSITREG := WSITREG;	/* Necessário atribuir algo, senão ocorre erro */
      END LOOP;
      /* Loop para contas financeiras */
      WCLASFI := WCLAFIN;
      WTEMSCT := 'S';
      WHILE (WTEMSCT='S')
      LOOP
         WTEMSCT := 'N';
         FOREACH CUR_E091PLF_S INTO WCTAFIN,WCLASFI,WANASIN,WPOSFIN
         LOOP
            /* Loop para centro de custos */
            WCLASCC := WCLACCU;
            WTEMSCC := 'S';
            WHILE (WTEMSCC='S')
            LOOP
               WTEMSCC := 'N';
               FOREACH CUR_E044CCU_S INTO WCODCCU,WCLASCC,WPOSCCU
               LOOP
                  /* Terá necessidade de executar INSERT */
                  WINSERT := 1;
                  /* Faz a atualização caso existir */
                  FOREACH CUR_E615POS INTO WCLASFI,WPOSFIN,WCLASCC,WPOSCCU
                  LOOP
                     /* Não terá necessidade de executar INSERT */
                     WINSERT := 0;
                     UPDATE E615POS SET
                            VLRCMP=(VLRCMP + WVLRCMP),
                            VLRDMP=(VLRDMP + WVLRDMP),
                            VLRSMP=(VLRSMP + WVLRSMP),
                            ACUCMP=(ACUCMP + WACUCMP),
                            ACUDMP=(ACUDMP + WACUDMP),
                            ACUSMP=(ACUSMP + WACUSMP),
                            SALCAP=(SALCAP + WSALCAP),
                            SALDAP=(SALDAP + WSALDAP),
                            SALSAP=(SALSAP + WSALSAP),
                            VLRCMX=(VLRCMX + WVLRCMX),
                            VLRDMX=(VLRDMX + WVLRDMX),
                            VLRSMX=(VLRSMX + WVLRSMX),
                            ACUCMX=(ACUCMX + WACUCMX),
                            ACUDMX=(ACUDMX + WACUDMX),
                            ACUSMX=(ACUSMX + WACUSMX),
                            SALCAX=(SALCAX + WSALCAX),
                            SALDAX=(SALDAX + WSALDAX),
                            SALSAX=(SALSAX + WSALSAX)
                            WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ AND CTAFIN=WCTAFIN AND
                                  CODCCU=WCODCCU AND ROTPPJ=PROTPPJ AND MESANO=PMESANO;
                  END LOOP;
                  /* Faz a inclusão caso não existir */
                  IF (WINSERT = 1) THEN
                     INSERT INTO E615POS
                            (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CODCCU,ROTPPJ,MESANO,VLRCMP,VLRDMP,VLRSMP,VLRCMX,VLRDMX,VLRSMX,
                             ACUCMP,ACUDMP,ACUSMP,ACUCMX,ACUDMX,ACUSMX,SALCAP,SALDAP,SALSAP,SALCAX,SALDAX,SALSAX,CLAFIN,
                             POSFIN,ANASIN,CLACCU,POSCCU)
                     VALUES (PCODEMP,PNUMPRJ,PCODFPJ,WCTAFIN,WCODCCU,PROTPPJ,PMESANO,WVLRCMP,WVLRDMP,WVLRSMP,WVLRCMX,WVLRDMX,WVLRSMX,
                             WACUCMP,WACUDMP,WACUSMP,WACUCMX,WACUDMX,WACUSMX,WSALCAP,WSALDAP,WSALSAP,WSALCAX,WSALDAX,WSALSAX,WCLASFI,
                             WPOSFIN,WANASIN,WCLASCC,WPOSCCU);
                  END IF;
                  WTAMCCU := LENGTH(WCLASCC);
                  WQTDCCU := WTAMCCU-WPOSCCU;
                  WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                  IF ((WSITREG <> 'A') AND (WQTDCCU > 0)) THEN
                     WTEMSCC := 'S';
                  END IF;
               END LOOP;
            END LOOP;
            WTAMFIN := LENGTH(WCLASFI);
            WQTDFIN := WTAMFIN-WPOSFIN;
            WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
            IF ((WSITREG <> 'A') AND (WQTDFIN > 0)) THEN
               WTEMSCT := 'S';
            END IF;
         END LOOP;
      END LOOP;
   END LOOP;
END LOOP;
END␀¡ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_CLEAR_E000LOG(V_NOMTAB VARCHAR2(255), V_CHATAB VARCHAR2(255), V_NOMFRM VARCHAR2(255), 
                           V_TIPLOG VARCHAR2(255), V_ABRUSU VARCHAR2(255), V_FILREG VARCHAR2(255), 
                           V_DATINI DATE, V_DATFIM DATE) 
 IS
BEGIN
  NULL;
END	ORACLE;0
¼	␀␀create or replace PROCEDURE SP_CLEAR_E000LOG (
    v_nomtab   IN  VARCHAR2,
    v_chatab   IN  VARCHAR2,
    v_nomfrm   IN  VARCHAR2,
    v_tiplog   IN  VARCHAR2,
    v_abrusu   IN  VARCHAR2,
    v_filreg   IN  VARCHAR2,
    v_datini   IN  DATE, 
    v_datfim   IN  DATE   
) AS
      
    TYPE TLOGS IS REF CURSOR;
    CUR_E000LOG TLOGS;    

    TYPE ROW_E000LOG IS RECORD (
        NOMTAB VARCHAR2(32),  
        SEQLOG NUMBER(9),     
        TIPLOG VARCHAR2(1),   
        CHATAB VARCHAR2(250), 
        NOMFRM VARCHAR2(30)  
    );

    TYPE TABLE_E000LOG IS TABLE OF ROW_E000LOG INDEX BY PLS_INTEGER;

    REG_E000LOG TABLE_E000LOG;
    V_SQL CLOB;
    I NUMBER;
BEGIN

    V_SQL := NULL; 

    V_SQL := ' SELECT NOMTAB, SEQLOG, TIPLOG, CHATAB, NOMFRM FROM E000LOG WHERE 1=1 ';

    IF (LENGTH(TRIM((V_NOMTAB))) > 0) THEN 
        V_SQL := V_SQL || ' AND NOMTAB = ' || '''' || V_NOMTAB || '''';
    END IF;
    IF (LENGTH(TRIM((V_CHATAB))) > 0) THEN
        V_SQL := V_SQL || ' AND CHATAB = ' || '''' || V_CHATAB || '''';
    END IF;

    IF (LENGTH(TRIM((V_NOMFRM))) > 0) THEN  
        V_SQL := V_SQL || ' AND NOMFRM = ' || '''' || V_NOMFRM || '''';
    END IF;

    IF (LENGTH(TRIM((V_TIPLOG))) > 0)  THEN 
        V_SQL := V_SQL || ' AND TIPLOG = ' || '''' || V_TIPLOG || '''';
    END IF; 

    IF (V_DATINI > '31/12/1900')  THEN 
        V_SQL := V_SQL || ' AND DATGER >= ' || '''' || V_DATINI || '''';
    END IF; 

    IF (V_DATFIM > '31/12/1900')  THEN 
        V_SQL := V_SQL || ' AND DATGER <= ' || '''' || V_DATFIM || '''';
    END IF; 

    IF (LENGTH(TRIM((V_FILREG))) > 0)  THEN 
        V_SQL := V_SQL || ' AND ' || V_FILREG || '';
    END IF; 

    I := 0;
    OPEN CUR_E000LOG FOR V_SQL;    
    LOOP
        FETCH CUR_E000LOG BULK COLLECT 
            INTO REG_E000LOG LIMIT 1000;
        EXIT WHEN REG_E000LOG.COUNT = 0;        
        FORALL I IN 1 .. REG_E000LOG.COUNT
            DELETE FROM E000LOG WHERE NOMTAB = REG_E000LOG(I).NOMTAB AND 
                                               SEQLOG = REG_E000LOG(I).SEQLOG AND
                                               TIPLOG = REG_E000LOG(I).TIPLOG AND 
                                               CHATAB = REG_E000LOG(I).CHATAB AND 
                                               NOMFRM = REG_E000LOG(I).NOMFRM;
            COMMIT;                                

    END LOOP;
    CLOSE CUR_E000LOG;   

END SP_CLEAR_E000LOG;	MSSQL;0
␀␀CREATE PROCEDURE SP_CLEAR_E000LOG (
    @V_NOMTAB    VARCHAR(4000),
    @V_CHATAB    VARCHAR(4000),
    @V_NOMFRM    VARCHAR(4000),
    @V_TIPLOG    VARCHAR(4000),
    @V_ABRUSU    VARCHAR(4000),
    @V_FILREG    VARCHAR(4000),
    @V_DATINI    DATETIME, 
    @V_DATFIM    DATETIME   
) AS
 BEGIN
      
    DECLARE @V_SQL VARCHAR(MAX);
	DECLARE @V_QTD AS INT;
    

    SET @V_SQL = NULL; 	

    SET @V_SQL = ' DELETE TOP(1000) FROM E000LOG WHERE 1=1 ';

    IF (LEN(LTRIM(RTRIM(@V_NOMTAB))) > 0) 
	BEGIN 
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND NOMTAB = ' + '''' + ISNULL(@V_NOMTAB, '') + '''';
    END 
    IF (LEN(LTRIM(RTRIM(@V_CHATAB))) > 0) 
	BEGIN 
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND CHATAB = ' + '''' + ISNULL(@V_CHATAB, '') + '''';
    END 

    IF (LEN(LTRIM(RTRIM(@V_NOMFRM))) > 0) 
	BEGIN 
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND NOMFRM = ' + '''' + ISNULL(@V_NOMFRM, '') + '''';
    END 

    IF (LEN(LTRIM(RTRIM(@V_TIPLOG))) > 0) 
	BEGIN  
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND TIPLOG = ' + '''' + ISNULL(@V_TIPLOG, '') + '''';
    END  

    IF (@V_DATINI > CONVERT(DATE, '31/12/1900', 103))  
	BEGIN 
        SET 
		@V_SQL = ISNULL(@V_SQL, '') + ' AND DATGER >= ' + '''' + ISNULL(CONVERT(VARCHAR(20), @V_DATINI, 0), '') + '''';
    END  

    IF (@V_DATFIM > CONVERT(DATE, '31/12/1900', 103))  
	BEGIN 
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND DATGER <= ' + '''' + ISNULL(CONVERT(VARCHAR(20), @V_DATFIM, 0), '') + '''';
    END  

    IF (LEN(LTRIM(RTRIM(@V_FILREG))) > 0) 
	BEGIN 
        SET @V_SQL = ISNULL(@V_SQL, '') + ' AND ' + @V_FILREG + '''';
    END;
	
    PRINT @V_SQL;
	SET @V_QTD = -1;
    WHILE @V_QTD <> 0 
	BEGIN
		EXECUTE (@V_SQL);
		SET @V_QTD = @@ROWCOUNT;
	END;
END ;	POSTGRESQL;0
ü␀␀CREATE OR REPLACE PROCEDURE sp_clear_e000log( 
v_nomtab character varying,
v_chatab character varying,
v_nomfrm character varying,
v_tiplog character varying,
v_abrusu character varying,
v_filreg character varying,
v_datini date,
v_datfim date)
LANGUAGE 'plpgsql'
AS $BODY$

DECLARE
    V_SQL VARCHAR; 
    CUR_E000LOG REFCURSOR;
    REG_E000LOG VARCHAR;


BEGIN

    V_SQL := NULL; 

    V_SQL := ' SELECT NOMTAB, SEQLOG, TIPLOG, CHATAB, NOMFRM FROM E000LOG WHERE 1=1 ';

    IF (TRIM(V_NOMTAB) <> '') THEN 
        V_SQL := V_SQL || ' AND NOMTAB = ' || '''' || V_NOMTAB || '''';
    END IF;
    IF (TRIM(V_CHATAB) <> '') THEN 
        V_SQL := V_SQL || ' AND CHATAB = ' || '''' || V_CHATAB || '''';
    END IF;

     IF (TRIM(V_NOMFRM) <> '')  THEN 
        V_SQL := V_SQL || ' AND NOMFRM = ' || '''' || V_NOMFRM || '''';
    END IF;

    IF (TRIM(V_TIPLOG) <> '')  THEN 
        V_SQL := V_SQL || ' AND TIPLOG = ' || '''' || V_TIPLOG || '''';
    END IF; 
	
    IF (TRIM(V_ABRUSU) <> '')  THEN  
        V_SQL := V_SQL || ' AND USUGER IN ('|| V_ABRUSU || ')';
    END IF; 

    IF ('1900-12-31 00:00:00' <> V_DATINI)  THEN 
        V_SQL := V_SQL || ' AND DATGER  >= ' || '''' || V_DATINI || '''';
    END IF; 

     IF ('1900-12-31 00:00:00' <> V_DATINI)  THEN 
        V_SQL := V_SQL || ' AND DATGER <= ' || '''' || V_DATFIM || '''';
    END IF; 

     IF (TRIM(V_FILREG) <> '')  THEN 
        V_SQL := V_SQL || ' AND ' || V_FILREG || '';
    END IF; 

    OPEN CUR_E000LOG FOR EXECUTE V_SQL;

    FETCH FROM CUR_E000LOG INTO REG_E000LOG;
		WHILE FOUND LOOP
            DELETE FROM E000LOG WHERE CURRENT OF CUR_E000LOG;                    
		    MOVE CUR_E000LOG;
    	END LOOP;
    CLOSE CUR_E000LOG; 

END;
$BODY$;
