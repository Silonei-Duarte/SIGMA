BEGIN
NULL;
END	MSSQL;0Û␀␀CREATE TRIGGER T120IPDD ON E120IPD FOR DELETE AS
BEGIN
  DECLARE @CODUSU INT
  DECLARE @HORA INT
  DECLARE @MINUTO INT
  DECLARE @CODREP INT
  DECLARE @CODEMP INT
  DECLARE @PEDPAL INT
  DECLARE @DATEMI DATETIME
  DECLARE @CODCLI INT
  DECLARE @CODFIL INT
  DECLARE @NUMPED INT
  DECLARE @SEQIPD INT 
  DECLARE @INDEXP INT
  DECLARE @CODPRO VARCHAR(14)
  DECLARE @CODDER VARCHAR(7)
  DECLARE @QTDPED   NUMERIC(14,5)
  DECLARE @SEQUENCIAL INT
  DECLARE @OBSEXC VARCHAR(100)
  DECLARE @NOMUSU VARCHAR(100)      

  -- BUSCAR HORA
  SELECT @MINUTO = DATEPART(MI, GETDATE()), @HORA = DATEPART(HH, GETDATE())
  SET @MINUTO = @HORA * 60 + @MINUTO  
  
  -- BUSCAR O USUÁRIO
  SELECT @CODUSU = B.CODUSU, @NOMUSU = A.APPUSR
    FROM R911SEC A
  INNER JOIN R999USU B ON A.APPUSR    = B.NOMUSU
   WHERE A.NUMSEC = @@SPID                            

  IF @CODUSU IS NULL
  BEGIN
    SET @CODUSU = 0    
    SET @OBSEXC = 'Registro excluído pelo usuário: via webservice ou via banco de dados'
  END
  else
    SET @OBSEXC = 'Registro excluído pelo usuário: ' + @NOMUSU          

  DECLARE CUR_PEDIDO CURSOR FAST_FORWARD FOR
    SELECT A.CODREP, A.PEDPAL, A.DATEMI, A.CODCLI, B.CODEMP, B.CODFIL, B.NUMPED, B.SEQIPD, 0 AS INDEXP, B.CODPRO, B.CODDER, B.QTDPED
    FROM E120PED A
    INNER JOIN DELETED B ON (A.CODEMP = B.CODEMP AND A.CODFIL = B.CODFIL AND A.NUMPED = B.NUMPED)
    
  OPEN CUR_PEDIDO
  FETCH CUR_PEDIDO INTO @CODREP, @PEDPAL, @DATEMI, @CODCLI, @CODEMP, @CODFIL, @NUMPED, @SEQIPD, @INDEXP, @CODPRO, @CODDER, @QTDPED
    WHILE @@FETCH_STATUS = 0
      BEGIN            
      --GERAR SEQUENCIAL
      EXEC GETNEXTVALUE 'E120EIP',1,'SELECT MAX(IDEEIP) FROM E120EIP',@SEQUENCIAL OUTPUT

      INSERT INTO E120EIP (IDEEIP,CODEMP,CODFIL,NUMPED,SEQIPD,CODREP,PEDPAL,INDEXP,CODPRO,CODDER,QTDPED,DATEMI,CODCLI,DATEXC,HOREXC,USUEXC,OBSEXC)      
      VALUES (@SEQUENCIAL, @CODEMP, @CODFIL, @NUMPED, @SEQIPD, @CODREP, @PEDPAL, @INDEXP, @CODPRO, @CODDER, @QTDPED, @DATEMI, @CODCLI, GETDATE(), @MINUTO, @CODUSU, @OBSEXC)

      FETCH CUR_PEDIDO INTO @CODREP, @PEDPAL, @DATEMI, @CODCLI, @CODEMP, @CODFIL, @NUMPED, @SEQIPD, @INDEXP, @CODPRO, @CODDER, @QTDPED
    END;
  CLOSE CUR_PEDIDO
  DEALLOCATE CUR_PEDIDO  
END

	ORACLE;0F␀␀CREATE OR REPLACE TRIGGER T120IPDD AFTER DELETE ON E120IPD FOR EACH ROW 
DECLARE SEQUENCIAL NUMBER;
  WCODUSU NUMBER;
  WHORA NUMBER;
  WSERVID NUMBER;
  WNOMUSU VARCHAR(100);
  WOBSEXC VARCHAR(100);
  WCODREP E120PED.CODREP%TYPE;
  WPEDPAL E120PED.PEDPAL%TYPE;
  WDATEMI E120PED.DATEMI%TYPE;
  WCODCLI E120PED.CODCLI%TYPE;
  CURSOR CUR_E120PED
  IS
    SELECT E120PED.CODREP CODREP,
      E120PED.PEDPAL PEDPAL,
      E120PED.DATEMI DATEMI,
      E120PED.CODCLI CODCLI
    FROM E120PED E120PED
    WHERE CODEMP=:OLD.CODEMP
    AND CODFIL  =:OLD.CODFIL
    AND NUMPED  =:OLD.NUMPED;
  CUR_E120PED_cnt INTEGER;
BEGIN
  SEQUENCIAL := 0;
  OPEN CUR_E120PED;
  BEGIN
    FETCH CUR_E120PED INTO WCODREP,WPEDPAL,WDATEMI,WCODCLI;
  EXCEPTION
  WHEN OTHERS THEN
    CLOSE CUR_E120PED;
    raise;
  END;
  CLOSE CUR_E120PED;
  
  GETNEXTVALUE('E120EIP',1,'SELECT MAX(IDEEIP) FROM E120EIP',SEQUENCIAL);
  
  SELECT SYS_CONTEXT('USERENV','SESSIONID') INTO WSERVID FROM DUAL;
  BEGIN
    SELECT b.codusu, a.APPUSR
    INTO WCODUSU, WNOMUSU 
    FROM r911sec a
    INNER JOIN r999usu b
    ON a.appusr    = b.nomusu
    WHERE a.NUMSEC = WSERVID;
      WOBSEXC := 'Registro excluído pelo usuário: ' || WNOMUSU;      
    EXCEPTION
    WHEN no_data_found THEN
      WCODUSU := 0;
      WOBSEXC := 'Registro excluído via webservice ou via banco de dados';      
    END; 
  
  SELECT TO_NUMBER(TO_CHAR(SYSDATE, 'MI')) + TO_NUMBER(TO_CHAR(SYSDATE, 'HH')) * 60 INTO WHORA FROM DUAL;
  
  INSERT INTO E120EIP
    (IDEEIP,CODEMP,CODFIL,NUMPED,SEQIPD,CODREP,PEDPAL,INDEXP,CODPRO,CODDER,QTDPED,DATEMI,CODCLI,DATEXC,HOREXC,USUEXC,OBSEXC)
  VALUES
    (SEQUENCIAL,:OLD.CODEMP,:OLD.CODFIL,:OLD.NUMPED,:OLD.SEQIPD,WCODREP,WPEDPAL,0,:OLD.CODPRO,:OLD.CODDER,:OLD.QTDPED,WDATEMI,WCODCLI,SYSDATE,WHORA,WCODUSU,WOBSEXC);
    
END; 

	POSTGRESQL;0O␀␀DO $$BEGIN
CREATE OR REPLACE FUNCTION t120ipdd$tf()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE
	SEQUENCIAL NUMERIC;
	WHORA INTEGER;
	
	WCODREP E120PED.CODREP%TYPE;
	WPEDPAL E120PED.PEDPAL%TYPE;
	WDATEMI E120PED.DATEMI%TYPE;
	WCODCLI E120PED.CODCLI%TYPE;	

	WSERVID R911SEC.NUMSEC%TYPE;
	WCODUSU R999USU.CODUSU%TYPE;
	WNOMUSU R911SEC.APPUSR%TYPE;
	WOBSEXC	 VARCHAR(100);
	
	CUR_E120PED CURSOR FOR
	SELECT
		E120PED.CODREP, E120PED.PEDPAL, E120PED.DATEMI, E120PED.CODCLI
	FROM
		E120PED E120PED
	WHERE
		CODEMP     =OLD.CODEMP
		AND CODFIL =OLD.CODFIL
		AND NUMPED =OLD.NUMPED;
		
BEGIN
	
	OPEN CUR_E120PED;
	BEGIN
		FETCH CUR_E120PED INTO WCODREP, WPEDPAL, WDATEMI, WCODCLI;
	END;
	CLOSE CUR_E120PED;
	
	CALL GETNEXTVALUE('E120EIP',1,'SELECT MAX(IDEEIP) FROM E120EIP',SEQUENCIAL);
	
	SELECT PG_BACKEND_PID()	INTO WSERVID;
	BEGIN		
		SELECT		
			B.CODUSU
		  , A.APPUSR
		INTO		
		STRICT
			WCODUSU			
		  ,  WNOMUSU		  
		FROM
			R911SEC A
			INNER JOIN
				R999USU B
				ON
					A.APPUSR = B.NOMUSU
		WHERE
			A.NUMSEC = WSERVID;
		
		WOBSEXC := 'REGISTRO EXCLUÍDO PELO USUÁRIO: ' || WNOMUSU;	
	EXCEPTION			
	WHEN NO_DATA_FOUND THEN
		WCODUSU := 0;
		WOBSEXC := 'REGISTRO EXCLUÍDO VIA WEBSERVICE OU VIA BANCO DE DADOS';
	END;	

	SELECT EXTRACT(MINUTE FROM CURRENT_TIMESTAMP) + EXTRACT(HOUR FROM CURRENT_TIMESTAMP) * 60 INTO WHORA;
	
	INSERT INTO E120EIP (IDEEIP,CODEMP,CODFIL,NUMPED,SEQIPD,CODREP,PEDPAL,INDEXP,CODPRO,CODDER,QTDPED,DATEMI,CODCLI,DATEXC,HOREXC,USUEXC,OBSEXC)
	VALUES(SEQUENCIAL,OLD.CODEMP,OLD.CODFIL,OLD.NUMPED,OLD.SEQIPD,WCODREP,WPEDPAL,0,OLD.CODPRO,OLD.CODDER,OLD.QTDPED,WDATEMI,WCODCLI,CURRENT_DATE,WHORA,WCODUSU,WOBSEXC);	

	RETURN OLD;
  
END
$function$
;

CREATE TRIGGER T120IPDD AFTER DELETE ON E120IPD FOR EACH ROW 
	EXECUTE FUNCTION t120ipdd$tf();
END $$;␀␀␀¸3␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#dŒ³␀	␀␀␀␀␀␀␀␀Â5”q”qr<␀„–˜␀ƒÿ␀␀R@␀¶µ␀	␀␀␀␀␀␀␀␀d6¶y¶yy<␀␀ƒÿ␀␀V@␀}¶␀␀Â␀	␀␀␀␀␀␀␀␀½␀␀¿É␀␀—¹␀␀:<␀␀ƒÿ␀␀Wd␀6ð␀␀³␀	␀␀␀␀␀␀␀␀Bó␀␀*¥␀␀*¥␀␀r<␀␀ƒÿ␀␀!d␀9ð␀␀³␀	␀␀␀␀␀␀␀␀Có␀␀ãí␀␀ãí␀␀r<␀␀ƒÿ␀␀ÿ␀½Û␀␀Š␀␀␀␀␀␀␀␀␀á␀␀kÜ␀␀kÜ␀␀b<␀␀ƒÿ␀␀ÿ␀Ü␀␀Š␀␀␀␀␀␀␀␀␀œÝ␀␀›Ý␀␀›Ý␀␀b<␀␀ƒÿ␀␀ÿ␀ùAÎ␀	␀␀␀␀␀␀␀␀‚IÕ␀␀Õ␀␀‚@␀”ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀·3␀␀␀␀␀␀␀␀␀␀$dŒ³␀	␀␀␀␀␀␀␀␀Þ5”q”qr<␀␀ƒÿ␀␀ÿ␀¶µ␀	␀␀␀␀␀␀␀␀‘6¶y¶yy<␀␀ƒÿ␀␀V@␀}¶␀␀Â␀	␀␀␀␀␀␀␀␀½␀␀¿É␀␀—¹␀␀:<␀␀ƒÿ␀␀Wd␀6ð␀␀³␀	␀␀␀␀␀␀␀␀ô␀␀ãí␀␀ñ␀␀r<␀␀ƒÿ␀␀!d␀8’␀␀È␀	␀␀␀␀␀␀␀␀+”␀␀ö’␀␀ˆ“␀␀]<␀␀ƒÿ␀␀…]␀Ñ‘␀␀È␀␀␀␀␀␀␀␀␀ö“␀␀“␀␀ ”␀␀]<␀␀␀ƒÿ␀␀~]␀ä5	␀␀␀␀␀␀␀␀K=#1º2W␀␀␀ÿ␀␀º^␀à“␀␀␀␀␀␀␀␀␀TTT@<␀␀␀ƒÿ␀␀ÿ␀
