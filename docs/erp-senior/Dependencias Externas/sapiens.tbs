DECLARE
EXISTE VARCHAR (01); 
WSITREG   E098REG.SITREG%TYPE;
WINDEXP   E012EFA.INDEXP%TYPE; 

CURSOR CUR_E098REG IS
       SELECT SITREG FROM E098REG
       WHERE CODEMP=:OLD.CODEMP AND MODSIS='GER' AND IDEREG='000INTMV01';

CURSOR CUR_E012EFA IS
       SELECT INDEXP
       FROM E012EFA
       WHERE CODEMP=:OLD.CODEMP AND CODFAM=:OLD.CODFAM;
BEGIN
WSITREG := 'I';
FOREACH CUR_E098REG INTO WSITREG
   LOOP
   EXISTE := 'N';
   END LOOP;

IF ((WSITREG = 'A') AND (:OLD.TIPINT <> 0)) OR (WSITREG='I') THEN
   EXISTE := 'N';
   FOREACH CUR_E012EFA INTO WINDEXP
             LOOP
             EXISTE := 'S';
             END LOOP;
   IF (EXISTE = 'N') THEN
       INSERT INTO E012EFA (CODEMP,CODFAM,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODFAM,0);
   END IF;
   IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
      UPDATE E012EFA SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODFAM=:OLD.CODFAM;
