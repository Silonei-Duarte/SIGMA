$BODY$;␀Žê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
2PROCEDURE SP_APLICACAOERP IS 
BEGIN
  NULL;
END	ORACLE;0
ä␀␀CREATE OR REPLACE PROCEDURE SP_APLICACAOERP (EHCMDNATIVO OUT INTEGER) IS
	CURSOR CUR_PROGID IS    
	    SELECT DISTINCT PRO.PROGRAM PROGRAM, PRO.SID SID
		  FROM (SELECT VSS.PROGRAM, VSS.SID
		          FROM SYS.V_$SESSION VSS 
		         WHERE VSS.AUDSID = USERENV('SESSIONID')                       
		         UNION                 
	      	    SELECT VSS.PROGRAM, VSS.SID
		          FROM SYS.GV_$SESSION VSS 
		         WHERE VSS.AUDSID = USERENV('SESSIONID')
		        ) PRO
		 WHERE PRO.SID =  USERENV('SID');
BEGIN	
	EHCMDNATIVO := 1;
	FOR SESSIONITEM IN CUR_PROGID 
	LOOP
		IF NOT (lower(SESSIONITEM.PROGRAM) IN ('sapiens.exe', 'sapienssrv.exe')) THEN
			EHCMDNATIVO := 0;
			EXIT;
		END IF;			
	END LOOP;
END;	MSSQL;0
p␀␀CREATE PROCEDURE SP_APLICACAOERP
@EHCMDNATIVO INTEGER OUTPUT
AS
BEGIN
  IF (EXISTS(SELECT 1 FROM sys.dm_exec_sessions WHERE session_id = @@SPID 
     AND (lower(program_name) LIKE '%gest_o empresarial%' OR lower(program_name) LIKE '%senior%' OR lower(program_name) LIKE '%web 5.0%') ))
     SELECT @EHCMDNATIVO = 1;
  ELSE
     SELECT @EHCMDNATIVO = 0;
END;
	POSTGRESQL;0
ª␀␀CREATE PROCEDURE SP_APLICACAOERP (INOUT EHCMDNATIVO INTEGER )
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
	IF (EXISTS(SELECT 1 FROM PG_STAT_ACTIVITY WHERE PID = PG_BACKEND_PID () AND STATE = 'active'
		AND (lower(application_name) LIKE '%gest_o empresarial%' OR lower(application_name) LIKE '%senior%' OR lower(application_name) LIKE '%web 5.0%') )) THEN
      	EHCMDNATIVO = 1;
	ELSE
		EHCMDNATIVO = 0;
	END IF;
END
$BODY$;␀ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUMESANO
„␀␀PROCEDURE SP_ATUCONTAS(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PMESANO DATE,PCTARED NUMBER(07),PVLRLCT NUMBER(17,2),PDEBCRE VARCHAR2(01))
 IS

WINSERT NUMBER (01);
WVLRMES NUMBER (17,2);
WSALMES NUMBER (17,2);
WVLRCAL NUMBER (17,2);
WCLACTA VARCHAR2 (30);
WCLASUP VARCHAR2 (30);
WQTDPOS NUMBER (01);
WANASIN CHAR;
WCTARED NUMBER (07);
WDATNOW DATE;
WTAMCAM NUMBER (05);
WPOSNIV INTEGER;  /* operações com string, variável deve ser INTEGER */
WVLRAUX NUMBER (17,2);
WDATATU   E650PMA.DATATU%TYPE;
WHORATU   E650PMA.HORATU%TYPE;

/* CURSOR para trazer o dados da conta e saldos a débito da conta em questão (E650SAL) */
CURSOR CUR_E650SAL_D IS
       SELECT CLACTA,QTDPOS,DEBMES,SALMES
              FROM E650SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                    MESANO=PMESANO AND CTARED=PCTARED FOR UPDATE;

/* CURSOR para trazer o dados da conta e saldos a crédito da conta em questão (E650SAL) */
CURSOR CUR_E650SAL_C IS
       SELECT CLACTA,QTDPOS,CREMES,SALMES
              FROM E650SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                    MESANO=PMESANO AND CTARED=PCTARED FOR UPDATE;

/* CURSOR para trazer a classificação e outras informações da conta contábil em questão */
CURSOR CUR_E045PLA_C IS
       SELECT CLACTA,ANASIN,QTDPOS
              FROM E045PLA
              WHERE CODEMP=PCODEMP AND CTARED=PCTARED FOR UPDATE;

/* CURSOR para trazer o saldo para cálculo da conta a débito superior (E650SAL) */
CURSOR CUR_E650SAL_DS IS
       SELECT CTARED,DEBCAL
              FROM E650SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                    MESANO=PMESANO AND CLACTA=WCLASUP FOR UPDATE;

/* CURSOR para trazer o saldo para cálculo da conta a crédito superior (E650SAL) */
CURSOR CUR_E650SAL_CS IS
       SELECT CTARED,CRECAL
              FROM E650SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                    MESANO=PMESANO AND CLACTA=WCLASUP FOR UPDATE;

/* CURSOR para trazer a conta reduzida e outras informações da conta contábil superior */
CURSOR CUR_E045PLA_S IS
       SELECT CTARED,ANASIN,QTDPOS
              FROM E045PLA
              WHERE CODEMP=PCODEMP AND CLACTA=WCLASUP FOR UPDATE;


BEGIN

/* Inicializa Variáveis */
WINSERT := 1;
WVLRMES := 0;
WSALMES := 0;

/* Buscar a data e hora da atualização */
WDATATU := CURDATE();
WHORATU := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());

/* Atualiza somente a conta analítica */
IF    (PDEBCRE = 'D') THEN
      FOREACH CUR_E650SAL_D INTO WCLACTA,WQTDPOS,WVLRMES,WSALMES
      LOOP
           WVLRMES := IFNULL(WVLRMES,0) + PVLRLCT;
           WSALMES := IFNULL(WSALMES,0) + PVLRLCT;
           UPDATE E650SAL SET DEBMES=WVLRMES,SALMES=WSALMES
                          WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                                MESANO=PMESANO AND CTARED=PCTARED;

           /* Não terá necessidade de executar INSERT */
           WINSERT := 0;
      END LOOP;

ELSIF (PDEBCRE = 'C') THEN
      FOREACH CUR_E650SAL_C INTO WCLACTA,WQTDPOS,WVLRMES,WSALMES
      LOOP
           WVLRMES := IFNULL(WVLRMES,0) + PVLRLCT;
           WSALMES := IFNULL(WSALMES,0) - PVLRLCT;
           UPDATE E650SAL SET CREMES=WVLRMES,SALMES=WSALMES
                         WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                               MESANO=PMESANO AND CTARED=PCTARED;

           /* Não terá necessidade de executar INSERT */
           WINSERT := 0;
      END LOOP;
END IF;

/* Trata movimentos novos, que não existam na base */
IF   (WINSERT = 1) THEN
     FOREACH CUR_E045PLA_C INTO WCLACTA,WANASIN,WQTDPOS
     LOOP
          IF    (PDEBCRE = 'D') THEN
                INSERT INTO E650SAL
                            (CODEMP,CODFIL,MESANO,CLACTA,ANASIN,
                             QTDPOS,CTARED,DEBMES,SALMES,
                             DEBCAL,CRECAL,CREMES,VLRORC)
                       VALUES (PCODEMP,PCODFIL,PMESANO,WCLACTA,
                               WANASIN,WQTDPOS,PCTARED,PVLRLCT,PVLRLCT,
                               0,0,0,0);
          ELSIF (PDEBCRE = 'C') THEN
                WVLRAUX := (PVLRLCT * -1);
                INSERT INTO E650SAL
                            (CODEMP,CODFIL,MESANO,CLACTA,ANASIN,
                             QTDPOS,CTARED,CREMES,SALMES,
                             DEBCAL,CRECAL,DEBMES,VLRORC)
                       VALUES (PCODEMP,PCODFIL,PMESANO,WCLACTA,
                               WANASIN,WQTDPOS,PCTARED,PVLRLCT,WVLRAUX,
                               0,0,0,0);
          END IF;
     END LOOP;
END IF;


/***************************************************************************/
/* No segundo passo atualiza a conta pai que no caso sempre será sintética */
WTAMCAM := LENGTH(WCLACTA);
WPOSNIV := WTAMCAM - WQTDPOS;
WCLASUP := SUBSTRING(WCLACTA,1,WPOSNIV);

WINSERT := 1;
WVLRCAL := 0;

IF   (PDEBCRE = 'D') THEN
     FOREACH CUR_E650SAL_DS INTO WCTARED,WVLRCAL
     LOOP
          WVLRCAL := IFNULL(WVLRCAL,0) + PVLRLCT;
          UPDATE E650SAL SET DEBCAL=WVLRCAL
                         WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                               MESANO=PMESANO AND CTARED=WCTARED;

           /* Não terá necessidade de executar INSERT */
          WINSERT := 0;
     END LOOP;

ELSIF (PDEBCRE = 'C') THEN
      FOREACH CUR_E650SAL_CS INTO WCTARED,WVLRCAL
      LOOP
           WVLRCAL := IFNULL(WVLRCAL,0) + PVLRLCT;
           UPDATE E650SAL SET CRECAL=WVLRCAL
                          WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                                MESANO=PMESANO AND CTARED=WCTARED;

           /* Não terá necessidade de executar INSERT */
           WINSERT := 0;
      END LOOP;

END IF;

/* Trata movimentos novos, que não existam na base */
IF   (WINSERT = 1) THEN
     FOREACH CUR_E045PLA_S INTO WCTARED,WANASIN,WQTDPOS
     LOOP
          IF    (PDEBCRE = 'D') THEN
                INSERT INTO E650SAL
                           (CODEMP,CODFIL,MESANO,CTARED,CLACTA,ANASIN,QTDPOS,DEBCAL,
                           CRECAL,DEBMES,CREMES,SALMES,VLRORC)
                       VALUES (PCODEMP,PCODFIL,PMESANO,WCTARED,
                               WCLASUP,WANASIN,WQTDPOS,PVLRLCT,
                               0,0,0,0,0);
          ELSIF (PDEBCRE = 'C') THEN
                INSERT INTO E650SAL
                           (CODEMP,CODFIL,MESANO,CTARED,CLACTA,ANASIN,QTDPOS,CRECAL,
                           DEBCAL,DEBMES,CREMES,SALMES,VLRORC)
                       VALUES (PCODEMP,PCODFIL,PMESANO,WCTARED,
                               WCLASUP,WANASIN,WQTDPOS,PVLRLCT,
                               0,0,0,0,0);
          END IF;
     END LOOP;
END IF;

/* Trata lançamento retroativo */
SP_ATUMESANO(PCODEMP,PCODFIL,PMESANO,PCTARED,PVLRLCT,PDEBCRE);

/* Atualiza parâmetros para consulta de saldos e data movimento de conta contábil */
UPDATE E650PMA SET TEMLCT='S', TEMRAT='S', DATATU = WDATATU, HORATU = WHORATU WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND MESANO=PMESANO;
UPDATE E045PLA SET ULTMOV=CURDATE() WHERE CODEMP=PCODEMP AND CTARED=PCTARED;
END␀ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUMESANOAUX
»␀␀PROCEDURE SP_ATUCONTASAUX(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PMESANO DATE,PCTAAUX NUMBER(07),PCTARED NUMBER(07),PVLRLCT NUMBER(17,2),PDEBCRE VARCHAR2(01))
 IS

WINSERT NUMBER (01);
WVLRMES NUMBER (17,2);
WSALMES NUMBER (17,2);
WVLRCAL NUMBER (17,2);
WCTAAUX NUMBER (07);
WDATNOW DATE;
WTAMCAM NUMBER (05);
WPOSNIV INTEGER;  /* operações com string, variável deve ser INTEGER */
WVLRAUX NUMBER (17,2);


/* CURSOR para trazer o dados da conta e saldos a débito da conta em questão (E652SAL) */
CURSOR CUR_E652SAL_D IS
       SELECT DEBMES,SALMES
              FROM E652SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND 
              MESANO=PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED FOR UPDATE;

/* CURSOR para trazer o dados da conta e saldos a crédito da conta em questão (E652SAL) */
CURSOR CUR_E652SAL_C IS
       SELECT CREMES,SALMES
              FROM E652SAL
              WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                    MESANO=PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED FOR UPDATE;


BEGIN

/* Inicializa Variáveis */
WINSERT := 1;
WVLRMES := 0;
WSALMES := 0;

/* Atualiza somente a conta analítica */
IF    (PDEBCRE = 'D') THEN
      FOREACH CUR_E652SAL_D INTO WVLRMES,WSALMES
      LOOP
           WVLRMES := IFNULL(WVLRMES,0) + PVLRLCT;
           WSALMES := IFNULL(WSALMES,0) + PVLRLCT;
           UPDATE E652SAL SET DEBMES=WVLRMES,SALMES=WSALMES
                          WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                                MESANO=PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED;

           /* Não terá necessidade de executar INSERT */
           WINSERT := 0;
      END LOOP;

ELSIF (PDEBCRE = 'C') THEN
      FOREACH CUR_E652SAL_C INTO WVLRMES,WSALMES
      LOOP
           WVLRMES := IFNULL(WVLRMES,0) + PVLRLCT;
           WSALMES := IFNULL(WSALMES,0) - PVLRLCT;
           UPDATE E652SAL SET CREMES=WVLRMES,SALMES=WSALMES
                         WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                               MESANO=PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED;

           /* Não terá necessidade de executar INSERT */
           WINSERT := 0;
      END LOOP;
END IF;

/* Trata movimentos novos, que não existam na base */
IF   (WINSERT = 1) THEN
     IF    (PDEBCRE = 'D') THEN
           INSERT INTO E652SAL
                       (CODEMP,CODFIL,MESANO,CTAAUX,CTARED,
                        DEBMES,SALMES,DEBCAL,CRECAL,CREMES)
                  VALUES (PCODEMP,PCODFIL,PMESANO,PCTAAUX,PCTARED,
                               PVLRLCT,PVLRLCT,0,0,0);
     ELSIF (PDEBCRE = 'C') THEN
           WVLRAUX := (PVLRLCT * -1);
           INSERT INTO E652SAL
                       (CODEMP,CODFIL,MESANO,CTAAUX,CTARED,
                        CREMES,SALMES,DEBCAL,CRECAL,DEBMES)
                  VALUES (PCODEMP,PCODFIL,PMESANO,PCTAAUX,PCTARED,
                          PVLRLCT,WVLRAUX,0,0,0);
     END IF;
END IF;


/***************************************************************************/
/* Trata lançamento retroativo */
SP_ATUMESANOAUX(PCODEMP,PCODFIL,PMESANO,PCTAAUX,PCTARED,PVLRLCT,PDEBCRE);

/* Atualiza parâmetros para consulta de saldos e data movimento de conta contábil */
UPDATE E045PCA SET ULTMOV=CURDATE() WHERE CODEMP=PCODEMP AND CTAAUX=PCTAAUX;
END␀‘ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
XA␀␀PROCEDURE SP_ATUFISPROJ(PCODEMP NUMBER(04),PNUMPRJ NUMBER(08),PCODFPJ NUMBER(04),PCTAFIN NUMBER(07),PCODCCU VARCHAR2(9),PMESANO DATE,PROTPPJ NUMBER(02),PCRIRAT NUMBER(01),PSOMSUB NUMBER(01),PCODTNS VARCHAR2(5),PTIPREC NUMBER(01),PCODPRO VARCHAR2(14),PCODDER VARCHAR2(7),PCODSER VARCHAR2(14),PQTDRAT NUMBER(13,4),PPREUNI NUMBER(13,4),PVLRRAT NUMBER(15,2))
 IS

/* Variávies gerais */
WINSERT NUMBER (01);
WSITREG CHAR;

/* Variáveis dos valores de saldos para UPDATE ou INSERT */
WQTDCMP NUMBER (15,2);
WTOTCMP NUMBER (15,2);
WQTDCXA NUMBER (15,2);
WTOTCXA NUMBER (15,2);

/* Variáveis para tratamento das fases */
WCLAFPJ_FILIAL CHAR;
WCODFPJ NUMBER (04);
WCLAFPJ VARCHAR2 (20);
WCLASFJ VARCHAR2 (20);
WPOSFPJ INTEGER;
WTAMFPJ NUMBER (04);
WQTDFPJ INTEGER;
WANAFPJ CHAR;
WTEMSFJ CHAR;
WNIVFPJ INTEGER;

/* Variáveis para tratamento das contas financeiras */
WCTAFIN NUMBER (07);
WCLAFIN VARCHAR2 (30);
WCLASFI VARCHAR2 (30);
WPOSFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMFIN NUMBER (07);
WQTDFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WANASIN CHAR;
WTEMSCT CHAR;

/* Variáveis para tratamento dos centros de custos */
WCODCCU VARCHAR2(09);
WCLACCU VARCHAR2 (30);
WCLASCC VARCHAR2 (30);
WPOSCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMCCU NUMBER (09);
WQTDCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WANACCU CHAR;
WTEMSCC CHAR;

/* CURSOR para trazer se o projeto utiliza a classificacao de fases */
CURSOR CUR_E615PRJ IS
       SELECT E615PRJ.CLAFPJ
              FROM E615PRJ
              WHERE E615PRJ.CODEMP=PCODEMP AND
                    E615PRJ.NUMPRJ=PNUMPRJ;

/* CURSOR para trazer o dados da conta e centro de custos e saldos fisicos do projeto (E615POF) */
CURSOR CUR_E615POF IS
       SELECT ANAFPJ,NIVFPJ,CLAFPJ,POSFPJ,CLAFIN,POSFIN,CLACCU,POSCCU
              FROM E615POF
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND 
                    TIPREC=PTIPREC AND CODPRO=PCODPRO AND CODDER=PCODDER AND 
                    CODSER=PCODSER AND ROTPPJ=PROTPPJ AND MESANO=PMESANO AND
                    CTAFIN=WCTAFIN AND CODCCU=WCODCCU;

/* CURSOR para trazer a classificação e outras informações da fase -NOVO */
CURSOR CUR_E615FPJ IS
       SELECT CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ;

/* CURSOR para trazer a classificacao e outras informacoes da conta financeira em questao */
CURSOR CUR_E091PLF IS
       SELECT CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CTAFIN=PCTAFIN;

/* CURSOR para trazer a classificacao e outras informacoes do centro de custo em questao */
CURSOR CUR_E044CCU IS
       SELECT CLACCU,POSCCU
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CODCCU=PCODCCU;

/* CURSOR para trazer a fase sintetica */
CURSOR CUR_E615FPJ_S IS
       SELECT CODFPJ,CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CLAFPJ=WCLASFJ;

/* CURSOR para trazer a fase analitica */
CURSOR CUR_E615FPJ_A IS
       SELECT CODFPJ,CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ;

/* CURSOR para trazer a conta financeira superior */
CURSOR CUR_E091PLF_S IS
       SELECT CTAFIN,CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CLAFIN=WCLASFI;

/* CURSOR para trazer a centro de custo superior */
CURSOR CUR_E044CCU_S IS
       SELECT CODCCU,CLACCU,POSCCU,ANASIN
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CLACCU=WCLASCC;

/* CURSOR para verificar se deve atualizar as contas sintéticas */
CURSOR CUR_E098REG IS
       SELECT SITREG
              FROM E098REG
              WHERE CODEMP=PCODEMP AND MODSIS='GER' AND IDEREG='000NOLPJ04' AND CODTNS=' ';
BEGIN
/* Caso critério for nenhum não atualiza saldo */
IF (PCRIRAT = 5) THEN
   RETURN;
END IF;

/* Inicializa Variáveis */
/* Variávies gerais */
WSITREG := 'I';

/* Valores de saldos para UPDATE ou INSERT */
WQTDCMP := 0;
WTOTCMP := 0;
WQTDCXA := 0;
WTOTCXA := 0;

/* Variáveis para tratamento das fases */

WCODFPJ := 0;
WCLAFPJ := ' ';
WCLASFJ := ' ';
WPOSFPJ := 0;
WANAFPJ := ' ';
WQTDFPJ := 0;
WTEMSFJ := 'S';
WNIVFPJ := 0;

/* Variáveis para tratamento das contas financeiras */
WCTAFIN := 0;
WCLAFIN := ' ';
WCLASFI := ' ';
WPOSFIN := 0;
WANASIN := ' ';
WQTDFIN := 0;
WTEMSCT := 'S';

/* Variáveis para tratamento dos centros de custos */
WCODCCU := ' ';
WCLACCU := ' ';
WCLASCC := ' ';
WPOSCCU := 0;
WQTDCCU := 0;
WANACCU := ' ';
WTEMSCC := 'S';

/* Verificar se utiliza classificacao de fases para atualizar para as superiores */
FOREACH CUR_E615PRJ INTO WCLAFPJ_FILIAL
LOOP
     WCLAFPJ_FILIAL := WCLAFPJ_FILIAL;	/* Necessário atribuir algo, senão ocorre erro */
END LOOP;

FOREACH CUR_E615FPJ INTO WCLAFPJ,WANAFPJ,WPOSFPJ,WNIVFPJ
LOOP
     FOREACH CUR_E091PLF INTO WCLAFIN,WANASIN,WPOSFIN
     LOOP
        FOREACH CUR_E044CCU INTO WCLACCU,WPOSCCU
        LOOP
           /* Regime competência */
           IF (PSOMSUB IN (1,3,4,6)) THEN
              /* Débito */
              IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
                 WQTDCMP := (PQTDRAT * -1);
                 WTOTCMP := (PVLRRAT * -1);
              /* Crédito */
              ELSE
                 WQTDCMP := PQTDRAT;
                 WTOTCMP := PVLRRAT;
              END IF;
           END IF;
           /* Regime caixa */
           IF (PSOMSUB IN (2,3,5,6)) THEN
              /* Débito */
              IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
                 WQTDCXA := (PQTDRAT * -1);
                 WTOTCXA := (PVLRRAT * -1);
              /* Crédito */
              ELSE
                 WQTDCXA := PQTDRAT;
                 WTOTCXA := PVLRRAT;
              END IF;
           END IF;

           /* Verificar se deve atualizar as contas sintéticas */
           FOREACH CUR_E098REG INTO WSITREG
           LOOP
              WSITREG := WSITREG;	/* Necessário atribuir algo, senão ocorre erro */
           END LOOP;

           /* Loop para fases */
           WCLASFJ := WCLAFPJ;
           WTEMSFJ := 'S';
           WHILE (WTEMSFJ='S')
           LOOP
              WTEMSFJ := 'N';
              IF   ((WCLAFPJ_FILIAL = 'S') AND (WCLASFJ <> ' ')) THEN
                 FOREACH CUR_E615FPJ_S INTO WCODFPJ,WCLASFJ,WANAFPJ,WPOSFPJ,WNIVFPJ
                 LOOP
                    /* Loop para contas financeiras */
                    WCLASFI := WCLAFIN;
                    WTEMSCT := 'S';
                    WHILE (WTEMSCT='S')
                    LOOP
                       WTEMSCT := 'N';
                       FOREACH CUR_E091PLF_S INTO WCTAFIN,WCLASFI,WANASIN,WPOSFIN
                       LOOP
                          /* Loop para centro de custos */
                          WCLASCC := WCLACCU;
                          WTEMSCC := 'S';
                          WHILE (WTEMSCC='S')
                          LOOP
                             WTEMSCC := 'N';
                             FOREACH CUR_E044CCU_S INTO WCODCCU,WCLASCC,WPOSCCU,WANACCU
                             LOOP
                                /* Terá necessidade de executar INSERT */
                                WINSERT := 1;
                                IF (WCLACCU=' ') THEN
                                   WCODCCU := PCODCCU;
                                   WPOSCCU := 0;
                                   WPOSFIN := 0;
                                END IF;

                                /* Faz a atualização caso existir */
                                FOREACH CUR_E615POF INTO WANAFPJ,WNIVFPJ,WCLASFJ,WPOSFPJ,WCLASFI,WPOSFIN,WCLASCC,WPOSCCU
                                LOOP
                                   /* Não terá necessidade de executar INSERT */
                                   WINSERT := 0;
                                   UPDATE E615POF SET
                                          QTDCMP=(QTDCMP + WQTDCMP),
                                          PRECMP=PPREUNI,
                                          TOTCMP=(TOTCMP + WTOTCMP),
                                          QTDCXA=(QTDCXA + WQTDCXA),
                                          PRECXA=PPREUNI,
                                          TOTCXA=(TOTCXA + WTOTCXA)
                                          WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND
                                                TIPREC=PTIPREC AND CODPRO=PCODPRO AND CODDER=PCODDER AND
                                                CODSER=PCODSER AND ROTPPJ=PROTPPJ AND MESANO=PMESANO AND
                                                CTAFIN=WCTAFIN AND CODCCU=WCODCCU;
                                END LOOP; /* FOR POF*/
                                /* Faz a inclusão caso não existir */
                                IF (WINSERT = 1) THEN
                                  IF (WCLACCU=' ') THEN
                                      WCODCCU := PCODCCU;
                                      WPOSCCU := 0;
                                      WPOSFIN := 0;
                                   END IF;

                                   INSERT INTO E615POF
                                          (CODEMP,NUMPRJ,CODFPJ,TIPREC,CODPRO,CODDER,CODSER,ROTPPJ,MESANO,CTAFIN,CODCCU,CLAFIN,
                                          POSFIN,ANASIN,CLACCU,POSCCU,QTDCMP,PRECMP,TOTCMP,QTDCXA,PRECXA,TOTCXA,ANACCU,CLAFPJ,
                                          POSFPJ,ANAFPJ,NIVFPJ)
                                   VALUES (PCODEMP,PNUMPRJ,WCODFPJ,PTIPREC,PCODPRO,PCODDER,PCODSER,PROTPPJ,PMESANO,WCTAFIN,WCODCCU,
                                           WCLASFI,WPOSFIN,WANASIN,WCLASCC,WPOSCCU,wQTDCMP,PPREUNI,WTOTCMP,WQTDCXA,PPREUNI,WTOTCXA,
                                           WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);
                                END IF;
                                WTAMCCU := LENGTH(WCLASCC);
                                WQTDCCU := WTAMCCU-WPOSCCU;
                                WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                                IF ((WSITREG<>'A') AND (WQTDCCU>0) AND (WCLACCU<>' ')) THEN
                                   WTEMSCC := 'S';
                             END IF;
                             IF (WCLACCU=' ') THEN
                                EXIT;
                             END IF;
                             END LOOP; /* FOR CCU_S*/
                          END LOOP; /* WHILE TEMSCC*/
                          WTAMFIN := LENGTH(WCLASFI);
                          WQTDFIN := WTAMFIN-WPOSFIN;
                          WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                          IF ((WSITREG<>'A') AND (WQTDFIN>0) AND (WCLAFIN<>' ')) THEN
                             WTEMSCT := 'S';
                          END IF;
                          IF (WCLAFIN=' ') THEN
                             EXIT;
                          END IF;
                       END LOOP; /* FOR PLF_S*/
                    END LOOP; /* WHILE TEMSCT*/

                    /* Tratamento Fase */
                    /* Se utiliza classificacao de fases */
                    WTAMFPJ := LENGTH(WCLASFJ);
                    WQTDFPJ := WTAMFPJ-WPOSFPJ;
                    WCLASFJ := SUBSTRING(WCLASFJ,1,WQTDFPJ);
                    IF ((WSITREG<>'A') AND (WQTDFPJ>0) AND (WCLAFPJ<>' ')) THEN
                       WTEMSFJ := 'S';
                    END IF;
                    IF (WCLAFPJ=' ') THEN
                       EXIT;
                    END IF;
                 END LOOP; /* For da Fase */

              ELSE /* (WCLAFPJ_FILIAL = 'N') */

                 FOREACH CUR_E615FPJ_A INTO WCODFPJ,WCLASFJ,WANAFPJ,WPOSFPJ,WNIVFPJ
                 LOOP
                    /* Loop para contas financeiras */
                    WCLASFI := WCLAFIN;
                    WTEMSCT := 'S';
                    WHILE (WTEMSCT='S')
                    LOOP
                       WTEMSCT := 'N';
                       FOREACH CUR_E091PLF_S INTO WCTAFIN,WCLASFI,WANASIN,WPOSFIN
                       LOOP
                          /* Loop para centro de custos */
                          WCLASCC := WCLACCU;
                          WTEMSCC := 'S';
                          WHILE (WTEMSCC='S')
                          LOOP
                             WTEMSCC := 'N';
                             FOREACH CUR_E044CCU_S INTO WCODCCU,WCLASCC,WPOSCCU,WANACCU
                             LOOP
                                /* Terá necessidade de executar INSERT */
                                WINSERT := 1;
                                IF (WCLACCU=' ') THEN
                                   WCODCCU := PCODCCU;
                                   WPOSCCU := 0;
                                   WPOSFIN := 0;
                                END IF;
                                /* Faz a atualização caso existir */
                                FOREACH CUR_E615POF INTO WANAFPJ,WNIVFPJ,WCLASFJ,WPOSFPJ,WCLASFI,WPOSFIN,WCLASCC,WPOSCCU
                                LOOP
                                   /* Não terá necessidade de executar INSERT */
                                   WINSERT := 0;
                                   UPDATE E615POF SET
                                          QTDCMP=(QTDCMP + WQTDCMP),
                                          PRECMP=PPREUNI,
                                          TOTCMP=(TOTCMP + WTOTCMP),
                                          QTDCXA=(QTDCXA + WQTDCXA),
                                          PRECXA=PPREUNI,
                                          TOTCXA=(TOTCXA + WTOTCXA)
                                          WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND
                                                TIPREC=PTIPREC AND CODPRO=PCODPRO AND CODDER=PCODDER AND
                                                CODSER=PCODSER AND ROTPPJ=PROTPPJ AND MESANO=PMESANO AND
                                                CTAFIN=WCTAFIN AND CODCCU=WCODCCU;
                                END LOOP; /* FOR POF*/
                                /* Faz a inclusão caso não existir */
                                IF (WINSERT = 1) THEN
                                   IF (WCLACCU=' ') THEN
                                      WCODCCU := PCODCCU;
                                      WPOSCCU := 0;
                                      WPOSFIN := 0;
                                   END IF;
                                   INSERT INTO E615POF
                                          (CODEMP,NUMPRJ,CODFPJ,TIPREC,CODPRO,CODDER,CODSER,ROTPPJ,MESANO,CTAFIN,CODCCU,CLAFIN,
                                           POSFIN,ANASIN,CLACCU,POSCCU,QTDCMP,PRECMP,TOTCMP,QTDCXA,PRECXA,TOTCXA,ANACCU,CLAFPJ,
                                           POSFPJ,ANAFPJ,NIVFPJ)
                                   VALUES (PCODEMP,PNUMPRJ,WCODFPJ,PTIPREC,PCODPRO,PCODDER,PCODSER,PROTPPJ,PMESANO,WCTAFIN,WCODCCU,
                                           WCLASFI,WPOSFIN,WANASIN,WCLASCC,WPOSCCU,wQTDCMP,PPREUNI,WTOTCMP,WQTDCXA,PPREUNI,WTOTCXA,
                                           WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);

                                END IF;
                                WTAMCCU := LENGTH(WCLASCC);
                                WQTDCCU := WTAMCCU-WPOSCCU;
                                WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                                IF ((WSITREG<>'A') AND (WQTDCCU>0) AND (WCLACCU<>' ')) THEN
                                   WTEMSCC := 'S';
                             END IF;
                             IF (WCLACCU=' ') THEN
                                EXIT;
                             END IF;
                             END LOOP;
                          END LOOP;
                          WTAMFIN := LENGTH(WCLASFI);
                          WQTDFIN := WTAMFIN-WPOSFIN;
                          WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                          IF ((WSITREG<>'A') AND (WQTDFIN>0) AND (WCLAFIN<>' ')) THEN
                             WTEMSCT := 'S';
                          END IF;
                          IF (WCLAFIN=' ') THEN
                             EXIT;
                          END IF;
                       END LOOP;
                    END LOOP;
                 END LOOP; /* For da Fase */
              END IF; /* (WCLAFPJ_FILIAL = 'S') */
           END LOOP; /* WHILE TEMSFJ CLASSIFICAO */
        END LOOP; /*FOR CCU*/
     END LOOP; /* FOR 091PLF*/
END LOOP; /* FOR 615FPJ */
END␀’ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
p␀␀PROCEDURE SP_ATULOTE(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PNUMLOT NUMBER(09),POLDDEB NUMBER(07),PNEWDEB NUMBER(07),POLDCRE NUMBER(07),PNEWCRE NUMBER(07),POLDVLR NUMBER(17,2),PNEWVLR NUMBER(17,2))
 IS

WTOTDEB NUMBER(17,2);
WTOTCRE NUMBER(17,2);


/* CURSOR para pegar o total de débitos e créditos do lote (E640LOT) */
CURSOR CUR_E640LOT IS
       SELECT TOTDEB,TOTCRE
       FROM E640LOT
       WHERE CODEMP=PCODEMP AND NUMLOT=PNUMLOT FOR UPDATE;


BEGIN

/* Inicializa variável para receber total de débito e crédito */
WTOTDEB := 0;
WTOTCRE := 0;

/* abre CURSOR do lote */
FOREACH CUR_E640LOT INTO WTOTDEB,WTOTCRE
LOOP
     /* contorno para atender limitações do Informix */
     WTOTDEB := IFNULL(WTOTDEB,0);
     WTOTCRE := IFNULL(WTOTCRE,0);

END LOOP;


IF    (POLDDEB = 0) AND (PNEWDEB > 0) THEN
      WTOTDEB := WTOTDEB + PNEWVLR;
ELSIF (POLDDEB > 0) AND (PNEWDEB = 0) THEN
      WTOTDEB := WTOTDEB - POLDVLR;
ELSIF (POLDDEB > 0) AND (PNEWDEB > 0) THEN
      WTOTDEB := WTOTDEB - (POLDVLR - PNEWVLR);
END IF;

IF    (POLDCRE = 0) AND (PNEWCRE > 0) THEN
      WTOTCRE := WTOTCRE + PNEWVLR;
ELSIF (POLDCRE > 0) AND (PNEWCRE = 0) THEN
      WTOTCRE := WTOTCRE - POLDVLR;
ELSIF (POLDCRE > 0) AND (PNEWCRE > 0) THEN
      WTOTCRE := WTOTCRE - (POLDVLR - PNEWVLR);
END IF;


UPDATE E640LOT SET TOTDEB=WTOTDEB,TOTCRE=WTOTCRE
                   WHERE CODEMP=PCODEMP AND NUMLOT=PNUMLOT;
END␀“ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0

␀␀PROCEDURE SP_ATUMESANO(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PMESANO DATE,PCTARED NUMBER(07),PVLRLCT NUMBER(17,2),PDEBCRE VARCHAR2(01))
 IS

WMESANO DATE;
WCLACTA VARCHAR2(30);
WANASIN CHAR;
WQTDPOS NUMBER(1);
WRETROA NUMBER(1);

/* CURSOR para pegar o último parâmetro do E650PMA cadastrado */
CURSOR CUR_MX_E650PMA IS
       SELECT MAX(MESANO) AS MESANO
       FROM E650PMA
       WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL;

/* CURSOR para trazer as contas que não possuem registro no E650Sal num determinado mês*/
CURSOR CUR_E650PMA IS
       SELECT E650PMA.MESANO,E045PLA.CLACTA,E045PLA.ANASIN,E045PLA.QTDPOS
       FROM E650PMA,E045PLA
       WHERE E650PMA.CODEMP=PCODEMP AND E650PMA.CODFIL=PCODFIL AND
             MESANO>PMESANO AND E045PLA.CODEMP=E650PMA.CODEMP AND
             E045PLA.CTARED=PCTARED AND
             NOT EXISTS
             (SELECT 1
              FROM E650SAL
              WHERE E650SAL.CODEMP=E650PMA.CODEMP AND
                    E650SAL.CODFIL=E650PMA.CODFIL AND
                    E650SAL.MESANO=E650PMA.MESANO AND
                    E650SAL.CTARED=E045PLA.CTARED
              )
       FOR UPDATE;

BEGIN

/* Verifica se o Mês em questão é retroativo */
WRETROA := 0;
FOREACH CUR_MX_E650PMA INTO WMESANO
LOOP
    IF   (WMESANO > PMESANO) THEN
         WRETROA := 1;
    END IF;
END LOOP;

/* se for um lançamento retroativo, altera mêses superiores */
IF   (WRETROA = 1) THEN
     /* Verifica se falta algum registro no E650Sal - garantia para o update*/
     FOREACH CUR_E650PMA INTO WMESANO,WCLACTA,WANASIN,WQTDPOS
     LOOP
          INSERT INTO E650SAL
                     (CODEMP,CODFIL,MESANO,CTARED,CLACTA,ANASIN,QTDPOS,
                      DEBCAL,CRECAL,DEBMES,CREMES,SALMES,VLRORC)
                 VALUES (PCODEMP,PCODFIL,WMESANO,PCTARED,WCLACTA,WANASIN,WQTDPOS,
                         0,0,0,0,0,0);
     END LOOP;

     /* Altera os valores para cáculos nos meses para frente */
     IF    (PDEBCRE = 'D') THEN
           UPDATE E650SAL SET DEBCAL = DEBCAL + PVLRLCT
                  WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                        MESANO>PMESANO AND CTARED=PCTARED;

     ELSIF (PDEBCRE = 'C') THEN
           UPDATE E650SAL SET CRECAL = CRECAL + PVLRLCT
                  WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                        MESANO>PMESANO AND CTARED=PCTARED;
     END IF;
     /* Altera a situação para lançamentos retroativos*/
     UPDATE E650PMA SET TEMLRT='S' WHERE CODEMP=PCODEMP AND
                                        CODFIL=PCODFIL AND MESANO>PMESANO;
END IF;
END␀”ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
J	␀␀PROCEDURE SP_ATUMESANOAUX(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PMESANO DATE,PCTAAUX NUMBER(07),PCTARED NUMBER(07),PVLRLCT NUMBER(17,2),PDEBCRE VARCHAR2(01))
 IS

WMESANO DATE;
WVLRAUX NUMBER(17,2);
WRETROA NUMBER(1);

/* CURSOR para pegar o último parâmetro do E650PMA cadastrado */
CURSOR CUR_MX_E650PMA IS
       SELECT MAX(MESANO) AS MESANO
       FROM E650PMA
       WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL;

/* CURSOR para trazer as contas que não possuem registro no E652Sal num determinado mês*/
CURSOR CUR_E650PMA IS
       SELECT E650PMA.MESANO
       FROM E650PMA,E045PCA
       WHERE E650PMA.CODEMP=PCODEMP AND E650PMA.CODFIL=PCODFIL AND
             MESANO>PMESANO AND E045PCA.CODEMP=E650PMA.CODEMP AND
             E045PCA.CTAAUX=PCTAAUX AND
             NOT EXISTS
             (SELECT 1
              FROM E652SAL
              WHERE E652SAL.CODEMP=E650PMA.CODEMP AND
                    E652SAL.CODFIL=E650PMA.CODFIL AND
                    E652SAL.MESANO=E650PMA.MESANO AND
                    E652SAL.CTAAUX=E045PCA.CTAAUX AND
                    E652SAL.CTARED=PCTARED
              )
       FOR UPDATE;

BEGIN

/* Verifica se o Mês em questão é retroativo */
WRETROA := 0;
FOREACH CUR_MX_E650PMA INTO WMESANO
LOOP
    IF   (WMESANO > PMESANO) THEN
         WRETROA := 1;
    END IF;
END LOOP;

/* se for um lançamento retroativo, altera mêses superiores */
IF   (WRETROA = 1) THEN
     /* Verifica se falta algum registro no E652Sal - garantia para o update*/
     FOREACH CUR_E650PMA INTO WMESANO
     LOOP
          INSERT INTO E652SAL
                     (CODEMP,CODFIL,MESANO,CTAAUX,CTARED,
                      DEBCAL,CRECAL,DEBMES,CREMES,SALMES)
                 VALUES (PCODEMP,PCODFIL,WMESANO,PCTAAUX,PCTARED,
                         0,0,0,0,0);
     END LOOP;


     /* Altera os valores para cáculos nos meses para frente */
     IF    (PDEBCRE = 'D') THEN
           UPDATE E652SAL SET SALMES = SALMES + PVLRLCT
                  WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                        MESANO>PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED;

     ELSIF (PDEBCRE = 'C') THEN
           WVLRAUX := (PVLRLCT * -1);
           UPDATE E652SAL SET SALMES = SALMES + WVLRAUX
                  WHERE CODEMP=PCODEMP AND CODFIL=PCODFIL AND
                        MESANO>PMESANO AND CTAAUX=PCTAAUX AND CTARED=PCTARED;
     END IF;
END IF;
END␀•ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
WJ␀␀PROCEDURE SP_ATUPROJETOS(PCODEMP NUMBER(04),PNUMPRJ NUMBER(08),PCODFPJ NUMBER(04),PCTAFIN NUMBER(07),PCODCCU VARCHAR2(9),PMESANO DATE,PROTPPJ NUMBER(02),PCRIRAT NUMBER(01),PSOMSUB NUMBER(01),PCODTNS VARCHAR2(5),PVLRRAT NUMBER(15,2))
 IS

/* Variávies gerais */
WINSERT NUMBER (01);
WSITREG CHAR;
/* Variáveis dos valores de saldos para UPDATE ou INSERT */
WVLRDMP NUMBER (15,2);
WVLRCMP NUMBER (15,2);
WVLRSMP NUMBER (15,2);
WVLRDMX NUMBER (15,2);
WVLRCMX NUMBER (15,2);
WVLRSMX NUMBER (15,2);
WACUDMP NUMBER (15,2);
WACUCMP NUMBER (15,2);
WACUSMP NUMBER (15,2);
WACUDMX NUMBER (15,2);
WACUCMX NUMBER (15,2);
WACUSMX NUMBER (15,2);
WSALDAP NUMBER (15,2);
WSALCAP NUMBER (15,2);
WSALSAP NUMBER (15,2);
WSALDAX NUMBER (15,2);
WSALCAX NUMBER (15,2);
WSALSAX NUMBER (15,2);

/* Variáveis para tratamento das fases */
WCLAFPJ_FILIAL CHAR;
WCODFPJ NUMBER (04);
WCLAFPJ VARCHAR2 (20);
WCLASFJ VARCHAR2 (20);
WPOSFPJ INTEGER;
WTAMFPJ NUMBER (04);
WQTDFPJ INTEGER;
WANAFPJ CHAR;
WTEMSFJ CHAR;
WNIVFPJ INTEGER;

/* Variáveis para tratamento das contas financeiras */
WCTAFIN NUMBER (07);
WCLAFIN VARCHAR2 (30);
WCLASFI VARCHAR2 (30);
WPOSFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMFIN NUMBER (07);
WQTDFIN INTEGER; /* operações com string, variável deve ser INTEGER */
WANASIN CHAR;
WTEMSCT CHAR;

/* Variáveis para tratamento dos centros de custos */
WCODCCU VARCHAR2(09);
WCLACCU VARCHAR2 (30);
WCLASCC VARCHAR2 (30);
WPOSCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WTAMCCU NUMBER (09);
WQTDCCU INTEGER; /* operações com string, variável deve ser INTEGER */
WANACCU CHAR;
WTEMSCC CHAR;

/* CURSOR para trazer se o projeto utiliza a classificacao de fases */
CURSOR CUR_E615PRJ IS
       SELECT E615PRJ.CLAFPJ
              FROM E615PRJ
              WHERE E615PRJ.CODEMP=PCODEMP AND
                    E615PRJ.NUMPRJ=PNUMPRJ;

/* CURSOR para trazer o dados da conta e centro de custos e saldos do projeto (E615POS) */
CURSOR CUR_E615POS IS
       SELECT ANAFPJ,NIVFPJ,CLAFPJ,POSFPJ,CLAFIN,POSFIN,CLACCU,POSCCU
              FROM E615POS
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND CTAFIN=WCTAFIN AND CODCCU=WCODCCU AND
                    ROTPPJ=PROTPPJ AND MESANO=PMESANO;

/* CURSOR para trazer a classificação e outras informações da fase */
CURSOR CUR_E615FPJ IS
       SELECT CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ;

/* CURSOR para trazer a classificacao e outras informacoes da conta financeira em questao */
CURSOR CUR_E091PLF IS
       SELECT CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CTAFIN=PCTAFIN;

/* CURSOR para trazer a classificacao e outras informacoes do centro de custo em questao */
CURSOR CUR_E044CCU IS
       SELECT CLACCU,POSCCU
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CODCCU=PCODCCU;

/* CURSOR para trazer a fase sintetica */
CURSOR CUR_E615FPJ_S IS
       SELECT CODFPJ,CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CLAFPJ=WCLASFJ;

/* CURSOR para trazer a fase analitica */
CURSOR CUR_E615FPJ_A IS
       SELECT CODFPJ,CLAFPJ,ANASIN,POSFPJ,NIVFPJ
              FROM E615FPJ
              WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ;

/* CURSOR para trazer a conta financeira  */
CURSOR CUR_E091PLF_S IS
       SELECT CTAFIN,CLAFIN,ANASIN,POSFIN
              FROM E091PLF
              WHERE CODEMP=PCODEMP AND CLAFIN=WCLASFI;

/* CURSOR para trazer a centro de custo superior */
CURSOR CUR_E044CCU_S IS
       SELECT CODCCU,CLACCU,POSCCU,ANASIN
              FROM E044CCU
              WHERE CODEMP=PCODEMP AND CLACCU=WCLASCC;

/* CURSOR para verificar se deve atualizar as contas sintéticas */
CURSOR CUR_E098REG IS
       SELECT SITREG
              FROM E098REG
              WHERE CODEMP=PCODEMP AND MODSIS='GER' AND IDEREG='000NOLPJ02' AND CODTNS=' ';
BEGIN
/* Caso critério for nenhum não atualiza saldo */
IF (PCRIRAT = 5) THEN
   RETURN;
END IF;

/* Inicializa Variáveis */
/* Variávies gerais */
WSITREG := 'I';
/* Valores de saldos para UPDATE ou INSERT */
WVLRDMP := 0;
WVLRCMP := 0;
WVLRSMP := 0;
WVLRDMX := 0;
WVLRCMX := 0;
WVLRSMX := 0;
WACUDMP := 0;
WACUCMP := 0;
WACUSMP := 0;
WACUDMX := 0;
WACUCMX := 0;
WACUSMX := 0;
WSALDAP := 0;
WSALCAP := 0;
WSALSAP := 0;
WSALDAX := 0;
WSALCAX := 0;
WSALSAX := 0;
/* Variáveis para tratamento das fase */
WCODFPJ := 0;
WCLAFPJ := ' ';
WCLASFJ := ' ';
WPOSFPJ := 0;
WANAFPJ := ' ';
WQTDFPJ := 0;
WTEMSFJ := 'S';
WNIVFPJ := 0;
/* Variáveis para tratamento das contas financeiras */
WCTAFIN := 0;
WCLAFIN := ' ';
WCLASFI := ' ';
WPOSFIN := 0;
WANASIN := ' ';
WQTDFIN := 0;
WTEMSCT := 'S';
/* Variáveis para tratamento dos centros de custos */
WCODCCU := ' ';
WCLACCU := ' ';
WCLASCC := ' ';
WPOSCCU := 0;
WANACCU := ' ';
WQTDCCU := 0;
WTEMSCC := 'S';

/* Verificar se utiliza classificacao de fases para atualizar para as superiores */
FOREACH CUR_E615PRJ INTO WCLAFPJ_FILIAL
LOOP
     WCLAFPJ_FILIAL := WCLAFPJ_FILIAL;	/* Necessário atribuir algo, senão ocorre erro */
END LOOP;

FOREACH CUR_E615FPJ INTO WCLAFPJ,WANAFPJ,WPOSFPJ,WNIVFPJ
LOOP
     FOREACH CUR_E091PLF INTO WCLAFIN,WANASIN,WPOSFIN
     LOOP
        FOREACH CUR_E044CCU INTO WCLACCU,WPOSCCU
        LOOP
           /* Regime competência */
           IF (PSOMSUB IN (1,3,4,6)) THEN
              /* Débito */
              IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
                 WVLRDMP := PVLRRAT;
                 WVLRSMP := (PVLRRAT * -1);
                 WACUDMP := PVLRRAT;
                 WACUSMP := (PVLRRAT * -1);
                 WSALDAP := PVLRRAT;
                 WSALSAP := (PVLRRAT * -1);
              /* Crédito */
              ELSE
                 WVLRCMP := PVLRRAT;
                 WVLRSMP := PVLRRAT;
                 WACUCMP := PVLRRAT;
                 WACUSMP := PVLRRAT;
                 WSALCAP := PVLRRAT;
                 WSALSAP := PVLRRAT;
              END IF;
           END IF;
           /* Regime caixa */
           IF (PSOMSUB IN (2,3,5,6)) THEN
              /* Débito */
              IF ((PCRIRAT = 3) OR (PCRIRAT = 4)) THEN
                 WVLRDMX := PVLRRAT;
                 WVLRSMX := (PVLRRAT * -1);
                 WACUDMX := PVLRRAT;
                 WACUSMX := (PVLRRAT * -1);
                 WSALDAX := PVLRRAT;
                 WSALSAX := (PVLRRAT * -1);
              /* Crédito */
              ELSE
                 WVLRCMX := PVLRRAT;
                 WVLRSMX := PVLRRAT;
                 WACUCMX := PVLRRAT;
                 WACUSMX := PVLRRAT;
                 WSALCAX := PVLRRAT;
                 WSALSAX := PVLRRAT;
              END IF;
           END IF;
           /* Verificar se deve atualizar as contas sintéticas */
           FOREACH CUR_E098REG INTO WSITREG
           LOOP
              WSITREG := WSITREG;	/* Necessário atribuir algo, senão ocorre erro */
           END LOOP;

           /* Loop para fases */
           WCLASFJ := WCLAFPJ;
           WTEMSFJ := 'S';
           WHILE (WTEMSFJ='S')
           LOOP
              WTEMSFJ := 'N';
              IF   ((WCLAFPJ_FILIAL = 'S') AND (WCLASFJ <> ' ')) THEN
                 FOREACH CUR_E615FPJ_S INTO WCODFPJ,WCLASFJ,WANAFPJ,WPOSFPJ,WNIVFPJ
                 LOOP
                    /* Loop para contas financeiras */
                    WCLASFI := WCLAFIN;
                    WTEMSCT := 'S';
                    WHILE (WTEMSCT='S')
                    LOOP
                       WTEMSCT := 'N';
                       FOREACH CUR_E091PLF_S INTO WCTAFIN,WCLASFI,WANASIN,WPOSFIN
                       LOOP
                          /* Loop para centro de custos */
                          WCLASCC := WCLACCU;
                          WTEMSCC := 'S';
                          WHILE (WTEMSCC='S')
                          LOOP
                             WTEMSCC := 'N';
                             FOREACH CUR_E044CCU_S INTO WCODCCU,WCLASCC,WPOSCCU,WANACCU
                             LOOP
                                /* Terá necessidade de executar INSERT */
                                WINSERT := 1;
                                IF (WCLACCU=' ') THEN
                                   WCODCCU := PCODCCU;
                                   WPOSCCU := 0;
                                   WPOSFIN := 0;
                                END IF;
                                /* Faz a atualização caso existir */
                                FOREACH CUR_E615POS INTO WANAFPJ,WNIVFPJ,WCLASFJ,WPOSFPJ,WCLASFI,WPOSFIN,WCLASCC,WPOSCCU
                                LOOP
                                   /* Não terá necessidade de executar INSERT */
                                   WINSERT := 0;
                                   UPDATE E615POS SET
                                          VLRCMP=(VLRCMP + WVLRCMP),
                                          VLRDMP=(VLRDMP + WVLRDMP),
                                          VLRSMP=(VLRSMP + WVLRSMP),
                                          ACUCMP=(ACUCMP + WACUCMP),
                                          ACUDMP=(ACUDMP + WACUDMP),
                                          ACUSMP=(ACUSMP + WACUSMP),
                                          SALCAP=(SALCAP + WSALCAP),
                                          SALDAP=(SALDAP + WSALDAP),
                                          SALSAP=(SALSAP + WSALSAP),
                                          VLRCMX=(VLRCMX + WVLRCMX),
                                          VLRDMX=(VLRDMX + WVLRDMX),
                                          VLRSMX=(VLRSMX + WVLRSMX),
                                          ACUCMX=(ACUCMX + WACUCMX),
                                          ACUDMX=(ACUDMX + WACUDMX),
                                          ACUSMX=(ACUSMX + WACUSMX),
                                          SALCAX=(SALCAX + WSALCAX),
                                          SALDAX=(SALDAX + WSALDAX),
                                          SALSAX=(SALSAX + WSALSAX)
                                          WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND CTAFIN=WCTAFIN AND
                                                CODCCU=WCODCCU AND ROTPPJ=PROTPPJ AND MESANO=PMESANO;
                                END LOOP;
                                /* Faz a inclusão caso não existir */
                                IF (WINSERT = 1) THEN
                                   IF (WCLACCU=' ') THEN
                                      WCODCCU := PCODCCU;
                                      WPOSCCU := 0;
                                      WPOSFIN := 0;
                                   END IF;
                                   INSERT INTO E615POS
                                          (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CODCCU,ROTPPJ,MESANO,VLRCMP,VLRDMP,VLRSMP,VLRCMX,VLRDMX,VLRSMX,
                                           ACUCMP,ACUDMP,ACUSMP,ACUCMX,ACUDMX,ACUSMX,SALCAP,SALDAP,SALSAP,SALCAX,SALDAX,SALSAX,CLAFIN,
                                           POSFIN,ANASIN,CLACCU,POSCCU,ANACCU,CLAFPJ,POSFPJ,ANAFPJ,NIVFPJ)
                                   VALUES (PCODEMP,PNUMPRJ,WCODFPJ,WCTAFIN,WCODCCU,PROTPPJ,PMESANO,WVLRCMP,WVLRDMP,WVLRSMP,WVLRCMX,WVLRDMX,WVLRSMX,
                                           WACUCMP,WACUDMP,WACUSMP,WACUCMX,WACUDMX,WACUSMX,WSALCAP,WSALDAP,WSALSAP,WSALCAX,WSALDAX,WSALSAX,WCLASFI,
                                           WPOSFIN,WANASIN,WCLASCC,WPOSCCU,WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);

                                END IF;
                                WTAMCCU := LENGTH(WCLASCC);
                                WQTDCCU := WTAMCCU-WPOSCCU;
                                WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                                IF ((WSITREG<>'A') AND (WQTDCCU>0) AND (WCLACCU<>' ')) THEN
                                   WTEMSCC := 'S';
                             END IF;
                             IF (WCLACCU=' ') THEN
                                EXIT;
                             END IF;
                             END LOOP;
                          END LOOP;
                          WTAMFIN := LENGTH(WCLASFI);
                          WQTDFIN := WTAMFIN-WPOSFIN;
                          WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                          IF ((WSITREG<>'A') AND (WQTDFIN>0) AND (WCLAFIN<>' ')) THEN
                             WTEMSCT := 'S';
                          END IF;
                          IF (WCLAFIN=' ') THEN
                             EXIT;
                          END IF;
                       END LOOP;
                    END LOOP;
                    /* Tratamento Fase */
                    /* Se utiliza classificacao de fases */
                    WTAMFPJ := LENGTH(WCLASFJ);
                    WQTDFPJ := WTAMFPJ-WPOSFPJ;
                    WCLASFJ := SUBSTRING(WCLASFJ,1,WQTDFPJ);
                    IF ((WSITREG<>'A') AND (WQTDFPJ>0) AND (WCLAFPJ<>' ')) THEN
                       WTEMSFJ := 'S';
                    END IF;
                    IF (WCLAFPJ=' ') THEN
                       EXIT;
                    END IF;
                 END LOOP; /* For da Fase */

              ELSE /* (WCLAFPJ_FILIAL = 'N') */

                 FOREACH CUR_E615FPJ_A INTO WCODFPJ,WCLASFJ,WANAFPJ,WPOSFPJ,WNIVFPJ
                 LOOP
                    /* Loop para contas financeiras */
                    WCLASFI := WCLAFIN;
                    WTEMSCT := 'S';
                    WHILE (WTEMSCT='S')
                    LOOP
                       WTEMSCT := 'N';
                       FOREACH CUR_E091PLF_S INTO WCTAFIN,WCLASFI,WANASIN,WPOSFIN
                       LOOP
                          /* Loop para centro de custos */
                          WCLASCC := WCLACCU;
                          WTEMSCC := 'S';
                          WHILE (WTEMSCC='S')
                          LOOP
                             WTEMSCC := 'N';
                             FOREACH CUR_E044CCU_S INTO WCODCCU,WCLASCC,WPOSCCU,WANACCU
                             LOOP
                                /* Terá necessidade de executar INSERT */
                                WINSERT := 1;
                                IF (WCLACCU=' ') THEN
                                   WCODCCU := PCODCCU;
                                   WPOSCCU := 0;
                                   WPOSFIN := 0;
                                END IF;
                                /* Faz a atualização caso existir */
                                FOREACH CUR_E615POS INTO WANAFPJ,WNIVFPJ,WCLASFJ,WPOSFPJ,WCLASFI,WPOSFIN,WCLASCC,WPOSCCU
                                LOOP
                                   /* Não terá necessidade de executar INSERT */
                                   WINSERT := 0;
                                   UPDATE E615POS SET
                                          VLRCMP=(VLRCMP + WVLRCMP),
                                          VLRDMP=(VLRDMP + WVLRDMP),
                                          VLRSMP=(VLRSMP + WVLRSMP),
                                          ACUCMP=(ACUCMP + WACUCMP),
                                          ACUDMP=(ACUDMP + WACUDMP),
                                          ACUSMP=(ACUSMP + WACUSMP),
                                          SALCAP=(SALCAP + WSALCAP),
                                          SALDAP=(SALDAP + WSALDAP),
                                          SALSAP=(SALSAP + WSALSAP),
                                          VLRCMX=(VLRCMX + WVLRCMX),
                                          VLRDMX=(VLRDMX + WVLRDMX),
                                          VLRSMX=(VLRSMX + WVLRSMX),
                                          ACUCMX=(ACUCMX + WACUCMX),
                                          ACUDMX=(ACUDMX + WACUDMX),
                                          ACUSMX=(ACUSMX + WACUSMX),
                                          SALCAX=(SALCAX + WSALCAX),
                                          SALDAX=(SALDAX + WSALDAX),
                                          SALSAX=(SALSAX + WSALSAX)
                                          WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=WCODFPJ AND CTAFIN=WCTAFIN AND
                                                CODCCU=WCODCCU AND ROTPPJ=PROTPPJ AND MESANO=PMESANO;
                                END LOOP;
                                /* Faz a inclusão caso não existir */
                                IF (WINSERT = 1) THEN
                                   IF (WCLACCU=' ') THEN
                                      WCODCCU := PCODCCU;
                                      WPOSCCU := 0;
                                      WPOSFIN := 0;
                                   END IF;
                                   INSERT INTO E615POS
                                          (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CODCCU,ROTPPJ,MESANO,VLRCMP,VLRDMP,VLRSMP,VLRCMX,VLRDMX,VLRSMX,
                                           ACUCMP,ACUDMP,ACUSMP,ACUCMX,ACUDMX,ACUSMX,SALCAP,SALDAP,SALSAP,SALCAX,SALDAX,SALSAX,CLAFIN,
                                           POSFIN,ANASIN,CLACCU,POSCCU,ANACCU,CLAFPJ,POSFPJ,ANAFPJ,NIVFPJ)
                                   VALUES (PCODEMP,PNUMPRJ,WCODFPJ,WCTAFIN,WCODCCU,PROTPPJ,PMESANO,WVLRCMP,WVLRDMP,WVLRSMP,WVLRCMX,WVLRDMX,WVLRSMX,
                                           WACUCMP,WACUDMP,WACUSMP,WACUCMX,WACUDMX,WACUSMX,WSALCAP,WSALDAP,WSALSAP,WSALCAX,WSALDAX,WSALSAX,WCLASFI,
                                           WPOSFIN,WANASIN,WCLASCC,WPOSCCU,WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);

                                END IF;
                                WTAMCCU := LENGTH(WCLASCC);
                                WQTDCCU := WTAMCCU-WPOSCCU;
                                WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                                IF ((WSITREG<>'A') AND (WQTDCCU>0) AND (WCLACCU<>' ')) THEN
                                   WTEMSCC := 'S';
                             END IF;
                             IF (WCLACCU=' ') THEN
                                EXIT;
                             END IF;
                             END LOOP;
                          END LOOP;
                          WTAMFIN := LENGTH(WCLASFI);
                          WQTDFIN := WTAMFIN-WPOSFIN;
                          WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                          IF ((WSITREG<>'A') AND (WQTDFIN>0) AND (WCLAFIN<>' ')) THEN
                             WTEMSCT := 'S';
                          END IF;
                          IF (WCLAFIN=' ') THEN
                             EXIT;
                          END IF;
                       END LOOP;
                    END LOOP;
                 END LOOP; /* For da Fase */
              END IF; /* (WCLAFPJ_FILIAL = 'S') */
           END LOOP; /* While da Fase */
        END LOOP;
     END LOOP;
END LOOP;
END	POSTGRESQL;0
6␀␀CREATE OR REPLACE PROCEDURE sp_atuprojetos(
	pcodemp smallint,
	pnumprj integer,
	pcodfpj smallint,
	pctafin integer,
	pcodccu character varying,
	pmesano timestamp without time zone,
	protppj smallint,
	pcrirat smallint,
	psomsub smallint,
	pcodtns character varying,
	pvlrrat numeric)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  WINSERT smallint;
  WSITREG varchar;
  WVLRDMP numeric(15,2);
  WVLRCMP numeric(15,2);
  WVLRSMP numeric(15,2);
  WVLRDMX numeric(15,2);
  WVLRCMX numeric(15,2);
  WVLRSMX numeric(15,2);
  WACUDMP numeric(15,2);
  WACUCMP numeric(15,2);
  WACUSMP numeric(15,2);
  WACUDMX numeric(15,2);
  WACUCMX numeric(15,2);
  WACUSMX numeric(15,2);
  WSALDAP numeric(15,2);
  WSALCAP numeric(15,2);
  WSALSAP numeric(15,2);
  WSALDAX numeric(15,2);
  WSALCAX numeric(15,2);
  WSALSAX numeric(15,2);
  WCLAFPJ_FILIAL varchar;
  WCODFPJ smallint;
  WCLAFPJ varchar(20);
  WCLASFJ varchar(20);
  WPOSFPJ integer;
  WTAMFPJ smallint;
  WQTDFPJ integer;
  WANAFPJ varchar;
  WTEMSFJ varchar;
  WNIVFPJ integer;
  WCTAFIN integer;
  WCLAFIN varchar(30);
  WCLASFI varchar(30);
  WPOSFIN integer;
  WTAMFIN integer;
  WQTDFIN integer;
  WANASIN varchar;
  WTEMSCT varchar;
  WCODCCU varchar(09);
  WCLACCU varchar(30);
  WCLASCC varchar(30);
  WPOSCCU integer;
  WTAMCCU integer;
  WQTDCCU integer;
  WANACCU varchar;
  WTEMSCC varchar;
  WANAFPJ_IN varchar;
  WNIVFPJ_IN integer;
  WCLASFJ_IN varchar(20);
  WPOSFPJ_IN integer;
  WCLASFI_IN varchar(30);
  WPOSFIN_IN integer;
  WCLASCC_IN varchar(30);
  WPOSCCU_IN integer;
  TEMREGISTRO smallint;
BEGIN
  TEMREGISTRO := 1;
  IF pcrirat = 5 THEN
    RETURN;
  END IF;
  WSITREG := 'I';
  WVLRDMP := 0;
  WVLRCMP := 0;
  WVLRSMP := 0;
  WVLRDMX := 0;
  WVLRCMX := 0;
  WVLRSMX := 0;
  WACUDMP := 0;
  WACUCMP := 0;
  WACUSMP := 0;
  WACUDMX := 0;
  WACUCMX := 0;
  WACUSMX := 0;
  WSALDAP := 0;
  WSALCAP := 0;
  WSALSAP := 0;
  WSALDAX := 0;
  WSALCAX := 0;
  WSALSAX := 0;
  WCODFPJ := 0;
  WCLAFPJ := ' ';
  WCLASFJ := ' ';
  WPOSFPJ := 0;
  WANAFPJ := ' ';
  WQTDFPJ := 0;
  WTEMSFJ := 'S';
  WNIVFPJ := 0;
  WCTAFIN := 0;
  WCLAFIN := ' ';
  WCLASFI := ' ';
  WPOSFIN := 0;
  WANASIN := ' ';
  WQTDFIN := 0;
  WTEMSCT := 'S';
  WCODCCU := ' ';
  WCLACCU := ' ';
  WCLASCC := ' ';
  WPOSCCU := 0;
  WANACCU := ' ';
  WQTDCCU := 0;
  WTEMSCC := 'S';
  FOR WCLAFPJ_FILIAL IN
    SELECT E615PRJ.CLAFPJ FROM e615prj WHERE E615PRJ.CODEMP = pcodemp AND E615PRJ.NUMPRJ = pnumprj
  LOOP
    WCLAFPJ_FILIAL := WCLAFPJ_FILIAL;
  END LOOP;
  FOR WCLAFPJ, WANAFPJ, WPOSFPJ, WNIVFPJ IN
    SELECT CLAFPJ, ANASIN, POSFPJ, NIVFPJ FROM e615fpj WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = pcodfpj
  LOOP
    FOR WCLAFIN, WANASIN, WPOSFIN IN
      SELECT CLAFIN, ANASIN, POSFIN FROM e091plf WHERE CODEMP = pcodemp AND CTAFIN = pctafin
    LOOP
      FOR WCLACCU, WPOSCCU IN
        SELECT CLACCU, POSCCU FROM e044ccu WHERE CODEMP = pcodemp AND CODCCU = pcodccu
      LOOP
        IF psomsub IN (1,3,4,6) THEN
          IF pcrirat = 3 OR pcrirat = 4 THEN
            WVLRDMP := pvlrrat;
            WVLRSMP := pvlrrat * -1;
            WACUDMP := pvlrrat;
            WACUSMP := pvlrrat * -1;
            WSALDAP := pvlrrat;
            WSALSAP := pvlrrat * -1;
          ELSE
            WVLRCMP := pvlrrat;
            WVLRSMP := pvlrrat;
            WACUCMP := pvlrrat;
            WACUSMP := pvlrrat;
            WSALCAP := pvlrrat;
            WSALSAP := pvlrrat;
          END IF;
        END IF;
        IF psomsub IN (2,3,5,6) THEN
          IF pcrirat = 3 OR pcrirat = 4 THEN
            WVLRDMX := pvlrrat;
            WVLRSMX := pvlrrat * -1;
            WACUDMX := pvlrrat;
            WACUSMX := pvlrrat * -1;
            WSALDAX := pvlrrat;
            WSALSAX := pvlrrat * -1;
          ELSE
            WVLRCMX := pvlrrat;
            WVLRSMX := pvlrrat;
            WACUCMX := pvlrrat;
            WACUSMX := pvlrrat;
            WSALCAX := pvlrrat;
            WSALSAX := pvlrrat;
          END IF;
        END IF;
        FOR WSITREG IN
          SELECT SITREG FROM e098reg WHERE CODEMP = pcodemp AND MODSIS = 'GER' AND IDEREG = '000NOLPJ02' AND CODTNS = ' '
        LOOP
          WSITREG := WSITREG;
        END LOOP;
        IF WSITREG IS NULL THEN
          WSITREG := 'I';
        END IF;
        WCLASFJ := WCLAFPJ;
        WTEMSFJ := 'S';
        WHILE WTEMSFJ = 'S'
        LOOP
          WTEMSFJ := 'N';
          IF WCLAFPJ_FILIAL = 'S' AND WCLASFJ <> ' ' THEN
            FOR WCODFPJ, WCLASFJ, WANAFPJ, WPOSFPJ, WNIVFPJ IN
              SELECT CODFPJ, CLAFPJ, ANASIN, POSFPJ, NIVFPJ FROM e615fpj WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CLAFPJ = WCLASFJ
            LOOP
              WCLASFI := WCLAFIN;
              WTEMSCT := 'S';
              WHILE WTEMSCT = 'S'
              LOOP
                WTEMSCT := 'N';
                FOR WCTAFIN, WCLASFI, WANASIN, WPOSFIN IN
                  SELECT CTAFIN, CLAFIN, ANASIN, POSFIN FROM e091plf WHERE CODEMP = pcodemp AND CLAFIN = WCLASFI
                LOOP
                  WCLASCC := WCLACCU;
                  WTEMSCC := 'S';
                  WHILE WTEMSCC = 'S'
                  LOOP
                    WTEMSCC := 'N';
                    FOR WCODCCU, WCLASCC, WPOSCCU, WANACCU IN
                      SELECT CODCCU, CLACCU, POSCCU, ANASIN FROM e044ccu WHERE CODEMP = pcodemp AND CLACCU = WCLASCC
                    LOOP
                      WINSERT := 1;
                      IF WCLACCU = ' ' THEN
                        WCODCCU := pcodccu;
                        WPOSCCU := 0;
                        WPOSFIN := 0;
                      END IF;
                      BEGIN
                        SELECT ANAFPJ, NIVFPJ, CLAFPJ, POSFPJ, CLAFIN, POSFIN, CLACCU, POSCCU INTO STRICT WANAFPJ_IN, WNIVFPJ_IN, WCLASFI_IN, WPOSFPJ_IN, WCLASFI_IN, WPOSFIN_IN, WCLASCC_IN, WPOSCCU_IN FROM e615pos WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = WCODFPJ AND CTAFIN = WCTAFIN AND CODCCU = WCODCCU AND ROTPPJ = protppj AND MESANO = pmesano;
                      EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          TEMREGISTRO := 0;
                          IF WINSERT = 1 THEN
                            IF WCLACCU = ' ' THEN
                              WCODCCU := pcodccu;
                              WPOSCCU := 0;
                              WPOSFIN := 0;
                            END IF;
                            INSERT INTO e615pos(codemp,numprj,codfpj,ctafin,codccu,rotppj,mesano,vlrcmp,vlrdmp,vlrsmp,vlrcmx,vlrdmx,vlrsmx,acucmp,acudmp,acusmp,acucmx,acudmx,acusmx,salcap,saldap,salsap,salcax,saldax,salsax,clafin,posfin,anasin,claccu,posccu,anaccu,clafpj,posfpj,anafpj,nivfpj) VALUES (pcodemp,pnumprj,WCODFPJ,WCTAFIN,WCODCCU,protppj,pmesano,WVLRCMP,WVLRDMP,WVLRSMP,WVLRCMX,WVLRDMX,WVLRSMX,WACUCMP,WACUDMP,WACUSMP,WACUCMX,WACUDMX,WACUSMX,WSALCAP,WSALDAP,WSALSAP,WSALCAX,WSALDAX,WSALSAX,WCLASFI,WPOSFIN,WANASIN,WCLASCC,WPOSCCU,WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);
                          END IF;
                      END;
                      IF TEMREGISTRO = 1 THEN
                        WINSERT := 0;
                        UPDATE e615pos SET vlrcmp = VLRCMP + WVLRCMP, vlrdmp = VLRDMP + WVLRDMP, vlrsmp = VLRSMP + WVLRSMP, acucmp = ACUCMP + WACUCMP, acudmp = ACUDMP + WACUDMP, acusmp = ACUSMP + WACUSMP, salcap = SALCAP + WSALCAP, saldap = SALDAP + WSALDAP, salsap = SALSAP + WSALSAP, vlrcmx = VLRCMX + WVLRCMX, vlrdmx = VLRDMX + WVLRDMX, vlrsmx = VLRSMX + WVLRSMX, acucmx = ACUCMX + WACUCMX, acudmx = ACUDMX + WACUDMX, acusmx = ACUSMX + WACUSMX, salcax = SALCAX + WSALCAX, saldax = SALDAX + WSALDAX, salsax = SALSAX + WSALSAX WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = WCODFPJ AND CTAFIN = WCTAFIN AND CODCCU = WCODCCU AND ROTPPJ = protppj AND MESANO = pmesano;
                      END IF;
                      WTAMCCU := LENGTH(TRIM(WCLASCC));
                      WQTDCCU := WTAMCCU - WPOSCCU;
                      WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                      IF WSITREG <> 'A' AND WQTDCCU > 0 AND WCLACCU <> ' ' THEN
                        WTEMSCC := 'S';
                      END IF;
                      IF WCLACCU = ' ' THEN
                        EXIT;
                      END IF;
                    END LOOP;
                  END LOOP;
                  WTAMFIN := LENGTH(TRIM(WCLASFI));
                  WQTDFIN := WTAMFIN - WPOSFIN;
                  WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                  IF WSITREG <> 'A' AND WQTDFIN > 0 AND WCLAFIN <> ' ' THEN
                    WTEMSCT := 'S';
                  END IF;
                  IF WCLAFIN = ' ' THEN
                    EXIT;
                  END IF;
                END LOOP;
              END LOOP;
              WTAMFPJ := LENGTH(TRIM(WCLASFJ));
              WQTDFPJ := WTAMFPJ - WPOSFPJ;
              WCLASFJ := SUBSTRING(WCLASFJ,1,WQTDFPJ);
              IF WSITREG <> 'A' AND WQTDFPJ > 0 AND WCLAFPJ <> ' ' THEN
                WTEMSFJ := 'S';
              END IF;
              IF WCLAFPJ = ' ' THEN
                EXIT;
              END IF;
            END LOOP;
          ELSE
            FOR WCODFPJ, WCLASFJ, WANAFPJ, WPOSFPJ, WNIVFPJ IN
              SELECT CODFPJ, CLAFPJ, ANASIN, POSFPJ, NIVFPJ FROM e615fpj WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = pcodfpj
            LOOP
              WCLASFI := WCLAFIN;
              WTEMSCT := 'S';
              WHILE WTEMSCT = 'S'
              LOOP
                WTEMSCT := 'N';
                FOR WCTAFIN, WCLASFI, WANASIN, WPOSFIN IN
                  SELECT CTAFIN, CLAFIN, ANASIN, POSFIN FROM e091plf WHERE CODEMP = pcodemp AND CLAFIN = WCLASFI
                LOOP
                  WCLASCC := WCLACCU;
                  WTEMSCC := 'S';
                  WHILE WTEMSCC = 'S'
                  LOOP
                    WTEMSCC := 'N';
                    FOR WCODCCU, WCLASCC, WPOSCCU, WANACCU IN
                      SELECT CODCCU, CLACCU, POSCCU, ANASIN FROM e044ccu WHERE CODEMP = pcodemp AND CLACCU = WCLASCC
                    LOOP
                      WINSERT := 1;
                      IF WCLACCU = ' ' THEN
                        WCODCCU := pcodccu;
                        WPOSCCU := 0;
                        WPOSFIN := 0;
                      END IF;
                      BEGIN
                        SELECT ANAFPJ, NIVFPJ, CLAFPJ, POSFPJ, CLAFIN, POSFIN, CLACCU, POSCCU INTO STRICT WANAFPJ_IN, WNIVFPJ_IN, WCLASFI_IN, WPOSFPJ_IN, WCLASFI_IN, WPOSFIN_IN, WCLASCC_IN, WPOSCCU_IN FROM e615pos WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = WCODFPJ AND CTAFIN = WCTAFIN AND CODCCU = WCODCCU AND ROTPPJ = protppj AND MESANO = pmesano;
                      EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          TEMREGISTRO := 0;
                          IF WINSERT = 1 THEN
                            IF WCLACCU = ' ' THEN
                              WCODCCU := pcodccu;
                              WPOSCCU := 0;
                              WPOSFIN := 0;
                            END IF;
                            INSERT INTO e615pos(codemp,numprj,codfpj,ctafin,codccu,rotppj,mesano,vlrcmp,vlrdmp,vlrsmp,vlrcmx,vlrdmx,vlrsmx,acucmp,acudmp,acusmp,acucmx,acudmx,acusmx,salcap,saldap,salsap,salcax,saldax,salsax,clafin,posfin,anasin,claccu,posccu,anaccu,clafpj,posfpj,anafpj,nivfpj) VALUES (pcodemp,pnumprj,WCODFPJ,WCTAFIN,WCODCCU,protppj,pmesano,WVLRCMP,WVLRDMP,WVLRSMP,WVLRCMX,WVLRDMX,WVLRSMX,WACUCMP,WACUDMP,WACUSMP,WACUCMX,WACUDMX,WACUSMX,WSALCAP,WSALDAP,WSALSAP,WSALCAX,WSALDAX,WSALSAX,WCLASFI,WPOSFIN,WANASIN,WCLASCC,WPOSCCU,WANACCU,WCLASFJ,WPOSFPJ,WANAFPJ,WNIVFPJ);
                          END IF;
                      END;
                      IF TEMREGISTRO = 1 THEN
                        WINSERT := 0;
                        UPDATE e615pos SET vlrcmp = VLRCMP + WVLRCMP, vlrdmp = VLRDMP + WVLRDMP, vlrsmp = VLRSMP + WVLRSMP, acucmp = ACUCMP + WACUCMP, acudmp = ACUDMP + WACUDMP, acusmp = ACUSMP + WACUSMP, salcap = SALCAP + WSALCAP, saldap = SALDAP + WSALDAP, salsap = SALSAP + WSALSAP, vlrcmx = VLRCMX + WVLRCMX, vlrdmx = VLRDMX + WVLRDMX, vlrsmx = VLRSMX + WVLRSMX, acucmx = ACUCMX + WACUCMX, acudmx = ACUDMX + WACUDMX, acusmx = ACUSMX + WACUSMX, salcax = SALCAX + WSALCAX, saldax = SALDAX + WSALDAX, salsax = SALSAX + WSALSAX WHERE CODEMP = pcodemp AND NUMPRJ = pnumprj AND CODFPJ = WCODFPJ AND CTAFIN = WCTAFIN AND CODCCU = WCODCCU AND ROTPPJ = protppj AND MESANO = pmesano;
                      END IF;
                    END LOOP;
                    WTAMCCU := LENGTH(TRIM(WCLASCC));
                    WQTDCCU := WTAMCCU - WPOSCCU;
                    WCLASCC := SUBSTRING(WCLASCC,1,WQTDCCU);
                    IF WSITREG <> 'A' AND WQTDCCU > 0 AND WCLACCU <> ' ' THEN
                      WTEMSCC := 'S';
                    END IF;
                    IF WCLACCU = ' ' THEN
                      EXIT;
                    END IF;
                  END LOOP;
                END LOOP;
                WTAMFIN := LENGTH(TRIM(WCLASFI));
                WQTDFIN := WTAMFIN - WPOSFIN;
                WCLASFI := SUBSTRING(WCLASFI,1,WQTDFIN);
                IF WSITREG <> 'A' AND WQTDFIN > 0 AND WCLAFIN <> ' ' THEN
                  WTEMSCT := 'S';
                END IF;
                IF WCLAFIN = ' ' THEN
                  EXIT;
                END IF;
              END LOOP;
            END LOOP;
          END IF;
        END LOOP;
      END LOOP;
    END LOOP;
  END LOOP;
END
$BODY$;
␀–ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
²␀␀PROCEDURE SP_ATURATEIOPROJ(POPERAT CHAR,PCODEMP NUMBER(04),PNUMPRJ NUMBER(08),PCODFPJ NUMBER(04),PCTAFIN NUMBER(07),PCTARED NUMBER(07),PCODCCU VARCHAR2(9),PDATBAS DATE,PCODTNS VARCHAR2(5),PMESANO DATE,PCRIRAT NUMBER(01),PSOMSUB NUMBER(01),PCODFIL NUMBER(05),PPERCTA NUMBER(07,4),PVLRCTA NUMBER(15,2),PPERRAT NUMBER(07,4),PVLRRAT NUMBER(15,2),POBSRAT VARCHAR2(120),PUSUGER NUMBER(10),PDATGER DATE,PHORGER NUMBER(05),PROTPPJ NUMBER(02),PFILRPJ NUMBER(05),PNUMRPJ NUMBER(09),PSEQRP1 NUMBER(09),PSEQRP2 NUMBER(09),PDATRP1 DATE,PDATRP2 DATE,PSTRRP1 VARCHAR2(15),PSTRRP2 VARCHAR2(7),PSTRRP3 VARCHAR2(10),PORIMOV VARCHAR2(2),PNUMCRL NUMBER(09),PATUSUP CHAR,PDATCSP DATE) 
 IS
BEGIN
  NULL;
END	ORACLE;0ATGETNEXTVALUE
M6␀␀CREATE OR REPLACE PROCEDURE SP_ATURATEIOPROJ(POPERAT CHAR,PCODEMP NUMBER,PNUMPRJ NUMBER,PCODFPJ NUMBER,PCTAFIN NUMBER,PCTARED NUMBER,PCODCCU VARCHAR2,PDATBAS DATE,PCODTNS VARCHAR2,PMESANO DATE,
                                             PCRIRAT NUMBER,PSOMSUB NUMBER,PCODFIL NUMBER,PPERCTA NUMBER,PVLRCTA NUMBER,PPERRAT NUMBER,PVLRRAT NUMBER,POBSRAT VARCHAR2,PUSUGER NUMBER,PDATGER DATE,
                                             PHORGER NUMBER,PROTPPJ NUMBER,PFILRPJ NUMBER,PNUMRPJ NUMBER,PSEQRP1 NUMBER,PSEQRP2 NUMBER,PDATRP1 DATE,PDATRP2 DATE,PSTRRP1 VARCHAR2,PSTRRP2 VARCHAR2,
                                             PSTRRP3 VARCHAR2,PORIMOV VARCHAR2,PNUMCRL NUMBER,PATUSUP CHAR,PDATCSP DATE) IS   
WSEQRAT NUMBER(09);   
WSITRAT CHAR;   
WCRIRAT NUMBER(01);   
WDATBAS DATE;   
WMESANO DATE;   
WNUMPRJ NUMBER(09);   
WPRJATU NUMBER(09);   
WPRJSUP NUMBER(09);   
WESTCCO CHAR;   
WREGATU CHAR;   
WESTRAT CHAR;   
WEXIFAS NUMBER(09);
WCOMANDO VARCHAR2(500);   
WCHAVE VARCHAR2(500);

cursor CUR_E615PRJ_ATU is      
  SELECT E615PRJ.ESTCCO E615PRJ_ESTCCO,E615PRJ.REGATU E615PRJ_REGATU,E615PRJ.ESTRAT E615PRJ_ESTRAT        
    FROM E615PRJ E615PRJ        
   WHERE E615PRJ.CODEMP=PCODEMP        
     AND E615PRJ.NUMPRJ=WPRJATU;   

CUR_E615PRJ_ATU_cnt integer;   

cursor CUR_E615PRJ_SUP is      
  SELECT E615PRJ.PRJSUP E615PRJ_PRJSUP        
    FROM E615PRJ E615PRJ        
   WHERE E615PRJ.CODEMP=PCODEMP        
     AND E615PRJ.NUMPRJ=WNUMPRJ;   

CUR_E615PRJ_SUP_cnt integer; 

begin   
  WPRJATU := PNUMPRJ;   
  open CUR_E615PRJ_ATU;   
  begin     
    fetch CUR_E615PRJ_ATU into WESTCCO,WREGATU,WESTRAT;     
    while (CUR_E615PRJ_ATU%FOUND) loop       
      if (POPERAT='I') then         
        WSITRAT := 'A';         
        WDATBAS := PDATBAS;         
        WCRIRAT := PCRIRAT;       
      else         
        WSITRAT := 'I';         
        if (PCRIRAT=1) then           
          WCRIRAT := 3;         
        else           
          WCRIRAT := 1;         
        end if;       
      end if;       
      
      if ((WREGATU='A') OR 
          (WREGATU IS NULL) OR 
          (WREGATU=' ') OR 
          ((WREGATU='E') AND ((PSOMSUB=1) OR (PSOMSUB=4))) OR 
          ((WREGATU='S') AND ((PSOMSUB=2) OR (PSOMSUB=5)))) then         
        
        if (POPERAT='I') then           
          WSITRAT := 'A';           
          WCRIRAT := PCRIRAT;           
          WDATBAS := PDATBAS;         
        else           
          WSITRAT := 'I';           
          
          if (PCRIRAT=1) then             
            WCRIRAT := 3;           
          else             
            WCRIRAT := 1;           
          end if;           
          
          if (WESTRAT='S') then             
            WDATBAS := PDATGER;           
          else             
            WDATBAS := PDATBAS;           
          end if;           
          
          if (WESTCCO='S') then             
            begin               
              if ((PROTPPJ=5) OR (PROTPPJ=13) OR (PROTPPJ=8) OR (PROTPPJ=14)) then                 
                UPDATE E615RAT  
                   SET SITRAT = 'I'  
                 WHERE CODEMP=PCODEMP        
                   AND NUMPRJ=PNUMPRJ        
                   AND ROTPPJ=PROTPPJ        
                   AND FILRPJ=PFILRPJ        
                   AND NUMRPJ=PNUMRPJ        
                   AND SEQRP2=PSEQRP2        
                   AND DATRP1=PDATRP1        
                   AND DATRP2=PDATRP2        
                   AND ((RTRIM(STRRP1) IS NULL) OR (STRRP1=PSTRRP1))        
                   AND ((RTRIM(STRRP2) IS NULL) OR (STRRP2=PSTRRP2))        
                   AND ((RTRIM(STRRP3) IS NULL) OR (STRRP3=PSTRRP3))        
                   AND SITRAT='A';               
              else                 
                UPDATE E615RAT  
                   SET SITRAT = 'I'  
                 WHERE CODEMP=PCODEMP        
                   AND NUMPRJ=PNUMPRJ        
                   AND ROTPPJ=PROTPPJ        
                   AND FILRPJ=PFILRPJ        
                   AND NUMRPJ=PNUMRPJ        
                   AND SEQRP1=PSEQRP1        
                   AND SEQRP2=PSEQRP2        
                   AND DATRP1=PDATRP1        
                   AND DATRP2=PDATRP2        
                   AND ((RTRIM(STRRP1) IS NULL) OR (STRRP1=PSTRRP1))        
                   AND ((RTRIM(STRRP2) IS NULL) OR (STRRP2=PSTRRP2))        
                   AND ((RTRIM(STRRP3) IS NULL) OR (STRRP3=PSTRRP3))        
                   AND SITRAT='A';               
              end if;             
            end;           
          end if;         
        end if;         
        
        WMESANO := TO_DATE(TO_CHAR(01)||'/'||
                   TO_CHAR(TO_NUMBER(TO_CHAR(WDATBAS,'MM')))||'/'||
                   TO_CHAR(TO_NUMBER(TO_CHAR(WDATBAS,'YYYY')))||' '||
                   TO_CHAR(0)||':'||
                   TO_CHAR(0)||':'||
                   TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS');         
        WNUMPRJ := PNUMPRJ;         
        
        WCOMANDO := 'SELECT COALESCE (MAX(SEQRAT),0)
                       FROM E615RAT
                      WHERE CODEMP='|| TO_CHAR(PCODEMP)||
                      ' AND NUMPRJ='|| TO_CHAR(PNUMPRJ)||
                      ' AND CODFPJ='|| TO_CHAR(PCODFPJ)||
                      ' AND CTAFIN='|| TO_CHAR(PCTAFIN)||
                      ' AND CTARED='|| TO_CHAR(PCTARED)||
                      ' AND CODCCU='''|| TO_CHAR(PCODCCU)||'''';
        
        WCHAVE := 'E615RAT#'|| TO_CHAR(PCODEMP)||'#'|| TO_CHAR(PNUMPRJ)||'#'|| TO_CHAR(PCODFPJ)||'#'|| TO_CHAR(PCTAFIN)||'#'|| TO_CHAR(PCTARED)||'#'|| TO_CHAR(PCODCCU);
        
        WSEQRAT:= NULL;
        ATGETNEXTVALUE(WCHAVE,1,WCOMANDO,WSEQRAT);        
        
        INSERT INTO E615RAT (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CTARED,CODCCU,SEQRAT,DATBAS,CODTNS,MESANO,CRIRAT,SOMSUB,CODFIL,PERCTA,VLRCTA,PERRAT,VLRRAT,OBSRAT,SITRAT,USUGER,
                             DATGER,HORGER,ROTPPJ,FILRPJ,NUMRPJ,SEQRP1,SEQRP2,DATRP1,DATRP2,STRRP1,STRRP2,STRRP3,PRJORI,PRJFIL,ORIMOV,NUMCRL,DATCSP) 
                     VALUES (PCODEMP,PNUMPRJ,PCODFPJ,PCTAFIN,PCTARED,PCODCCU,WSEQRAT,WDATBAS,PCODTNS,WMESANO,WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PVLRCTA,PPERRAT,PVLRRAT,POBSRAT,WSITRAT,PUSUGER,
                             PDATGER,PHORGER,PROTPPJ,PFILRPJ,PNUMRPJ,PSEQRP1,PSEQRP2,PDATRP1,PDATRP2,PSTRRP1,PSTRRP2,PSTRRP3,PNUMPRJ,WNUMPRJ,PORIMOV,PNUMCRL,PDATCSP);       
      end if;       
      
      fetch CUR_E615PRJ_ATU into WESTCCO,WREGATU,WESTRAT;     
    end loop;   
    
  exception when others then     
    close CUR_E615PRJ_ATU;     
    raise;   
  end;   
    
  close CUR_E615PRJ_ATU;   
  WDATBAS := PDATBAS;   
  WMESANO := TO_DATE(TO_CHAR(01)||'/'||
             TO_CHAR(TO_NUMBER(TO_CHAR(WDATBAS,'MM')))||'/'||
             TO_CHAR(TO_NUMBER(TO_CHAR(WDATBAS,'YYYY')))||' '||
             TO_CHAR(0)||':'||
             TO_CHAR(0)||':'||
             TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS');   
  WNUMPRJ := PNUMPRJ;   
    
  begin     
    SELECT E615PRJ.PRJSUP PRJSUP INTO WPRJSUP         
      FROM E615PRJ E615PRJ        
     WHERE E615PRJ.CODEMP=PCODEMP        
       AND E615PRJ.NUMPRJ=PNUMPRJ;   
  exception when NO_DATA_FOUND then       
    WPRJSUP := 0;   
  end;   
  
  if ((WPRJSUP>0) AND 
      ((PATUSUP='S') OR (PATUSUP IS NULL) OR (PATUSUP=' '))) then     
    loop       
    
      WPRJATU := WPRJSUP;       
      open CUR_E615PRJ_ATU;       
      begin         
        fetch CUR_E615PRJ_ATU into WESTCCO,WREGATU,WESTRAT;         
        while (CUR_E615PRJ_ATU%FOUND) loop           
          if ((WREGATU='A') OR 
              (WREGATU IS NULL) OR 
              (WREGATU=' ') OR 
              ((WREGATU='E') AND ((PSOMSUB=1) OR (PSOMSUB=4))) OR 
              ((WREGATU='S') AND ((PSOMSUB=2) OR (PSOMSUB=5)))) then             
            
            open CUR_E615PRJ_SUP;             
            
            begin               
              fetch CUR_E615PRJ_SUP into WPRJSUP;               
              while (CUR_E615PRJ_SUP%FOUND) loop                                                
                
                if (WCRIRAT=1) then                   
                  WCRIRAT := 2;                 
                else                   
                  if (WCRIRAT=3) then                     
                    WCRIRAT := 4;                   
                  end if;                 
                end if;                                
								 
                WCOMANDO := 'SELECT COALESCE (MAX(SEQRAT),0) 
                               FROM E615RAT
                              WHERE CODEMP='|| TO_CHAR(PCODEMP)||
                              ' AND NUMPRJ='|| TO_CHAR(WPRJSUP)||
                              ' AND CODFPJ='|| TO_CHAR(PCODFPJ)||
                              ' AND CTAFIN='|| TO_CHAR(PCTAFIN)||
                              ' AND CTARED='|| TO_CHAR(PCTARED)||
                              ' AND CODCCU='''|| TO_CHAR(PCODCCU)||'''';
        
                WCHAVE := 'E615RAT#'|| TO_CHAR(PCODEMP)||'#'|| TO_CHAR(WPRJSUP)||'#'|| TO_CHAR(PCODFPJ)||'#'|| TO_CHAR(PCTAFIN)||'#'|| TO_CHAR(PCTARED)||'#'|| TO_CHAR(PCODCCU);
                
				WSEQRAT:= NULL;
                ATGETNEXTVALUE(WCHAVE,1,WCOMANDO,WSEQRAT);                
                
                if (WSEQRAT = 1) then                   
                  WEXIFAS := 1;                   
                  begin                     
                    SELECT 1 EXPR1854813268 INTO WEXIFAS         
                      FROM E615FPJ E615FPJ        
                     WHERE E615FPJ.CODEMP=PCODEMP        
                       AND E615FPJ.NUMPRJ=WPRJSUP        
                       AND E615FPJ.CODFPJ=PCODFPJ;                   
                  exception when NO_DATA_FOUND then                       
                    WEXIFAS := 0;                   
                  end;                   
                  
                  if (WEXIFAS=0) then                     
                  
                    INSERT INTO E615FPJ (CODEMP,NUMPRJ,CODFPJ,DESFPJ,ABRFPJ,
                                         CLAFPJ,DATPIF,DATPFF,DATIFP,DATFFP,
                                         PERFPJ,OBSFPJ,SITFPJ,CODMOT,OBSMOT,
                                         USUGER,DATGER,HORGER,USUATU,DATATU,HORATU)        
                         SELECT E615FPJ.CODEMP E615FPJ_CODEMP,E615PRJ.PRJSUP E615PRJ_PRJSUP,E615FPJ.CODFPJ E615FPJ_CODFPJ,E615FPJ.DESFPJ E615FPJ_DESFPJ,E615FPJ.ABRFPJ E615FPJ_ABRFPJ,
                                E615FPJ.CLAFPJ E615FPJ_CLAFPJ,E615FPJ.DATPIF E615FPJ_DATPIF,E615FPJ.DATPFF E615FPJ_DATPFF,E615FPJ.DATIFP E615FPJ_DATIFP,E615FPJ.DATFFP E615FPJ_DATFFP,       
                                E615FPJ.PERFPJ E615FPJ_PERFPJ,E615FPJ.OBSFPJ E615FPJ_OBSFPJ,E615FPJ.SITFPJ E615FPJ_SITFPJ,E615FPJ.CODMOT E615FPJ_CODMOT,E615FPJ.OBSMOT E615FPJ_OBSMOT,
                                E615FPJ.USUGER E615FPJ_USUGER,E615FPJ.DATGER E615FPJ_DATGER,E615FPJ.HORGER E615FPJ_HORGER,E615FPJ.USUATU E615FPJ_USUATU,E615FPJ.DATATU E615FPJ_DATATU,E615FPJ.HORATU E615FPJ_HORATU        
                           FROM E615FPJ E615FPJ,E615PRJ E615PRJ        
                          WHERE E615FPJ.CODEMP=PCODEMP        
                            AND E615FPJ.NUMPRJ=WNUMPRJ        
                            AND E615FPJ.CODFPJ=PCODFPJ        
                            AND E615PRJ.CODEMP=E615FPJ.CODEMP        
                            AND E615PRJ.NUMPRJ=E615FPJ.NUMPRJ;                   
                  end if;                 
                end if;                                 
                
                INSERT INTO E615RAT (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CTARED,CODCCU,SEQRAT,DATBAS,CODTNS,MESANO,CRIRAT,SOMSUB,CODFIL,PERCTA,VLRCTA,PERRAT,VLRRAT,OBSRAT,SITRAT,USUGER,
                                     DATGER,HORGER,ROTPPJ,FILRPJ,NUMRPJ,SEQRP1,SEQRP2,DATRP1,DATRP2,STRRP1,STRRP2,STRRP3,PRJORI,PRJFIL,ORIMOV,NUMCRL,DATCSP) 
                             VALUES (PCODEMP,WPRJSUP,PCODFPJ,PCTAFIN,PCTARED,PCODCCU,WSEQRAT,WDATBAS,PCODTNS,WMESANO,WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PVLRCTA,PPERRAT,PVLRRAT,POBSRAT,WSITRAT,PUSUGER,
                                     PDATGER,PHORGER,PROTPPJ,PFILRPJ,PNUMRPJ,PSEQRP1,PSEQRP2,PDATRP1,PDATRP2,PSTRRP1,PSTRRP2,PSTRRP3,PNUMPRJ,WNUMPRJ,PORIMOV,PNUMCRL,PDATCSP);                 
                 
                fetch CUR_E615PRJ_SUP into WPRJSUP;               
              end loop;             
                
            exception when others then               
              close CUR_E615PRJ_SUP;                
              raise;             
            end;             
            
            close CUR_E615PRJ_SUP;           
          end if;           
          
          fetch CUR_E615PRJ_ATU into WESTCCO,WREGATU,WESTRAT;         
        end loop;       
      exception when others then         
        close CUR_E615PRJ_ATU;         
        raise;       
      end;       
      
      close CUR_E615PRJ_ATU;       
      WNUMPRJ := WPRJSUP;       
      begin         
        SELECT E615PRJ.PRJSUP PRJSUP  INTO WPRJSUP         
          FROM E615PRJ E615PRJ        
         WHERE E615PRJ.CODEMP=PCODEMP        
           AND E615PRJ.NUMPRJ=WPRJSUP;       
      exception when NO_DATA_FOUND then           
        WPRJSUP := 0;       
      end;       
      
      if ((WPRJSUP=0) OR (WPRJSUP=WNUMPRJ)) then         
        EXIT;       
      end if;     
    end loop;   
  end if; 
end;	MSSQL;0
o>␀␀CREATE PROCEDURE sp_aturateioproj(@POPERAT CHAR, @PCODEMP SMALLINT, @PNUMPRJ INTEGER, @PCODFPJ SMALLINT, @PCTAFIN INTEGER, @PCTARED INTEGER, @PCODCCU VARCHAR(9), 
                                  @PDATBAS DATETIME, @PCODTNS VARCHAR(5), @PMESANO DATETIME, @PCRIRAT SMALLINT, @PSOMSUB SMALLINT, @PCODFIL INTEGER, @PPERCTA FLOAT, 
                                  @PVLRCTA FLOAT, @PPERRAT FLOAT, @PVLRRAT FLOAT, @POBSRAT VARCHAR(120), @PUSUGER BIGINT, @PDATGER DATETIME, @PHORGER INTEGER, 
                                  @PROTPPJ SMALLINT, @PFILRPJ INTEGER, @PNUMRPJ INTEGER, @PSEQRP1 INTEGER, @PSEQRP2 INTEGER, @PDATRP1 DATETIME, @PDATRP2 DATETIME, 
                                  @PSTRRP1 VARCHAR(15), @PSTRRP2 VARCHAR(7), @PSTRRP3 VARCHAR(10), @PORIMOV VARCHAR(2), @PNUMCRL INTEGER, @PATUSUP CHAR, 
                                  @PDATCSP DATETIME) AS
BEGIN
DECLARE @wseqrat INTEGER
DECLARE @wsitrat CHAR
DECLARE @wcrirat SMALLINT
DECLARE @wdatbas DATETIME
DECLARE @wmesano DATETIME
DECLARE @wnumprj INTEGER
DECLARE @wprjatu INTEGER
DECLARE @wprjsup INTEGER
DECLARE @westcco CHAR
DECLARE @wregatu CHAR
DECLARE @westrat CHAR
DECLARE @wexifas INTEGER
DECLARE @wcomando VARCHAR(500)
DECLARE @wchave VARCHAR(500)
DECLARE @ChkError INTEGER
DECLARE @SE_EXC2 INTEGER
DECLARE @SE_EXC5 INTEGER
DECLARE @SE_EXC6 INTEGER
SELECT @ChkError = 0
SELECT @WPRJATU = @PNUMPRJ
DECLARE cur_e615prj_atu CURSOR FOR 
  SELECT e615prj.estcco E615PRJ_ESTCCO,e615prj.regatu E615PRJ_REGATU,e615prj.estrat E615PRJ_ESTRAT
    FROM e615prj e615prj
   WHERE e615prj.codemp=@pcodemp 
     and e615prj.numprj=@wprjatu
  
OPEN CUR_E615PRJ_ATU
FETCH NEXT FROM CUR_E615PRJ_ATU INTO @WESTCCO, @WREGATU, @WESTRAT
WHILE  (@@FETCH_STATUS = 0)
BEGIN
  IF (@POPERAT='I')
  BEGIN
    SELECT @WSITRAT = 'A'
    SELECT @WDATBAS = @PDATBAS
    SELECT @WCRIRAT = @PCRIRAT
  END
    ELSE
    BEGIN
      SELECT @WSITRAT = 'I'
      IF (@PCRIRAT=1)
      BEGIN
		SELECT @WCRIRAT = 3
      END
      ELSE
      BEGIN
        SELECT @WCRIRAT = 1
      END
    END
    IF ((@WREGATU='A') OR 
        (@WREGATU IS NULL) OR 
        (@WREGATU=' ') OR 
        ((@WREGATU='E') AND ((@PSOMSUB=1) OR (@PSOMSUB=4))) OR 
        ((@WREGATU='S') AND ((@PSOMSUB=2) OR (@PSOMSUB=5))))
    BEGIN
      
      IF (@POPERAT='I')
      BEGIN
        SELECT @WSITRAT = 'A'
        SELECT @WCRIRAT = @PCRIRAT
        SELECT @WDATBAS = @PDATBAS
      END
      ELSE
      BEGIN
        SELECT @WSITRAT = 'I'
        
        IF (@PCRIRAT=1)
        BEGIN
          SELECT @WCRIRAT = 3
        END
        ELSE
        BEGIN
          SELECT @WCRIRAT = 1
        END
        
        IF (@WESTRAT='S')
        BEGIN
          SELECT @WDATBAS = @PDATGER
        END
        ELSE
        BEGIN
          SELECT @WDATBAS = @PDATBAS
        END
        
        IF (@WESTCCO='S')
        BEGIN
            IF ((@PROTPPJ=5) OR (@PROTPPJ=13) OR (@PROTPPJ=8) OR (@PROTPPJ=14))
            BEGIN
              UPDATE e615rat SET sitrat='I' 
               WHERE codemp=@pcodemp 
                 AND numprj=@pnumprj 
                 AND rotppj=@protppj 
                 AND filrpj=@pfilrpj 
                 AND numrpj=@pnumrpj 
                 AND seqrp2=@pseqrp2 
                 AND datrp1=@pdatrp1 
                 AND datrp2=@pdatrp2 
                 AND ((rtrim(strrp1) is null) or (strrp1=@pstrrp1)) 
                 AND ((rtrim(strrp2) is null) or (strrp2=@pstrrp2)) 
                 AND ((rtrim(strrp3) is null) or (strrp3=@pstrrp3)) 
                 AND sitrat='A'
              
              SELECT @ChkError = @@Error
              
              IF @ChkError <> 0
              BEGIN
                GOTO FNCUR_E615PRJ_ATU1
              END
              
            END
            ELSE
            BEGIN
              UPDATE e615rat SET sitrat='I' 
               WHERE codemp=@pcodemp 
                 AND numprj=@pnumprj 
                 AND rotppj=@protppj 
                 AND filrpj=@pfilrpj 
                 AND numrpj=@pnumrpj 
                 AND seqrp1=@pseqrp1 
                 AND seqrp2=@pseqrp2 
                 AND datrp1=@pdatrp1 
                 AND datrp2=@pdatrp2 
                 AND ((rtrim(strrp1) is null) or (strrp1=@pstrrp1)) 
                 AND ((rtrim(strrp2) is null) or (strrp2=@pstrrp2)) 
                 AND ((rtrim(strrp3) is null) or (strrp3=@pstrrp3)) 
                 AND sitrat='A'
              
              SELECT @ChkError = @@Error
              IF @ChkError <> 0
              BEGIN
                GOTO FNCUR_E615PRJ_ATU1
              END
            END
        END
      END
      
      SELECT @WMESANO = CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,@WDATBAS))+'/'+
                                         CONVERT(VARCHAR,01)+'/'+
                                         CONVERT(VARCHAR,DATEPART(yy,@WDATBAS))+' '+
                                         CONVERT(VARCHAR,0)+':'+
                                         CONVERT(VARCHAR,0)+':'+
                                         CONVERT(VARCHAR,0))
      
      SELECT @WNUMPRJ = @PNUMPRJ
      
      SELECT @wcomando = 'SELECT @PRET = COALESCE (MAX(SEQRAT),0)' + 
                          ' FROM E615RAT' +
                         ' WHERE CODEMP= '+ CONVERT(VARCHAR,@PCODEMP)+
                           ' AND NUMPRJ= '+ CONVERT(VARCHAR,@PNUMPRJ)+
                           ' AND CODFPJ= '+ CONVERT(VARCHAR,@PCODFPJ)+
                           ' AND CTAFIN= '+ CONVERT(VARCHAR,@PCTAFIN)+
                           ' AND CTARED= '+ CONVERT(VARCHAR,@PCTARED)+
                           ' AND CODCCU= '''+ CONVERT(VARCHAR,@PCODCCU)+''''
                           
      SELECT @wchave = 'E615RAT#'+ CONVERT(VARCHAR,@PCODEMP)+'#'+ CONVERT(VARCHAR,@PNUMPRJ)+'#'+ CONVERT(VARCHAR,@PCODFPJ)+'#'+ CONVERT(VARCHAR,@PCTAFIN)+'#'+ CONVERT(VARCHAR,@PCTARED)+'#'+ CONVERT(VARCHAR,@PCODCCU)
      
	  SELECT @WSEQRAT = NULL
      EXEC GETNEXTVALUE @wchave,1,@wcomando,@WSEQRAT OUTPUT
      
      INSERT INTO e615rat
        (codemp,numprj,codfpj,ctafin,ctared,codccu,seqrat,datbas,codtns,mesano,crirat,somsub,codfil,percta,vlrcta,perrat,
         vlrrat,obsrat,sitrat,usuger,datger,horger,rotppj,filrpj,numrpj,seqrp1,seqrp2,datrp1,datrp2,strrp1,strrp2,strrp3,
         prjori,prjfil,orimov,numcrl,datcsp) 
      VALUES 
        (@PCODEMP,@PNUMPRJ,@PCODFPJ,@PCTAFIN,@PCTARED,@PCODCCU,@WSEQRAT,@WDATBAS,@PCODTNS,@WMESANO,@WCRIRAT,@PSOMSUB,@PCODFIL,@PPERCTA,@PVLRCTA,@PPERRAT,
         @PVLRRAT,@POBSRAT,@WSITRAT,@PUSUGER,@PDATGER,@PHORGER,@PROTPPJ,@PFILRPJ,@PNUMRPJ,@PSEQRP1,@PSEQRP2,@PDATRP1,@PDATRP2,@PSTRRP1,@PSTRRP2,@PSTRRP3,
         @PNUMPRJ,@WNUMPRJ,@PORIMOV,@PNUMCRL,@PDATCSP)
      
      SELECT @ChkError = @@Error
      IF @ChkError <> 0
      BEGIN        
      	
        GOTO FNCUR_E615PRJ_ATU1
      END
    END
    FETCH NEXT FROM CUR_E615PRJ_ATU INTO @WESTCCO, @WREGATU, @WESTRAT
  END
  
  FNCUR_E615PRJ_ATU1: /* FINALLY OPEN CURSOR */
  CLOSE CUR_E615PRJ_ATU
  DEALLOCATE CUR_E615PRJ_ATU
  
  IF @ChkError <> 0
    GOTO FIM
  
  SELECT @WDATBAS = @PDATBAS
  SELECT @WMESANO = CONVERT(DATETIME,CONVERT(VARCHAR,DATEPART(MONTH,@WDATBAS))+'/'+
                                     CONVERT(VARCHAR,01)+'/'+
                                     CONVERT(VARCHAR,DATEPART(yy,@WDATBAS))+' '+
                                     CONVERT(VARCHAR,0)+':'+
                                     CONVERT(VARCHAR,0)+':'+
                                     CONVERT(VARCHAR,0))
  SELECT @WNUMPRJ = @PNUMPRJ
  /* TRY */
  SELECT @WPRJSUP=e615prj.prjsup 
    FROM e615prj e615prj
   WHERE e615prj.codemp=@pcodemp 
     AND e615prj.numprj=@pnumprj
  
  SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC2
    END
  /* END TRY */
  
  /* BEGIN EXCEPTION HANDLER */  
  EXC2:
    SELECT @SE_EXC2 = @ChkError
    IF @ChkError <> 0
    BEGIN
      IF @ChkError = -50
      BEGIN
        SELECT @ChkError = 0
        SELECT @WPRJSUP = 0
      END
      ELSE
      BEGIN
        GOTO FIM
      END
    END
  /* END EXCEPTION HANDLER */
  
  IF ((@WPRJSUP>0) AND 
      ((@PATUSUP='S') OR (@PATUSUP IS NULL) OR (@PATUSUP=' ')))
  BEGIN
    WHILE 1=1
    BEGIN
      SELECT @WPRJATU = @WPRJSUP
      DECLARE cur_e615prj_atu CURSOR FOR 
        SELECT e615prj.estcco E615PRJ_ESTCCO,e615prj.regatu E615PRJ_REGATU,e615prj.estrat E615PRJ_ESTRAT
          FROM e615prj e615prj
         WHERE e615prj.codemp=@pcodemp 
           AND e615prj.numprj=@wprjatu
        
      OPEN CUR_E615PRJ_ATU
      FETCH NEXT FROM CUR_E615PRJ_ATU INTO @WESTCCO, @WREGATU, @WESTRAT
      
      WHILE  (@@FETCH_STATUS = 0)
      BEGIN
        IF ((@WREGATU='A') OR 
            (@WREGATU IS NULL) OR 
            (@WREGATU=' ') OR 
            ((@WREGATU='E') AND ((@PSOMSUB=1) OR (@PSOMSUB=4))) OR 
            ((@WREGATU='S') AND ((@PSOMSUB=2) OR (@PSOMSUB=5))))
        BEGIN
          DECLARE cur_e615prj_sup CURSOR FOR 
            SELECT e615prj.prjsup E615PRJ_PRJSUP
              FROM e615prj e615prj
             WHERE e615prj.codemp=@pcodemp 
               AND e615prj.numprj=@wnumprj
          
          OPEN CUR_E615PRJ_SUP
          FETCH NEXT FROM CUR_E615PRJ_SUP INTO @WPRJSUP
          
          WHILE  (@@FETCH_STATUS = 0)
          BEGIN
                        
            IF (@WCRIRAT=1)
            BEGIN
              SELECT @WCRIRAT = 2
            END
            ELSE
            BEGIN
              IF (@WCRIRAT=3)
              BEGIN
                SELECT @WCRIRAT = 4
              END
            END
            
            SELECT @wcomando = 'SELECT @PRET = COALESCE (MAX(SEQRAT),0)' + 
                                ' FROM E615RAT' +
                               ' WHERE CODEMP= '+ CONVERT(VARCHAR,@PCODEMP)+
                                 ' AND NUMPRJ= '+ CONVERT(VARCHAR,@WPRJSUP)+
                                 ' AND CODFPJ= '+ CONVERT(VARCHAR,@PCODFPJ)+
                                 ' AND CTAFIN= '+ CONVERT(VARCHAR,@PCTAFIN)+
                                 ' AND CTARED= '+ CONVERT(VARCHAR,@PCTARED)+
                                 ' AND CODCCU= '''+ CONVERT(VARCHAR,@PCODCCU)+''''
                           
            SELECT @wchave = 'E615RAT#'+ CONVERT(VARCHAR,@PCODEMP)+'#'+ CONVERT(VARCHAR,@WPRJSUP)+'#'+ CONVERT(VARCHAR,@PCODFPJ)+'#'+ CONVERT(VARCHAR,@PCTAFIN)+'#'+ CONVERT(VARCHAR,@PCTARED)+'#'+ CONVERT(VARCHAR,@PCODCCU)
      
			SELECT @WSEQRAT = NULL
            EXEC GETNEXTVALUE @wchave,1,@wcomando,@WSEQRAT OUTPUT
            
            IF (@WSEQRAT = 1)
            BEGIN
              SELECT @WEXIFAS = 1
              
              /* TRY */
              SELECT @WEXIFAS=1 
                FROM e615fpj e615fpj
               WHERE e615fpj.codemp=@pcodemp 
                 AND e615fpj.numprj=@wprjsup 
                 AND e615fpj.codfpj=@pcodfpj

              SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
              IF @ChkError <> 0
              BEGIN
                GOTO EXC5
              END
              /* END TRY */
              
              /* BEGIN EXCEPTION HANDLER */
              EXC5:
                SELECT @SE_EXC5 = @ChkError
                IF @ChkError <> 0
                BEGIN
                  IF @ChkError = -50
                  BEGIN
                    SELECT @ChkError = 0
                    SELECT @WEXIFAS = 0
                  END
                  ELSE
                  BEGIN
                    GOTO FNCUR_E615PRJ_SUP4
                  END
                END
              /* END EXCEPTION HANDLER */
              
              IF (@WEXIFAS=0)
              BEGIN
                INSERT INTO e615fpj 
                            (CODEMP,NUMPRJ,CODFPJ,DESFPJ,ABRFPJ,
                             CLAFPJ,DATPIF,DATPFF,DATIFP,DATFFP,
                             PERFPJ,OBSFPJ,SITFPJ,CODMOT,OBSMOT,
                             USUGER,DATGER,HORGER,USUATU,DATATU,
                             HORATU)
                     SELECT  e615fpj.codemp E615FPJ_CODEMP,e615prj.prjsup E615PRJ_PRJSUP,e615fpj.codfpj E615FPJ_CODFPJ,e615fpj.desfpj E615FPJ_DESFPJ,e615fpj.abrfpj E615FPJ_ABRFPJ,
                             e615fpj.clafpj E615FPJ_CLAFPJ,e615fpj.datpif E615FPJ_DATPIF,e615fpj.datpff E615FPJ_DATPFF,e615fpj.datifp E615FPJ_DATIFP,e615fpj.datffp E615FPJ_DATFFP,
                             e615fpj.perfpj E615FPJ_PERFPJ,e615fpj.obsfpj E615FPJ_OBSFPJ,e615fpj.sitfpj E615FPJ_SITFPJ,e615fpj.codmot E615FPJ_CODMOT,e615fpj.obsmot E615FPJ_OBSMOT,
                             e615fpj.usuger E615FPJ_USUGER,e615fpj.datger E615FPJ_DATGER,e615fpj.horger E615FPJ_HORGER,e615fpj.usuatu E615FPJ_USUATU,e615fpj.datatu E615FPJ_DATATU,
                             e615fpj.horatu E615FPJ_HORATU
                        FROM e615fpj e615fpj,e615prj e615prj
                       WHERE e615fpj.codemp=@pcodemp 
                         AND e615fpj.numprj=@wnumprj 
                         AND e615fpj.codfpj=@pcodfpj 
                         AND e615prj.codemp=e615fpj.codemp 
                         AND e615prj.numprj=e615fpj.numprj
                SELECT @ChkError = @@Error
                IF @ChkError <> 0
                BEGIN
                  GOTO FNCUR_E615PRJ_SUP4
                END
              END
            END
          
            INSERT INTO e615rat
                        (codemp,numprj,codfpj,ctafin,ctared,codccu,seqrat,datbas,codtns,mesano,crirat,somsub,codfil,percta,vlrcta,perrat,vlrrat,obsrat,sitrat,
                         usuger,datger,horger,rotppj,filrpj,numrpj,seqrp1,seqrp2,datrp1,datrp2, strrp1,strrp2,strrp3,prjori,prjfil,orimov,numcrl,datcsp) 
                 VALUES (@PCODEMP,@WPRJSUP,@PCODFPJ,@PCTAFIN,@PCTARED,@PCODCCU,@WSEQRAT,@WDATBAS,@PCODTNS,@WMESANO,@WCRIRAT,@PSOMSUB,@PCODFIL,@PPERCTA,@PVLRCTA,@PPERRAT,@PVLRRAT,@POBSRAT,@WSITRAT,
                         @PUSUGER,@PDATGER,@PHORGER,@PROTPPJ,@PFILRPJ,@PNUMRPJ,@PSEQRP1,@PSEQRP2,@PDATRP1,@PDATRP2,@PSTRRP1,@PSTRRP2,@PSTRRP3,@PNUMPRJ,@WNUMPRJ,@PORIMOV,@PNUMCRL,@PDATCSP)
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO FNCUR_E615PRJ_SUP4
            END
          
		  FETCH NEXT FROM CUR_E615PRJ_SUP INTO @WPRJSUP
        END
          FNCUR_E615PRJ_SUP4: /* FINALLY OPEN CURSOR */
          CLOSE CUR_E615PRJ_SUP
          DEALLOCATE CUR_E615PRJ_SUP
          IF @ChkError <> 0
            GOTO FNCUR_E615PRJ_ATU3
        END
        FETCH NEXT FROM CUR_E615PRJ_ATU INTO @WESTCCO, @WREGATU, @WESTRAT
      END
      
	  FNCUR_E615PRJ_ATU3: /* FINALLY OPEN CURSOR */
      CLOSE CUR_E615PRJ_ATU
      DEALLOCATE CUR_E615PRJ_ATU
      
	  IF @ChkError <> 0
        GOTO FIM
      SELECT @WNUMPRJ = @WPRJSUP
      
	  /* TRY */
      SELECT @WPRJSUP=e615prj.prjsup 
       FROM e615prj e615prj
      WHERE e615prj.codemp=@pcodemp 
        AND e615prj.numprj=@wprjsup
      
	  SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC6
      END
      /* END TRY */
	  
      /* BEGIN EXCEPTION HANDLER */
      EXC6:
        SELECT @SE_EXC6 = @ChkError
        IF @ChkError <> 0
        BEGIN
          IF @ChkError = -50
          BEGIN
            SELECT @ChkError = 0
            SELECT @WPRJSUP = 0
          END
          ELSE
          BEGIN
            GOTO FIM
          END
        END
      /* END EXCEPTION HANDLER */
      
	  IF ((@WPRJSUP=0) OR (@WPRJSUP=@WNUMPRJ))
      BEGIN
        BREAK
      END
    END
  END
  FIM:
    RETURN @ChkError
END	POSTGRESQL;0
2␀␀CREATE OR REPLACE PROCEDURE sp_aturateioproj(
	poperat character varying,
	pcodemp numeric,
	pnumprj numeric,
	pcodfpj numeric,
	pctafin numeric,
	pctared numeric,
	pcodccu character varying,
	pdatbas timestamp without time zone,
	pcodtns character varying,
	pmesano timestamp without time zone,
	pcrirat numeric,
	psomsub numeric,
	pcodfil numeric,
	ppercta numeric,
	pvlrcta numeric,
	pperrat numeric,
	pvlrrat numeric,
	pobsrat character varying,
	pusuger numeric,
	pdatger timestamp without time zone,
	phorger numeric,
	protppj numeric,
	pfilrpj numeric,
	pnumrpj numeric,
	pseqrp1 numeric,
	pseqrp2 numeric,
	pdatrp1 timestamp without time zone,
	pdatrp2 timestamp without time zone,
	pstrrp1 character varying,
	pstrrp2 character varying,
	pstrrp3 character varying,
	porimov character varying,
	pnumcrl numeric,
	patusup character varying,
	pdatcsp timestamp without time zone)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE 
	wseqrat NUMERIC;
	wsitrat CHAR;
	wcrirat SMALLINT;
    wdatbas DATE;
    wmesano DATE;
    wnumprj INTEGER;
    wprjatu INTEGER;
    wprjsup INTEGER;
    westcco CHAR;
    wregatu CHAR;
    westrat CHAR;
    wexifas INTEGER;
    wcomando VARCHAR(500);
    wchave VARCHAR(500);
    ChkError INTEGER;
    SE_EXC2 INTEGER;
    SE_EXC5 INTEGER;
    SE_EXC6 INTEGER;
	
    CUR_E615PRJ_ATU CURSOR FOR SELECT e615prj.estcco E615PRJ_ESTCCO,e615prj.regatu E615PRJ_REGATU,e615prj.estrat E615PRJ_ESTRAT
	    FROM e615prj e615prj
	   WHERE e615prj.codemp=pcodemp 
	     and e615prj.numprj=wprjatu ;
	
	CUR_E615PRJ_SUP CURSOR FOR SELECT e615prj.prjsup E615PRJ_PRJSUP
              FROM e615prj e615prj
             WHERE e615prj.codemp=pcodemp 
               AND e615prj.numprj=wnumprj;
	
BEGIN
	ChkError := 0;
    WPRJATU = PNUMPRJ;
	
	OPEN CUR_E615PRJ_ATU;
	FETCH CUR_E615PRJ_ATU INTO WESTCCO, WREGATU, WESTRAT;
  	WHILE FOUND LOOP
        
        IF(POPERAT='I') THEN
            WSITRAT := 'A';
            WDATBAS := PDATBAS;
            WCRIRAT := PCRIRAT;
        ELSE
            WSITRAT := 'I';
            IF(PCRIRAT=1) THEN
                WCRIRAT:=3;
            ELSE
                WCRIRAT:=1;
            END IF;
        END IF;

		IF ((WREGATU='A') OR (WREGATU IS NULL) OR (WREGATU=' ') OR ((WREGATU='E') AND ((PSOMSUB=1) OR (PSOMSUB=4)))
			OR ((WREGATU='S') AND ((PSOMSUB=2) OR (PSOMSUB=5)))) THEN
                        
            IF(POPERAT='I') THEN
                WSITRAT := 'A';
                WCRIRAT := PCRIRAT;
                WDATBAS := PDATBAS;
            ELSE
                WSITRAT := 'I';              
                IF (PCRIRAT=1) THEN
                	WCRIRAT := 3;
                ELSE
                    WCRIRAT := 1;
                END IF;
               
                IF (WESTRAT='S') THEN
                    WDATBAS := PDATGER;
                ELSE
                    WDATBAS := PDATBAS;
                END IF;				
				
                IF(WESTCCO='S') THEN
					BEGIN 
						IF ((PROTPPJ=5) OR (PROTPPJ=13) OR (PROTPPJ=8) OR (PROTPPJ=14)) THEN                        
								UPDATE e615rat
								   SET sitrat='I' 
								 WHERE codemp=pcodemp 
								   AND numprj=pnumprj 
								   AND rotppj=protppj 
								   AND filrpj=pfilrpj 
								   AND numrpj=pnumrpj 
								   AND seqrp2=pseqrp2 
								   AND datrp1=pdatrp1 
								   AND datrp2=pdatrp2 
								   AND ((rtrim(strrp1) is null) or (strrp1=pstrrp1)) 
								   AND ((rtrim(strrp2) is null) or (strrp2=pstrrp2)) 
								   AND ((rtrim(strrp3) is null) or (strrp3=pstrrp3)) 
								   AND sitrat='A';												
						ELSE
							UPDATE e615rat
							   SET sitrat='I' 
							 WHERE codemp=pcodemp 
							   AND numprj=pnumprj 
							   AND rotppj=protppj 
							   AND filrpj=pfilrpj 
							   AND numrpj=pnumrpj 
							   AND seqrp1=pseqrp1 
							   AND seqrp2=pseqrp2 
							   AND datrp1=pdatrp1 
							   AND datrp2=pdatrp2 
							   AND ((rtrim(strrp1) is null) or (strrp1=pstrrp1)) 
							   AND ((rtrim(strrp2) is null) or (strrp2=pstrrp2)) 
							   AND ((rtrim(strrp3) is null) or (strrp3=pstrrp3)) 
							   AND sitrat='A';                                              
						END IF;	
					EXCEPTION WHEN OTHERS THEN
						CLOSE CUR_E615PRJ_ATU;
						RAISE;
					END;
                END IF;				
            END IF;
            
            WMESANO := DATE_TRUNC('MONTH', WDATBAS);
			
            WNUMPRJ := PNUMPRJ;
			
            WCOMANDO := 'SELECT COALESCE (MAX(SEQRAT),0)
                           FROM E615RAT
                          WHERE CODEMP='|| TO_CHAR(PCODEMP, '9999')||
                          ' AND NUMPRJ='|| TO_CHAR(PNUMPRJ,'99999999')||
                          ' AND CODFPJ='|| TO_CHAR(PCODFPJ,'9999')||
                          ' AND CTAFIN='|| TO_CHAR(PCTAFIN,'9999999')||
                          ' AND CTARED='|| TO_CHAR(PCTARED,'9999999')||
                          ' AND CODCCU='''|| PCODCCU||'''';
            
			WCHAVE := 'E615RAT#'|| TO_CHAR(PCODEMP,'9999')||'#'|| TO_CHAR(PNUMPRJ,'9999')||'#'|| 
					   TO_CHAR(PCODFPJ,'9999')||'#'|| TO_CHAR(PCTAFIN,'99999')||'#'|| TO_CHAR(PCTARED,'9999')||'#'|| PCODCCU;
			
			WSEQRAT:= NULL;
			CALL GETNEXTVALUE(WCHAVE,1,WCOMANDO,WSEQRAT);        
			BEGIN
				INSERT INTO E615RAT (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CTARED,CODCCU,SEQRAT,DATBAS,CODTNS,MESANO,CRIRAT,SOMSUB,CODFIL,PERCTA,VLRCTA,PERRAT,VLRRAT,OBSRAT,SITRAT,USUGER,
									 DATGER,HORGER,ROTPPJ,FILRPJ,NUMRPJ,SEQRP1,SEQRP2,DATRP1,DATRP2,STRRP1,STRRP2,STRRP3,PRJORI,PRJFIL,ORIMOV,NUMCRL,DATCSP) 
							 VALUES (PCODEMP,PNUMPRJ,PCODFPJ,PCTAFIN,PCTARED,PCODCCU,WSEQRAT,WDATBAS,PCODTNS,WMESANO,WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PVLRCTA,PPERRAT,PVLRRAT,POBSRAT,WSITRAT,PUSUGER,
									 PDATGER,PHORGER,PROTPPJ,PFILRPJ,PNUMRPJ,PSEQRP1,PSEQRP2,PDATRP1,PDATRP2,PSTRRP1,PSTRRP2,PSTRRP3,PNUMPRJ,WNUMPRJ,PORIMOV,PNUMCRL,PDATCSP);
			EXCEPTION WHEN OTHERS THEN
    			CLOSE CUR_E615PRJ_ATU;     
    			RAISE;  									 
			END;                      
		END IF;
		MOVE CUR_E615PRJ_ATU;
  	END LOOP;
	CLOSE CUR_E615PRJ_ATU;
	
	WDATBAS := PDATBAS;   
 	WMESANO := DATE_TRUNC('MONTH', WDATBAS);
  	WNUMPRJ := PNUMPRJ;   
	
	BEGIN     
		SELECT E615PRJ.PRJSUP PRJSUP INTO WPRJSUP         
		  FROM E615PRJ E615PRJ        
		 WHERE E615PRJ.CODEMP=PCODEMP        
		   AND E615PRJ.NUMPRJ=PNUMPRJ;   
	EXCEPTION WHEN NO_DATA_FOUND THEN
    	WPRJSUP := 0;   
  	END;  

	IF ((WPRJSUP>0) AND ((PATUSUP='S') OR (PATUSUP IS NULL) OR (PATUSUP=' '))) THEN     
    	LOOP       
    
      WPRJATU := WPRJSUP;       
      BEGIN 
	  	OPEN CUR_E615PRJ_ATU;             
        FETCH CUR_E615PRJ_ATU INTO WESTCCO,WREGATU,WESTRAT;         
        WHILE (CUR_E615PRJ_ATU%FOUND) LOOP           
          IF ((WREGATU='A') OR 
              (WREGATU IS NULL) OR 
              (WREGATU=' ') OR 
              ((WREGATU='E') AND ((PSOMSUB=1) OR (PSOMSUB=4))) OR 
              ((WREGATU='S') AND ((PSOMSUB=2) OR (PSOMSUB=5)))) THEN    
			  
            	BEGIN 
            	OPEN CUR_E615PRJ_SUP;                                             
              	FETCH CUR_E615PRJ_SUP INTO WPRJSUP;               
              		WHILE (CUR_E615PRJ_SUP%FOUND) LOOP                                                
                
					IF (WCRIRAT=1) THEN                   
					  WCRIRAT := 2;                 
					ELSE                   
					  IF (WCRIRAT=3) THEN                     
						WCRIRAT := 4;                   
					  END IF;                 
					END IF;                                
								 
                WCOMANDO := 'SELECT COALESCE (MAX(SEQRAT),0) 
                               FROM E615RAT
						      WHERE CODEMP='|| TO_CHAR(PCODEMP, '9999')||
		                      ' AND NUMPRJ='|| TO_CHAR(PNUMPRJ,'99999999')||
		                      ' AND CODFPJ='|| TO_CHAR(PCODFPJ,'9999')||
		                      ' AND CTAFIN='|| TO_CHAR(PCTAFIN,'9999999')||
		                      ' AND CTARED='|| TO_CHAR(PCTARED,'9999999')||
		                      ' AND CODCCU='''|| PCODCCU||'''';
                WCHAVE := 'E615RAT#'|| TO_CHAR(PCODEMP,'9999')||'#'|| TO_CHAR(WPRJSUP,'9999')||'#'|| 
				 		   TO_CHAR(PCODFPJ,'9999')||'#'|| TO_CHAR(PCTAFIN,'9999')||'#'|| TO_CHAR(PCTARED)||'#'|| PCODCCU;
                
				WSEQRAT:= NULL;
                CALL ATGETNEXTVALUE(WCHAVE,1,WCOMANDO,WSEQRAT);                
              
                IF (WSEQRAT = 1) THEN                   
                	WEXIFAS := 1;                   
                  	BEGIN                     
						SELECT 1 EXPR1854813268 INTO WEXIFAS         
						  FROM E615FPJ E615FPJ        
						 WHERE E615FPJ.CODEMP=PCODEMP        
						   AND E615FPJ.NUMPRJ=WPRJSUP        
						   AND E615FPJ.CODFPJ=PCODFPJ;                   
                  	EXCEPTION WHEN NO_DATA_FOUND THEN                       
                    	WEXIFAS := 0;                   
                  	END;                   
                  
                  	IF (WEXIFAS=0) THEN                                       
                    	INSERT INTO E615FPJ (CODEMP,NUMPRJ,CODFPJ,DESFPJ,ABRFPJ,
                                         CLAFPJ,DATPIF,DATPFF,DATIFP,DATFFP,
                                         PERFPJ,OBSFPJ,SITFPJ,CODMOT,OBSMOT,
                                         USUGER,DATGER,HORGER,USUATU,DATATU,HORATU)        
                         SELECT E615FPJ.CODEMP E615FPJ_CODEMP,E615PRJ.PRJSUP E615PRJ_PRJSUP,E615FPJ.CODFPJ E615FPJ_CODFPJ,E615FPJ.DESFPJ E615FPJ_DESFPJ,E615FPJ.ABRFPJ E615FPJ_ABRFPJ,
                                E615FPJ.CLAFPJ E615FPJ_CLAFPJ,E615FPJ.DATPIF E615FPJ_DATPIF,E615FPJ.DATPFF E615FPJ_DATPFF,E615FPJ.DATIFP E615FPJ_DATIFP,E615FPJ.DATFFP E615FPJ_DATFFP,       
                                E615FPJ.PERFPJ E615FPJ_PERFPJ,E615FPJ.OBSFPJ E615FPJ_OBSFPJ,E615FPJ.SITFPJ E615FPJ_SITFPJ,E615FPJ.CODMOT E615FPJ_CODMOT,E615FPJ.OBSMOT E615FPJ_OBSMOT,
                                E615FPJ.USUGER E615FPJ_USUGER,E615FPJ.DATGER E615FPJ_DATGER,E615FPJ.HORGER E615FPJ_HORGER,E615FPJ.USUATU E615FPJ_USUATU,E615FPJ.DATATU E615FPJ_DATATU,E615FPJ.HORATU E615FPJ_HORATU        
                           FROM E615FPJ E615FPJ,E615PRJ E615PRJ        
                          WHERE E615FPJ.CODEMP=PCODEMP        
                            AND E615FPJ.NUMPRJ=WNUMPRJ        
                            AND E615FPJ.CODFPJ=PCODFPJ        
                            AND E615PRJ.CODEMP=E615FPJ.CODEMP        
                            AND E615PRJ.NUMPRJ=E615FPJ.NUMPRJ;                   
                 	END IF;                 
                END IF;                                               
                INSERT INTO E615RAT (CODEMP,NUMPRJ,CODFPJ,CTAFIN,CTARED,CODCCU,SEQRAT,DATBAS,CODTNS,MESANO,CRIRAT,SOMSUB,CODFIL,PERCTA,VLRCTA,PERRAT,VLRRAT,OBSRAT,SITRAT,USUGER,
                                     DATGER,HORGER,ROTPPJ,FILRPJ,NUMRPJ,SEQRP1,SEQRP2,DATRP1,DATRP2,STRRP1,STRRP2,STRRP3,PRJORI,PRJFIL,ORIMOV,NUMCRL,DATCSP) 
                             VALUES (PCODEMP,WPRJSUP,PCODFPJ,PCTAFIN,PCTARED,PCODCCU,WSEQRAT,WDATBAS,PCODTNS,WMESANO,WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PVLRCTA,PPERRAT,PVLRRAT,POBSRAT,WSITRAT,PUSUGER,
                                     PDATGER,PHORGER,PROTPPJ,PFILRPJ,PNUMRPJ,PSEQRP1,PSEQRP2,PDATRP1,PDATRP2,PSTRRP1,PSTRRP2,PSTRRP3,PNUMPRJ,WNUMPRJ,PORIMOV,PNUMCRL,PDATCSP);									 
                FETCH CUR_E615PRJ_SUP INTO WPRJSUP;               
              	END LOOP;             
                
            EXCEPTION WHEN OTHERS THEN               
              CLOSE CUR_E615PRJ_SUP;                
              RAISE;             
            END;             
            
            CLOSE CUR_E615PRJ_SUP;           
          END IF;           
          
          FETCH CUR_E615PRJ_ATU INTO WESTCCO,WREGATU,WESTRAT;         
        END LOOP;       
      EXCEPTION WHEN OTHERS THEN         
        CLOSE CUR_E615PRJ_ATU;         
        RAISE;       
      END;       
      
      CLOSE CUR_E615PRJ_ATU;       
      WNUMPRJ := WPRJSUP;       
      BEGIN         
        SELECT E615PRJ.PRJSUP PRJSUP  INTO WPRJSUP         
          FROM E615PRJ E615PRJ        
         WHERE E615PRJ.CODEMP=PCODEMP        
           AND E615PRJ.NUMPRJ=WPRJSUP;       
      EXCEPTION WHEN NO_DATA_FOUND THEN           
        WPRJSUP := 0;       
      END;       
      
      IF ((WPRJSUP=0) OR (WPRJSUP=WNUMPRJ)) THEN         
        EXIT;       
      END IF;     
    END LOOP;   
  END IF; 
	
 EXCEPTION WHEN OTHERS THEN   
    RAISE;

END;
$BODY$;
␀—ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
'*␀␀PROCEDURE SP_ATURATFISPROJ(POPERAT CHAR,PCODEMP NUMBER(04),PNUMPRJ NUMBER(08),PCODFPJ NUMBER(04),PTIPREC NUMBER(01),PCODPRO VARCHAR2(14),PCODDER VARCHAR2(7),PCODSER VARCHAR2(14),PQTDCTA NUMBER(13,4),PPREUNI NUMBER(13,4),PQTDRAT NUMBER(13,4),PCTAFIN NUMBER(07),PCTARED NUMBER(07),PCODCCU VARCHAR2(9),PDATBAS DATE,PCODTNS VARCHAR2(5),PMESANO DATE,PCRIRAT NUMBER(01),PSOMSUB NUMBER(01),PCODFIL NUMBER(05),PPERCTA NUMBER(07,4),PVLRCTA NUMBER(15,2),PPERRAT NUMBER(07,4),PVLRRAT NUMBER(15,2),POBSRAT VARCHAR2(120),PUSUGER NUMBER(10),PDATGER DATE,PHORGER NUMBER(05),PROTPPJ NUMBER(02),PFILRPJ NUMBER(05),PNUMRPJ NUMBER(09),PSEQRP1 NUMBER(09),PSEQRP2 NUMBER(09),PDATRP1 DATE,PDATRP2 DATE,PSTRRP1 VARCHAR2(14),PSTRRP2 VARCHAR2(7),PSTRRP3 VARCHAR2(10),PORIMOV VARCHAR2(2),PNUMCRL NUMBER(09),PATUSUP CHAR,PDATCSP IN DATE)
 IS

WSEQRAT NUMBER(09);
WSITRAT CHAR;
WCRIRAT NUMBER(01);
WDATBAS DATE;
WMESANO DATE;
WNUMPRJ NUMBER(09);
WPRJATU NUMBER(09);
WPRJSUP NUMBER(09);
WESTCCO CHAR;
WREGATU CHAR;
WESTRAT CHAR;
WEXIFAS NUMBER(09);
WPRJFIS CHAR;

CURSOR CUR_E615PRJ_ATU IS
	SELECT E615PRJ.ESTCCO, E615PRJ.REGATU, E615PRJ.ESTRAT, E615PRJ.PRJFIS
	FROM E615PRJ
	WHERE E615PRJ.CODEMP=PCODEMP AND E615PRJ.NUMPRJ=WPRJATU;

CURSOR CUR_E615PRJ_SUP IS
	SELECT E615PRJ.PRJSUP
	FROM E615PRJ
	WHERE E615PRJ.CODEMP=PCODEMP AND E615PRJ.NUMPRJ=WNUMPRJ;


BEGIN
   WPRJATU := PNUMPRJ;
   FOREACH CUR_E615PRJ_ATU INTO WESTCCO, WREGATU, WESTRAT, WPRJFIS
   LOOP

      IF (POPERAT = 'I') THEN
         WSITRAT := 'A';
         WCRIRAT := PCRIRAT;
         WDATBAS := PDATBAS;
      ELSE
         WSITRAT := 'I';

         IF (PCRIRAT = 1) THEN
            WCRIRAT := 3;
         ELSE
            WCRIRAT := 1;
         END IF;
      END IF;

      IF (((WREGATU = 'A') OR (WREGATU IS NULL) OR (WREGATU = ' ') OR
          ((WREGATU = 'E') AND ((PSOMSUB = 1) OR (PSOMSUB = 4))) OR
          ((WREGATU = 'S') AND ((PSOMSUB = 2) OR (PSOMSUB = 5)))) AND (WPRJFIS <> 'N')) THEN

         SELECT (MAX(SEQRAT)+1) INTO WSEQRAT
         FROM E615RAF
         WHERE CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND CODFPJ=PCODFPJ AND TIPREC=PTIPREC AND
               CODPRO=PCODPRO AND CODDER=PCODDER AND CODSER=PCODSER AND CTAFIN=PCTAFIN AND
               CTARED=PCTARED AND CODCCU=PCODCCU;

         IF (WSEQRAT IS NULL) THEN
            WSEQRAT := 1;
         END IF;

         IF (POPERAT = 'I') THEN
            WSITRAT := 'A';
            WCRIRAT := PCRIRAT;
            WDATBAS := PDATBAS;
         ELSE
            WSITRAT := 'I';

            IF (PCRIRAT = 1) THEN
               WCRIRAT := 3;
            ELSE
               WCRIRAT := 1;
            END IF;

            /* WDATBAS := PDATBAS; */

            /* Gera estorno do rateio com data atual caso a data base do rateio seja menor que data atual */
            /* IF ((PDATBAS < CURDATE()) AND (WESTRAT = 'S')) THEN */
            /*    WDATBAS := CURDATE(); */
            /* ELSE */
            /*    WDATBAS := PDATBAS; */
            /* END; */

            /* Gera estorno do rateio com data atual caso a data base do rateio seja menor que data atual */
            IF (WESTRAT = 'S') THEN
               WDATBAS := PDATGER;
            ELSE
               WDATBAS := PDATBAS;
            END IF;

            /* Inativa os rateios dos movimentos da rotina */
            IF (WESTCCO = 'S') THEN
               BEGIN
               IF (PROTPPJ = 3) THEN /* Requesição*/
                  UPDATE E615RAF SET SITRAT='I' WHERE
                  CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND ROTPPJ=3 AND FILRPJ=PFILRPJ AND
                  NUMRPJ=PNUMRPJ AND SEQRP1=PSEQRP1 AND SITRAT='A';

               ELSE
                  UPDATE E615RAF SET SITRAT='I' WHERE
                  CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND ROTPPJ=PROTPPJ AND FILRPJ=PFILRPJ AND
                  SEQRP1=PSEQRP1 AND STRRP1=PSTRRP1 AND STRRP2=PSTRRP2 AND STRRP3=PSTRRP3 AND
                  SITRAT='A';
               END IF;
               END;
               ELSE
               /* Inativa os rateios dos movimentos da rotina quando não atualizar o sitrat - mantem o padrão do sistema*/
                  UPDATE E615RAF SET SITRAT='I' WHERE
                  CODEMP=PCODEMP AND NUMPRJ=PNUMPRJ AND ROTPPJ=PROTPPJ AND FILRPJ=PFILRPJ AND NUMRPJ=PNUMRPJ AND
                  SEQRP1=PSEQRP1 AND SEQRP2=PSEQRP2 AND DATRP1=PDATRP1 AND DATRP2=PDATRP2 AND
                  ((RTRIM(STRRP1) IS NULL) OR (STRRP1=PSTRRP1)) AND
                  ((RTRIM(STRRP2) IS NULL) OR (STRRP2=PSTRRP2)) AND
                  ((RTRIM(STRRP3) IS NULL) OR (STRRP3=PSTRRP3)) AND
                  SITRAT='A';
            END IF;
         END IF;

         WMESANO := DATETIME(01,MONTH(WDATBAS),YEAR(WDATBAS),0,0,0);
         WNUMPRJ := PNUMPRJ;

         INSERT INTO E615RAF
		      (CODEMP,NUMPRJ,CODFPJ,TIPREC,CODPRO,CODDER,CODSER,
                 CTAFIN,CTARED,CODCCU,SEQRAT,DATBAS,CODTNS,MESANO,
                 CRIRAT,SOMSUB,CODFIL,PERCTA,QTDCTA,VLRCTA,PERRAT,
                 QTDRAT,VLRRAT,OBSRAT,PREUNI,SITRAT,ROTPPJ,FILRPJ,
                 NUMRPJ,PRJORI,PRJFIL,SEQRP1,SEQRP2,DATRP1,DATRP2,
                 STRRP1,STRRP2,STRRP3,USUGER,DATGER,HORGER,ORIMOV,NUMCRL,DATCSP)
         VALUES (PCODEMP,PNUMPRJ,PCODFPJ,PTIPREC,PCODPRO,PCODDER,PCODSER,
                 PCTAFIN,PCTARED,PCODCCU,WSEQRAT,WDATBAS,PCODTNS,WMESANO,
                 WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PQTDCTA,PVLRCTA,PPERRAT,
                 PQTDRAT,PVLRRAT,POBSRAT,PPREUNI,WSITRAT,PROTPPJ,PFILRPJ,
                 PNUMRPJ,PNUMPRJ,WNUMPRJ,PSEQRP1,PSEQRP2,PDATRP1,PDATRP2,
                 PSTRRP1,PSTRRP2,PSTRRP3,PUSUGER,PDATGER,PHORGER,PORIMOV,PNUMCRL,PDATCSP);
      END IF;
   END LOOP;

   /* WSITRAT := 'A'; */
   /* WCRIRAT := PCRIRAT; */
   WDATBAS := PDATBAS;
   WMESANO := DATETIME(01,MONTH(WDATBAS),YEAR(WDATBAS),0,0,0);
   WNUMPRJ := PNUMPRJ;

   BEGIN
        SELECT PRJSUP INTO WPRJSUP
             FROM E615PRJ
             WHERE E615PRJ.CODEMP=PCODEMP AND E615PRJ.NUMPRJ=PNUMPRJ;
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  WPRJSUP := 0;
   END;

   IF ((WPRJSUP > 0) AND ((PATUSUP = 'S') OR (PATUSUP IS NULL) OR (PATUSUP = ' '))) THEN
      LOOP

         /* IF (WCRIRAT = 1) THEN */
         /*    WCRIRAT := 2; */
         /* ELSE IF (WCRIRAT = 3) THEN */
         /*         WCRIRAT := 4; */
         /*      END; */
         /* END; */

         WPRJATU := WPRJSUP;
         FOREACH CUR_E615PRJ_ATU INTO WESTCCO, WREGATU, WESTRAT, WPRJFIS
         LOOP
            IF (((WREGATU = 'A') OR (WREGATU IS NULL) OR (WREGATU = ' ') OR 
                ((WREGATU = 'E') AND ((PSOMSUB = 1) OR (PSOMSUB = 4))) OR
                ((WREGATU = 'S') AND ((PSOMSUB = 2) OR (PSOMSUB = 5)))) AND (WPRJFIS <> 'N')) THEN

               FOREACH CUR_E615PRJ_SUP INTO WPRJSUP
               LOOP
                  SELECT (MAX(SEQRAT)+1) INTO WSEQRAT
	                FROM E615RAF
                     WHERE CODEMP=PCODEMP AND NUMPRJ=WPRJSUP AND CODFPJ=PCODFPJ AND TIPREC=PTIPREC AND
                           CODPRO=PCODPRO AND CODDER=PCODDER AND CODSER=PCODSER AND CTAFIN=PCTAFIN AND
                           CTARED=PCTARED AND CODCCU=PCODCCU;

                  IF (WCRIRAT = 1) THEN
                     WCRIRAT := 2;
                  ELSE IF (WCRIRAT = 3) THEN
                          WCRIRAT := 4;
                       END IF;
                  END IF;

                  IF (WSEQRAT IS NULL) THEN
                     WSEQRAT := 1;
                     WEXIFAS := 1;
                     BEGIN
                        SELECT 1 INTO WEXIFAS
                        FROM E615FPJ
                        WHERE E615FPJ.CODEMP=PCODEMP AND E615FPJ.NUMPRJ=WPRJSUP AND E615FPJ.CODFPJ=PCODFPJ;
                           EXCEPTION
                              WHEN NO_DATA_FOUND THEN
                                 WEXIFAS := 0;
			      END;

                     IF (WEXIFAS = 0) THEN
                             INSERT INTO E615FPJ
                                    (CODEMP,NUMPRJ,CODFPJ,DESFPJ,ABRFPJ,CLAFPJ,DATPIF,DATPFF,DATIFP,DATFFP,PERFPJ,
                                     OBSFPJ,SITFPJ,CODMOT,OBSMOT,USUGER,DATGER,HORGER,USUATU,DATATU,HORATU)
                             SELECT E615FPJ.CODEMP,E615PRJ.PRJSUP,E615FPJ.CODFPJ,E615FPJ.DESFPJ,E615FPJ.ABRFPJ,
                                     E615FPJ.CLAFPJ,E615FPJ.DATPIF,E615FPJ.DATPFF,E615FPJ.DATIFP,E615FPJ.DATFFP,
                                     E615FPJ.PERFPJ,E615FPJ.OBSFPJ,E615FPJ.SITFPJ,E615FPJ.CODMOT,E615FPJ.OBSMOT,
                                     E615FPJ.USUGER,E615FPJ.DATGER,E615FPJ.HORGER,E615FPJ.USUATU,E615FPJ.DATATU,
                                     E615FPJ.HORATU
	                         FROM E615FPJ,E615PRJ WHERE
                                      E615FPJ.CODEMP=PCODEMP AND
                                      E615FPJ.NUMPRJ=WNUMPRJ AND
                                      E615FPJ.CODFPJ=PCODFPJ AND
                                      E615PRJ.CODEMP=E615FPJ.CODEMP AND
                                      E615PRJ.NUMPRJ=E615FPJ.NUMPRJ;
                     END IF;

                  END IF;

                  INSERT INTO E615RAF (CODEMP,NUMPRJ,CODFPJ,TIPREC,CODPRO,CODDER,CODSER, CTAFIN,CTARED,CODCCU,
                                       SEQRAT,DATBAS,CODTNS,MESANO,CRIRAT,SOMSUB,CODFIL,PERCTA,QTDCTA,VLRCTA,
                                       PERRAT,QTDRAT,VLRRAT,OBSRAT,PREUNI,SITRAT,ROTPPJ,FILRPJ,NUMRPJ,PRJORI,
                                       PRJFIL,SEQRP1,SEQRP2,DATRP1,DATRP2,STRRP1,STRRP2,STRRP3,USUGER,DATGER,
                                       HORGER,ORIMOV,NUMCRL,DATCSP)
                  VALUES (PCODEMP,WPRJSUP,PCODFPJ,PTIPREC,PCODPRO,PCODDER,PCODSER,PCTAFIN,PCTARED,PCODCCU,WSEQRAT,
                          WDATBAS,PCODTNS,WMESANO,WCRIRAT,PSOMSUB,PCODFIL,PPERCTA,PQTDCTA,PVLRCTA,PPERRAT,PQTDRAT,
                          PVLRRAT,POBSRAT,PPREUNI,WSITRAT,PROTPPJ,PFILRPJ,PNUMRPJ,PNUMPRJ,WNUMPRJ,PSEQRP1,PSEQRP2,
                          PDATRP1,PDATRP2,PSTRRP1,PSTRRP2,PSTRRP3,PUSUGER,PDATGER,PHORGER,PORIMOV,PNUMCRL,PDATCSP);
               END LOOP;
            END IF;
         END LOOP;

         WNUMPRJ := WPRJSUP;

         BEGIN
            SELECT PRJSUP INTO WPRJSUP
            FROM E615PRJ
            WHERE E615PRJ.CODEMP=PCODEMP AND E615PRJ.NUMPRJ=WPRJSUP;
            EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                      WPRJSUP := 0;
         END;

         IF ((WPRJSUP = 0) OR (WPRJSUP = WNUMPRJ)) THEN
             EXIT;
         END IF;

      END LOOP;
   END IF;
END␀˜ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUPROJETOS
˜␀␀PROCEDURE SP_ATUSALDOFINPRJ(PCODEMP NUMBER(04),PNUMCRL NUMBER(09),PUSUGER NUMBER(10))
 IS

WVLRRAT NUMBER(15,2);
WCODEMP NUMBER(04);
WNUMPRJ NUMBER(08);
WCODFPJ NUMBER(04);
WCTAFIN NUMBER(07);
WCODCCU VARCHAR2(09);
WMESANO DATE;
WCRIRAT NUMBER(01);
WSOMSUB NUMBER(01);
WROTPPJ NUMBER(02);

CURSOR CUR_E615RAT_SAL IS SELECT E615RAT.CODEMP, E615RAT.NUMPRJ, E615RAT.CODFPJ, E615RAT.CTAFIN, E615RAT.CODCCU, 
                                 E615RAT.MESANO, E615RAT.CRIRAT, E615RAT.SOMSUB, E615RAT.ROTPPJ, SUM(E615RAT.VLRRAT) AS VLRRAT                  
                          FROM E615RAT,E615CSP 
                          WHERE 
                              E615CSP.CODEMP = PCODEMP AND 
                              E615CSP.NUMCRL = PNUMCRL AND
                              E615CSP.USUGER = PUSUGER AND
                              E615RAT.CODEMP = E615CSP.CODEMP AND
                              E615RAT.NUMPRJ = E615CSP.NUMPRJ AND
                              E615RAT.NUMCRL = E615CSP.NUMCRL
                          GROUP BY E615RAT.CODEMP, E615RAT.NUMPRJ, E615RAT.CODFPJ, E615RAT.CTAFIN, E615RAT.CODCCU, 
                                   E615RAT.MESANO, E615RAT.CRIRAT, E615RAT.SOMSUB, E615RAT.ROTPPJ
                          ORDER BY E615RAT.CODEMP, E615RAT.NUMPRJ, E615RAT.CODFPJ, E615RAT.CTAFIN, E615RAT.CODCCU, 
                                   E615RAT.MESANO, E615RAT.CRIRAT, E615RAT.SOMSUB, E615RAT.ROTPPJ;

BEGIN
   FOREACH CUR_E615RAT_SAL INTO WCODEMP, WNUMPRJ, WCODFPJ, WCTAFIN, WCODCCU, WMESANO, WCRIRAT, WSOMSUB, WROTPPJ, WVLRRAT
   LOOP
     SP_ATUPROJETOS(WCODEMP,WNUMPRJ,WCODFPJ,WCTAFIN,WCODCCU,WMESANO,WROTPPJ,WCRIRAT,WSOMSUB,'',WVLRRAT);
   END LOOP;
END␀™ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUFISPROJ
/	␀␀PROCEDURE SP_ATUSALDOFISPRJ(PCODEMP NUMBER(04),PNUMCRL NUMBER(09),PUSUGER NUMBER(10))
 IS

WVLRRAT NUMBER(15,2);
WCODEMP NUMBER(04);
WNUMPRJ NUMBER(08);
WCODFPJ NUMBER(04);
WCTAFIN NUMBER(07);
WCODCCU VARCHAR2(09);
WMESANO DATE;
WCRIRAT NUMBER(01);
WSOMSUB NUMBER(01);
WROTPPJ NUMBER(02);
WTIPREC NUMBER(01);
WCODPRO VARCHAR2(14);
WCODDER VARCHAR2(07);
WCODSER VARCHAR2(14);
WQTDRAT NUMBER(13,4);
WPREUNI NUMBER(13,4);


CURSOR CUR_E615RAF_SAL IS SELECT E615RAF.CODEMP, E615RAF.NUMPRJ, E615RAF.CODFPJ, E615RAF.CTAFIN, E615RAF.CODCCU, E615RAF.MESANO,
                                 E615RAF.ROTPPJ, E615RAF.CRIRAT, E615RAF.SOMSUB, E615RAF.TIPREC, E615RAF.CODPRO, E615RAF.CODDER, 
                                 E615RAF.CODSER, SUM(E615RAF.QTDRAT) AS QTDRAT, AVG(E615RAF.PREUNI) AS PREUNI,
                                 SUM(E615RAF.VLRRAT) AS VLRRAT
                          FROM E615RAF,E615CSP 
                          WHERE 
                              E615CSP.CODEMP = PCODEMP AND 
                              E615CSP.NUMCRL = PNUMCRL AND
                              E615CSP.USUGER = PUSUGER AND
                              E615RAF.CODEMP = E615CSP.CODEMP AND
                              E615RAF.NUMPRJ = E615CSP.NUMPRJ AND
                              E615RAF.NUMCRL = E615CSP.NUMCRL
                          GROUP BY E615RAF.CODEMP, E615RAF.NUMPRJ, E615RAF.CODFPJ, E615RAF.CTAFIN, E615RAF.CODCCU, E615RAF.MESANO, 
                                   E615RAF.ROTPPJ, E615RAF.CRIRAT, E615RAF.SOMSUB, E615RAF.TIPREC, E615RAF.CODPRO, E615RAF.CODDER, 
                                   E615RAF.CODSER 
                          ORDER BY E615RAF.CODEMP, E615RAF.NUMPRJ, E615RAF.CODFPJ, E615RAF.CTAFIN, E615RAF.CODCCU, E615RAF.MESANO, 
                                   E615RAF.ROTPPJ, E615RAF.CRIRAT, E615RAF.SOMSUB, E615RAF.TIPREC, E615RAF.CODPRO, E615RAF.CODDER, 
                                   E615RAF.CODSER;

BEGIN
   FOREACH CUR_E615RAF_SAL INTO WCODEMP, WNUMPRJ, WCODFPJ, WCTAFIN, WCODCCU, WMESANO, WROTPPJ, WCRIRAT, WSOMSUB, 
                                WTIPREC, WCODPRO, WCODDER,  WCODSER, WQTDRAT, WPREUNI, WVLRRAT
   LOOP
      SP_ATUFISPROJ(WCODEMP,WNUMPRJ,WCODFPJ,WCTAFIN,WCODCCU,WMESANO,WROTPPJ,WCRIRAT,WSOMSUB,'',
                    WTIPREC,WCODPRO,WCODDER,WCODSER,WQTDRAT,WPREUNI,WVLRRAT);
   END LOOP;
END␀šê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_ATUSALDOS(PCODEMP NUMBER(04,0),PCODFIL NUMBER(05,0),PMESINI DATE,PMESFIM DATE,PTEMLCT VARCHAR2(255),PTEMLRT VARCHAR2(255),PCTASUP OUT NUMBER(07,0))
 IS

WCODFIL NUMBER(05,0);
WMESANO DATE;
WMESANO_SAL DATE;
WDEBCAL NUMBER(17,2);
WCRECAL NUMBER(17,2);
WANASIN CHAR;
WCLACTA VARCHAR(30);
WQTDPOS NUMBER(04,0);
WCTARED NUMBER(07,0);
WAUX CHAR;
WNUMAUX NUMBER(07,0);
WCLASUP VARCHAR(30);
WTAMCAM NUMBER(04,0);
WPOSNIV NUMBER(04,0);
WCTARED_AUX NUMBER(07,0);
WCLACTA_AUX VARCHAR(30);
WQTDPOS_AUX NUMBER(04,0);

CURSOR CUR_E650PMA_S IS
  SELECT CODFIL, MESANO
     FROM E650PMA 
     WHERE CODEMP=PCODEMP 
       AND CODFIL=PCODFIL 
       AND MESANO >= PMESINI
       AND MESANO <= PMESFIM 
       AND ((TEMLCT = PTEMLCT) OR (TEMLRT = PTEMLRT)) FOR UPDATE;

CURSOR CUR_E650SAL_S IS
  SELECT MESANO, DEBCAL, CRECAL, ANASIN, CLACTA, QTDPOS, CTARED
     FROM E650SAL E650SAL
     WHERE CODEMP = PCODEMP 
       AND CODFIL = PCODFIL
       AND MESANO >= PMESINI
       AND MESANO <= PMESFIM
       AND ((DEBCAL <> 0) OR (CRECAL <> 0)) FOR UPDATE;

CURSOR CUR_E045PLA_S IS
  SELECT CTARED, CLACTA, QTDPOS
     FROM E045PLA E045PLA
     WHERE CODEMP=PCODEMP 
       AND CLACTA=WCLASUP;

CURSOR CUR_E045PLA_I IS
  SELECT CTARED, CLACTA, QTDPOS
     FROM E045PLA E045PLA
     WHERE ANASIN = 'S'
       AND CODEMP = PCODEMP
       AND CTARED = WCTARED
       AND NOT EXISTS (SELECT 1 FROM E650SAL E650SAL WHERE E650SAL.CODEMP = E045PLA.CODEMP
                       AND E650SAL.CODFIL = PCODFIL AND E650SAL.CTARED = E045PLA.CTARED AND E650SAL.MESANO = WMESANO);

CURSOR CUR_E045PLA_N IS
  SELECT NIVCTA
     FROM E045PLA E045PLA
     WHERE CODEMP = PCODEMP
     AND CTARED = WCTARED_AUX;

BEGIN
PCTASUP := 0; /*vai retornar a conta contábil cuja conta superior não foi encontrada*/
FOREACH CUR_E650PMA_S INTO WCODFIL, WMESANO
LOOP
  FOREACH CUR_E650SAL_S INTO WMESANO_SAL, WDEBCAL, WCRECAL, WANASIN, WCLACTA, WQTDPOS, WCTARED
  LOOP
    WAUX := 'S';
    WHILE (WAUX = 'S') AND (PCTASUP = 0)
    LOOP
      WAUX := 'N';
      IF (WANASIN = 'A') THEN /*analítica só atualiza o saldo */
        UPDATE E650SAL SET DEBCAL = 0, CRECAL = 0,
            SALMES = 
                            (SELECT B.SALMES + (WDEBCAL - WCRECAL) FROM E650SAL B 
                            WHERE E650SAL.CODEMP = B.CODEMP AND E650SAL.CODFIL = B.CODFIL AND 
                            E650SAL.MESANO = B.MESANO AND E650SAL.CTARED = B.CTARED) 
            WHERE
              E650SAL.CODEMP = PCODEMP AND E650SAL.CODFIL = PCODFIL AND 
              E650SAL.MESANO = WMESANO_SAL AND E650SAL.CTARED = WCTARED;

      ELSE /* sintética atualiza tudo */
      
        UPDATE E650SAL SET DEBCAL = 0, CRECAL = 0,
            DEBMES = (SELECT B.DEBMES  + WDEBCAL FROM E650SAL B 
                            WHERE E650SAL.CODEMP = B.CODEMP AND E650SAL.CODFIL = B.CODFIL AND 
                            E650SAL.MESANO = B.MESANO AND E650SAL.CTARED = B.CTARED),
            CREMES = (SELECT B.CREMES + WCRECAL FROM E650SAL B 
                            WHERE E650SAL.CODEMP = B.CODEMP AND E650SAL.CODFIL = B.CODFIL AND
                            E650SAL.MESANO = B.MESANO AND E650SAL.CTARED = B.CTARED),
            SALMES = 
                            (SELECT B.SALMES + (WDEBCAL - WCRECAL) FROM E650SAL B 
                            WHERE E650SAL.CODEMP = B.CODEMP AND E650SAL.CODFIL = B.CODFIL AND 
                            E650SAL.MESANO = B.MESANO AND E650SAL.CTARED = B.CTARED) 
            WHERE
              E650SAL.CODEMP = PCODEMP AND E650SAL.CODFIL = PCODFIL AND 
              E650SAL.MESANO = WMESANO_SAL AND E650SAL.CTARED = WCTARED;

      END IF;
      WTAMCAM := LENGTH(WCLACTA);
      WPOSNIV := WTAMCAM-WQTDPOS;
      WCLASUP := SUBSTRING(WCLACTA,1,WPOSNIV);
      WCTARED_AUX := WCTARED; /*joga para a variável auxiliar para o caso de não encontrar o nível superior */
      WCTARED := 0;
      /* Buscar a conta reduzida do nível superior da conta atual */
      FOREACH CUR_E045PLA_S INTO WCTARED, WCLACTA, WQTDPOS
      LOOP
        WCTARED := WCTARED;
      END LOOP;
      IF (WCTARED > 0) THEN
        WAUX := 'S';
        /*Inserir conta sintética superior na tabela E650SAL para a data em questão*/
        FOREACH CUR_E045PLA_I INTO WCTARED_AUX, WCLACTA_AUX, WQTDPOS_AUX
        LOOP
          INSERT INTO E650SAL (CODEMP, CODFIL, MESANO, CTARED, CLACTA, ANASIN, QTDPOS, 
                               DEBCAL, CRECAL, DEBMES, CREMES, SALMES, VLRORC)
          VALUES (PCODEMP, PCODFIL, WMESANO, WCTARED_AUX, WCLACTA_AUX, 'S', WQTDPOS_AUX, 
                  0, 0, 0, 0, 0, 0);  
        END LOOP;  
      ELSE
        FOREACH CUR_E045PLA_N INTO WPOSNIV
        LOOP
          WPOSNIV := WPOSNIV;
        END LOOP;
        /*Se não for o primeiro nível, significa que há inconsistências na máscara*/
        IF (WPOSNIV <> 1) THEN
           PCTASUP := WCTARED_AUX;
        END IF;
      END IF;  
    END LOOP; 
  END LOOP;
  IF (PCTASUP = 0) THEN
    UPDATE E650SAL SET DEBCAL = 0, CRECAL = 0,
              SALMES=
                 (SELECT B.SALMES + (B.DEBCAL - B.CRECAL) FROM E650SAL B 
                  WHERE E650SAL.CODEMP = B.CODEMP AND E650SAL.CODFIL = B.CODFIL AND 
                  E650SAL.MESANO = B.MESANO AND E650SAL.CTARED = B.CTARED AND 
                  E650SAL.ANASIN = B.ANASIN) 
                  WHERE 
                  E650SAL.CODEMP = PCODEMP AND E650SAL.CODFIL = PCODFIL AND 
                  E650SAL.MESANO >= PMESINI AND E650SAL.MESANO <= PMESFIM AND
                  E650SAL.ANASIN = 'A' AND ((E650SAL.DEBCAL <> 0) OR (E650SAL.CRECAL <> 0));
        
    UPDATE E650PMA SET TEMLCT = 'N', TEMLRT = 'N' 
                  WHERE CODEMP = PCODEMP AND CODFIL = PCODFIL AND 
                  MESANO >= PMESINI AND MESANO <= PMESFIM;
  END IF;
END LOOP;
END␀›ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
!␀␀PROCEDURE SP_ATUVLRIMP_ERT(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PCODFOR NUMBER(09),PNUMNFI NUMBER(09),PNUMNFF NUMBER(09),PCODSNF VARCHAR2(3), PCODTNS VARCHAR2(5), PSEQINC NUMBER(04), PCODIMP VARCHAR2(3), PVLRIMP NUMBER(13,2))
 IS

WVALORITEM    NUMBER (17,2);
WTOTALPORITEM NUMBER (17,2);
WTIPIMP NUMBER(2);
   	    	  
BEGIN
  SELECT TIPIMP
    INTO WTIPIMP
    FROM E051IMP
   WHERE CODIMP = PCODIMP;
  
  IF (WTIPIMP = 83) THEN
    UPDATE E660INC SET TOTCBS = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINC = PSEQINC;  
    
    SELECT SUM(TOTCBS)
      INTO WTOTALPORITEM  
      FROM E660INC
     WHERE CODEMP = PCODEMP
  	   AND CODFIL = PCODFIL
  	   AND CODFOR = PCODFOR
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFC SET TOTCBS = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;              
  ELSIF (WTIPIMP = 84) THEN       
    UPDATE E660INC SET TOTIBU = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINC = PSEQINC;                      
    
    SELECT SUM(TOTIBU)
      INTO WTOTALPORITEM  
      FROM E660INC
     WHERE CODEMP = PCODEMP
  	   AND CODFIL = PCODFIL
  	   AND CODFOR = PCODFOR
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFC SET TOTIBU = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;                  
  ELSIF (WTIPIMP = 85) THEN       
    UPDATE E660INC SET TOTIBM = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINC = PSEQINC; 
                   
    SELECT SUM(TOTIBM)
      INTO WTOTALPORITEM  
      FROM E660INC
     WHERE CODEMP = PCODEMP
  	   AND CODFIL = PCODFIL
  	   AND CODFOR = PCODFOR
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFC SET TOTIBM = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODFOR = PCODFOR
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;                                              
  END IF;
END␀œê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_ATUVLRIMP_SRT(PCODEMP NUMBER(04),PCODFIL NUMBER(05),PCODCLI NUMBER(09),PNUMNFI NUMBER(09),PNUMNFF NUMBER(09),PCODSNF VARCHAR2(03), PCODTNS VARCHAR2(05), PSEQINV NUMBER(4), PCODIMP VARCHAR2(03), PVLRIMP NUMBER(17,2))
 IS

WVALORITEM    NUMBER (17,2);
WTOTALPORITEM NUMBER (17,2);
WTIPIMP NUMBER(2);

BEGIN
  SELECT TIPIMP
    INTO WTIPIMP
    FROM E051IMP
   WHERE CODIMP = PCODIMP;
   
  IF (WTIPIMP = 83) THEN
    UPDATE E660INV SET TOTCBS = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINV = PSEQINV;  
    
    SELECT SUM(TOTCBS)
      INTO WTOTALPORITEM
      FROM E660INV
     WHERE CODEMP = PCODEMP
       AND CODFIL = PCODFIL
  	   AND CODCLI = PCODCLI
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFV SET TOTCBS = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;              
  ELSIF (WTIPIMP = 84) THEN       
    UPDATE E660INV SET TOTIBU = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINV = PSEQINV;      
                   
    SELECT SUM(TOTIBU)
      INTO WTOTALPORITEM
      FROM E660INV
     WHERE CODEMP = PCODEMP
       AND CODFIL = PCODFIL
  	   AND CODCLI = PCODCLI
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFV SET TOTIBU = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;                  
  ELSIF (WTIPIMP = 85) THEN       
    UPDATE E660INV SET TOTIBM = PVLRIMP
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS
                   AND SEQINV = PSEQINV; 
                   
    SELECT SUM(TOTIBM)
      INTO WTOTALPORITEM
      FROM E660INV
     WHERE CODEMP = PCODEMP
       AND CODFIL = PCODFIL
  	   AND CODCLI = PCODCLI
  	   AND NUMNFI = PNUMNFI
  	   AND NUMNFF = PNUMNFF
  	   AND CODSNF = PCODSNF
   	   AND CODTNS = PCODTNS;
    
    UPDATE E660NFV SET TOTIBM = WTOTALPORITEM 
                 WHERE CODEMP = PCODEMP
                   AND CODFIL = PCODFIL
                   AND CODCLI = PCODCLI
                   AND NUMNFI = PNUMNFI
                   AND NUMNFF = PNUMNFF
                   AND CODSNF = PCODSNF
                   AND CODTNS = PCODTNS;                                              
  END IF;
END␀ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
