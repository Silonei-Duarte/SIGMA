       SUM(E670SAL.SALANO) AS EW67SCC_SALANO, SUM(E670SAL.SALANC) AS EW67SCC_SALANC,
       SUM(E670SAL.ENTMIO) AS EW67SCC_ENTMIO, SUM(E670SAL.ENTMCO) AS EW67SCC_ENTMCO,
       SUM(E670SAL.BAIMIO) AS EW67SCC_BAIMIO, SUM(E670SAL.BAIMCO) AS EW67SCC_BAIMCO,
       SUM(E670SAL.REAMIO) AS EW67SCC_REAMIO, SUM(E670SAL.REAMCO) AS EW67SCC_REAMCO,
       SUM(E670SAL.BDPMIO) AS EW67SCC_BDPMIO, SUM(E670SAL.BDPMCO) AS EW67SCC_BDPMCO,
       SUM(E670SAL.CORMCO) AS EW67SCC_CORMCO, SUM(E670SAL.DPRMIO) AS EW67SCC_DPRMIO,
       SUM(E670SAL.DPRMCO) AS EW67SCC_DPRMCO, SUM(E670SAL.SALATO) AS EW67SCC_SALATO,
