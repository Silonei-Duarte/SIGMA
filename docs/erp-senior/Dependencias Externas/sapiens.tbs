␀␀0;1{þ␀␀		SENIOR;0v␀␀TRIGGER T075PROU AFTER UPDATE ON E075PRO FOR EACH ROW

DECLARE
	
DERIVACAO   E075DER.CODDER%TYPE;
DATAFISCAL   E070EPF.DATHFI%TYPE;
DATA DATE;
	
CURSOR CUR_E070EPF IS
	SELECT DATHFI 
	  FROM E070EPF
	 WHERE CODEMP=:OLD.CODEMP AND
	 	   DATHFI IS NOT NULL AND 
	 	   UTIFIS = 'N'; 

CURSOR CUR_E075DER IS
	SELECT CODDER
	  FROM E075DER
	 WHERE CODEMP=:OLD.CODEMP AND
	 	   CODPRO=:OLD.CODPRO; 

BEGIN
  DATA := DATETIME(31,12,1900,0,0,0);
  
  IF NOT(((:NEW.DATGER = :NEW.DATALT) OR (:NEW.DATALT = DATA)) AND ((:NEW.HORGER = :NEW.HORALT) OR (:NEW.HORALT <= (:NEW.HORGER+100)))) THEN	
	IF (:OLD.DESNFV <> :NEW.DESNFV) THEN
	  FOREACH CUR_E070EPF INTO DATAFISCAL LOOP
		IF (DATA <> DATAFISCAL) THEN			
		  FOREACH CUR_E075DER INTO DERIVACAO LOOP
		    SP_T055HPF(:NEW.CODEMP,:NEW.CODPRO,DERIVACAO,'D','',:OLD.DESNFV);
		  END LOOP;
		END IF;								
      END LOOP;
	END IF;
  END IF;	
END␀zþ␀␀		SENIOR;0Ø␀␀

TRIGGER T075PROD AFTER DELETE ON E075PRO FOR EACH ROW

DECLARE
EXISTE VARCHAR (01); 
WINDEXP   E075EPR.INDEXP%TYPE; 
WSITREG   E098REG.SITREG%TYPE;
WCODESO   E083ORI.CODESO%TYPE; 

CURSOR CUR_E098REG IS
       SELECT SITREG FROM E098REG
       WHERE CODEMP=:OLD.CODEMP AND MODSIS='GER' AND IDEREG='000INTMV01';

CURSOR CUR_E083ORI IS
       SELECT CODESO
       FROM E083ORI
       WHERE CODEMP=:OLD.CODEMP AND CODORI=:OLD.CODORI;

CURSOR CUR_E075EPR IS
       SELECT INDEXP
       FROM E075EPR
       WHERE CODEMP=:OLD.CODEMP AND CODPRO=:OLD.CODPRO;

BEGIN
  WSITREG := 'I';
  FOREACH CUR_E098REG INTO WSITREG LOOP
    EXISTE := 'N';
  END LOOP;

  IF ((WSITREG = 'A') AND (:OLD.TIPINT <> 0)) OR (WSITREG='I') THEN
    EXISTE := 'N';
    FOREACH CUR_E083ORI INTO WCODESO LOOP
      IF (WCODESO <> ' ')  THEN
        FOREACH CUR_E075EPR INTO WINDEXP LOOP
          EXISTE := 'S';
        END LOOP;
		
        IF (EXISTE = 'N') THEN
          INSERT INTO E075EPR (CODEMP,CODPRO,INDEXP) VALUES (:OLD.CODEMP,:OLD.CODPRO,0);
        END IF;
          
		IF (EXISTE = 'S') AND (WINDEXP <> 0) THEN
          UPDATE E075EPR SET INDEXP = 0 WHERE CODEMP=:OLD.CODEMP AND CODPRO=:OLD.CODPRO;
        END IF;
      END IF;
    END LOOP;
  END IF;
