×␀␀CREATE OR REPLACE PROCEDURE SP_CTB_LIMPAR AS 
  V_COUNT Integer;
  
  
  PROCEDURE REMOVER ( aNMTable IN VARCHAR2) is
  begin
    SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES  WHERE TABLE_NAME =aNMTable;
    IF V_COUNT > 0 THEN
      EXECUTE IMMEDIATE 'DROP TABLE '|| aNMTable;
    end if;
  end;
BEGIN  

  REMOVER('CRE_TMP'); REMOVER('CRE_TMP1'); REMOVER('CRE_TMP2'); REMOVER('CRE_TMP3'); REMOVER('CRE_TMP4');
  REMOVER('DEB_TMP'); REMOVER('DEB_TMP1'); REMOVER('DEB_TMP2'); REMOVER('DEB_TMP3'); REMOVER('DEB_TMP4');
  REMOVER('E044CCU_TMP'); REMOVER('E044CCU_TMP1'); REMOVER('E044CCU_TMP2'); REMOVER('E044CCU_TMP3'); REMOVER('E044CCU_TMP4');
  REMOVER('E045PLA_TMP'); REMOVER('E045PLA_TMP1'); REMOVER('E045PLA_TMP2'); REMOVER('E045PLA_TMP3'); REMOVER('E045PLA_TMP4');
  REMOVER('PLACCU_TMP'); REMOVER('PLACCU_TMP1'); REMOVER('PLACCU_TMP2'); REMOVER('PLACCU_TMP3'); REMOVER('PLACCU_TMP4');
  REMOVER('TEMPSLDCCU'); REMOVER('TEMPSLDFIL');
  
END SP_CTB_LIMPAR;
	POSTGRESQL;0
f␀␀CREATE OR REPLACE PROCEDURE sp_ctb_limpar()
LANGUAGE 'plpgsql'
AS $BODY$

DECLARE
     V_EXECDROP VARCHAR;
	 V_TABELA VARCHAR[];
	 V_TABELAS VARCHAR[] := ARRAY[['tabela', 'CRE_TMP'],['tabela', 'CRE_TMP1'],['tabela','CRE_TMP2'],['tabela','CRE_TMP3'],
	 							  ['tabela','CRE_TMP4'],['tabela','DEB_TMP'],['tabela','DEB_TMP1'],['tabela','DEB_TMP2'],
								  ['tabela','DEB_TMP3'],['tabela','DEB_TMP4'],['tabela','E044CCU_TMP'],['tabela','E044CCU_TMP1'],
								  ['tabela','E044CCU_TMP2'],['tabela','E044CCU_TMP3'],['tabela','E044CCU_TMP4'],['tabela','E045PLA_TMP'],
								  ['tabela','E045PLA_TMP1'],['tabela','E045PLA_TMP2'],['tabela','E045PLA_TMP3'],['tabela','E045PLA_TMP4'],
								  ['tabela','PLACCU_TMP'],['tabela','PLACCU_TMP1'],['tabela','PLACCU_TMP2'],['tabela','PLACCU_TMP3'],
								  ['tabela','PLACCU_TMP4'],['tabela','TEMPSLDCCU'],['tabela','TEMPSLDFIL']];

BEGIN
	FOREACH V_TABELA SLICE 1 IN ARRAY V_TABELAS 
		LOOP			
			RAISE NOTICE 'DROPANDO A TABELA ''%''', V_TABELA[2];
			V_EXECDROP := 'DROP TABLE IF EXISTS ' || V_TABELA[2];
			EXECUTE V_EXECDROP;
		END LOOP;
END;

$BODY$␀¤ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_EXISTEPROJETO(PCODEMP NUMBER,AINDPRJ OUT INTEGER)
 IS

WINDPRJ VARCHAR(2);
BEGIN
   SELECT INDPRJ INTO WINDPRJ
          FROM E070EMP
          WHERE CODEMP=PCODEMP;

   IF (WINDPRJ = 'S') THEN
      AINDPRJ := 1;
   ELSE
      AINDPRJ := 0;
   END IF;
END␀¥ê␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
”PROCEDURE SP_GERA650SLC(V_CODEMP NUMBER,V_CODFIL VARCHAR2(255),V_MESINIPAR DATE,V_MESFIMPAR DATE,V_LOCK NUMBER,V_STATS NUMBER)
 IS
BEGIN
  NULL;
END	ORACLE;0
ÈA␀␀CREATE OR REPLACE PROCEDURE SP_GERA650SLC
(V_CODEMP IN NUMBER, V_CODFIL IN VARCHAR2, V_MESINIPAR IN DATE, V_MESFIMPAR IN DATE, V_LOCK IN NUMBER, V_STATS IN NUMBER)
AS
  V_MESINI DATE;
  V_MESFIM DATE;
  V_COUNT PLS_INTEGER;
BEGIN
	IF V_MESINIPAR IS NOT NULL THEN
    V_MESINI:= TRUNC(V_MESINIPAR,'MONTH');
  ELSE
    EXECUTE IMMEDIATE 'SELECT TRUNC(MIN(MESANO),''MONTH'') FROM E650PMA WHERE CODEMP = :1 AND CODFIL IN ('||V_CODFIL||')'
    INTO V_MESINI USING IN V_CODEMP;
  END IF;
  
  IF V_MESFIMPAR IS NOT NULL THEN
    V_MESFIM:= LAST_DAY(V_MESFIMPAR);
  ELSE
    EXECUTE IMMEDIATE 'SELECT LAST_DAY(MAX(MESANO)) FROM E650PMA WHERE CODEMP = :1 AND CODFIL IN ('||V_CODFIL||') '
    INTO V_MESFIM USING IN V_CODEMP;    
  END IF;
  
  /* CRIANDO/TRUNCANDO TABELAS TEMPORARIAS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...)');
  
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E045PLA_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E045PLA_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E045PLA_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CTARED NUMBER(7) NOT NULL,
     ROOT_CTARED NUMBER(7) NOT NULL,
     CLACTA VARCHAR2(30) NOT NULL,
     NIVCTA NUMBER(2) NOT NULL,
     QTDPOS NUMBER(1) NOT NULL) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX E045PLA_TMP1Indice1 ON E045PLA_TMP1 (CODEMP, ROOT_CTARED)';
  END IF;
   
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'E044CCU_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE E044CCU_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE E044CCU_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CODCCU VARCHAR(9) NOT NULL,
     ROOT_CODCCU VARCHAR(9) NOT NULL,
     CCUPAI VARCHAR(9) NULL,
     CLACCU VARCHAR2(30) NOT NULL,
     NIVCCU NUMBER(2) NOT NULL,
     POSCCU NUMBER(2) NOT NULL) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX E044CCU_TMP1Indice1 ON E044CCU_TMP1 (CODEMP, ROOT_CODCCU)';
  END IF;
    
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'PLACCU_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE PLACCU_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE PLACCU_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CODFIL NUMBER(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMBER(7) NOT NULL,
     CLACTA VARCHAR2(30) NOT NULL,
     NIVCTA NUMBER(2) NULL,
     CODCCU VARCHAR(9) NULL,
     CLACCU VARCHAR2(30) NULL,
     NIVCCU NUMBER(2) NULL) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX PLACCU_TMP1Indice1 ON PLACCU_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'DEB_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE DEB_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE DEB_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CODFIL NUMBER(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMBER(7) NOT NULL,
     CLACTA VARCHAR2(30) NOT NULL,
     CODCCU VARCHAR2(9) NOT NULL,
     CLACCU VARCHAR2(30) NOT NULL,
     SOMA NUMBER(17,2)) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX DEB_TMP1Indice1 ON DEB_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'CRE_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE CRE_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE CRE_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CODFIL NUMBER(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMBER(7) NOT NULL,
     CLACTA VARCHAR2(30) NOT NULL,
     CODCCU VARCHAR2(9) NOT NULL,
     CLACCU VARCHAR2(30) NOT NULL,
     SOMA NUMBER(17,2)) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX CRE_TMP1Indice1 ON CRE_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
  SELECT COUNT(1) INTO V_COUNT FROM USER_TABLES WHERE TABLE_NAME = 'MOV_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE IMMEDIATE 'TRUNCATE TABLE MOV_TMP1';
  ELSE
    EXECUTE IMMEDIATE 'CREATE GLOBAL TEMPORARY TABLE MOV_TMP1
    (CODEMP NUMBER(4) NOT NULL,
     CODFIL NUMBER(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMBER(7) NOT NULL,
     CLACTA VARCHAR2(30) NOT NULL,
     CODCCU VARCHAR2(9) NOT NULL,
     CLACCU VARCHAR2(30) NOT NULL,
     DEBMES NUMBER(17,2),
     CREMES NUMBER(17,2),
     MOVMES NUMBER(17,2)) ON COMMIT DELETE ROWS';
     EXECUTE IMMEDIATE 'CREATE INDEX MOV_TMP1Indice1 ON MOV_TMP1 (CODEMP, CODFIL, CTARED, CODCCU, MESANO)';
     EXECUTE IMMEDIATE 'CREATE INDEX MOV_TMP1Indice2 ON MOV_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;

  /* EXECUTANDO LOCKS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 2 (EXECUTANDO LOCKS...)');
  IF V_LOCK = '1' THEN
    LOCK TABLE E650SLC IN EXCLUSIVE MODE;
    LOCK TABLE E640RAT IN EXCLUSIVE MODE;
    LOCK TABLE E640LCT IN EXCLUSIVE MODE;
  END IF;

  /* GERANDO CONTAS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 3 (GERANDO CONTAS...)');
  FOR C_PLA IN (SELECT CODEMP, CTARED FROM E045PLA WHERE CODEMP = V_CODEMP ORDER BY CTARED)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E045PLA_TMP1
    (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS)
    SELECT E045PLA2.CODEMP CODEMP, E045PLA2.CTARED CTARED, E045PLA3.CTARED ROOT_CTARED, E045PLA2.CLACTA CLACTA, 
       E045PLA2.NIVCTA NIVCTA, E045PLA2.QTDPOS QTDPOS
    FROM E045PLA E045PLA2, (SELECT CODEMP, CTARED FROM E045PLA WHERE E045PLA.CODEMP = :1 AND E045PLA.CTARED = :2) E045PLA3
    WHERE E045PLA2.CODEMP = E045PLA3.CODEMP
    START WITH E045PLA2.CODEMP = E045PLA3.CODEMP AND E045PLA2.CTARED = E045PLA3.CTARED
    CONNECT BY PRIOR E045PLA2.CODEMP = E045PLA2.CODEMP AND PRIOR E045PLA2.NIVCTA-1 = E045PLA2.NIVCTA 
           AND PRIOR SUBSTR(TO_CHAR(E045PLA2.CLACTA),1,LENGTH(E045PLA2.CLACTA)-E045PLA2.QTDPOS) = E045PLA2.CLACTA
    ORDER SIBLINGS BY E045PLA2.CLACTA' USING IN C_PLA.CODEMP, IN C_PLA.CTARED;
  END LOOP;

  /* GERANDO CENTROS DE CUSTO... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 4 (GERANDO CENTROS DE CUSTO...)');
  FOR C_CCU IN (SELECT CODEMP, CODCCU FROM E044CCU WHERE CODEMP = V_CODEMP ORDER BY CODCCU)
  LOOP
    EXECUTE IMMEDIATE 'INSERT INTO E044CCU_TMP1
    (CODEMP, CODCCU, ROOT_CODCCU, CCUPAI, CLACCU, NIVCCU, POSCCU)
    SELECT E044CCU2.CODEMP CODEMP, E044CCU2.CODCCU CODCCU, E044CCU3.CODCCU ROOT_CODCCU, E044CCU2.CCUPAI CCUPAI, E044CCU2.CLACCU CLACCU, 
       E044CCU2.NIVCCU NIVCCU, E044CCU2.POSCCU POSCCU
    FROM E044CCU E044CCU2, (SELECT CODEMP, CODCCU FROM E044CCU WHERE E044CCU.CODEMP = :1 AND E044CCU.CODCCU = :2) E044CCU3
    WHERE E044CCU2.CODEMP = E044CCU3.CODEMP
    START WITH E044CCU2.CODEMP = E044CCU3.CODEMP AND E044CCU2.CODCCU = E044CCU3.CODCCU
    CONNECT BY PRIOR E044CCU2.CODEMP = E044CCU2.CODEMP AND PRIOR E044CCU2.NIVCCU-1 = E044CCU2.NIVCCU 
           AND PRIOR CCUPAI = E044CCU2.CODCCU
    ORDER SIBLINGS BY E044CCU2.CLACCU' USING IN C_CCU.CODEMP, IN C_CCU.CODCCU;
  END LOOP;

  /* GERANDO CONTAS/CENTROS/MESANO */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 5 (GERANDO CONTAS/CENTROS/MESANO)');
  EXECUTE IMMEDIATE 'INSERT INTO PLACCU_TMP1
  SELECT E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, 
         PLACCU.CLACTA, PLACCU.NIVCTA, PLACCU.CODCCU, PLACCU.CLACCU, PLACCU.NIVCCU
  FROM E650PMA, (SELECT E045PLA.CODEMP, -1 CODFIL, E045PLA.CTARED, E045PLA.CLACTA, E045PLA.NIVCTA, 
                        '' '' CODCCU, ''0'' CLACCU, 0 NIVCCU
                 FROM E045PLA
                 WHERE E045PLA.CODEMP = :1
                 UNION ALL
                 SELECT DISTINCT E640RAT.CODEMP, E640RAT.FILRAT, E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, E045PLA_TMP1.NIVCTA, 
                        E044CCU_TMP1.CODCCU, E044CCU_TMP1.CLACCU, E044CCU_TMP1.NIVCCU
                 FROM (SELECT NVL(E640RAT.CODEMP,E650SLC.CODEMP) CODEMP, 
                              NVL(E640RAT.FILRAT,E650SLC.CODFIL) FILRAT, 
                              NVL(E640RAT.CTARED,E650SLC.CTARED) CTARED, 
                              NVL(E640RAT.CODCCU,E650SLC.CODCCU) CODCCU 
                       FROM (SELECT CODEMP, FILRAT, CTARED, CODCCU FROM E640RAT
                             WHERE E640RAT.CODEMP = :2
                             AND E640RAT.FILRAT IN ('||V_CODFIL||')
                             AND E640RAT.DATLCT >= :3
                             AND E640RAT.DATLCT <= :4
                             GROUP BY CODEMP, FILRAT, CTARED, CODCCU) E640RAT
                       FULL OUTER JOIN (SELECT CODEMP, CODFIL, CTARED, CODCCU FROM E650SLC
                                        WHERE E650SLC.CODEMP = :4
                                        AND E650SLC.CODFIL IN ('||V_CODFIL||')
                                        AND E650SLC.MESANO = ADD_MONTHS(:5,-1)) E650SLC
                         ON E640RAT.CODEMP = E650SLC.CODEMP
                        AND E640RAT.FILRAT = E650SLC.CODFIL
                        AND E640RAT.CTARED = E650SLC.CTARED
                        AND E640RAT.CODCCU = E650SLC.CODCCU) E640RAT
                 INNER JOIN E045PLA_TMP1 
                   ON E640RAT.CODEMP = E045PLA_TMP1.CODEMP
                   AND E640RAT.CTARED = E045PLA_TMP1.ROOT_CTARED
                 INNER JOIN E044CCU_TMP1
                   ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
                  AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU) PLACCU
  WHERE E650PMA.CODEMP = PLACCU.CODEMP
  AND (E650PMA.CODFIL = PLACCU.CODFIL OR PLACCU.CODFIL = -1)
  AND E650PMA.CODEMP = :6
  AND E650PMA.CODFIL IN ('||V_CODFIL||')
  AND E650PMA.MESANO >= :7
  AND E650PMA.MESANO <= :8
  ORDER BY E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, PLACCU.CODCCU' 
  USING IN V_CODEMP, IN V_CODEMP, IN V_MESINI, V_MESFIM, IN V_CODEMP, IN V_MESINI, IN V_CODEMP, IN V_MESINI, IN V_MESFIM;
  
  /* GERANDO DEBITOS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 6 (GERANDO DEBITOS...)');
  EXECUTE IMMEDIATE 'INSERT INTO DEB_TMP1
  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT,''MONTH'') MESANO, 
  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, NVL(E044CCU_TMP1.CODCCU,'' '') CODCCU, NVL(E044CCU_TMP1.CLACCU,''0'') CLACCU, 
  SUM(DECODE(E640LCT.TEMRAT,1,E640RAT.VLRRAT,3,E640RAT.VLRRAT,E640LCT.VLRLCT)) SOMA
  FROM E640LCT 
  INNER JOIN E045PLA_TMP1 
    ON E640LCT.CODEMP = E045PLA_TMP1.CODEMP
    AND E640LCT.CTADEB = E045PLA_TMP1.ROOT_CTARED
  LEFT OUTER JOIN E640RAT
    ON E640LCT.CODEMP = E640RAT.CODEMP
    AND E640LCT.NUMLCT = E640RAT.NUMLCT
    AND E640LCT.CTADEB = E640RAT.CTARED
    AND E640RAT.DATLCT >= :1
    AND E640RAT.DATLCT <= :2
  LEFT OUTER JOIN E044CCU_TMP1
    ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
    AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU
  WHERE E640LCT.CODEMP = :3
  AND E640LCT.CODFIL IN ('||V_CODFIL||')
  AND E640LCT.SITLCT = 2 
  AND E640LCT.CTADEB <> 0
  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
  AND E640LCT.DATLCT >= :4
  AND E640LCT.DATLCT <= :5
  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''), 
  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA,  NVL(E044CCU_TMP1.CODCCU,'' ''), NVL(E044CCU_TMP1.CLACCU,''0'')
  ORDER BY 1, 2, 3, 4, 6'
  USING IN V_MESINI, IN V_MESFIM, IN V_CODEMP, IN V_MESINI, IN V_MESFIM;
  
  /* GERANDO CREDITOS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 7 (GERANDO CREDITOS...)');
  EXECUTE IMMEDIATE 'INSERT INTO CRE_TMP1
  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, TRUNC(E640LCT.DATLCT,''MONTH'') MESANO, 
  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, NVL(E044CCU_TMP1.CODCCU,'' '') CODCCU, NVL(E044CCU_TMP1.CLACCU,''0'') CLACCU, 
  SUM(DECODE(E640LCT.TEMRAT,2,E640RAT.VLRRAT,3,E640RAT.VLRRAT,E640LCT.VLRLCT)) SOMA
  FROM E640LCT 
  INNER JOIN E045PLA_TMP1 
    ON E640LCT.CODEMP = E045PLA_TMP1.CODEMP
    AND E640LCT.CTACRE = E045PLA_TMP1.ROOT_CTARED
  LEFT OUTER JOIN E640RAT
    ON E640LCT.CODEMP = E640RAT.CODEMP
    AND E640LCT.NUMLCT = E640RAT.NUMLCT
    AND E640LCT.CTACRE = E640RAT.CTARED
    AND E640RAT.DATLCT >= :1
    AND E640RAT.DATLCT <= :2
  LEFT OUTER JOIN E044CCU_TMP1
    ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
    AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU
  WHERE E640LCT.CODEMP = :3
  AND E640LCT.CODFIL IN ('||V_CODFIL||') 
  AND E640LCT.SITLCT = 2 
  AND E640LCT.CTACRE <> 0
  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
  AND E640LCT.DATLCT >= :4
  AND E640LCT.DATLCT <= :5
  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, TRUNC(E640LCT.DATLCT,''MONTH''), 
  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA,  NVL(E044CCU_TMP1.CODCCU,'' ''), NVL(E044CCU_TMP1.CLACCU,''0'')
  ORDER BY 1, 2, 3, 4, 6'
  USING IN V_MESINI, IN V_MESFIM, IN V_CODEMP, IN V_MESINI, IN V_MESFIM;

  /* CAPTURANDO ULTIMO SALDO VALIDO... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 8 (CAPTURANDO ULTIMO SALDO VALIDO...)');
  EXECUTE IMMEDIATE 'INSERT INTO MOV_TMP1
  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, SALMES
  FROM E650SLC
  WHERE CODEMP = :1
  AND CODFIL IN ('||V_CODFIL||')
  AND MESANO = ADD_MONTHS(:2,-1)'
  USING IN V_CODEMP, IN V_MESINI;

  /* CONSOLIDANDO MOVIMENTOS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 9 (CONSOLIDANDO MOVIMENTOS...)');
  EXECUTE IMMEDIATE 'INSERT INTO MOV_TMP1
  SELECT PLACCU_TMP1.CODEMP, PLACCU_TMP1.CODFIL, PLACCU_TMP1.MESANO, 
         PLACCU_TMP1.CTARED, PLACCU_TMP1.CLACTA, PLACCU_TMP1.CODCCU, PLACCU_TMP1.CLACCU,
         NVL(MOVTO.DEBMES,0) DEBMES, NVL(MOVTO.CREMES,0) CREMES, NVL(MOVTO.MOVMES,0) MOVMES
  FROM PLACCU_TMP1
  LEFT OUTER JOIN
      (SELECT NVL(DEB.CODEMP,CRE.CODEMP) CODEMP, NVL(DEB.CODFIL,CRE.CODFIL) CODFIL, NVL(DEB.MESANO,CRE.MESANO) MESANO, 
       NVL(DEB.CTARED,CRE.CTARED) CTARED, NVL(DEB.CLACTA,CRE.CLACTA) CLACTA, 
       NVL(DEB.CODCCU,CRE.CODCCU) CODCCU, NVL(DEB.CLACCU,CRE.CLACCU) CLACCU,
       NVL(DEB.SOMA,0) DEBMES, NVL(CRE.SOMA,0) CREMES, 
       NVL(DEB.SOMA,0)-NVL(CRE.SOMA,0) MOVMES
       FROM DEB_TMP1 DEB
       FULL OUTER JOIN CRE_TMP1 CRE
         ON DEB.CODEMP = CRE.CODEMP
         AND DEB.CODFIL = CRE.CODFIL
         AND DEB.MESANO = CRE.MESANO
         AND DEB.CTARED = CRE.CTARED
         AND DEB.CODCCU = CRE.CODCCU) MOVTO
    ON PLACCU_TMP1.CODEMP = MOVTO.CODEMP
   AND PLACCU_TMP1.CODFIL = MOVTO.CODFIL
   AND PLACCU_TMP1.MESANO = MOVTO.MESANO
   AND PLACCU_TMP1.CTARED = MOVTO.CTARED
   AND PLACCU_TMP1.CODCCU = MOVTO.CODCCU
  ORDER BY PLACCU_TMP1.CODEMP, PLACCU_TMP1.CODFIL, PLACCU_TMP1.MESANO, 
           PLACCU_TMP1.CLACTA, PLACCU_TMP1.CTARED, PLACCU_TMP1.CLACCU, PLACCU_TMP1.CODCCU';

  /* GERANDO SALDOS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 10 (GERANDO SALDOS...)');
  EXECUTE IMMEDIATE 'INSERT INTO E650SLC
  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, 
  SALMES-MOVMES SALANT, DEBMES, CREMES, MOVMES, SALMES
  FROM (SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, MOVMES, 
            (SELECT SUM(MOVMES)
             FROM MOV_TMP1 D2
             WHERE D2.CODEMP = D1.CODEMP 
             AND D2.CODFIL = D1.CODFIL
             AND D2.CTARED = D1.CTARED 
             AND D2.CODCCU = D1.CODCCU 
             AND D2.MESANO <= D1.MESANO) SALMES
        FROM MOV_TMP1 D1
        WHERE CODEMP = :1 AND CODFIL IN ('||V_CODFIL||') AND MESANO >= :2) SALDOS'
  USING IN V_CODEMP, IN V_MESINI;

  /* SALVA ALTERACOES REALIZADAS */
  COMMIT;

  /* TRUNCANDO TABELAS TEMPORARIAS... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 11 (TRUNCANDO TABELAS TEMPORARIAS...)');
  EXECUTE IMMEDIATE 'TRUNCATE TABLE E045PLA_TMP1';
  EXECUTE IMMEDIATE 'TRUNCATE TABLE E044CCU_TMP1';
  EXECUTE IMMEDIATE 'TRUNCATE TABLE PLACCU_TMP1';
  EXECUTE IMMEDIATE 'TRUNCATE TABLE DEB_TMP1';
  EXECUTE IMMEDIATE 'TRUNCATE TABLE CRE_TMP1';
  EXECUTE IMMEDIATE 'TRUNCATE TABLE MOV_TMP1';
  
  /* CASO SOLICITADO, EXECUTANDO ANALYZE... */
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 12 (EXECUTANDO ANALYZE...)');
  IF V_STATS = '1' THEN
    EXECUTE IMMEDIATE 'ANALYZE TABLE E650SLC COMPUTE STATISTICS';
  END IF;
  
  DBMS_OUTPUT.PUT_LINE(TO_CHAR(SYSDATE,'DD/MM/YY HH24:MI:SS')||' - PASSO 13 (PROCESSO FINALIZADO!)');
EXCEPTION
  WHEN OTHERS THEN
    ROLLBACK;
    RAISE;
END SP_GERA650SLC;

	MSSQL;0
!9␀␀CREATE PROCEDURE SP_GERA650SLC
@V_CODEMP SMALLINT, @V_CODFIL NVARCHAR(4000), @V_MESINIPAR DATETIME, @V_MESFIMPAR DATETIME, @V_LOCK TINYINT, @V_STATS TINYINT
AS
  DECLARE @V_MESINI DATETIME
  DECLARE @V_MESFIM DATETIME
  DECLARE @V_COUNT 
BIGINT
  DECLARE @V_STMT NVARCHAR(4000)
  
  SELECT @V_MESINI = DATEADD(DD,-(DAY(@V_MESINIPAR)-1),@V_MESINIPAR)
  SELECT @V_MESFIM = DATEADD(DD,-(DAY(DATEADD(MM,1,@V_MESFIMPAR))),DATEADD(MM,1,@V_MESFIMPAR))
  
  /* CRIANDO/TRUNCANDO TABELAS TEMPORARIAS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 1 (CRIANDO TABELAS TEMPORARIAS...)'
  
  CREATE TABLE #E045PLA_TMP1
    (CODEMP SMALLINT NOT NULL,
     CTARED INT NOT NULL,
     ROOT_CTARED INT NOT NULL,
     CLACTA VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     NIVCTA SMALLINT NOT NULL,
     QTDPOS SMALLINT NOT NULL)
  CREATE INDEX E045PLA_TMPIndice1 ON #E045PLA_TMP1 (CODEMP, ROOT_CTARED)
   
  CREATE TABLE #E044CCU_TMP1
    (CODEMP SMALLINT NOT NULL,
     CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NOT NULL,
     ROOT_CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NOT NULL,
     CCUPAI VARCHAR(9) COLLATE DATABASE_DEFAULT NULL,
     CLACCU VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     NIVCCU SMALLINT NOT NULL,
     POSCCU SMALLINT NOT NULL)
  CREATE INDEX E044CCU_TMPIndice1 ON #E044CCU_TMP1 (CODEMP, ROOT_CODCCU)

  CREATE TABLE #PLACCU_TMP1
    (CODEMP SMALLINT NOT NULL,
     CODFIL INT NOT NULL,
     MESANO DATETIME NOT NULL,
     CTARED INT NOT NULL,
     CLACTA VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     NIVCTA SMALLINT NULL,
     CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NULL,
     CLACCU VARCHAR(30) COLLATE DATABASE_DEFAULT NULL,
     NIVCCU SMALLINT NULL)
  CREATE INDEX PLACCU_TMPIndice1 ON #PLACCU_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)
  
  CREATE TABLE #DEB_TMP1
    (CODEMP SMALLINT NOT NULL,
     CODFIL INT NOT NULL,
     MESANO DATETIME NOT NULL,
     CTARED INT NOT NULL,
     CLACTA VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NOT NULL,
     CLACCU VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     SOMA NUMERIC(17,2))
  
  CREATE INDEX DEB_TMPIndice1 ON #DEB_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)
  
  CREATE TABLE #CRE_TMP1
    (CODEMP SMALLINT NOT NULL,
     CODFIL INT NOT NULL,
     MESANO DATETIME NOT NULL,
     CTARED INT NOT NULL,
     CLACTA VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NOT NULL,
     CLACCU VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     SOMA NUMERIC(17,2))
  CREATE INDEX CRE_TMPIndice1 ON #CRE_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)
  
  CREATE TABLE #MOV_TMP1
    (CODEMP SMALLINT NOT NULL,
     CODFIL INT NOT NULL,
     MESANO DATETIME NOT NULL,
     CTARED INT NOT NULL,
     CLACTA VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     CODCCU VARCHAR(9) COLLATE DATABASE_DEFAULT NOT NULL,
     CLACCU VARCHAR(30) COLLATE DATABASE_DEFAULT NOT NULL,
     DEBMES NUMERIC(17,2),
     CREMES NUMERIC(17,2),
     MOVMES NUMERIC(17,2))
  CREATE INDEX MOV_TMPIndice1 ON #MOV_TMP1 (CODEMP, CODFIL, CTARED, CODCCU, MESANO)
  CREATE INDEX MOV_TMPIndice2 ON #MOV_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)

  /* INICIANDO TRANSACAO... */
  BEGIN TRANSACTION
  
  /* GERANDO CONTAS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 2 (GERANDO CONTAS...)'
  SET @V_STMT=N'INSERT INTO #E045PLA_TMP1
  (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS)
  SELECT E045PLA2.CODEMP, E045PLA2.CTARED, E045PLA.CTARED ROOT_CTARED, 
         E045PLA2.CLACTA, E045PLA2.NIVCTA, E045PLA2.QTDPOS
  FROM E045PLA
  INNER JOIN E045PLA E045PLA2
     ON E045PLA.CODEMP = E045PLA2.CODEMP
    AND E045PLA.CLACTA LIKE E045PLA2.CLACTA+''%''
    AND NOT (E045PLA.NIVCTA = E045PLA2.NIVCTA
             AND E045PLA.CTARED <> E045PLA2.CTARED)
  WHERE E045PLA.CODEMP = @V_CODEMP
  ORDER BY E045PLA.CODEMP, E045PLA.CLACTA, E045PLA2.CLACTA'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint',@V_CODEMP=@V_CODEMP
  
  /* GERANDO CENTROS DE CUSTO... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 3 (GERANDO CENTROS DE CUSTO...)'
  SET @V_STMT=N'INSERT INTO #E044CCU_TMP1
    (CODEMP, CODCCU, ROOT_CODCCU, CCUPAI, CLACCU, NIVCCU, POSCCU)
  SELECT E044CCU2.CODEMP, E044CCU2.CODCCU, E044CCU.CODCCU ROOT_CODCCU, 
         E044CCU2.CCUPAI, E044CCU2.CLACCU, E044CCU2.NIVCCU, E044CCU2.POSCCU
  FROM E044CCU
  INNER JOIN E044CCU E044CCU2
     ON E044CCU.CODEMP = E044CCU2.CODEMP
    AND E044CCU.CLACCU LIKE E044CCU2.CLACCU+''%''
    AND NOT (E044CCU.NIVCCU = E044CCU2.NIVCCU
             AND E044CCU.CODCCU <> E044CCU2.CODCCU)
  WHERE E044CCU.CODEMP = @V_CODEMP
  ORDER BY E044CCU.CODEMP, E044CCU.CODCCU, E044CCU2.CLACCU'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint',@V_CODEMP=@V_CODEMP
  
  /* GERANDO CONTAS/CENTROS/MESANO */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 4 (GERANDO CONTAS/CENTROS/MESANO)'
  SET @V_STMT=N'INSERT INTO #PLACCU_TMP1
  SELECT E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, 
         PLACCU.CLACTA, PLACCU.NIVCTA, PLACCU.CODCCU, PLACCU.CLACCU, PLACCU.NIVCCU
  FROM E650PMA, (SELECT E045PLA.CODEMP, -1 CODFIL, E045PLA.CTARED, 
                        E045PLA.CLACTA, E045PLA.NIVCTA, 
                        '' '' CODCCU, ''0'' CLACCU, 0 NIVCCU
                 FROM E045PLA
                 WHERE E045PLA.CODEMP = @V_CODEMP
                 UNION ALL
                 SELECT DISTINCT E640RAT.CODEMP, E640RAT.FILRAT, E045PLA_TMP.CTARED, 
                        E045PLA_TMP.CLACTA, E045PLA_TMP.NIVCTA, E044CCU_TMP.CODCCU, 
                        E044CCU_TMP.CLACCU, E044CCU_TMP.NIVCCU
                 FROM (SELECT ISNULL(E640RAT.CODEMP,E650SLC.CODEMP) CODEMP, 
                              ISNULL(E640RAT.FILRAT,E650SLC.CODFIL) FILRAT, 
                              ISNULL(E640RAT.CTARED,E650SLC.CTARED) CTARED, 
                              ISNULL(E640RAT.CODCCU,E650SLC.CODCCU) CODCCU 
                       FROM (SELECT CODEMP, FILRAT, CTARED, CODCCU FROM E640RAT
                             WHERE E640RAT.CODEMP = @V_CODEMP
                             AND E640RAT.FILRAT IN ('+@V_CODFIL+')
                             AND E640RAT.DATLCT >= @V_MESINI
                             AND E640RAT.DATLCT <= @V_MESFIM
                             GROUP BY CODEMP, FILRAT, CTARED, CODCCU) E640RAT
                       FULL OUTER JOIN (SELECT CODEMP, CODFIL, CTARED, CODCCU 
                                        FROM E650SLC
                                        WHERE E650SLC.CODEMP = @V_CODEMP
                                        AND E650SLC.CODFIL IN ('+@V_CODFIL+')
                                        AND E650SLC.MESANO = DATEADD(MM,-1,@V_MESINI)) E650SLC
                         ON E640RAT.CODEMP = E650SLC.CODEMP
                        AND E640RAT.FILRAT = E650SLC.CODFIL
                        AND E640RAT.CTARED = E650SLC.CTARED
                        AND E640RAT.CODCCU = E650SLC.CODCCU) E640RAT
                 INNER JOIN #E045PLA_TMP1 E045PLA_TMP
                   ON E640RAT.CODEMP = E045PLA_TMP.CODEMP
                   AND E640RAT.CTARED = E045PLA_TMP.ROOT_CTARED
                 INNER JOIN #E044CCU_TMP1 E044CCU_TMP
                   ON E640RAT.CODEMP = E044CCU_TMP.CODEMP
                  AND E640RAT.CODCCU = E044CCU_TMP.ROOT_CODCCU) PLACCU
  WHERE E650PMA.CODEMP = PLACCU.CODEMP
  AND (E650PMA.CODFIL = PLACCU.CODFIL OR PLACCU.CODFIL = -1)
  AND E650PMA.CODEMP = @V_CODEMP
  AND E650PMA.CODFIL IN ('+@V_CODFIL+')
  AND E650PMA.MESANO >= @V_MESINI
  AND E650PMA.MESANO <= @V_MESFIM
  ORDER BY E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, 
           PLACCU.CTARED, PLACCU.CODCCU'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint,@V_MESINI datetime,@V_MESFIM datetime',@V_CODEMP=@V_CODEMP,@V_MESINI=@V_MESINI,@V_MESFIM=@V_MESFIM
  
  /* GERANDO DEBITOS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 5 (GERANDO DEBITOS...)'
  SET @V_STMT=N'INSERT INTO #DEB_TMP1
  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATEADD(DD,-(DAY(E640LCT.DATLCT)-1),E640LCT.DATLCT) MESANO, 
  E045PLA_TMP.CTARED, E045PLA_TMP.CLACTA, ISNULL(E044CCU_TMP.CODCCU,'' '') CODCCU, ISNULL(E044CCU_TMP.CLACCU,''0'') CLACCU, 
  SUM(CASE E640LCT.TEMRAT WHEN 1 THEN E640RAT.VLRRAT WHEN 3 THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA
  FROM E640LCT 
  INNER JOIN #E045PLA_TMP1 E045PLA_TMP 
    ON E640LCT.CODEMP = E045PLA_TMP.CODEMP
    AND E640LCT.CTADEB = E045PLA_TMP.ROOT_CTARED
  LEFT OUTER JOIN E640RAT
    ON E640LCT.CODEMP = E640RAT.CODEMP
    AND E640LCT.NUMLCT = E640RAT.NUMLCT
    AND E640LCT.CTADEB = E640RAT.CTARED
    AND E640RAT.DATLCT >= @V_MESINI
    AND E640RAT.DATLCT <= @V_MESFIM
  LEFT OUTER JOIN #E044CCU_TMP1 E044CCU_TMP
    ON E640RAT.CODEMP = E044CCU_TMP.CODEMP
    AND E640RAT.CODCCU = E044CCU_TMP.ROOT_CODCCU
  WHERE E640LCT.CODEMP = @V_CODEMP
  AND E640LCT.CODFIL IN ('+@V_CODFIL+')
  AND E640LCT.SITLCT = 2 
  AND E640LCT.CTADEB <> 0
  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
  AND E640LCT.DATLCT >= @V_MESINI
  AND E640LCT.DATLCT <= @V_MESFIM
  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATEADD(DD,-(DAY(E640LCT.DATLCT)-1),E640LCT.DATLCT), 
  E045PLA_TMP.CTARED, E045PLA_TMP.CLACTA,  ISNULL(E044CCU_TMP.CODCCU,'' ''), ISNULL(E044CCU_TMP.CLACCU,''0'')
  ORDER BY 1, 2, 3, 4, 6'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint,@V_MESINI datetime,@V_MESFIM datetime',@V_CODEMP=@V_CODEMP,@V_MESINI=@V_MESINI,@V_MESFIM=@V_MESFIM
  
  /* GERANDO CREDITOS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 6 (GERANDO CREDITOS...)'
  SET @V_STMT=N'INSERT INTO #CRE_TMP1
  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATEADD(DD,-(DAY(E640LCT.DATLCT)-1),E640LCT.DATLCT) MESANO, 
  E045PLA_TMP.CTARED, E045PLA_TMP.CLACTA, ISNULL(E044CCU_TMP.CODCCU,'' '') CODCCU, ISNULL(E044CCU_TMP.CLACCU,''0'') CLACCU, 
  SUM(CASE E640LCT.TEMRAT WHEN 2 THEN E640RAT.VLRRAT WHEN 3 THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA
  FROM E640LCT 
  INNER JOIN #E045PLA_TMP1 E045PLA_TMP 
    ON E640LCT.CODEMP = E045PLA_TMP.CODEMP
    AND E640LCT.CTACRE = E045PLA_TMP.ROOT_CTARED
  LEFT OUTER JOIN E640RAT
    ON E640LCT.CODEMP = E640RAT.CODEMP
    AND E640LCT.NUMLCT = E640RAT.NUMLCT
    AND E640LCT.CTACRE = E640RAT.CTARED
    AND E640RAT.DATLCT >= @V_MESINI
    AND E640RAT.DATLCT <= @V_MESFIM
  LEFT OUTER JOIN #E044CCU_TMP1 E044CCU_TMP
    ON E640RAT.CODEMP = E044CCU_TMP.CODEMP
    AND E640RAT.CODCCU = E044CCU_TMP.ROOT_CODCCU
  WHERE E640LCT.CODEMP = @V_CODEMP
  AND E640LCT.CODFIL IN ('+@V_CODFIL+')
  AND E640LCT.SITLCT = 2 
  AND E640LCT.CTACRE <> 0
  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
  AND E640LCT.DATLCT >= @V_MESINI
  AND E640LCT.DATLCT <= @V_MESFIM
  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATEADD(DD,-(DAY(E640LCT.DATLCT)-1),E640LCT.DATLCT), 
  E045PLA_TMP.CTARED, E045PLA_TMP.CLACTA,  ISNULL(E044CCU_TMP.CODCCU,'' ''), ISNULL(E044CCU_TMP.CLACCU,''0'')
  ORDER BY 1, 2, 3, 4, 6'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint,@V_MESINI datetime,@V_MESFIM datetime',@V_CODEMP=@V_CODEMP,@V_MESINI=@V_MESINI,@V_MESFIM=@V_MESFIM
  
  /* CAPTURANDO ULTIMO SALDO VALIDO... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 7 (CAPTURANDO ULTIMO SALDO VALIDO...)'
  SET @V_STMT=N'INSERT INTO #MOV_TMP1
  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, SALMES
  FROM E650SLC
  WHERE CODEMP = @V_CODEMP
  AND CODFIL IN ('+@V_CODFIL+')
  AND MESANO = DATEADD(MM,-1,@V_MESINI)'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint,@V_MESINI datetime',@V_CODEMP=@V_CODEMP,@V_MESINI=@V_MESINI
  
  /* CONSOLIDANDO MOVIMENTOS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 8 (CONSOLIDANDO MOVIMENTOS...)'
  SET @V_STMT=N'INSERT INTO #MOV_TMP1
  SELECT PLACCU_TMP.CODEMP, PLACCU_TMP.CODFIL, PLACCU_TMP.MESANO, 
         PLACCU_TMP.CTARED, PLACCU_TMP.CLACTA, PLACCU_TMP.CODCCU, PLACCU_TMP.CLACCU,
         ISNULL(MOVTO.DEBMES,0) DEBMES, ISNULL(MOVTO.CREMES,0) CREMES, ISNULL(MOVTO.MOVMES,0) MOVMES
  FROM #PLACCU_TMP1 PLACCU_TMP
  LEFT OUTER JOIN
      (SELECT ISNULL(DEB.CODEMP,CRE.CODEMP) CODEMP, ISNULL(DEB.CODFIL,CRE.CODFIL) CODFIL, ISNULL(DEB.MESANO,CRE.MESANO) MESANO, 
       ISNULL(DEB.CTARED,CRE.CTARED) CTARED, ISNULL(DEB.CLACTA,CRE.CLACTA) CLACTA, 
       ISNULL(DEB.CODCCU,CRE.CODCCU) CODCCU, ISNULL(DEB.CLACCU,CRE.CLACCU) CLACCU,
       ISNULL(DEB.SOMA,0) DEBMES, ISNULL(CRE.SOMA,0) CREMES, 
       ISNULL(DEB.SOMA,0)-ISNULL(CRE.SOMA,0) MOVMES
       FROM #DEB_TMP1 DEB
       FULL OUTER JOIN #CRE_TMP1 CRE
         ON DEB.CODEMP = CRE.CODEMP
         AND DEB.CODFIL = CRE.CODFIL
         AND DEB.MESANO = CRE.MESANO
         AND DEB.CTARED = CRE.CTARED
         AND DEB.CODCCU = CRE.CODCCU) MOVTO
    ON PLACCU_TMP.CODEMP = MOVTO.CODEMP
   AND PLACCU_TMP.CODFIL = MOVTO.CODFIL
   AND PLACCU_TMP.MESANO = MOVTO.MESANO
   AND PLACCU_TMP.CTARED = MOVTO.CTARED
   AND PLACCU_TMP.CODCCU = MOVTO.CODCCU
  ORDER BY PLACCU_TMP.CODEMP, PLACCU_TMP.CODFIL, PLACCU_TMP.MESANO, 
           PLACCU_TMP.CLACTA, PLACCU_TMP.CTARED, PLACCU_TMP.CLACCU, PLACCU_TMP.CODCCU'
  EXEC sp_executesql @stmt=@V_STMT
  
  /* GERANDO SALDOS... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 9 (GERANDO SALDOS...)'
  SET @V_STMT=N'INSERT INTO E650SLC
  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, 
  SALMES-MOVMES SALANT, DEBMES, CREMES, MOVMES, SALMES
  FROM (SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, MOVMES, 
            (SELECT SUM(MOVMES)
             FROM #MOV_TMP1 D2
             WHERE D2.CODEMP = D1.CODEMP 
             AND D2.CODFIL = D1.CODFIL
             AND D2.CTARED = D1.CTARED 
             AND D2.CODCCU = D1.CODCCU 
             AND D2.MESANO <= D1.MESANO) SALMES
        FROM #MOV_TMP1 D1
        WHERE CODEMP = @V_CODEMP AND CODFIL IN ('+@V_CODFIL+') AND MESANO >= @V_MESINI) SALDOS'
  EXEC sp_executesql @stmt=@V_STMT,@params=N'@V_CODEMP smallint,@V_MESINI datetime',@V_CODEMP=@V_CODEMP,@V_MESINI=@V_MESINI
  
  /* SALVA ALTERACOES REALIZADAS */
  COMMIT TRANSACTION
  
  /* CASO SOLICITADO, EXECUTANDO ANALYZE... */
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 10 (EXECUTANDO ANALYZE...)'
  IF @V_STATS = 1
    EXECUTE ('UPDATE STATISTICS E650SLC')
  
  PRINT CONVERT(VARCHAR,GETDATE(),109)+' - PASSO 11 (PROCESSO FINALIZADO!)'

	POSTGRESQL;0
;B␀␀CREATE OR REPLACE PROCEDURE sp_gera650slc(v_codemp numeric, v_codfil character varying, v_mesinipar timestamp without time zone, v_mesfimpar timestamp without time zone, v_lock numeric, v_stats numeric)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  V_MESINI DATE;
  V_MESFIM DATE;
  V_COUNT INTEGER;
  C_PLA REFCURSOR;
  V_EMPPLA VARCHAR;
  V_CTARED VARCHAR;
  C_CCU REFCURSOR;
  V_EMPCCU VARCHAR;
  V_CODCCU VARCHAR;
BEGIN
	IF (V_MESINIPAR IS NOT NULL) THEN
    V_MESINI:= DATE_TRUNC('MONTH', V_MESINIPAR)::DATE;
  ELSE
    EXECUTE CONCAT('SELECT CAST(DATE_TRUNC(''MONTH'', MIN(MESANO)) FROM E650PMA WHERE CODEMP = ', V_CODEMP) ||' AND CODFIL IN ('||V_CODFIL||')'
    INTO V_MESINI;
  END IF;
  
  IF (V_MESFIMPAR IS NOT NULL) THEN
    V_MESFIM:= (DATE_TRUNC('MONTH', V_MESFIMPAR) +  INTERVAL '1 MONTH - 1 DAY')::DATE;
  ELSE
    EXECUTE CONCAT('SELECT LAST_DAY(MAX(MESANO)) FROM E650PMA WHERE CODEMP = ', V_CODEMP) ||' AND CODFIL IN ('||V_CODFIL||') '
    INTO V_MESFIM;    
  END IF;
  
  /* CRIANDO/TRUNCANDO TABELAS TEMPORARIAS... */
  RAISE NOTICE '% - PASSO 1 (CRIANDO/TRUNCANDO TABELAS TEMPORARIAS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  
  SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'E045PLA_TMP1';
  IF (V_COUNT > 0) THEN
    EXECUTE 'TRUNCATE TABLE E045PLA_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE E045PLA_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CTARED NUMERIC(7) NOT NULL,
     ROOT_CTARED NUMERIC(7) NOT NULL,
     CLACTA VARCHAR(30) NOT NULL,
     NIVCTA NUMERIC(2) NOT NULL,
     QTDPOS NUMERIC(1) NOT NULL)';
     EXECUTE 'CREATE INDEX E045PLA_TMP1Indice1 ON E045PLA_TMP1 (CODEMP, ROOT_CTARED)';
  END IF;
   
   SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'E044CCU_TMP1';
  IF (V_COUNT > 0) THEN
    EXECUTE 'TRUNCATE TABLE E044CCU_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE E044CCU_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CODCCU VARCHAR(9) NOT NULL,
     ROOT_CODCCU VARCHAR(9) NOT NULL,
     CCUPAI VARCHAR(9) NULL,
     CLACCU VARCHAR(30) NOT NULL,
     NIVCCU NUMERIC(2) NOT NULL,
     POSCCU NUMERIC(2) NOT NULL)';
     EXECUTE 'CREATE INDEX E044CCU_TMP1Indice1 ON E044CCU_TMP1 (CODEMP, ROOT_CODCCU)';
  END IF;
    
   SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'PLACCU_TMP1';
  IF (V_COUNT > 0) THEN
    EXECUTE 'TRUNCATE TABLE PLACCU_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE PLACCU_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CODFIL NUMERIC(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMERIC(7) NOT NULL,
     CLACTA VARCHAR(30) NOT NULL,
     NIVCTA NUMERIC(2) NULL,
     CODCCU VARCHAR(9) NULL,
     CLACCU VARCHAR(30) NULL,
     NIVCCU NUMERIC(2) NULL)';
     EXECUTE 'CREATE INDEX PLACCU_TMP1Indice1 ON PLACCU_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
   SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'DEB_TMP1';
  IF V_COUNT > 0 THEN
    EXECUTE 'TRUNCATE TABLE DEB_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE DEB_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CODFIL NUMERIC(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMERIC(7) NOT NULL,
     CLACTA VARCHAR(30) NOT NULL,
     CODCCU VARCHAR(9) NOT NULL,
     CLACCU VARCHAR(30) NOT NULL,
     SOMA NUMERIC(17,2))';
     EXECUTE 'CREATE INDEX DEB_TMP1Indice1 ON DEB_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
   SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'CRE_TMP1';
  IF (V_COUNT > 0) THEN
    EXECUTE 'TRUNCATE TABLE CRE_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE CRE_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CODFIL NUMERIC(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMERIC(7) NOT NULL,
     CLACTA VARCHAR(30) NOT NULL,
     CODCCU VARCHAR(9) NOT NULL,
     CLACCU VARCHAR(30) NOT NULL,
     SOMA NUMERIC(17,2))';
     EXECUTE 'CREATE INDEX CRE_TMP1Indice1 ON CRE_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;
    
   SELECT COUNT(1) INTO V_COUNT FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) = 'MOV_TMP1';
  IF (V_COUNT > 0) THEN
    EXECUTE 'TRUNCATE TABLE MOV_TMP1';
  ELSE
    EXECUTE 'CREATE TEMPORARY TABLE MOV_TMP1
    (CODEMP NUMERIC(4) NOT NULL,
     CODFIL NUMERIC(5) NOT NULL,
     MESANO DATE NOT NULL,
     CTARED NUMERIC(7) NOT NULL,
     CLACTA VARCHAR(30) NOT NULL,
     CODCCU VARCHAR(9) NOT NULL,
     CLACCU VARCHAR(30) NOT NULL,
     DEBMES NUMERIC(17,2),
     CREMES NUMERIC(17,2),
     MOVMES NUMERIC(17,2))';
     EXECUTE 'CREATE INDEX MOV_TMP1Indice1 ON MOV_TMP1 (CODEMP, CODFIL, CTARED, CODCCU, MESANO)';
     EXECUTE 'CREATE INDEX MOV_TMP1Indice2 ON MOV_TMP1 (CODEMP, CODFIL, MESANO, CTARED, CODCCU)';
  END IF;

  /* EXECUTANDO LOCKS... */  
  RAISE NOTICE '% - PASSO 2 (EXECUTANDO LOCKS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  IF (V_LOCK = '1') THEN
    LOCK TABLE E650SLC IN EXCLUSIVE MODE;
    LOCK TABLE E640RAT IN EXCLUSIVE MODE;
    LOCK TABLE E640LCT IN EXCLUSIVE MODE;
  END IF;

  /* GERANDO CONTAS... */
 RAISE NOTICE '% - PASSO 3 (GERANDO CONTAS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
 EXECUTE CONCAT('INSERT INTO E045PLA_TMP1
	  (CODEMP, CTARED, ROOT_CTARED, CLACTA, NIVCTA, QTDPOS)
		WITH PLA AS (SELECT E045PLA2.CODEMP, E045PLA2.CTARED, E045PLA.CTARED ROOT_CTARED, 
	         E045PLA2.CLACTA, E045PLA2.NIVCTA, E045PLA2.QTDPOS
	  FROM E045PLA
	  INNER JOIN E045PLA AS E045PLA2
	     ON E045PLA.CODEMP = E045PLA2.CODEMP 
	    AND E045PLA.CLACTA LIKE E045PLA2.CLACTA || ''%''
	    AND NOT (E045PLA.NIVCTA = E045PLA2.NIVCTA
	             AND E045PLA.CTARED <> E045PLA2.CTARED)
	  WHERE E045PLA.CODEMP = ', V_CODEMP) || ' 
	  ORDER BY E045PLA.CODEMP, E045PLA.CLACTA, E045PLA2.CLACTA)
		SELECT PLA.CODEMP, PLA.CTARED, PLA.ROOT_CTARED, 
	         PLA.CLACTA, PLA.NIVCTA, PLA.QTDPOS FROM PLA';
    

  /* GERANDO CENTROS DE CUSTO... */
  RAISE NOTICE '% - PASSO 4 (GERANDO CENTROS DE CUSTO...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
 	EXECUTE CONCAT('INSERT INTO E044CCU_TMP1
		    (CODEMP, CODCCU, ROOT_CODCCU, CCUPAI, CLACCU, NIVCCU, POSCCU)
		  WITH CCU AS (
		  SELECT E044CCU2.CODEMP, E044CCU2.CODCCU, E044CCU.CODCCU ROOT_CODCCU, 
		         E044CCU2.CCUPAI, E044CCU2.CLACCU, E044CCU2.NIVCCU, E044CCU2.POSCCU
		  FROM E044CCU
		  INNER JOIN E044CCU AS E044CCU2
		     ON E044CCU.CODEMP = E044CCU2.CODEMP
		    AND E044CCU.CLACCU LIKE E044CCU2.CLACCU || ''%''
		    AND NOT (E044CCU.NIVCCU = E044CCU2.NIVCCU
		             AND E044CCU.CODCCU <> E044CCU2.CODCCU)
		  WHERE E044CCU.CODEMP =  ', V_CODEMP) || '
		  ORDER BY E044CCU.CODEMP, E044CCU.CODCCU, E044CCU2.CLACCU) 
			SELECT CCU.CODEMP, CCU.CODCCU, CCU.ROOT_CODCCU, 
		         CCU.CCUPAI, CCU.CLACCU, CCU.NIVCCU, CCU.POSCCU FROM CCU';
		
  /* GERANDO CONTAS/CENTROS/MESANO */
  RAISE NOTICE '% - PASSO 5 (GERANDO CONTAS/CENTROS/MESANO)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE CONCAT('INSERT INTO PLACCU_TMP1
		  SELECT E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, 
		         PLACCU.CLACTA, PLACCU.NIVCTA, PLACCU.CODCCU, PLACCU.CLACCU, PLACCU.NIVCCU
		  FROM E650PMA, (SELECT E045PLA.CODEMP, -1 CODFIL, E045PLA.CTARED, E045PLA.CLACTA, E045PLA.NIVCTA, 
		                        '' '' CODCCU, ''0'' CLACCU, 0 NIVCCU
		                 FROM E045PLA
		                 WHERE E045PLA.CODEMP = ', V_CODEMP) || CONCAT('
		                 UNION ALL
		                 SELECT DISTINCT E640RAT.CODEMP, E640RAT.FILRAT, E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, E045PLA_TMP1.NIVCTA, 
		                        E044CCU_TMP1.CODCCU, E044CCU_TMP1.CLACCU, E044CCU_TMP1.NIVCCU
		                 FROM (SELECT COALESCE(E640RAT.CODEMP,E650SLC.CODEMP) CODEMP, 
		                              COALESCE(E640RAT.FILRAT,E650SLC.CODFIL) FILRAT, 
		                              COALESCE(E640RAT.CTARED,E650SLC.CTARED) CTARED, 
		                              COALESCE(E640RAT.CODCCU,E650SLC.CODCCU) CODCCU 
		                       FROM (SELECT CODEMP, FILRAT, CTARED, CODCCU FROM E640RAT
		                             WHERE E640RAT.CODEMP = ', V_CODEMP) ||'
		                             AND E640RAT.FILRAT IN ('||V_CODFIL||')
		                             AND E640RAT.DATLCT >= '''||V_MESINI||'''
		                             AND E640RAT.DATLCT <= '''||V_MESFIM||'''' || CONCAT('
		                             GROUP BY CODEMP, FILRAT, CTARED, CODCCU) E640RAT
		                       FULL OUTER JOIN (SELECT CODEMP, CODFIL, CTARED, CODCCU FROM E650SLC
		                                        WHERE E650SLC.CODEMP = ', V_CODEMP) ||'
		                                        AND E650SLC.CODFIL IN ('||V_CODFIL||')
		                                        AND E650SLC.MESANO = DATE '''||V_MESINI||'''' || CONCAT(' - INTERVAL ''1 MONTH'') E650SLC
		                         ON E640RAT.CODEMP = E650SLC.CODEMP
		                        AND E640RAT.FILRAT = E650SLC.CODFIL
		                        AND E640RAT.CTARED = E650SLC.CTARED
		                        AND E640RAT.CODCCU = E650SLC.CODCCU) E640RAT
		                 INNER JOIN E045PLA_TMP1 
		                   ON E640RAT.CODEMP = E045PLA_TMP1.CODEMP
		                   AND E640RAT.CTARED = E045PLA_TMP1.ROOT_CTARED
		                 INNER JOIN E044CCU_TMP1
		                   ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
		                  AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU) PLACCU
		  WHERE E650PMA.CODEMP = PLACCU.CODEMP
		  AND (E650PMA.CODFIL = PLACCU.CODFIL OR PLACCU.CODFIL = -1)
		  AND E650PMA.CODEMP = ', V_CODEMP) ||'
		  AND E650PMA.CODFIL IN ('||V_CODFIL||')
		  AND E650PMA.MESANO >= '''||V_MESINI||'''
		  AND E650PMA.MESANO <= '''||V_MESFIM||'''
		  ORDER BY E650PMA.CODEMP, E650PMA.CODFIL, E650PMA.MESANO, PLACCU.CTARED, PLACCU.CODCCU';
  
  /* GERANDO DEBITOS... */
  RAISE NOTICE '% - PASSO 6 (GERANDO DEBITOS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE 'INSERT INTO DEB_TMP1
		  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATE_TRUNC(''MONTH'', E640LCT.DATLCT) MESANO, 
		  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, COALESCE(E044CCU_TMP1.CODCCU,'' '') CODCCU, COALESCE(E044CCU_TMP1.CLACCU,''0'') CLACCU, 
		  SUM(CASE E640LCT.TEMRAT WHEN 1 THEN E640RAT.VLRRAT WHEN 3 THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA
		  FROM E640LCT 
		  INNER JOIN E045PLA_TMP1 
		    ON E640LCT.CODEMP = E045PLA_TMP1.CODEMP
		    AND E640LCT.CTADEB = E045PLA_TMP1.ROOT_CTARED
		  LEFT OUTER JOIN E640RAT
		    ON E640LCT.CODEMP = E640RAT.CODEMP
		    AND E640LCT.NUMLCT = E640RAT.NUMLCT
		    AND E640LCT.CTADEB = E640RAT.CTARED
		    AND E640RAT.DATLCT >= '''||V_MESINI||'''
		    AND E640RAT.DATLCT <= '''||V_MESFIM||'''' || CONCAT('
		  LEFT OUTER JOIN E044CCU_TMP1
		    ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
		    AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU
		  WHERE E640LCT.CODEMP = ', V_CODEMP) ||'
		  AND E640LCT.CODFIL IN ('||V_CODFIL||')
		  AND E640LCT.SITLCT = 2 
		  AND E640LCT.CTADEB <> 0
		  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
		  AND E640LCT.DATLCT >= '''||V_MESINI||'''
		  AND E640LCT.DATLCT <= '''||V_MESFIM||'''
		  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''MONTH'', E640LCT.DATLCT), 
		  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA,  COALESCE(E044CCU_TMP1.CODCCU,'' ''), COALESCE(E044CCU_TMP1.CLACCU,''0'')
		  ORDER BY 1, 2, 3, 4, 6';
		  
  /* GERANDO CREDITOS... */
  RAISE NOTICE '% - PASSO 7 (GERANDO CREDITOS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE 'INSERT INTO CRE_TMP1
		  SELECT E640LCT.CODEMP CODEMP, E640LCT.CODFIL CODFIL, DATE_TRUNC(''MONTH'',E640LCT.DATLCT) MESANO, 
		  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA, COALESCE(E044CCU_TMP1.CODCCU,'' '') CODCCU, COALESCE(E044CCU_TMP1.CLACCU,''0'') CLACCU, 
		  SUM(CASE E640LCT.TEMRAT WHEN 2 THEN E640RAT.VLRRAT WHEN 3 THEN E640RAT.VLRRAT ELSE E640LCT.VLRLCT END) SOMA   
		  FROM E640LCT 
		  INNER JOIN E045PLA_TMP1 
		    ON E640LCT.CODEMP = E045PLA_TMP1.CODEMP
		    AND E640LCT.CTACRE = E045PLA_TMP1.ROOT_CTARED
		  LEFT OUTER JOIN E640RAT
		    ON E640LCT.CODEMP = E640RAT.CODEMP
		    AND E640LCT.NUMLCT = E640RAT.NUMLCT
		    AND E640LCT.CTACRE = E640RAT.CTARED
		    AND E640RAT.DATLCT >= '''||V_MESINI||'''
		    AND E640RAT.DATLCT <= '''||V_MESFIM||'''' || CONCAT('
		  LEFT OUTER JOIN E044CCU_TMP1
		    ON E640RAT.CODEMP = E044CCU_TMP1.CODEMP
		    AND E640RAT.CODCCU = E044CCU_TMP1.ROOT_CODCCU
		  WHERE E640LCT.CODEMP = ', V_CODEMP) ||'
		  AND E640LCT.CODFIL IN ('||V_CODFIL||') 
		  AND E640LCT.SITLCT = 2 
		  AND E640LCT.CTACRE <> 0
		  AND (E640LCT.TIPLCT = 1 OR E640LCT.TIPLCT = 3)
		  AND E640LCT.DATLCT >= '''||V_MESINI||'''
		  AND E640LCT.DATLCT <= '''||V_MESFIM||'''
		  GROUP BY E640LCT.CODEMP, E640LCT.CODFIL, DATE_TRUNC(''MONTH'', E640LCT.DATLCT), 
		  E045PLA_TMP1.CTARED, E045PLA_TMP1.CLACTA,  COALESCE(E044CCU_TMP1.CODCCU,'' ''), COALESCE(E044CCU_TMP1.CLACCU,''0'')
		  ORDER BY 1, 2, 3, 4, 6';

  /* CAPTURANDO ULTIMO SALDO VALIDO... */
  RAISE NOTICE '% - PASSO 8 (CAPTURANDO ULTIMO SALDO VALIDO...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE CONCAT('INSERT INTO MOV_TMP1
  		  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, SALMES
  			 FROM E650SLC
  			WHERE CODEMP = ', V_CODEMP) ||'
  			  AND CODFIL IN ('||V_CODFIL||')
  			  AND MESANO = DATE '''||V_MESINI||''' - INTERVAL ''1 MONTH''';

  /* CONSOLIDANDO MOVIMENTOS... */
  RAISE NOTICE '% - PASSO 9 (CONSOLIDANDO MOVIMENTOS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE 'INSERT INTO MOV_TMP1
		  SELECT PLACCU_TMP1.CODEMP, PLACCU_TMP1.CODFIL, PLACCU_TMP1.MESANO, 
		         PLACCU_TMP1.CTARED, PLACCU_TMP1.CLACTA, PLACCU_TMP1.CODCCU, PLACCU_TMP1.CLACCU,
		         COALESCE(MOVTO.DEBMES,0) DEBMES, COALESCE(MOVTO.CREMES,0) CREMES, COALESCE(MOVTO.MOVMES,0) MOVMES
		  FROM PLACCU_TMP1
		  LEFT OUTER JOIN
		      (SELECT COALESCE(DEB.CODEMP,CRE.CODEMP) CODEMP, COALESCE(DEB.CODFIL,CRE.CODFIL) CODFIL, COALESCE(DEB.MESANO,CRE.MESANO) MESANO, 
		       COALESCE(DEB.CTARED,CRE.CTARED) CTARED, COALESCE(DEB.CLACTA,CRE.CLACTA) CLACTA, 
		       COALESCE(DEB.CODCCU,CRE.CODCCU) CODCCU, COALESCE(DEB.CLACCU,CRE.CLACCU) CLACCU,
		       COALESCE(DEB.SOMA,0) DEBMES, COALESCE(CRE.SOMA,0) CREMES, 
		       COALESCE(DEB.SOMA,0)-COALESCE(CRE.SOMA,0) MOVMES
		       FROM DEB_TMP1 DEB
		       FULL OUTER JOIN CRE_TMP1 CRE
		         ON DEB.CODEMP = CRE.CODEMP
		         AND DEB.CODFIL = CRE.CODFIL
		         AND DEB.MESANO = CRE.MESANO
		         AND DEB.CTARED = CRE.CTARED
		         AND DEB.CODCCU = CRE.CODCCU) MOVTO
		    ON PLACCU_TMP1.CODEMP = MOVTO.CODEMP
		   AND PLACCU_TMP1.CODFIL = MOVTO.CODFIL
		   AND PLACCU_TMP1.MESANO = MOVTO.MESANO
		   AND PLACCU_TMP1.CTARED = MOVTO.CTARED
		   AND PLACCU_TMP1.CODCCU = MOVTO.CODCCU
		  ORDER BY PLACCU_TMP1.CODEMP, PLACCU_TMP1.CODFIL, PLACCU_TMP1.MESANO, 
		           PLACCU_TMP1.CLACTA, PLACCU_TMP1.CTARED, PLACCU_TMP1.CLACCU, PLACCU_TMP1.CODCCU';

  /* GERANDO SALDOS... */
  RAISE NOTICE '% - PASSO 10 (GERANDO SALDOS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE CONCAT('INSERT INTO E650SLC
  SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, 
  SALMES-MOVMES SALANT, DEBMES, CREMES, MOVMES, SALMES
  FROM (SELECT CODEMP, CODFIL, MESANO, CTARED, CLACTA, CODCCU, CLACCU, DEBMES, CREMES, MOVMES, 
            (SELECT SUM(MOVMES)
             FROM MOV_TMP1 D2
             WHERE D2.CODEMP = D1.CODEMP 
             AND D2.CODFIL = D1.CODFIL
             AND D2.CTARED = D1.CTARED 
             AND D2.CODCCU = D1.CODCCU 
             AND D2.MESANO <= D1.MESANO) SALMES
        FROM MOV_TMP1 D1
        WHERE CODEMP = ', V_CODEMP) ||' AND CODFIL IN ('||V_CODFIL||') AND MESANO >= '''||V_MESINI||''') SALDOS';
  

  /* TRUNCANDO TABELAS TEMPORARIAS... */
  RAISE NOTICE '% - PASSO 11 (TRUNCANDO TABELAS TEMPORARIAS...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  EXECUTE 'TRUNCATE TABLE E045PLA_TMP1';
  EXECUTE 'TRUNCATE TABLE E044CCU_TMP1';
  EXECUTE 'TRUNCATE TABLE PLACCU_TMP1';
  EXECUTE 'TRUNCATE TABLE DEB_TMP1';
  EXECUTE 'TRUNCATE TABLE CRE_TMP1';
  EXECUTE 'TRUNCATE TABLE MOV_TMP1';
  
  /* CASO SOLICITADO, EXECUTANDO ANALYZE... */
  RAISE NOTICE '% - PASSO 12 (EXECUTANDO ANALYZE...)', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
  IF V_STATS = '1' THEN
    EXECUTE 'ANALYZE E650SLC';
  END IF;
  
 RAISE NOTICE '% - PASSO 13 (PROCESSO FINALIZADO!', TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YY HH24:MI:SS');
 
EXCEPTION
  WHEN OTHERS THEN
  ROLLBACK;
    RAISE;
END;
$BODY$
;
