{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe manage.py test)",
      "Bash(.venv/Scripts/python.exe manage.py test *)",
      "Bash(.venv/Scripts/python.exe manage.py check)",
      "Bash(.venv/Scripts/python.exe manage.py check *)",
      "Bash(python manage.py test)",
      "Bash(python manage.py test *)",
      "Bash(python manage.py check)",
      "Bash(python manage.py check *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(.venv/Scripts/ruff.exe check *)",
      "Bash(.venv/Scripts/ruff.exe format --check *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_de_comandos.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_no_arquivo.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
